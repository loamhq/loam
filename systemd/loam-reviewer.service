[Unit]
Description=Loam reviewer — one persona's workspace read by a non-author, one note left (Move 11)
# The same handler every wake carries: a kill that runs no `finally` is
# reported from outside the dying process. bin/wake-failed knows this unit's
# name and the marker bin/review drops under state/wake/.
OnFailure=loam-wake-failed@%N.service

[Service]
Type=oneshot
# No memory ceiling (2026-11-16; a wake's MemoryHigh 1G / MemoryMax 1536M
# until then): an agent run, at the agents' place in the OOM order
# (lib/loam_config.py).
OOMScoreAdjust=@AGENT_OOM@
CPUWeight=@BACKGROUND_CPU_WEIGHT@
Nice=@BACKGROUND_NICE@
IOSchedulingClass=@BACKGROUND_IO_CLASS@
Environment=DISABLE_AUTOUPDATER=1
# And Antigravity's own updater off (lib/loam_pins.py: the CLIs stay at
# the release's pin; the variable is read only as `true`).
Environment=AGY_CLI_DISABLE_AUTO_UPDATE=true
Environment=PATH=@UNIT_PATH@
EnvironmentFile=-@WAKE_ENV@
WorkingDirectory=@ROOT@/reviewer
ExecStart=@ROOT@/bin/review
# No clock (since 2026-11-10; 5100 s until then, the run's 3600 and a
# 1200 s lock wait): a review goes until it is done, as a wake does.
TimeoutStartSec=infinity

[Install]
WantedBy=default.target
