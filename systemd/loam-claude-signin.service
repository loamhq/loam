# Run by loam-claude-signin.path on every change to the Claude Code login
# file: write down whether Claude Code is signed in (bin/claude-signin). It
# starts and stops nothing since Remote Control was retired (2026-11-19); it
# is where a sign-in will decide whether agents can run. Never enabled
# itself.
[Unit]
Description=Loam: record the Claude Code sign-in

[Service]
Type=oneshot
ExecStart=@ROOT@/bin/claude-signin
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal
