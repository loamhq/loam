# Run by loam-claude-signin.path on every change to the Claude Code login file:
# start the Remote Control servers waiting for a sign-in, or stop the running
# ones when the sign-in is gone (bin/rc-arm says which, and why a running or
# deliberately stopped server is left alone). Never enabled itself.
[Unit]
Description=Loam: start or stop the Remote Control servers by the Claude Code sign-in

[Service]
Type=oneshot
ExecStart=@ROOT@/bin/rc-arm
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal
