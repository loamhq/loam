[Unit]
Description=Loam — providers follow their latest release (smoke test, switch, rollback)
# lib/loam_follow.py is the rule; bin/provider-follow is the command. The owner,
# 2026-11-11 11:06 PT: automatic, "for all the providers, or at least any
# provider that is actively signed in and active", with no stop on an alias
# or model move. A provider not signed in is skipped in the run log
# (logs/provider-follow.jsonl). A switch is followed by an hour's watch in
# this same run, and a lane that fails to start in it rolls the link back.

[Service]
Type=oneshot
# The smoke runs the candidate build by its full path, so nothing here can
# make a build update itself; the variable is set for the binaries the
# command calls through the links (--version) all the same.
Environment=DISABLE_AUTOUPDATER=1
Environment=PATH=@UNIT_PATH@
# The wake lane's credential, so the wake-shaped run is a wake's.
EnvironmentFile=-@WAKE_ENV@
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/bin/provider-follow run
# A run waits for a quiet broker (never cutting a turn) and then watches for
# an hour, so it has no clock.
TimeoutStartSec=infinity
# No memory ceiling (2026-11-16; MemoryHigh 2G / MemoryMax 3G until then):
# the smoke runs are agent runs, at the agents' place in the OOM order
# (lib/loam_config.py).
OOMScoreAdjust=@AGENT_OOM@
