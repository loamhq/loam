[Unit]
Description=Loam — nightly housekeeping for /tmp, bytecode, Antigravity, GitHub and plugins
# bin/sweep-tmp holds the what and the why. It is the backstop behind each
# engineer job's own scratch (removed when the job ends): a unit killed before
# its `finally`, a path typed by hand. Caused 2026-10-21, `/` full of ~30 GB
# of ended jobs' scratch. What it removes is one line each in
# logs/sweep-tmp.jsonl; the summary is in this unit's journal.

[Service]
Type=oneshot
# The walk stops at the first fresh file of a busy tree; a stale one is
# walked whole and then measured, which on 10-21's /tmp took a few minutes.
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
ExecStart=/usr/bin/python3 -I -X pycache_prefix=@PYCACHE@ @ROOT@/bin/sweep-tmp
# The Python prefix cache outlives test scratch and job clones. Sudo keeps
# the prefix for Python commands, so the user's cache can contain root-owned
# directories. Pass the rendered prefix explicitly when sweeping as root.
ExecStart=-/usr/bin/sudo -n /usr/bin/python3 -IB @ROOT@/bin/sweep-pycache --cache @PYCACHE@
# Work that was a step of drift-watch until 2026-11-19, when the one check on
# a clock (bin/loam-check) replaced it: work is not watching, so it is done
# here. Each is its own process; the leading `-` keeps one that fails from
# stopping the next or marking the sweep failed, and each says what it did in
# this unit's journal. clear-agy-files removes Antigravity's week-old
# conversation files. `github-app check` is the day's one call to GitHub,
# which refreshes the user token when it is due and so keeps the six-month
# refresh token rolling while nobody touches GitHub; what it finds wrong is
# read from its store by the check (lib/loam_check.py), not said here.
ExecStart=-/usr/bin/python3 -X pycache_prefix=@PYCACHE@ @ROOT@/bin/clear-agy-files
ExecStart=-/usr/bin/python3 -X pycache_prefix=@PYCACHE@ @ROOT@/bin/github-app check
ExecStart=-/usr/bin/python3 -X pycache_prefix=@PYCACHE@ @ROOT@/bin/check-plugin-updates
ExecStart=-/usr/bin/python3 -X pycache_prefix=@PYCACHE@ @ROOT@/bin/loam-report check
