[Unit]
Description=Daily drift check, after the Remote Control recycle

[Timer]
# 01:40 @ZONE_WORD@: ten minutes after the recycle at 01:30, so it reads the RC
# servers as they restarted, and twenty before the first wake at 02:00, so a
# finding is in comms before any persona reads it. The check takes seconds.
# Persistent=false like every timer in the grid: a night missed because the
# box was down is not run late into the wakes.
OnCalendar=*-*-* 01:40:00 @TZ@
Persistent=false
Unit=loam-check-drift.service

[Install]
WantedBy=timers.target
