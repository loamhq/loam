[Unit]
Description=Loam session broker: persona sessions for the web half
# The bridge it binds to is docker's, so docker has to have made it. A user
# unit cannot depend on a system unit, so this is a wait rather than an
# ordering: the address either exists or the unit restarts until it does.
After=network-online.target
Wants=network-online.target

[Service]
# Runs as the box's user, and that is the entire point. The login at ~/.claude is
# this user's, the persona workspaces are this user's, and a session the
# broker starts has to be indistinguishable from a session started at a
# terminal here. No credential is passed in: there is nothing to pass, the
# session uses the login where it lives.
Type=simple
Restart=always
RestartSec=5s
# The sessions the broker starts are its children and live in this cgroup.
#
# **No ceiling, since 2026-11-16.** The owner: "remove all of these limits
# on the different agents, whether personas or engineers." The broker admits
# a session by the box's memory (lib/loam_broker.py: a start is admitted
# while MemAvailable leaves MEMORY_RESERVE_MB for the rest of the box) and
# ends idle ones under pressure; nothing here bounds the chats. What decides
# who goes if the box truly runs out is the kernel's OOM order
# (lib/loam_config.py):
#
#   * every chat's CLI, and the MCP servers under it, is started at the
#     agents' score through `choom` (CHILD_OOM_SCORE_ADJ = AGENT_OOM_SCORE_ADJ,
#     800), as is every other agent run on the box;
#   * this unit, and so the broker's own process, is at the core's 100, the
#     lowest a user unit may take. So the kernel ends a chat, a job or a wake
#     long before it reaches the broker, and Caddy, Authelia, the app and the
#     claim service (the system's 0) after that.
#
# Until 11-16: MemoryHigh=80% / MemoryMax=88% as the wall around every chat
# together, and OOMScoreAdjust=500 -- which ranked the broker ABOVE every
# engineer job, wake and (then) Remote Control server (the user manager's 200), so a global OOM
# took the broker first. Before 11-09: High 28% / Max 32%, sized in 2026-10
# for a cap of four chats.
OOMScoreAdjust=@CORE_OOM@
Environment=DISABLE_AUTOUPDATER=1
# And Antigravity's own updater off (lib/loam_pins.py: the CLIs stay at
# the release's pin; the variable is read only as `true`).
Environment=AGY_CLI_DISABLE_AUTO_UPDATE=true
Environment=PATH=@UNIT_PATH@
WorkingDirectory=@ROOT@
ExecStart=/usr/bin/python3 @ROOT@/bin/session-broker
# stdout carries the listening line and the idle reaper; stderr carries a
# session's own stderr, prefixed with which session it came from. Both are
# worth keeping and neither redraws itself, so this keeps both.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
