[Unit]
Description=Daily memory headroom check, immediately before the wake grid

[Timer]
# 01:55 @ZONE_WORD@: 5 minutes before the first wake at 02:00. The placement is
# the point -- this reads the headroom the grid is actually about to run on.
OnCalendar=*-*-* 01:55:00 @TZ@
Persistent=false
Unit=loam-check-memory.service

[Install]
WantedBy=timers.target
