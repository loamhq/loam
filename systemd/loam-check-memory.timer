[Unit]
Description=Daily memory headroom check, immediately before the wake grid

[Timer]
# 01:55 @ZONE_WORD@: 25 minutes after the recycle at 01:30 and 5 minutes before
# Iris wakes at 02:00. The placement is the point -- this reads headroom the
# grid is actually about to run on, after the recycle has returned whatever it
# is going to return, not the pre-recycle number that says nothing about tonight.
OnCalendar=*-*-* 01:55:00 @TZ@
Persistent=false
Unit=loam-check-memory.service

[Install]
WantedBy=timers.target
