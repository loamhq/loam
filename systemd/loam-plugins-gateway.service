[Unit]
Description=Loam plugin gateway: /x/<id>/ to each server plugin's own port
# bin/plugin-gateway. Caddy sends /x/* on the app's host here, behind the
# login; this passes each request to the plugin's loopback port from
# state/plugins/ports.json. It runs no plugin code: each plugin's server is
# its own transient unit, loam-plugin-<id>.service (lib/loam_plugin_servers.py),
# and neither a plugin nor this touches the broker.

[Service]
Type=simple
Restart=always
RestartSec=2s
# Core, so the kernel reaches it after every agent run (lib/loam_config.py,
# 2026-11-16; 300 until then). The 128M is its own, not an agent's: a gateway
# that grows past it is itself the runaway, and Restart= brings it back in 2 s.
MemoryMax=128M
OOMScoreAdjust=@CORE_OOM@
NoNewPrivileges=yes
WorkingDirectory=@ROOT@
ExecStart=/usr/bin/python3 @ROOT@/bin/plugin-gateway
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
