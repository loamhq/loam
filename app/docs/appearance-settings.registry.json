{
  "status": "broker integration required",
  "route": "/v1/settings/appearance",
  "settings": [
    {
      "key": "appearance.location",
      "type": [
        "object",
        "null"
      ],
      "default": null,
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude",
        "source",
        "timeZone"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "multipleOf": 0.1
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "multipleOf": 0.1
        },
        "source": {
          "type": "string",
          "enum": [
            "geolocation",
            "timezone"
          ]
        },
        "timeZone": {
          "type": "string",
          "description": "IANA time zone for dates and switch-time labels"
        }
      }
    },
    {
      "key": "appearance.phone.mode",
      "type": "string",
      "enum": [
        "light",
        "dark",
        "sun",
        "system"
      ],
      "default": "system"
    },
    {
      "key": "appearance.phone.transition",
      "type": "string",
      "enum": [
        "fast",
        "normal",
        "long"
      ],
      "default": "normal"
    },
    {
      "key": "appearance.phone.board_view",
      "type": "string",
      "enum": [
        "cards",
        "doc"
      ],
      "default": "cards"
    },
    {
      "key": "appearance.phone.size",
      "type": "integer",
      "minimum": 75,
      "maximum": 150,
      "multipleOf": 5,
      "default": 100
    },
    {
      "key": "appearance.phone.theme",
      "type": "string",
      "enum": [
        "latte",
        "plain"
      ],
      "default": "latte"
    },
    {
      "key": "appearance.phone.options.latte.agent-colours",
      "type": "string",
      "enum": [
        "palette",
        "latte-tones"
      ],
      "default": "palette"
    },
    {
      "key": "appearance.phone.options.latte.agent-shapes",
      "type": "string",
      "enum": [
        "distinct",
        "circle",
        "rounded-square",
        "latte-art"
      ],
      "default": "circle"
    },
    {
      "key": "appearance.phone.options.latte.latte-mug",
      "type": "string",
      "enum": [
        "on",
        "off"
      ],
      "default": "on"
    },
    {
      "key": "appearance.phone.options.latte.latte-inside",
      "type": "string",
      "enum": [
        "pour",
        "initials"
      ],
      "default": "pour"
    },
    {
      "key": "appearance.desktop.mode",
      "type": "string",
      "enum": [
        "light",
        "dark",
        "sun",
        "system"
      ],
      "default": "system"
    },
    {
      "key": "appearance.desktop.transition",
      "type": "string",
      "enum": [
        "fast",
        "normal",
        "long"
      ],
      "default": "normal"
    },
    {
      "key": "appearance.desktop.board_view",
      "type": "string",
      "enum": [
        "cards",
        "doc"
      ],
      "default": "cards"
    },
    {
      "key": "appearance.desktop.size",
      "type": "integer",
      "minimum": 75,
      "maximum": 150,
      "multipleOf": 5,
      "default": 100
    },
    {
      "key": "appearance.desktop.theme",
      "type": "string",
      "enum": [
        "latte",
        "plain"
      ],
      "default": "latte"
    },
    {
      "key": "appearance.desktop.options.latte.agent-colours",
      "type": "string",
      "enum": [
        "palette",
        "latte-tones"
      ],
      "default": "palette"
    },
    {
      "key": "appearance.desktop.options.latte.agent-shapes",
      "type": "string",
      "enum": [
        "distinct",
        "circle",
        "rounded-square",
        "latte-art"
      ],
      "default": "circle"
    },
    {
      "key": "appearance.desktop.options.latte.latte-mug",
      "type": "string",
      "enum": [
        "on",
        "off"
      ],
      "default": "on"
    },
    {
      "key": "appearance.desktop.options.latte.latte-inside",
      "type": "string",
      "enum": [
        "pour",
        "initials"
      ],
      "default": "pour"
    }
  ]
}
