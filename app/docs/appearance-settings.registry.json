    {
      "key": "appearance.location",
      "type": [
        "object",
        "null"
      ],
      "default": null,
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude",
        "source",
        "timeZone"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "multipleOf": 0.1
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "multipleOf": 0.1
        },
        "source": {
          "type": "string",
          "enum": [
            "geolocation",
            "timezone"
          ]
        },
        "timeZone": {
          "type": "string",
          "description": "IANA time zone for dates and switch-time labels"
        }
      }
    },
    {
      "key": "appearance.phone.mode",
      "type": "string",
      "enum": [
        "light",
        "dark",
        "sun",
        "system"
      ],
      "default": "system"
    },
    {
      "key": "appearance.phone.size",
