#!/usr/bin/env python3
"""Run test_*.py scripts in parallel. Exit nonzero if any script fails. Each test gets
its own temporary install, vault, runtime state and lock directory. The landing
also isolates network and live install paths. Tests use python3 unless their
Run: line requests the MCP environment.

Run: python3 tests/run-all [--jobs N] [test_x.py ...]
     python3 tests/run-all --live

The live set checks the actual host one test at a time and runs only on request.
"""

import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))
import loam_config  # noqa: E402

VENV = loam_config.MCP_VENV / "bin" / "python"
PER_TEST_TIMEOUT = 600


def interpreter(test: Path) -> str:
    head = test.read_text(encoding="utf-8")[:4000]
    if re.search(r"^Run: mcp/\.venv/bin/python", head, re.MULTILINE):
        return str(VENV)
    return sys.executable


# Use the suite's install layout for every fixture regardless of the host configuration.
FIXTURE = {
    "timezone": "America/Los_Angeles",
    "vault": {"inbox": "00_INBOX", "failure_log": "00_INBOX/from-agents/loam-wake-failures.md",
              "conversations": "15_CONVERSATIONS", "projects": "40_PROJECTS",
              "attachments": "98_ATTACHMENTS", "system": "99_SYSTEM"},
}

# What of the install a test may see: who it runs as, and its tools.
MACHINE = {
    "user": loam_config.USER,
    "paths": {"home": str(loam_config.HOME), "root": str(ROOT),
              "mcp_venv": str(loam_config.MCP_VENV),
              "pycache": str(loam_config.PYCACHE)},
}

# Loam's starter agent, which every install has (lib/loam_install.py).
STARTER = "iris"

# Every other path, into the test's scratch folder (its name there).
SCRATCH_PATHS = {
    "vault": "vault", "workspaces": "ai-labs", "projects": "projects",
    "plugins": "plugins", "state": "state", "logs": "state/logs",
    "jobs": "state/jobs", "reviewer_state": "state/reviewer",
    "secrets_env": "config/secrets.env", "wake_env": "config/wake.env",
}

# Start slow tests early so a single straggler does not extend the whole suite.
SLOW_FIRST = ("test_doc_comments.py", "test_schedule.py", "test_app.py",
              "test_cron_locks.py", "test_stuck_command.py", "test_threads.py",
              "test_settings.py")


def toml_value(value) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return repr(value)
    if isinstance(value, list):
        return "[" + ", ".join(toml_value(v) for v in value) + "]"
    return json.dumps(str(value), ensure_ascii=False)


def toml_text(table: dict, prefix: str = "") -> str:
    plain = [f"{json.dumps(k)} = {toml_value(v)}" for k, v in table.items()
             if not isinstance(v, dict)]
    out = ([f"[{prefix}]"] if prefix and plain else []) + plain
    for key, value in table.items():
        if isinstance(value, dict):
            out.append(toml_text(value, f"{prefix}.{json.dumps(key)}" if prefix
                                 else json.dumps(key)))
    return "\n".join(out) + "\n"


def fixture_config(scratch: Path) -> str:
    """The suite's own configuration, every path in `scratch`, as a file."""
    table = json.loads(json.dumps(FIXTURE))
    table.update(json.loads(json.dumps({k: v for k, v in MACHINE.items()
                                        if k != "paths"})))
    paths = dict(MACHINE["paths"])
    for key, rel in SCRATCH_PATHS.items():
        paths[key] = str(scratch / rel)
    table["paths"] = paths
    for key in ("vault", "workspaces", "projects", "plugins", "state"):
        Path(paths[key]).mkdir(parents=True, exist_ok=True)
    # The install's starter agent and the shared page every agent imports,
    # as a fresh install has them (install.sh): the guard, the identity gate
    # and the plugin gateway judge a call by the agent it comes from.
    labs = Path(paths["workspaces"])
    (labs / STARTER).mkdir()
    (labs / STARTER / "agent.json").write_text(json.dumps({
        "name": STARTER, "display": STARTER.title(), "emoji": "*",
        "workspace": str(labs / STARTER), "vault": paths["vault"],
        "wake_schedule": "04:00", "wake_timezone": FIXTURE["timezone"]},
        indent=2) + "\n", encoding="utf-8")
    # Supply a sibling soul for identity preflight without reading installed workspaces.
    (labs / STARTER / "soul.md").write_text(
        "# Soul\n\nI am the starter agent of a test install, and nobody's. "
        "The heron standing in the shallow river is the picture I keep.\n",
        encoding="utf-8")
    (labs / "_shared").mkdir()
    (labs / "_shared" / "reach.md").write_text(
        "# What you can reach\n\nThe suite's own install.\n", encoding="utf-8")
    (labs / "commons").mkdir()
    path = scratch / "loam.toml"
    path.write_text(toml_text(table), encoding="utf-8")
    return str(path)


def sealed_env(scratch: Path) -> dict[str, str]:
    """The environment one test file runs in: everything it could share
    with another test, or with the box, in its own scratch folder."""
    env = dict(os.environ)
    tmp = scratch / "tmp"
    tmp.mkdir()
    env["TMPDIR"] = str(tmp)
    # Give each child isolated defaults for locks, host settings, schedule state and thread delivery.
    # A test can override them with its own fixtures.
    for var, rel in (("LOAM_LOCK_DIR", "locks"), ("LOAM_SCHEDULE_STATE", "schedules"),
                     ("LOAM_THREADS_STATE", "threads"), ("LOAM_WAITERS_DIR", "waiters"),
                     ("LOAM_ATTENTION_DIR", "attention")):
        (scratch / rel).mkdir()
        env[var] = str(scratch / rel)
    env["LOAM_HOST_SETTINGS"] = str(scratch / "settings.json")
    env["LOAM_VAULT"] = str(scratch / "vault")
    # Tests that manage plugin units must opt in and provide their own stub.
    env.setdefault("LOAM_PLUGIN_UNITS", "0")
    env.pop("LOAM_LIVE_LOCKS", None)
    if not os.environ.get("LOAM_TEST_INSTALL_CONFIG"):
        env["LOAM_CONFIG"] = fixture_config(scratch)
        env["TZ"] = FIXTURE["timezone"]
    # No test's broker object reads the box's real usage through a real CLI
    # (lib/loam_provider_usage.py).
    env["LOAM_USAGE_READS"] = "off"
    # Isolate credentials and restrict network calls to loopback, including in child processes.
    env["LOAM_OFFLINE"] = "1"
    offline = str(ROOT / "tests" / "offline")
    env["PYTHONPATH"] = os.pathsep.join(
        [offline] + [x for x in os.environ.get("PYTHONPATH", "").split(os.pathsep) if x])
    return env


def run_one(test: Path, live: bool = False) -> tuple[Path, object, str, float]:
    t0 = time.monotonic()
    scratch = Path(tempfile.mkdtemp(prefix=f"loam-t-{test.stem[5:][:12]}-"))
    try:
        out = subprocess.run([interpreter(test), str(test)], cwd=ROOT,
                             capture_output=True, text=True,
                             timeout=PER_TEST_TIMEOUT,
                             env=None if live else sealed_env(scratch),
                             stdin=subprocess.DEVNULL)
        code, text = out.returncode, out.stdout + out.stderr
    except subprocess.TimeoutExpired as exc:
        partial = exc.stdout if isinstance(exc.stdout, str) else ""
        code, text = "timeout", (partial or "") + f"\n(timed out after {PER_TEST_TIMEOUT} s)"
    finally:
        shutil.rmtree(scratch, ignore_errors=True)
    return test, code, text, time.monotonic() - t0


def workers(argv: list[str]) -> int:
    if "--jobs" in argv:
        return max(1, int(argv[argv.index("--jobs") + 1]))
    if os.environ.get("LOAM_TEST_JOBS"):
        return max(1, int(os.environ["LOAM_TEST_JOBS"]))
    return max(2, min(8, (os.cpu_count() or 2) // 2))


def main() -> int:
    argv = sys.argv[1:]
    only = [a for a in argv if a.endswith(".py")]
    # `--live`: the tests that read this box as it is (live_*.py), one at a
    # time, unsealed. Never a landing's; run by hand (tests/README.md).
    live = "--live" in argv
    tests = [t for t in sorted((ROOT / "tests").glob("live_*.py" if live else "test_*.py"))
             if not only or t.name in only]
    tests.sort(key=lambda t: (t.name not in SLOW_FIRST,
                              SLOW_FIRST.index(t.name) if t.name in SLOW_FIRST else 0))
    n = 1 if live else workers(argv)
    failed, tails = [], []
    started = time.monotonic()
    print(f"{len(tests)} files, {n} at a time", flush=True)
    with ThreadPoolExecutor(max_workers=n) as pool:
        for fut in as_completed([pool.submit(run_one, t, live) for t in tests]):
            test, code, text, took = fut.result()
            mark = "ok  " if code == 0 else "FAIL"
            if only:
                print(text, flush=True)
            print(f"{mark} {test.name} ({took:.0f} s)", flush=True)
            if code != 0:
                failed.append(test.name)
                lines = text.rstrip().splitlines()
                tails.append((test.name, code, "\n".join(lines[-15:]),
                              [ln for ln in lines[:-15] if ln.lstrip().startswith("FAIL")]))
                print(tails[-1][2], flush=True)
    # Repeat failures at the end because the launcher retains only the suite output's tail.
    for name, code, text, fails in sorted(tails):
        print(f"--- {name} (exit {code}) ---", flush=True)
        if fails:
            print("\n".join(fails[:10]), flush=True)
        print(text, flush=True)
    failed.sort()
    print(f"{len(failed)} failed in {time.monotonic() - started:.0f} s"
          + (f": {', '.join(failed)}" if failed else ""))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
