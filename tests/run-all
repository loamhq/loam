#!/usr/bin/env python3
"""Run every tests/test_*.py, each as the script it is, and exit non-zero if
any fails. This is the agents repository's test command: what a landing runs
on a job's branch and on the merged tree (lib/loam_worktree.py).

Each test is run with the interpreter its own docstring names on its `Run:`
line when that is the MCP venv -- a test of an MCP server imports `mcp`, which
lives only there -- and with python3 otherwise.

Run: python3 tests/run-all [test_x.py ...]   (named ones only, in full)
"""

import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))
import loam_config  # noqa: E402

VENV = loam_config.MCP_VENV / "bin" / "python"


def interpreter(test: Path) -> str:
    head = test.read_text(encoding="utf-8")[:4000]
    if re.search(r"^Run: mcp/\.venv/bin/python", head, re.MULTILINE):
        return str(VENV)
    return sys.executable


# What the tests' fixtures assume of an install, over whatever it says.
FIXTURE = {
    "timezone": "America/Los_Angeles",
    "vault": {"inbox": "00_INBOX", "boards": "00_INBOX/boards",
              "general_board": "00_INBOX/from-agents/comms.md",
              "conversations": "15_CONVERSATIONS", "projects": "40_PROJECTS",
              "attachments": "98_ATTACHMENTS", "system": "99_SYSTEM"},
}


# And what the tests' fixtures assume an install does not say: an install
# made by install.sh names its web front in `[edge]` (its domain, and which
# app records it serves), and the deploy layer's tests render their own; a
# `[bin]` table moves the tools a test's own stub stands in for.
FIXTURE_DROP = ("edge", "bin")


def toml_value(value) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return repr(value)
    if isinstance(value, list):
        return "[" + ", ".join(toml_value(v) for v in value) + "]"
    return json.dumps(str(value), ensure_ascii=False)


def toml_text(table: dict, prefix: str = "") -> str:
    plain = [f"{json.dumps(k)} = {toml_value(v)}" for k, v in table.items()
             if not isinstance(v, dict)]
    out = ([f"[{prefix}]"] if prefix and plain else []) + plain
    for key, value in table.items():
        if isinstance(value, dict):
            out.append(toml_text(value, f"{prefix}.{json.dumps(key)}" if prefix
                                 else json.dumps(key)))
    return "\n".join(out) + "\n"


def fixture_config(where: Path) -> str:
    """The install's configuration with FIXTURE laid over it, as a file."""
    import tomllib  # noqa: PLC0415
    real = Path(os.environ.get("LOAM_CONFIG") or loam_config.CONFIG_FILE)
    try:
        table = tomllib.loads(real.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        table = {}
    for key in FIXTURE_DROP:
        table.pop(key, None)
    for key, value in FIXTURE.items():
        table[key] = ({**table.get(key, {}), **value} if isinstance(value, dict)
                      else value)
    path = where / "loam.toml"
    path.write_text(toml_text(table), encoding="utf-8")
    return str(path)


def main() -> int:
    # A lock table of the suite's own unless the caller chose one, as a
    # landing's run_tests already does (lib/loam_worktree.py). test_cron_locks
    # and test_wake_failed take run slots and wait for them; run from a job's
    # session, they took the box's REAL slots beside the live jobs and left
    # their holder lines in state/locks (probeone 17:40Z, wakefailedselftest
    # 17:47Z on 2026-10-13), and with every slot held they would wait out
    # their 1200 s budget.
    locks = None
    if not os.environ.get("LOAM_LOCK_DIR"):
        locks = tempfile.mkdtemp(prefix="loam-test-locks-")
        os.environ["LOAM_LOCK_DIR"] = locks
        os.environ.pop("LOAM_LIVE_LOCKS", None)
    # And a schedule log of its own: a test that runs bin/wake records a fire
    # (lib/loam_schedule.py), which must not land in the box's real log.
    schedules = None
    if not os.environ.get("LOAM_SCHEDULE_STATE"):
        schedules = tempfile.mkdtemp(prefix="loam-test-schedules-")
        os.environ["LOAM_SCHEDULE_STATE"] = schedules
    # And host settings of its own, empty: the box's own say what a project
    # engineer runs on (`engineers` in state/broker/settings.json,
    # lib/loam_engineer.py). On 2026-11-16 at 16:43:43Z the default became
    # Antigravity mid-landing, and test_engineer_walled, whose stub stands in
    # for the Claude CLI only, launched a REAL Antigravity session instead
    # (the stub never ran, its receipt and commit never came);
    # test_engineer_codex read 'antigravity' where its record said codex.
    settings = None
    if not os.environ.get("LOAM_HOST_SETTINGS"):
        settings = tempfile.mkdtemp(prefix="loam-test-settings-")
        os.environ["LOAM_HOST_SETTINGS"] = os.path.join(settings, "settings.json")
    # And a thread store and vault of its own (2026-11-16): a test that
    # writes threads without naming its own would write the owner's, as the
    # live probe's `broker-probe` threads did. Every thread test names its
    # own today; this is the floor under one that forgets.
    stores = None
    if not os.environ.get("LOAM_THREADS_STATE") or not os.environ.get("LOAM_VAULT"):
        stores = tempfile.mkdtemp(prefix="loam-test-threads-")
        if not os.environ.get("LOAM_THREADS_STATE"):
            os.environ["LOAM_THREADS_STATE"] = os.path.join(stores, "threads")
        if not os.environ.get("LOAM_VAULT"):
            os.environ["LOAM_VAULT"] = os.path.join(stores, "vault")
    # The engineer's delivery records and the broker's quiet-route mark
    # (2026-11-18): every test that starts a broker runs its delivery pass,
    # which marks the route and delivers what it finds owed. Against the
    # owner's state that made `route_live` true for a test's lifetime (the
    # landing of job 20261118-213751-94e2c7f7 left such a mark) and could
    # deliver, or drop as "thread gone", a real job's result.
    waiters = None
    if not os.environ.get("LOAM_WAITERS_DIR"):
        waiters = tempfile.mkdtemp(prefix="loam-test-waiters-")
        os.environ["LOAM_WAITERS_DIR"] = waiters
    # And the layout the suite was written against (2026-11-18): the
    # install's own configuration, with the vault's folder names and the
    # time zone the tests' fixtures spell out laid over it. Found by the
    # 0.2.2 rehearsal: on a fresh install (`Conversations`, `Inbox`, UTC)
    # 35 test files failed on a checkout nothing had changed, so no engineer
    # change could land there. A test that names its own LOAM_CONFIG keeps it.
    fixture = None
    if not os.environ.get("LOAM_TEST_INSTALL_CONFIG"):
        fixture = tempfile.mkdtemp(prefix="loam-test-config-")
        os.environ["LOAM_CONFIG"] = fixture_config(Path(fixture))
        # The clock's zone too, for what reads the machine's local time.
        os.environ["TZ"] = FIXTURE["timezone"]
    # No test's broker object reads the box's real usage through a real CLI
    # (lib/loam_provider_usage.py); the ones that build a Server say so too.
    os.environ["LOAM_USAGE_READS"] = "off"
    # And nothing off the box: no real credential read and no socket off
    # loopback, in this process and every one a test spawns
    # (lib/loam_offline.py). A test of the move once repointed every real
    # A DNS record to 5.6.7.8 with a real key from secrets.env
    # (2026-11-10, 02:29Z, 1 h 56 min down).
    os.environ["LOAM_OFFLINE"] = "1"
    offline = str(ROOT / "tests" / "offline")
    os.environ["PYTHONPATH"] = os.pathsep.join(
        [offline] + [x for x in os.environ.get("PYTHONPATH", "").split(os.pathsep) if x])
    try:
        return run_all()
    finally:
        if locks:
            shutil.rmtree(locks, ignore_errors=True)
        if schedules:
            shutil.rmtree(schedules, ignore_errors=True)
        if settings:
            shutil.rmtree(settings, ignore_errors=True)
        if stores:
            shutil.rmtree(stores, ignore_errors=True)
        if waiters:
            shutil.rmtree(waiters, ignore_errors=True)
        if fixture:
            shutil.rmtree(fixture, ignore_errors=True)


def run_all() -> int:
    failed, tails = [], []
    started = time.monotonic()
    # `run-all test_a.py test_b.py` runs only those, each in full.
    only = [a for a in sys.argv[1:] if a.endswith(".py")]
    for test in sorted((ROOT / "tests").glob("test_*.py")):
        if only and test.name not in only:
            continue
        t0 = time.monotonic()
        try:
            out = subprocess.run([interpreter(test), str(test)], cwd=ROOT,
                                 capture_output=True, text=True, timeout=600,
                                 stdin=subprocess.DEVNULL)
            code, text = out.returncode, out.stdout + out.stderr
        except subprocess.TimeoutExpired:
            code, text = "timeout", ""
        mark = "ok  " if code == 0 else "FAIL"
        if only:
            print(text, flush=True)
        print(f"{mark} {test.name} ({time.monotonic() - t0:.0f} s)", flush=True)
        if code != 0:
            failed.append(test.name)
            lines = text.rstrip().splitlines()
            tails.append((test.name, code, "\n".join(lines[-15:]),
                          [ln for ln in lines[:-15] if ln.lstrip().startswith("FAIL")]))
            print(tails[-1][2], flush=True)
    # Each failure's tail again, at the end. A landing quotes only the last
    # TAIL_LINES of this output (lib/loam_worktree.py), so a failure early in
    # the alphabet was quoted as its name alone, behind the `ok` lines that
    # followed it: a login test on 2026-11-08, never reproduced after.
    # Its FAIL lines first: test_schedule prints 29 checks and its tail can be
    # all PASS (caused, the same day).
    for name, code, text, fails in tails:
        print(f"--- {name} (exit {code}) ---", flush=True)
        if fails:
            print("\n".join(fails[:10]), flush=True)
        print(text, flush=True)
    print(f"{len(failed)} failed in {time.monotonic() - started:.0f} s"
          + (f": {', '.join(failed)}" if failed else ""))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
