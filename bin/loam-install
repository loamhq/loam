#!/usr/bin/env python3
"""The installer's eleven steps (first release L12). Started by install.sh,
which fetched this release; run as root.

  loam-install [--domain DOMAIN | --name NAME] [--owner "NAME"]
               [--timezone ZONE] [--data-dir DIR] [--yes]
               [--source URL] [--version TAG]
  rehearsal only: [--address IP] [--resolver system] [--local-certs]
                  [--base DOMAIN]

Where it lives on the web is one of two (docs/install.md, "Where your Loam
lives"): `--domain loam.example.com`, a domain the person has, for which they
make two DNS records; or `--name sam`, a name under Loam's own domain, whose
records Loam's makers make (ask them first). Without either, it asks.

Each step writes /var/lib/loam/install/<n>-<step>.done when it has finished,
and a run starts at the first step without one, so running the install
command again carries on where the last run stopped. Every step is also
safe to repeat. What each step runs goes to /var/log/loam-install.log; the
screen shows the step and what it is doing, in plain words. docs/install.md
is the whole account.
"""

from __future__ import annotations

import argparse
import datetime as dt
import grp
import itertools
import json
import os
import pwd
import re
import shlex
import shutil
import subprocess
import sys
import textwrap
import threading
import time
import tomllib
from contextlib import contextmanager
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent          # this release's code
LOG = Path("/var/log/loam-install.log")
STATE = Path("/var/lib/loam/install")
ANSWERS = STATE / "answers.json"
CONFIG = Path("/etc/loam/loam.toml")
ROOT_PYCACHE = "/var/cache/loam/pycache"               # root's bytecode, never the tree
DEFAULT_SOURCE = "https://github.com/loamhq/loam.git"

os.environ["PYTHONPYCACHEPREFIX"] = ROOT_PYCACHE
os.environ.setdefault("LOAM_CONFIG", str(CONFIG))
# No bytecode beside the code: anything in the checkout a release did not
# put there refuses the next update (L13's clean-tree rule).
sys.dont_write_bytecode = True
sys.path.insert(0, str(HERE / "lib"))
import loam_data_disk as dd  # noqa: E402
import loam_install as li  # noqa: E402  (no loam_config yet: the file may not exist)

WIDTH = 72
step_started = 0.0


class Stop(Exception):
    """A step cannot go on. `say` is for the person; the log has the rest."""

    def __init__(self, say: str, fix: str = "") -> None:
        super().__init__(say)
        self.say, self.fix = say, fix


# ---------------------------------------------------------------------------
# Saying things, and running things
# ---------------------------------------------------------------------------

def logline(text: str) -> None:
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a", encoding="utf-8") as fh:
        fh.write(f"{dt.datetime.now().isoformat(timespec='seconds')} {text}\n")


def say(text: str = "", indent: int = 0) -> None:
    pad = " " * indent
    for para in text.split("\n"):
        print(textwrap.fill(para, WIDTH, initial_indent=pad, subsequent_indent=pad)
              if para else "", flush=True)
    logline(f"SAY {text}")


@contextmanager
def progress(label: str, done: str = "", *, announce: bool = True):
    """Keep one temporary line alive while work runs in the foreground."""
    interactive = sys.stdout.isatty() and os.environ.get("TERM") != "dumb"
    if interactive:
        stopped = threading.Event()
        started = step_started or time.monotonic()
        logline(f"DOING {label}")

        def draw(frame: str) -> None:
            minutes, seconds = divmod(int(time.monotonic() - started), 60)
            prefix = f"  {frame} {minutes}:{seconds:02d}  "
            width = shutil.get_terminal_size().columns - len(prefix) - 1
            activity = textwrap.shorten(f"{label}…", width=max(1, width), placeholder="…")
            print(f"\r\033[K{prefix}{activity}", end="", flush=True)

        def tick() -> None:
            for frame in itertools.cycle("/-\\|"):
                if stopped.wait(1):
                    break
                draw(frame)

        draw("|")
        ticker = threading.Thread(target=tick, daemon=True)
        ticker.start()
    elif announce:
        say(f"{label}…", 2)
    try:
        yield
    finally:
        if interactive:
            stopped.set()
            ticker.join()
            print("\r\033[K", end="", flush=True)
    if done:
        say(f"✓ {done}", 2)


def run(argv: list[str] | str, *, check: bool = True, input: str | None = None,
        env: dict | None = None, timeout: int = 3600, cwd: str | None = None,
        quiet_fail: bool = False, shown: str | None = None) -> subprocess.CompletedProcess:
    full = argv if isinstance(argv, str) else " ".join(shlex.quote(a) for a in argv)
    shown = shown or full
    logline(f"RUN {full}")
    res = subprocess.run(argv, shell=isinstance(argv, str), capture_output=True, text=True,
                         input=input, env={**os.environ, **(env or {})}, timeout=timeout,
                         cwd=cwd, check=False)
    for stream in (res.stdout, res.stderr):
        if stream.strip():
            with LOG.open("a", encoding="utf-8") as fh:
                fh.write(stream if stream.endswith("\n") else stream + "\n")
    logline(f"EXIT {res.returncode}")
    if check and res.returncode != 0 and not quiet_fail:
        name = shown if len(shown) <= 70 else shown[:67] + "..."
        raise Stop(f"one of the commands it runs did not work ({name})")
    return res


def user_env(cfg: dict) -> dict:
    uid = pwd.getpwnam(cfg["user"]).pw_uid
    home = cfg["home"]
    return {"HOME": home, "USER": cfg["user"], "LOGNAME": cfg["user"],
            "XDG_RUNTIME_DIR": f"/run/user/{uid}",
            "DBUS_SESSION_BUS_ADDRESS": f"unix:path=/run/user/{uid}/bus",
            "PATH": f"{home}/.local/bin:/usr/local/bin:/usr/bin:/bin",
            "LOAM_CONFIG": str(CONFIG),
            "PYTHONPYCACHEPREFIX": f"{home}/.cache/loam/pycache"}


def as_user(cfg: dict, argv: list[str], **kw) -> subprocess.CompletedProcess:
    """A command as Loam's user, in its home (a tool started in root's
    working directory reads root's files: uv read /root/uv.toml and was
    refused, found in the first rehearsal)."""
    env = user_env(cfg)
    kw.setdefault("cwd", cfg["home"])
    kw.setdefault("shown", " ".join(shlex.quote(a) for a in argv))
    return run(["runuser", "-u", cfg["user"], "--", "env", "-i",
                *(f"{k}={v}" for k, v in env.items()), *argv], **kw)


def ask(question: str, default: str = "", *, check=None) -> str:
    """One question, from the terminal even when the script came down a pipe.
    The terminal is opened twice, to read and to write: a text file opened
    "r+" on /dev/tty raises "not seekable", so until 0.2.8 every question
    stopped the install as if there were no terminal (found walking 0.2.8;
    every earlier rehearsal gave all its answers as options)."""
    try:
        tty_in = open("/dev/tty", "r", encoding="utf-8")
        tty = open("/dev/tty", "w", encoding="utf-8")
    except OSError:
        if default:
            return default
        raise Stop(f"The installer needs an answer and has no way to ask: {question}",
                   "run it again with the answer given as an option (see --help)")
    with tty_in, tty:
        while True:
            hint = f" [{default}]" if default else ""
            tty.write(f"\n{question}{hint}: ")
            tty.flush()
            answer = tty_in.readline().strip() or default
            why = check(answer) if check else (None if answer else "an answer is needed")
            if not why:
                logline(f"ASKED {question} -> {answer}")
                return answer
            tty.write(f"  {why}\n")


# ---------------------------------------------------------------------------
# The answers this install keeps between runs
# ---------------------------------------------------------------------------

def load_answers() -> dict:
    try:
        return json.loads(ANSWERS.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def save_answers(ans: dict) -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = ANSWERS.with_suffix(".tmp")
    tmp.write_text(json.dumps(ans, indent=2) + "\n", encoding="utf-8")
    os.chmod(tmp, 0o600)
    os.replace(tmp, ANSWERS)


def config_values() -> dict:
    raw = tomllib.loads(CONFIG.read_text(encoding="utf-8"))
    paths = raw.get("paths", {})
    return {"user": raw.get("user", li.USER), "home": paths["home"], "root": paths["root"],
            "vault": paths["vault"], "workspaces": paths["workspaces"],
            "projects": paths["projects"], "plugins": paths["plugins"],
            "edge": raw.get("edge", {}), "timezone": raw.get("timezone", "UTC"),
            "owner": raw.get("owner", {}).get("name", ""),
            "data_dir": (raw.get("storage") or {}).get("data_dir")}


def mark_done(n: int) -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    li.step_file(n).write_text(dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds") + "\n")


# ---------------------------------------------------------------------------
# 1. Preflight
# ---------------------------------------------------------------------------

SUPPORTED_OS = {
    ("debian", "12"): "Debian 12",
    ("debian", "13"): "Debian 13",
    ("ubuntu", "24.04"): "Ubuntu 24.04",
    ("ubuntu", "26.04"): "Ubuntu 26.04",
}


def os_release() -> dict:
    out = {}
    for line in Path("/etc/os-release").read_text().splitlines():
        k, _, v = line.partition("=")
        out[k] = v.strip().strip('"')
    return out


def listeners(port: int) -> list[str]:
    res = run(["ss", "-Htlnp", f"( sport = :{port} )"], check=False)
    names = re.findall(r'users:\(\("([^"]+)"', res.stdout)
    return sorted(set(names)) if res.stdout.strip() else []


def step_preflight(a, ans: dict) -> None:
    osr = os_release()
    if (osr.get("ID"), osr.get("VERSION_ID")) not in SUPPORTED_OS:
        *earlier, last = SUPPORTED_OS.values()
        supported = f"{', '.join(earlier)}, or {last}"
        raise Stop(f"Loam installs on {supported}. This server is "
                   f"{osr.get('PRETTY_NAME', 'something else')}.",
                   "make a new server with one of those versions and run the install command on it")
    mem_mb = int(re.search(r"MemTotal:\s+(\d+)", Path("/proc/meminfo").read_text()).group(1)) // 1024
    if mem_mb < 3600:
        raise Stop(f"Loam needs a server with at least 4 GB of memory; this one has "
                   f"{mem_mb / 1024:.1f} GB.", "choose a bigger server size and run it again")
    free_gb = shutil.disk_usage("/").free / 1e9
    if free_gb < 15:
        raise Stop(f"Loam needs at least 15 GB of free disk; this server has {free_gb:.0f} GB.",
                   "choose a server with a bigger disk")
    for port in (80, 443):
        held = [n for n in listeners(port) if n != "caddy"]
        if held:
            raise Stop(f"Something else on this server already answers on port {port} "
                       f"({', '.join(held)}). Loam needs ports 80 and 443 for itself.",
                       "install Loam on a fresh server, or stop that program first")

    # The address the name must point at.
    address = a.address or ans.get("address") or li.primary_address()
    if not address or (not li.is_public(address) and not a.address):
        raise Stop(f"This server has no public internet address of its own "
                   f"(it sends from {address or 'nowhere'}), so nobody could reach Loam on it.",
                   "use a server with a public IPv4 address")

    # Optional separate data disk (`--data-dir DIR`): validate early and either
    # adopt an existing Loam data disk or prepare a fresh one.
    raw_data_dir = a.data_dir or ans.get("data_dir")
    data_dir: Path | None = None
    if raw_data_dir:
        data_dir, why = dd.validate_path(raw_data_dir, etc=CONFIG.parent)
        if why or data_dir is None:
            raise Stop(f"Cannot use --data-dir {raw_data_dir}: {why}.",
                       "mount a writable disk at that directory first and run the install command again")

    if CONFIG.exists():
        cfg = config_values()
        have_data_dir = cfg.get("data_dir")
        if data_dir is not None and not dd.is_bind_mounted(data_dir / "etc", CONFIG.parent):
            raise Stop(f"{CONFIG} already exists on this server; refusing to mount {data_dir} over it.",
                       "use a fresh server when adopting or starting on a data disk")
        if data_dir is not None and have_data_dir and Path(have_data_dir) != data_dir:
            raise Stop(f"This server is already set up with data disk {have_data_dir}, not {data_dir}.",
                       f"run the install command with --data-dir {have_data_dir}, or without it")
        name = cfg["edge"].get("name")
        have = cfg["edge"].get("domain")
        own = bool(cfg["edge"].get("own_domain"))
        if (a.domain and a.domain.lower().rstrip(".") != have) or \
                (a.name and (own or (name and a.name != name))):
            again = f"--domain {have}" if own else f"--name {name}"
            raise Stop(f"This server is already set up as {have}.",
                       f"run the install command with {again}, or without it")
        ans.update({"name": name, "owner": cfg["owner"], "timezone": cfg["timezone"],
                    "address": cfg["edge"].get("address", address),
                    "source": a.source or ans.get("source") or DEFAULT_SOURCE,
                    "version": ans.get("version") or a.version})
        if have_data_dir:
            ans["data_dir"] = have_data_dir
        save_answers(ans)
        say(f"This server is already set up for {cfg['edge'].get('domain')}; carrying on.", 2)
        return

    if data_dir is not None:
        info = dd.classify(data_dir)
        if info["kind"] == "unrecognized":
            raise Stop(f"{data_dir} is not empty and is not a Loam data disk ({info['reason']}).",
                       "point --data-dir at an empty mounted disk for a fresh install, or a disk "
                       "created by an earlier Loam install")
        free_data_gb = shutil.disk_usage(data_dir).free / 1e9
        if info["kind"] == "existing":
            if free_data_gb < dd.MIN_FREE_GB_ADOPT:
                raise Stop(f"The data disk at {data_dir} has only {free_data_gb:.1f} GB free "
                           f"(Loam needs at least {dd.MIN_FREE_GB_ADOPT:.0f} GB).",
                           "free space on or resize the data disk and run the install command again")
            disk_cfg_text = (data_dir / "etc" / "loam.toml").read_text(encoding="utf-8")
            disk_raw = tomllib.loads(disk_cfg_text)
            disk_edge = disk_raw.get("edge") or {}
            have = disk_edge.get("domain")
            disk_name = disk_edge.get("name")
            disk_own = bool(disk_edge.get("own_domain"))
            if (a.domain and a.domain.lower().rstrip(".") != have) or \
                    (a.name and (disk_own or (disk_name and a.name != disk_name))):
                again = f"--domain {have}" if disk_own else f"--name {disk_name}"
                raise Stop(f"The data disk at {data_dir} already belongs to {have}.",
                           f"run the install command with --data-dir {data_dir} (or with {again})")
            try:
                dd.ensure_bind_mount(data_dir / "etc", CONFIG.parent)
                adopted_text = dd.adopt_config_text(
                    disk_cfg_text,
                    address=address,
                    data_dir=str(data_dir),
                    resolver=a.resolver,
                    tls="internal" if a.local_certs else None,
                )
            except dd.DataDiskError as exc:
                raise Stop(str(exc)) from exc
            tmp_cfg = CONFIG.with_suffix(".adopt-tmp")
            tmp_cfg.write_text(adopted_text, encoding="utf-8")
            os.chmod(tmp_cfg, 0o644)
            os.replace(tmp_cfg, CONFIG)
            dd.update_fstab([dd.etc_spec(data_dir, CONFIG.parent)])
            run(["systemctl", "daemon-reload"], check=False)
            cfg = config_values()
            edge = cfg["edge"]
            dd.write_marker(
                data_dir,
                last_adopted_at=dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"),
                domain=edge.get("domain"),
                user=cfg["user"],
            )
            ans.update({
                "adopted": True,
                "data_dir": str(data_dir),
                "previous_address": disk_edge.get("address"),
                "name": edge.get("name"),
                "domain": edge.get("domain") if edge.get("own_domain") else "",
                "owner": cfg["owner"],
                "timezone": cfg["timezone"],
                "address": edge.get("address", address),
                "base": (edge.get("domain", "").split(".", 1)[1]
                         if "." in edge.get("domain", "") and not edge.get("own_domain")
                         else li.BASE_DOMAIN),
                "resolver": edge.get("resolver", "public"),
                "tls": edge.get("tls", "acme"),
                "source": a.source or ans.get("source") or DEFAULT_SOURCE,
                "version": ans.get("version") or a.version,
            })
            save_answers(ans)
            say(f"Found an existing Loam on {data_dir} ({edge.get('domain')}, for {cfg['owner']}); "
                "adopting it on this server without overwriting your data.", 2)
            return
        if free_data_gb < dd.MIN_FREE_GB_FRESH:
            raise Stop(f"The data disk at {data_dir} has only {free_data_gb:.1f} GB free "
                       f"(a fresh install needs at least {dd.MIN_FREE_GB_FRESH:.0f} GB).",
                       "choose a larger data disk and run the install command again")

    base = a.base or ans.get("base") or li.BASE_DOMAIN
    if a.name and a.domain:
        raise Stop("--name and --domain were both given; Loam lives at one of them.",
                   "run it again with --domain for your own domain, or --name for a "
                   f"name under {base}")
    domain = (a.domain or ans.get("domain") or "").strip().lower().rstrip(".")
    name = "" if domain else (a.name or ans.get("name") or "")
    if not domain and not name:
        domain, name = ask_where(base)
    if domain:
        why = li.valid_domain(domain)
        if why:
            raise Stop(f"\"{domain}\" cannot be used: {why}.",
                       "run it again with another --domain")
        name = domain.split(".", 1)[0]
        where = domain
    else:
        why = li.valid_name(name)
        if why:
            raise Stop(f"\"{name}\" cannot be used: {why}.", "run it again with another --name")
        where = f"{name}.{base}"
    owner = a.owner or ans.get("owner") or ask("Your first name, as Loam should call you")
    tz_default = run(["timedatectl", "show", "-p", "Timezone", "--value"],
                     check=False).stdout.strip() or "UTC"
    tz = a.timezone or ans.get("timezone") or ask(
        "Your time zone (for example Europe/Berlin or America/New_York)",
        tz_default if not a.yes else tz_default, check=valid_zone)
    if valid_zone(tz):
        raise Stop(f"\"{tz}\" is not a time zone this server knows.",
                   "use a name like Europe/Berlin or America/Los_Angeles")
    resolver = a.resolver or ans.get("resolver") or "public"
    tls = "internal" if a.local_certs else "acme"
    ans.update({"name": name, "domain": domain, "owner": owner, "timezone": tz,
                "address": address, "base": base, "resolver": resolver, "tls": tls,
                "source": a.source or ans.get("source") or DEFAULT_SOURCE,
                "version": ans.get("version") or a.version})
    if data_dir is not None:
        ans["data_dir"] = str(data_dir)
        ans["adopted"] = False
    save_answers(ans)
    home = f"/home/{li.USER}"
    text = li.render_config(name=name, owner=owner, timezone=tz, address=address, home=home,
                            base=base, resolver=resolver, domain=domain or None,
                            tls=tls, data_dir=str(data_dir) if data_dir else None)
    if data_dir is not None:
        for d, mode in ((data_dir / "etc", 0o755), (data_dir / "home", 0o755),
                        (data_dir / "login", 0o755), (dd.login_data_dir(data_dir), 0o700)):
            d.mkdir(parents=True, mode=mode, exist_ok=True)
            os.chmod(d, mode)
        try:
            dd.ensure_bind_mount(data_dir / "etc", CONFIG.parent)
        except dd.DataDiskError as exc:
            raise Stop(str(exc)) from exc
        CONFIG.write_text(text, encoding="utf-8")
        os.chmod(CONFIG, 0o644)
        dd.write_marker(data_dir, user=li.USER, domain=where)
        dd.update_fstab([dd.etc_spec(data_dir, CONFIG.parent)])
        run(["systemctl", "daemon-reload"], check=False)
        say(f"Your Loam will be {where}, for {owner}, in {tz}, with your data on {data_dir}.", 2)
    else:
        CONFIG.parent.mkdir(parents=True, exist_ok=True)
        CONFIG.write_text(text, encoding="utf-8")
        os.chmod(CONFIG, 0o644)
        say(f"Your Loam will be {where}, for {owner}, in {tz}.", 2)


def ask_where(base: str) -> tuple[str, str]:
    """The first question of an install given neither --domain nor --name:
    which of the two ways. Returns (domain, "") or ("", name)."""
    try:
        open("/dev/tty", "r", encoding="utf-8").close()
    except OSError:
        raise Stop("The installer needs to know where your Loam will live on the web, "
                   "and has no way to ask.",
                   "run it again with --domain loam.example.com (a domain you have) or "
                   f"--name <name> (a name under {base} from Loam's makers)") from None
    say("Where will your Loam live on the web? Either:", 2)
    say("1. On a domain you have, for example loam.example.com (or example.com "
        "itself). You add two DNS records where you bought the domain; the "
        "installer says which, and checks them.", 4)
    say(f"2. On a name under {base}, like sam.{base}. Loam's makers add its "
        "records, so ask them for a name first, in an issue at "
        f"{li.ASK_FOR_A_NAME}", 4)
    choice = ask("Type 1 or 2", check=lambda x: None if x.strip() in ("1", "2")
                 else "type 1 for your own domain, or 2 for a name we give you")
    if choice.strip() == "1":
        return ask("Your domain (for example loam.example.com)",
                   check=li.valid_domain).strip().lower().rstrip("."), ""
    return "", ask(f"The name Loam's makers gave you (your Loam will be at <name>.{base})",
                   check=li.valid_name)


def valid_zone(zone: str) -> str | None:
    from zoneinfo import ZoneInfo, ZoneInfoNotFoundError  # noqa: PLC0415
    try:
        ZoneInfo(zone)
        return None
    except (ZoneInfoNotFoundError, ValueError):
        return "that is not a time zone name this server knows"


# ---------------------------------------------------------------------------
# 2. The name
# ---------------------------------------------------------------------------

def step_name(a, ans: dict) -> None:
    cfg = config_values()
    edge = cfg["edge"]
    if edge.get("own_domain"):
        return step_name_own(edge, ans)
    base = edge["domain"].split(".", 1)[1]
    with progress("Checking where your name points"):
        found = li.name_check(edge["name"], edge["address"], base=base,
                              resolver=edge.get("resolver", "public"))
    ans["name_check"] = found
    save_answers(ans)
    if found["state"] == "taken":
        if ans.get("adopted"):
            say(f"{edge['domain']} still points to another server ({', '.join(found['apex'])}). "
                "Carrying on; move these two DNS records to this server when ready:", 2)
            for rec in li.records_to_ask_for(edge["name"], edge["address"], base):
                say(rec, 6)
            return
        raise Stop(f"{edge['domain']} is already someone else's: it points to another server "
                   f"({', '.join(found['apex'])}).",
                   "choose another name and run the install command again with --name")
    if found["state"] == "here":
        say(f"{edge['domain']} already points to this server.", 2)
    elif found["state"] == "unknown":
        say("The name could not be checked right now (no answer from DNS). Carrying on; "
            "it is checked again before Loam goes on the web.", 2)
    else:
        say(f"{edge['domain']} does not point to this server yet. That is fine: everything "
            f"until the last steps works without it. Two DNS records are needed:", 2)
        for rec in li.records_to_ask_for(edge["name"], edge["address"], base):
            say(rec, 6)


def say_records(edge: dict) -> None:
    """The two records, and where they are made, for an own domain."""
    for rec in li.edge_records(edge):
        say(rec, 6)
    say("Make them where you manage the domain's DNS (usually the company you "
        "bought it from: its \"DNS\" or \"DNS records\" page). Type A, the name "
        "as shown (some pages want only the part before your domain), the "
        "address as shown. If the domain is on Cloudflare, set both to \"DNS "
        "only\", not proxied.", 2)


def say_problems(found: dict) -> None:
    for line in found.get("problems") or []:
        print(textwrap.fill(f"- {line}", WIDTH, initial_indent="    ",
                            subsequent_indent="      "), flush=True)
        logline(f"SAY - {line}")


def step_name_own(edge: dict, ans: dict) -> None:
    """Step 2 on the person's own domain: nothing is anybody else's, so it
    never stops here. It says what DNS has now and which records to make;
    the install goes on, and step 10 checks again (and can wait)."""
    with progress("Checking where your domain points"):
        found = li.edge_check(edge)
    ans["name_check"] = found
    save_answers(ans)
    if found["state"] == "here":
        say(f"{edge['domain']} and *.{edge['domain']} already point to this server.", 2)
        return
    if found["state"] == "unknown":
        say("DNS could not be asked right now. Carrying on; it is checked again "
            "before Loam goes on the web.", 2)
    else:
        say(f"{edge['domain']} is not ready for Loam yet. That is fine: everything "
            "until the last steps works without it. What DNS says now:", 2)
        say_problems(found)
    say("Loam needs these two DNS records on your domain:", 2)
    say_records(edge)
    say("You can make them now, while the install carries on; it checks them "
        "again near the end.", 2)


# ---------------------------------------------------------------------------
# 3. System packages
# ---------------------------------------------------------------------------

APT = ["git", "python3", "python3-yaml",
       # The GitHub App's signed requests (lib/loam_github_app.py), in the
       # broker's /usr/bin/python3; missing on every install until 0.2.2.
       "python3-cryptography",
       "sqlite3", "ripgrep", "ffmpeg", "nftables",
       # dnsutils was a transitional name removed in Debian 13 and Ubuntu 26.04.
       "iptables", "curl", "ca-certificates", "gnupg", "sudo", "bind9-dnsutils", "iproute2",
       "unzip",
       # ssh-keygen: every update checks the release's signature with it
       # (lib/loam_signing.py). A box reached over SSH has it already.
       "openssh-client",
       "dbus-user-session", "procps", "lsof", "systemd-timesyncd",
       # Loam's app runs on the host, not in a container (2026-11-16): its page
       # previews' browser, their fonts, and `choom` (util-linux) to start
       # the browser at the agents' OOM score. ffmpeg above is its speech
       # encoder; Node 24 comes from NodeSource below.
       "fonts-noto-core", "util-linux"]

# The previews' browser. Debian ships Chromium's headless shell as a package;
# Ubuntu has none (its `chromium-browser` is a snap, and a server has no
# snapd to give it), so there the same headless shell is fetched by Playwright
# at a pinned version, with the libraries it needs, and given the Debian
# package's command name, which is what the app is told to run (bin/deploy
# APP_PREVIEW_CHROME). Found 2026-11-16: a fresh Ubuntu 24.04 stopped at step
# 3, "Unable to locate package chromium-headless-shell".
PREVIEW_BROWSER = "chromium-headless-shell"
PLAYWRIGHT = "1.65.1"
PLAYWRIGHT_BROWSERS = Path("/opt/loam/chromium")


def apt_packages(distro: str) -> list[str]:
    """Step 3's packages from the distribution's own archive."""
    return APT + ([PREVIEW_BROWSER] if distro == "debian" else [])


def playwright_shell() -> Path | None:
    """The headless shell under PLAYWRIGHT_BROWSERS, newest build first."""
    found = sorted(PLAYWRIGHT_BROWSERS.glob(
        "chromium_headless_shell-*/chrome-headless-shell-linux64/chrome-headless-shell"),
        key=lambda f: int(re.sub(r"\D", "", f.parts[-3]) or 0), reverse=True)
    return found[0] if found else None


def ensure_preview_browser(distro: str) -> None:
    """Where the archive has no headless shell (Ubuntu), Playwright's, as
    /usr/local/bin/chromium-headless-shell. Safe to repeat."""
    if distro == "debian":
        return
    shell = playwright_shell()
    if shell is None:
        with progress("Installing the preview browser", "Preview browser downloaded."):
            PLAYWRIGHT_BROWSERS.mkdir(parents=True, exist_ok=True)
            run(["npx", "--yes", f"playwright@{PLAYWRIGHT}", "install", "--with-deps",
                 "--only-shell", "chromium"],
                env={"DEBIAN_FRONTEND": "noninteractive",
                     "PLAYWRIGHT_BROWSERS_PATH": str(PLAYWRIGHT_BROWSERS),
                     "npm_config_cache": "/var/cache/loam/npm"}, timeout=1800)
            shell = playwright_shell()
            if shell is None:
                raise Stop("the browser for the apps' previews could not be installed")
    link = Path("/usr/local/bin") / PREVIEW_BROWSER
    if not (link.is_symlink() and link.resolve() == shell.resolve()):
        tmp = link.with_name(link.name + ".tmp")
        tmp.unlink(missing_ok=True)
        tmp.symlink_to(shell)
        os.replace(tmp, link)


def clock_skew() -> float | None:
    """Seconds this box's clock is off, read against the Date header of an
    HTTPS answer (second resolution; enough to see minutes)."""
    import email.utils  # noqa: PLC0415
    import urllib.request  # noqa: PLC0415
    for url in ("https://deb.debian.org/", "https://www.cloudflare.com/"):
        try:
            with urllib.request.urlopen(urllib.request.Request(url, method="HEAD"), timeout=10) as r:
                stamp = email.utils.parsedate_to_datetime(r.headers["Date"]).timestamp()
            return time.time() - stamp
        except (OSError, TypeError, ValueError):
            continue
    return None


def ensure_clock() -> None:
    """The login refuses to start on a clock that is off (Authelia's NTP
    check), and passkeys and one-time codes need the time. Time sync on;
    then, if the clock is still minutes out, set it once from the answer
    above and say so in the log (found in the first rehearsal: a box an
    hour behind, with no time sync, left the login in a restart loop)."""
    run(["timedatectl", "set-ntp", "true"], check=False)
    for _ in range(10):
        skew = clock_skew()
        if skew is None or abs(skew) < 5:
            return
        time.sleep(3)
    logline(f"CLOCK off by {skew:.0f}s after time sync was turned on; setting it once")
    run(["date", "-u", "-s", f"@{int(time.time() - skew)}"], check=False)


def apt(*pkgs: str) -> None:
    env = {"DEBIAN_FRONTEND": "noninteractive"}
    run(["apt-get", "install", "-y", "-q", "--no-install-recommends", *pkgs], env=env, timeout=3600)


def add_repo(name: str, key_url: str, line: str) -> None:
    keyring = Path(f"/usr/share/keyrings/{name}.gpg")
    if not keyring.exists():
        run(f"curl -fsSL {shlex.quote(key_url)} | gpg --dearmor -o {keyring}")
    Path(f"/etc/apt/sources.list.d/{name}.list").write_text(line.format(keyring=keyring) + "\n")


def step_packages(a, ans: dict) -> None:
    osr = os_release()
    distro, codename = osr["ID"], osr.get("VERSION_CODENAME", "bookworm")
    env = {"DEBIAN_FRONTEND": "noninteractive"}
    with progress("Checking for system software", "Package lists updated."):
        run(["apt-get", "update", "-q"], env=env)
    with progress("Installing system software", "System software installed."):
        apt(*apt_packages(distro))
    with progress("Finding Docker, Caddy and Node", "Docker, Caddy and Node found."):
        arch = run(["dpkg", "--print-architecture"]).stdout.strip()
        add_repo("caddy-stable", "https://dl.cloudsmith.io/public/caddy/stable/gpg.key",
                 "deb [signed-by={keyring}] https://dl.cloudsmith.io/public/caddy/stable/deb/debian any-version main")
        add_repo("docker", f"https://download.docker.com/linux/{distro}/gpg",
                 f"deb [arch={arch} signed-by={{keyring}}] https://download.docker.com/linux/{distro} {codename} stable")
        add_repo("nodesource", "https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key",
                 "deb [signed-by={keyring}] https://deb.nodesource.com/node_24.x nodistro main")
        run(["apt-get", "update", "-q"], env=env)
    # Docker carries the login (Authelia) and the agents' shared browser, and
    # is there for an agent's own project; Loam's app does not use it.
    with progress("Installing Docker, Caddy and Node", "Docker, Caddy and Node installed."):
        apt("caddy", "docker-ce", "docker-ce-cli", "containerd.io", "docker-compose-plugin", "nodejs")
        run(["systemctl", "enable", "--now", "docker", "caddy"])
    ensure_preview_browser(distro)
    with progress("Checking the server's clock", "Clock check finished."):
        ensure_clock()


# ---------------------------------------------------------------------------
# 4. The user
# ---------------------------------------------------------------------------

def _uid_free(uid: int) -> bool:
    if uid < 1000:
        return False
    try:
        pwd.getpwuid(uid)
        return False
    except KeyError:
        return True


def _gid_free(gid: int) -> bool:
    if gid < 1000:
        return False
    try:
        grp.getgrgid(gid)
        return False
    except KeyError:
        return True


def _prepare_data_disk_user(cfg: dict, ans: dict) -> None:
    """Create `user`, bind-mount `<data_dir>/home` to `<home>`, bind-mount the
    seven server-local overlays on top inside `<home>`, and record all mounts
    in `/etc/fstab`."""
    user, home = cfg["user"], Path(cfg["home"])
    data_dir = Path(cfg["data_dir"])
    data_home = data_dir / "home"
    data_home.mkdir(parents=True, mode=0o755, exist_ok=True)
    adopted = bool(ans.get("adopted"))

    old_uid: int | None = None
    old_gid: int | None = None
    if adopted:
        marker = dd.read_marker(data_dir) or {}
        st = data_home.stat()
        old_uid = st.st_uid if st.st_uid >= 1000 else marker.get("uid")
        old_gid = st.st_gid if st.st_gid >= 1000 else marker.get("gid")

    try:
        pw = pwd.getpwnam(user)
    except KeyError:
        if (adopted and isinstance(old_uid, int) and isinstance(old_gid, int)
                and _uid_free(old_uid) and _gid_free(old_gid)):
            run(["groupadd", "--gid", str(old_gid), user])
            run(["useradd", "--no-create-home", "--home-dir", str(home),
                 "--uid", str(old_uid), "--gid", str(old_gid),
                 "--shell", "/bin/bash", user])
        else:
            run(["useradd", "--no-create-home", "--home-dir", str(home),
                 "--shell", "/bin/bash", user])
        pw = pwd.getpwnam(user)

    uid, gid = pw.pw_uid, pw.pw_gid
    if adopted:
        if isinstance(old_uid, int) and isinstance(old_gid, int) and (old_uid, old_gid) != (uid, gid):
            with progress("Adjusting file ownership on the data disk for this server",
                          "Data disk ownership aligned."):
                run(["chown", "-R", f"--from={old_uid}:{old_gid}", f"{uid}:{gid}", str(data_home)])
    else:
        if not (data_home / ".bashrc").exists() and Path("/etc/skel").is_dir():
            for item in Path("/etc/skel").iterdir():
                dest = data_home / item.name
                if not dest.exists():
                    if item.is_dir():
                        shutil.copytree(item, dest, symlinks=True)
                    else:
                        shutil.copy2(item, dest)
        run(["chown", "-R", f"{uid}:{gid}", str(data_home)])
        os.chmod(data_home, 0o755)

    home.mkdir(parents=True, mode=0o755, exist_ok=True)
    os.chown(home, uid, gid)
    os.chmod(home, 0o755)
    try:
        dd.ensure_bind_mount(data_home, home)
    except dd.DataDiskError as exc:
        raise Stop(str(exc)) from exc

    # Ensure server-local overlay root is traversable while keeping installer
    # state root-only (0700).
    dd.LOCAL_BASE.parent.mkdir(parents=True, mode=0o755, exist_ok=True)
    os.chmod(dd.LOCAL_BASE.parent, 0o755)
    if STATE.exists():
        os.chmod(STATE, 0o700)
    dd.LOCAL_BASE.mkdir(parents=True, mode=0o755, exist_ok=True)
    os.chmod(dd.LOCAL_BASE, 0o755)

    for sub, rel, mode in dd.LOCAL_OVERLAYS:
        src = dd.LOCAL_BASE / sub
        src.mkdir(parents=True, mode=mode, exist_ok=True)
        os.chown(src, uid, gid)
        os.chmod(src, mode)
        tgt = dd.ensure_owned_path(home, rel, uid, gid, mode=mode)
        try:
            dd.ensure_bind_mount(src, tgt)
        except dd.DataDiskError as exc:
            raise Stop(str(exc)) from exc

    specs = dd.mount_specs(data_dir, home, etc=CONFIG.parent)
    dd.update_fstab(specs)
    run(["systemctl", "daemon-reload"], check=False)
    dd.write_marker(data_dir, uid=uid, gid=gid, user=user)


def step_user(a, ans: dict) -> None:
    cfg = config_values()
    user, home = cfg["user"], cfg["home"]
    if cfg.get("data_dir"):
        _prepare_data_disk_user(cfg, ans)
    else:
        try:
            pwd.getpwnam(user)
        except KeyError:
            run(["useradd", "--create-home", "--home-dir", home, "--shell", "/bin/bash", user])
    run(["usermod", "-aG", "sudo", user])
    sudoers = Path("/etc/sudoers.d/loam")
    text = (f"# Loam's agents get the whole machine (first release, decision 1).\n"
            f"{user} ALL=(ALL) NOPASSWD: ALL\n"
            f'Defaults env_keep += "PYTHONPYCACHEPREFIX LOAM_CONFIG"\n')
    tmp = sudoers.with_suffix(".tmp")
    tmp.write_text(text)
    os.chmod(tmp, 0o440)
    run(["visudo", "-cf", str(tmp)])
    os.replace(tmp, sudoers)
    with progress("Starting Loam's background services", "Background services started."):
        run(["loginctl", "enable-linger", user])
        uid = pwd.getpwnam(user).pw_uid
        for _ in range(30):
            if Path(f"/run/user/{uid}/bus").exists():
                break
            time.sleep(1)
        else:
            raise Stop("Loam's user was made, but its background services did not start.",
                       "restart the server and run the install command again")
    tz = cfg["timezone"]
    if run(["timedatectl", "set-timezone", tz], check=False).returncode != 0:
        Path("/etc/localtime").unlink(missing_ok=True)
        os.symlink(f"/usr/share/zoneinfo/{tz}", "/etc/localtime")
        Path("/etc/timezone").write_text(tz + "\n")
    # Setting the zone can move the clock: the kernel's first settimeofday
    # with a zone shifts it by the zone's offset unless systemd told it at
    # boot that the hardware clock is UTC, which a systemd that is not the
    # machine's own first process cannot (the rehearsal's sandbox: an hour
    # behind, and the login refused to start). So the clock is checked again.
    with progress("Checking the clock after setting your time zone", "Clock check finished."):
        ensure_clock()
    # Python's bytecode never lands in the checkout: for the user's services,
    # its shells, and root's runs.
    pyc = f"{home}/.cache/loam/pycache"
    envd = Path(home) / ".config" / "environment.d"
    as_user(cfg, ["mkdir", "-p", str(envd), pyc])
    as_user(cfg, ["sh", "-c", f"printf 'PYTHONPYCACHEPREFIX={pyc}\\nLOAM_CONFIG={CONFIG}\\n' "
                              f"> {envd}/50-loam.conf"])
    profile = Path(home) / ".profile"
    have = profile.read_text(errors="ignore") if profile.exists() else ""
    for line in (f"export PYTHONPYCACHEPREFIX={pyc}", f"export LOAM_CONFIG={CONFIG}"):
        if line not in have:
            as_user(cfg, ["sh", "-c", f"printf '\\n{line}\\n' >> {profile}"])
    Path("/etc/profile.d/loam.sh").write_text(
        f"# Loam (install.sh): Python's bytecode outside Loam's checkout.\n"
        f'if [ "$(id -u)" = 0 ]; then export PYTHONPYCACHEPREFIX={ROOT_PYCACHE}; fi\n')
    as_user(cfg, ["systemctl", "--user", "set-environment",
                  f"PYTHONPYCACHEPREFIX={pyc}", f"LOAM_CONFIG={CONFIG}"])
    # Docker's daemon.json before anything uses Docker: loopback publishes and
    # userns-remap move where Docker keeps everything, so it is set once, here.
    import loam_deploy as dep  # noqa: PLC0415
    want = dep.daemon_json()
    if not dep.DAEMON_JSON.exists() or dep.DAEMON_JSON.read_text() != want:
        dep.DAEMON_JSON.parent.mkdir(parents=True, exist_ok=True)
        dep.DAEMON_JSON.write_text(want)
        with progress("Restarting Docker", "Docker restarted."):
            run(["systemctl", "restart", "docker"])
    say(f"Made the user \"{user}\" that Loam and its agents run as.", 2)


# ---------------------------------------------------------------------------
# 5. Loam
# ---------------------------------------------------------------------------

def git_env() -> dict:
    """The install token, for a private repository, as an HTTP header that
    lives only in this process's environment: never in a file, a URL, or a
    git config on disk."""
    token = os.environ.get("LOAM_INSTALL_TOKEN", "")
    if not token:
        return {}
    import base64  # noqa: PLC0415
    basic = base64.b64encode(f"x-access-token:{token}".encode()).decode()
    return {"GIT_CONFIG_COUNT": "1", "GIT_CONFIG_KEY_0": "http.extraHeader",
            "GIT_CONFIG_VALUE_0": f"Authorization: Basic {basic}"}


def step_loam(a, ans: dict) -> None:
    cfg = config_values()
    user, root = cfg["user"], Path(cfg["root"])
    release = Path(os.environ.get("LOAM_RELEASE_DIR", str(HERE)))
    version = ans.get("version") or run(["git", "-C", str(release), "describe", "--tags",
                                         "--exact-match"], check=False).stdout.strip()
    if not (root / ".git").is_dir():
        with progress("Copying Loam onto the server", "Loam copied."):
            run(["git", "clone", "--quiet", "--no-hardlinks", str(release), str(root)])
            run(["chown", "-R", f"{user}:{user}", str(root)])
    as_user(cfg, ["git", "-C", str(root), "remote", "set-url", "origin",
                  ans.get("source") or DEFAULT_SOURCE])
    head = as_user(cfg, ["git", "-C", str(root), "rev-parse", "HEAD"]).stdout.strip()
    want = run(["git", "-C", str(release), "rev-parse", "HEAD"]).stdout.strip()
    if head != want:
        with progress("Copying this version of Loam", "Loam copied."):
            as_user(cfg, ["git", "-C", str(root), "fetch", "--quiet", str(release), "--tags"])
            as_user(cfg, ["git", "-C", str(root), "checkout", "--quiet", want])
    ans["commit"], ans["version"] = want, version or ans.get("version")
    save_answers(ans)
    for key in ("vault", "workspaces", "projects", "plugins"):
        as_user(cfg, ["mkdir", "-p", cfg[key]])
    as_user(cfg, ["mkdir", "-p", f"{cfg['home']}/.local/state/loam",
                  f"{cfg['home']}/.config/loam", f"{cfg['home']}/.local/bin"])
    if not (Path(cfg["plugins"]) / ".git").is_dir():
        as_user(cfg, ["git", "-C", cfg["plugins"], "init", "--quiet", "-b", "main"])
    # uv, then the MCP servers' Python.
    if not Path(f"{cfg['home']}/.local/bin/uv").exists():
        with progress("Installing the Python package tool", "Python package tool installed."):
            as_user(cfg, ["sh", "-c", "curl -LsSf https://astral.sh/uv/install.sh | "
                                      "env UV_NO_MODIFY_PATH=1 sh"], timeout=900)
    venv = f"{cfg['home']}/.local/share/loam/mcp-venv"
    if not Path(venv, "bin", "python").exists():
        as_user(cfg, [f"{cfg['home']}/.local/bin/uv", "venv", "--quiet", "--python",
                      "/usr/bin/python3", venv])
    with progress("Installing what Loam's tools need", "Tool packages installed."):
        as_user(cfg, [f"{cfg['home']}/.local/bin/uv", "pip", "install", "--quiet", "--python",
                      f"{venv}/bin/python", "-r", str(root / "mcp" / "requirements.txt")], timeout=1800)
    link = Path("/usr/local/bin/loam")
    if link.is_symlink() or link.exists():
        link.unlink()
    link.symlink_to(root / "bin" / "loam")
    say(f"Loam {ans.get('version') or want[:7]} is at {root}.", 2)


# ---------------------------------------------------------------------------
# 6. The starter vault
# ---------------------------------------------------------------------------

def step_vault(a, ans: dict) -> None:
    cfg = config_values()
    root = cfg["root"]
    if ans.get("adopted"):
        with progress("Refreshing Loam's library on your vault", "Library refreshed."):
            as_user(cfg, ["python3", f"{root}/bin/library", "install"])
    else:
        with progress("Making your vault", "Vault folders ready."):
            as_user(cfg, ["python3", f"{root}/bin/library", "seed-vault"])
    ident = ["-c", "user.name=loam", "-c", f"user.email=loam@{cfg['edge']['domain']}"]
    for key in ("vault", "workspaces"):
        where = cfg[key]
        if not Path(where, ".git").is_dir():
            # On `main` by name: git's own default is `master` on Debian's
            # git, and the backup plugin restores from `main` (docs/backup.md).
            as_user(cfg, ["git", "-C", where, "init", "--quiet", "-b", "main"])
            as_user(cfg, ["git", "-C", where, *ident, "add", "-A"])
            as_user(cfg, ["git", "-C", where, *ident, "commit", "--quiet", "--allow-empty",
                          "-m", "Loam: the starting point"])
    reach = Path(cfg["workspaces"]) / "_shared" / "reach.md"
    if not reach.exists():
        text = as_user(cfg, ["python3", "-c",
                             f"import sys; sys.path.insert(0, {root + '/lib'!r}); "
                             "import loam_install; print(loam_install.reach_text(), end='')"]).stdout
        as_user(cfg, ["mkdir", "-p", str(reach.parent)])
        as_user(cfg, ["sh", "-c", f"cat > {shlex.quote(str(reach))}"], input=text)
    if ans.get("adopted"):
        say(f"Kept your existing vault at {cfg['vault']} and refreshed Loam's library.", 2)
    else:
        say(f"Made your vault at {cfg['vault']} (Inbox, Conversations, Projects, "
            f"Attachments, System).", 2)


# ---------------------------------------------------------------------------
# 7. The providers
# ---------------------------------------------------------------------------

def step_providers(a, ans: dict) -> None:
    """Claude Code, Codex and Antigravity at the builds this release pins
    (lib/loam_pins.py), each installed beside under ~/.local/share, checked
    by its own --version, and linked from ~/.local/bin; nothing updates them
    between releases."""
    cfg = config_values()
    root = cfg["root"]
    labels = {"claude-code": "Claude Code", "codex": "Codex", "antigravity": "Antigravity"}
    got = {}
    problems = []
    for which, label in labels.items():
        with progress(f"Installing {label}"):
            res = as_user(cfg, ["python3", f"{root}/bin/provider-pin", "apply", "--no-restart",
                                "--json", "--provider", which], timeout=3600, check=False)
            try:
                row = json.loads(res.stdout)
            except ValueError:
                row = {}
        if row and not row["error"] and row.get("after") == row["pinned"]:
            got[which] = row["after"]
            say(f"✓ {label} {row['after']} ready.", 2)
        else:
            problems.append(f"{label} {row.get('pinned', 'at its pinned version')}")
    if problems:
        raise Stop(f"{problems[0]} could not be installed.",
                   "check this server can reach the internet, then run the install "
                   "command again; the details are at the end of /var/log/loam-install.log")
    # Every provider's own memory off, and proved off.
    with progress("Turning off the AI tools' own memory", "Loam will keep your agents' memory."):
        as_user(cfg, ["python3", f"{root}/bin/provider-memory", "pin"])
        check = as_user(cfg, ["python3", f"{root}/bin/provider-memory", "check"], check=False)
        if check.returncode != 0:
            raise Stop("The AI tools' own memory could not be confirmed off.",
                       "the details are at the end of /var/log/loam-install.log")
    ans["providers"] = got
    save_answers(ans)


# ---------------------------------------------------------------------------
# 8. The starter agent and its hello thread
# ---------------------------------------------------------------------------

def step_starter(a, ans: dict) -> None:
    cfg = config_values()
    if ans.get("adopted"):
        for option in ("--managed-settings", "--reviewer"):
            as_user(cfg, ["python3", f"{cfg['root']}/bin/provision", option])
        with progress("Setting up the engineer", "Engineer ready to make changes your agents ask for."):
            res = as_user(cfg, ["python3", f"{cfg['root']}/bin/provision", "--engineer"],
                          check=False)
            if res.returncode != 0:
                raise Stop("The engineer, which changes Loam itself when your agents ask, "
                           "could not be set up.",
                           "run the install command again; the details are at the end of "
                           "/var/log/loam-install.log")
        listed = as_user(cfg, ["python3", "-c",
                               f"import json, sys; sys.path.insert(0, {cfg['root'] + '/lib'!r}); "
                               "import loam_agents as a; print(json.dumps(a.live(a.every())))"])
        agents = json.loads(listed.stdout) if listed.stdout.strip() else []
        with progress("Re-provisioning your existing agents"):
            for name in agents:
                as_user(cfg, ["python3", f"{cfg['root']}/bin/provision", name])
        if agents:
            say(f"✓ Kept your existing agents ({', '.join(agents)}) and re-provisioned them for this server.", 2)
        else:
            say("✓ Kept your existing workspaces (no active agents to re-provision).", 2)
        return
    with progress("Making Iris, your first agent"):
        res = as_user(cfg, ["python3", f"{cfg['root']}/bin/library", "seed-starter"],
                      check=False, timeout=3600)
    try:
        out = json.loads(res.stdout)
    except ValueError:
        out = {}
    if res.returncode != 0 or not (out.get("thread") or "seeded at" in out.get("skipped", "")):
        raise Stop("Iris, your first agent, could not be made.",
                   "run the install command again; a half-made Iris is set aside and made again")
    ans["starter"] = out
    save_answers(ans)
    say("✓ Made Iris and your first conversation with her.", 2)
    # The engineer, which makes changes to Loam itself when an agent briefs
    # it (2026-11-18): its role and project file are seeded into the vault
    # from this release and rendered beside the code (bin/provision).
    as_user(cfg, ["python3", f"{cfg['root']}/bin/preinstall-plugins"])
    for option in ("--managed-settings", "--reviewer"):
        as_user(cfg, ["python3", f"{cfg['root']}/bin/provision", option])
    with progress("Setting up the engineer", "Engineer ready to make changes your agents ask for."):
        res = as_user(cfg, ["python3", f"{cfg['root']}/bin/provision", "--engineer"],
                      check=False)
        if res.returncode != 0:
            raise Stop("The engineer, which changes Loam itself when your agents ask, "
                       "could not be set up.",
                       "run the install command again; the details are at the end of "
                       "/var/log/loam-install.log")


# ---------------------------------------------------------------------------
# 9. Units
# ---------------------------------------------------------------------------

SYSTEM_UNITS = ("loam-broker-firewall.service", "loam-claim.service",
                "loam-await-dns.service", "loam-await-dns.timer",
                "loam-user-manager.service")


def system_unit_text(name: str, cfg: dict) -> str:
    text = (Path(cfg["root"]) / "systemd" / "system" / name).read_text(encoding="utf-8")
    return (text.replace("@ROOT@", cfg["root"]).replace("@PYCACHE@", ROOT_PYCACHE)
            .replace("@USER@", cfg["user"]))


def install_system_units(cfg: dict) -> bool:
    changed = False
    for name in SYSTEM_UNITS:
        path = Path("/etc/systemd/system") / name
        text = system_unit_text(name, cfg)
        if not path.exists() or path.read_text() != text:
            path.write_text(text)
            changed = True
    if changed:
        run(["systemctl", "daemon-reload"])
    return changed


def step_units(a, ans: dict) -> None:
    cfg = config_values()
    root = cfg["root"]
    sys.path.insert(0, f"{root}/lib")
    import loam_broker as brk  # noqa: PLC0415
    # The broker's bridge and the wall around its port, before the broker binds.
    if run(["docker", "network", "inspect", brk.NETWORK], check=False).returncode != 0:
        run(["docker", "network", "create", "--subnet", brk.SUBNET, "--gateway", brk.BIND_ADDR,
             "-o", "com.docker.network.bridge.name=br-loambroker", brk.NETWORK])
    fw = Path(root) / "broker" / "firewall.sh"
    run(["install", "-D", "-o", "root", "-g", "root", "-m", "755", str(fw), str(brk.FIREWALL_SCRIPT)])
    install_system_units(cfg)
    run(["systemctl", "enable", "--now", brk.WALL_SERVICE])
    # Loam's user manager comes back at boot even where lingering alone does
    # not bring it (found by the 2026-11-16 first-day walk's reboot).
    run(["systemctl", "enable", "loam-user-manager.service"])
    # The user's units, rendered from the templates; services started and
    # timers armed so that none fires on the spot (lib/loam_units.py).
    with progress("Starting Loam's engine and timers", "Loam's engine, plugin host and timers started."):
        as_user(cfg, ["python3", f"{root}/bin/gen-units", "--fresh-install"])
        as_user(cfg, ["systemctl", "--user", "daemon-reload"])
        for svc in (brk.SERVICE, "loam-plugins-gateway.service"):
            as_user(cfg, ["systemctl", "--user", "enable", "--now", svc])
        # The first check may run before either sampling timer's first deadline.
        # Give it real readings before arming the timers and opening the claim.
        as_user(cfg, ["systemctl", "--user", "start", "loam-pressure.service",
                      "loam-memsample.service"])
        arm = (f"import sys; sys.path.insert(0, {root + '/lib'!r}); import loam_units as u\n"
               "for t in sorted(n for n in u.rendered() if n.endswith('.timer')):\n"
               "    print(t, u.arm_timer(t))\n")
        as_user(cfg, ["python3", "-c", arm])
        for _ in range(60):
            if run(["curl", "-fsS", "-o", "/dev/null", f"http://{brk.BIND_ADDR}:{brk.PORT}/up"],
                   check=False).returncode == 0:
                break
            time.sleep(2)
        else:
            raise Stop("Loam's engine (the session broker) did not start.",
                       f"its log: sudo -u {cfg['user']} journalctl --user -u {brk.SERVICE} -n 50")
    # Reconcile every agent schedule and enabled plugin server/timer right away
    # (essential on an adopted disk whose generated unit directory is fresh, and
    # leaves any install with zero drift immediately after step 9).
    with progress("Reconciling schedules and plugins", "Schedules and plugins reconciled."):
        as_user(cfg, ["python3", f"{root}/bin/schedule", "reconcile"], check=False)
        as_user(cfg, ["python3", f"{root}/bin/plugin-servers", "reconcile"], check=False)
    # The host's own setup is kept from here on, and can be put back with
    # `loam host restore` (lib/loam_host.py, docs/host-history.md).
    with progress("Saving the server's setup", "Server setup saved."):
        run([sys.executable, f"{root}/bin/loam-host", "install"])
        run([sys.executable, f"{root}/bin/loam-host", "snapshot", "--reason", "installed"])


# ---------------------------------------------------------------------------
# 10. The edge
# ---------------------------------------------------------------------------

def step_edge(a, ans: dict) -> None:
    cfg = config_values()
    root, edge = cfg["root"], cfg["edge"]
    py = sys.executable
    with progress("Setting up web access", "Web access configured."):
        run([py, f"{root}/bin/gen-deploy", "--init-secrets"])
        run([py, f"{root}/bin/gen-deploy"], timeout=1800)
    commit = ans.get("commit") or run(["git", "-C", root, "rev-parse", "HEAD"]).stdout.strip()
    with progress("Starting the Loam app", "Loam app started."):
        run([py, f"{root}/bin/deploy", edge.get("app", "loam-ui"), "up", commit], timeout=3600)
    install_system_units(cfg)
    run(["systemctl", "enable", "--now", "loam-claim.service"])
    sys.path.insert(0, f"{root}/lib")
    import loam_deploy as dep  # noqa: PLC0415
    # gen-deploy raised the inbound wall (lib/loam_deploy.py, "The inbound
    # wall"); one line says what guards this server now.
    say(dep.inbound_wall_words(dep.inbound_wall_status()), 2)
    with progress("Checking your domain and web certificate"):
        res = run([py, f"{root}/bin/loam-await-dns"], timeout=1800, check=False)
    state = dep.edge_state()
    if state.get("ready_at"):
        say(f"✓ Loam is on the web at https://{edge['domain']}/ with its certificate.", 2)
        return
    run(["systemctl", "enable", "--now", "loam-await-dns.timer"])
    if edge.get("own_domain") and state.get("dns") != "resolved" and not a.yes \
            and wait_for_dns(cfg, edge):
        state = dep.edge_state()
        if state.get("ready_at"):
            say(f"✓ Loam is on the web at https://{edge['domain']}/ with its certificate.", 2)
            return
    if state.get("dns") == "resolved":
        say(f"{edge['domain']} points here; its certificate is on its way. Loam keeps "
            f"checking by itself.", 2)
    elif edge.get("own_domain"):
        say(f"Everything is ready except the domain: {edge['domain']} is not pointing "
            "to this server yet. What DNS says now:", 2)
        say_problems(state)
        say("The two records it needs:", 2)
        say_records(edge)
        say("Loam checks every 30 seconds and goes on the web by itself as soon as they "
            "work. Nothing else needs doing here; `loam status` says what it last found.", 2)
    else:
        base = edge["domain"].split(".", 1)[1]
        say(f"Everything is ready except the name: {edge['domain']} does not point to this "
            f"server yet. Add these two DNS records (type A, not proxied):", 2)
        for rec in li.records_to_ask_for(edge["name"], edge["address"], base):
            say(rec, 6)
        say("Loam checks every 30 seconds and goes on the web by itself as soon as they "
            "work. Nothing else needs doing here.", 2)
    if res.returncode:
        logline("loam-await-dns exited non-zero; the timer will carry on")


DNS_WAIT = 15 * 60          # how long step 10 waits here for an own domain's records
DNS_POLL = 15


def wait_for_dns(cfg: dict, edge: dict) -> bool:
    """On an own domain, with someone at the terminal: wait here while they
    make the records, saying what is still missing whenever it changes, and
    put Loam on the web the moment they are right. Enter stops the wait (the
    timer carries on by itself). True when the records came right."""
    import select  # noqa: PLC0415
    import termios  # noqa: PLC0415
    try:
        tty = open("/dev/tty", "r", encoding="utf-8")
    except OSError:
        return False
    with tty:
        say(f"{edge['domain']} does not point to this server yet. The installer can "
            "wait here while you make the two records:", 2)
        say_records(edge)
        say(f"Checking every {DNS_POLL} seconds for up to {DNS_WAIT // 60} minutes. "
            "Press Enter to stop waiting; Loam then keeps checking by itself.", 2)
        # Echoing Enter advances the cursor and would leave the last spinner
        # frame in scrollback. Keep line input and signals working as usual.
        original = termios.tcgetattr(tty)
        silent = original.copy()
        silent[3] &= ~(termios.ECHO | termios.ECHONL)
        termios.tcsetattr(tty, termios.TCSANOW, silent)
        try:
            shown: list[str] | None = None
            deadline = time.monotonic() + DNS_WAIT
            while time.monotonic() < deadline:
                with progress("Waiting for your domain records", announce=False):
                    found = li.edge_check(edge)
                if found["state"] == "here":
                    break
                if found.get("problems") != shown:
                    shown = found.get("problems")
                    say("Still waiting for:", 2)
                    say_problems(found)
                with progress("Waiting for your domain records", announce=False):
                    ready, _, _ = select.select([tty], [], [], DNS_POLL)
                    if ready:
                        tty.readline()
                if ready:
                    say("Stopped waiting here.", 2)
                    return False
            else:
                return False
        finally:
            termios.tcsetattr(tty, termios.TCSANOW, original)
    say("✓ Both records are right.", 2)
    with progress("Getting your web certificate"):
        run([sys.executable, f"{cfg['root']}/bin/loam-await-dns"], timeout=1800, check=False)
    return True


# ---------------------------------------------------------------------------
# 11. The claim
# ---------------------------------------------------------------------------

def step_claim(a, ans: dict) -> None:
    cfg = config_values()
    sys.path.insert(0, f"{cfg['root']}/lib")
    import loam_deploy as dep  # noqa: PLC0415
    if not dep.unclaimed():
        say("This Loam already has its owner.", 2)
        return
    li.mint_claim()
    os.chmod(li.CLAIM_FILE, 0o600)
    say("Made the one-time link that creates your sign-in.", 2)


# ---------------------------------------------------------------------------

STEP_FUNCS = {1: step_preflight, 2: step_name, 3: step_packages, 4: step_user,
              5: step_loam, 6: step_vault, 7: step_providers, 8: step_starter,
              9: step_units, 10: step_edge, 11: step_claim}


def finale(elapsed: float | None = None) -> None:
    cfg = config_values()
    sys.path.insert(0, f"{cfg['root']}/lib")
    import loam_deploy as dep  # noqa: PLC0415
    domain = cfg["edge"]["domain"]
    state = dep.edge_state()
    print()
    say("Loam is installed." if elapsed is None
        else f"Loam is installed. That took {li.took(elapsed)}.")
    print()
    if dep.unclaimed():
        link = li.claim_link(domain)
        if state.get("ready_at"):
            say("Open this link in your browser to make your sign-in. It works once; "
                "whoever opens it first becomes this Loam's owner, so keep it private:")
        else:
            say("This is your link to make your sign-in. It starts working once the name "
                "points here (Loam checks by itself every 30 seconds). Keep it private: "
                "whoever opens it first becomes this Loam's owner.")
        print(f"\n    {link}\n")
        say("To see how everything is doing, or to see this link again, type:  loam status")
    else:
        say(f"Open https://{domain}/ and sign in.")
        print()
        say("To see how everything is doing, type:  loam status")
    print()


def main() -> int:
    global step_started
    p = argparse.ArgumentParser(prog="install.sh", description="Install Loam on this server.")
    p.add_argument("--domain", help="your own domain, for example loam.example.com: "
                   "you make two DNS records there, and the installer says which")
    p.add_argument("--name", help=f"or a name under {li.BASE_DOMAIN} (<name>.{li.BASE_DOMAIN}), "
                   "whose records Loam's makers make: ask them first, in an "
                   f"issue at {li.ASK_FOR_A_NAME}")
    p.add_argument("--owner", help="your first name, as Loam should call you")
    p.add_argument("--timezone", help="for example Europe/Berlin")
    p.add_argument("--data-dir", help="existing mounted directory for all of your data "
                   "(or to adopt an existing Loam data disk)")
    p.add_argument("--yes", action="store_true", help="take the defaults; ask nothing")
    p.add_argument("--source", help=argparse.SUPPRESS)
    p.add_argument("--version", help=argparse.SUPPRESS)
    p.add_argument("--address", help=argparse.SUPPRESS)       # rehearsal: behind NAT
    p.add_argument("--resolver", default=None, choices=("public", "system"),
                   help=argparse.SUPPRESS)                     # rehearsal: /etc/hosts
    p.add_argument("--local-certs", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--base", help=argparse.SUPPRESS)          # rehearsal: a .test name
    a = p.parse_args()
    if os.geteuid() != 0:
        print("The installer needs to run as root: put  sudo  in front of the command.")
        return 2
    STATE.mkdir(parents=True, exist_ok=True)
    ans = load_answers()
    logline(f"=== install.sh {' '.join(sys.argv[1:])}")
    start = li.first_unfinished()
    if start is None:
        say("Every step of the install has already finished. Nothing to do.")
        finale()
        return 0
    if start > 1:
        say(f"Carrying on from step {start} of 11; steps 1 to {start - 1} finished earlier.")
    began = time.time()
    for n, _key, label in li.STEPS:
        if n < start:
            continue
        print()
        say(f"Step {n} of 11: {label}")
        step_started = time.monotonic()
        try:
            STEP_FUNCS[n](a, ans)
        except Stop as stop:
            logline(f"STOP step {n}: {stop.say}")
            print()
            say(f"The install stopped at step {n} of 11 ({label[0].lower() + label[1:]}): {stop.say}")
            if stop.fix:
                say(f"What to do: {stop.fix}.")
            say("Running the same install command again carries on from this step; "
                "everything before it is kept. If it stops here again, send the file "
                f"{LOG} to whoever helps you with Loam.")
            return 1
        except Exception as exc:  # noqa: BLE001 -- the person gets a sentence, the log the trace
            import traceback  # noqa: PLC0415
            logline("TRACE " + traceback.format_exc())
            print()
            say(f"The install stopped at step {n} of 11, on something unexpected "
                f"({exc.__class__.__name__}: {str(exc)[:160]}).")
            say("Running the same install command again carries on from this step. If it "
                "stops here again, send /var/log/loam-install.log to whoever helps you "
                "with Loam.")
            return 1
        mark_done(n)
        logline(f"DONE step {n} in {time.monotonic() - step_started:.0f}s")
    # The time this run took, said only when it ran every step: a re-run's
    # clock leaves out the steps an earlier run finished.
    finale(time.time() - began if start == 1 else None)
    return 0


if __name__ == "__main__":
    sys.exit(main())
