#!/bin/sh
# Dispatch the public verbs to their sibling scripts. Other loam-* programs are internal.
set -eu
VERBS="status update report market host tell plugin"
here=$(dirname "$(readlink -f "$0")")
# Python's bytecode never lands in the checkout, however `loam` was reached
# (a root shell over ssh reads no profile): an update refuses a tree with
# anything in it that the release did not put there.
if [ -z "${PYTHONPYCACHEPREFIX:-}" ]; then
  if [ "$(id -u)" = 0 ]; then PYTHONPYCACHEPREFIX=/var/cache/loam/pycache
  else PYTHONPYCACHEPREFIX="$HOME/.cache/loam/pycache"; fi
  export PYTHONPYCACHEPREFIX
fi
verb=${1:-help}
case "$verb" in
  help|-h|--help)
    echo "loam: the command for this server's Loam."
    echo
    for name in $VERBS; do
      f="$here/loam-$name"
      [ -x "$f" ] || continue
      line=$(sed -n '2,12{s/^"""//;s/^# *//;p}' "$f" | grep -m1 . || true)
      printf '  loam %-8s %s\n' "$name" "$line"
    done
    exit 0 ;;
esac
shift
case " $VERBS " in
  *" $verb "*) [ -x "$here/loam-$verb" ] && exec "$here/loam-$verb" "$@" ;;
esac
# A host administrator can install an extra local command here.
case "$verb" in
  *[!a-z0-9-]*|'') ;;
  *) local_command="/etc/loam/commands/loam-$verb"
     [ "$(id -u)" = 0 ] || [ ! -x "$local_command" ] || exec "$local_command" "$@" ;;
esac
echo "loam: there is no \"$verb\". Type: loam help" >&2
exit 2
