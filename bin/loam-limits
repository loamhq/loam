#!/usr/bin/env python3
"""Show when memory or capacity limits bit on this server (counts and events).

  loam limits                   last 7 days, counts by kind plus recent events
  loam limits --days 30         last 30 days (0 = all kept history)
  loam limits --kind oom_kill   filter to one or more comma-separated kinds
  loam limits --limit 50        cap raw events returned (counts cover the window)
  loam limits --json            machine-readable JSON (same shape as GET /v1/limit-events)
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import loam_limits as limits  # noqa: E402


def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        prog="loam limits",
        description="Read durable memory and capacity limit events.",
    )
    p.add_argument("--days", type=float, default=7,
                   help="Window in days (default: 7; 0 = all kept history)")
    p.add_argument("--kind", default=None,
                   help="Filter by kind or comma-separated kinds")
    p.add_argument("--limit", type=int, default=200,
                   help="Maximum raw events to include (default: 200)")
    p.add_argument("--json", action="store_true",
                   help="Print JSON output")
    return p.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    try:
        data = limits.query(days=args.days, kind=args.kind, limit=args.limit)
    except ValueError as exc:
        print(f"loam limits: {exc}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(data, indent=2))
    else:
        print(limits.format_text(data))
    return 0


if __name__ == "__main__":
    sys.exit(main())
