#!/usr/bin/env python3
"""Read or change a setting through the same broker route the page uses.

The registry in lib/loam_settings.py supplies the route and scope. A target
can identify a thread, session or schedule. A member selects whose provider
or model to change. Decode JSON values when possible and pass other text
through. Print the result as one JSON object for the settings tool."""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import loam_settings as settings  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(prog="settings")
    ap.add_argument("action", choices=("describe", "get", "set", "do"))
    ap.add_argument("setting", nargs="?", default="")
    ap.add_argument("value", nargs="?", default=None)
    ap.add_argument("--target", default="")
    ap.add_argument("--member", default="")
    ap.add_argument("--by", default=os.environ.get("LOAM_AGENT", ""))
    ap.add_argument("--reason", default="")
    args = ap.parse_args()
    try:
        if args.action == "describe":
            out = settings.describe(args.setting, args.target, args.member)
        elif args.action == "get":
            out = settings.get(args.setting, args.target, args.member)
        else:
            e = settings.entry(args.setting)
            if args.action == "set" and e.kind != "setting":
                raise settings.SettingsError(
                    f"{e.key} is an action: `do` it")
            if args.action == "do" and e.kind != "action":
                raise settings.SettingsError(
                    f"{e.key} is a setting: `set` it to a value")
            if args.action == "set" and args.value is None:
                raise settings.SettingsError(f"{e.key} needs a value ({e.values})")
            value = True if args.value is None else args.value
            out = settings.change(args.setting, value, args.by, args.target,
                                  args.member, args.reason)
            print(f"settings: {out['by']} {args.action} {args.setting}"
                  f"{' ' + args.target if args.target else ''}", file=sys.stderr)
        print(json.dumps(out, ensure_ascii=False))
        return 0
    except settings.SettingsError as exc:
        print(json.dumps({"ok": False, "error": exc.message}, ensure_ascii=False))
        return 1


if __name__ == "__main__":
    sys.exit(main())
