#!/usr/bin/env python3
"""Server plugins from a terminal (2026-11-13): lib/loam_plugin_servers.py.

Usage:
  plugin-servers reconcile        what loam-plugins-reconcile.timer runs: start
                                  every wanted server not loaded, stop what is
                                  loaded and no longer wanted (a failed unit is
                                  left alone, so a crash loop stays visible)
  plugin-servers status [<id>]    every server plugin's state, or one with its log
  plugin-servers restart <id>     a fresh start of that one unit
  plugin-servers ports            the port table bin/plugin-gateway routes by
  plugin-servers gateway-state    refresh gateway.json and print it
  plugin-servers ensure-gateway [--reconcile]
                                  restart loam-plugins-gateway.service if active
                                  and running stale code (re-rendering its unit
                                  first if needed)

Turning a plugin on or off is `bin/settings` (plugin.on) or the app: this
only reads and brings units into line, the same calls the broker makes.
"""

from __future__ import annotations

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

import loam_plugin_servers as servers  # noqa: E402
import loam_plugins as plugins  # noqa: E402


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0 if argv else 2
    cmd, rest = argv[0], argv[1:]
    if cmd == "reconcile":
        out = servers.reconcile()
        print(json.dumps(out, sort_keys=True))
        return 1 if out.get("errors") else 0
    if cmd == "status":
        if rest:
            row = plugins.one(rest[0])["plugin"]
            print(json.dumps(row.get("service"), indent=2))
            return 0
        rows = [r for r in plugins.listing()["plugins"] if r.get("service")]
        for r in rows:
            s = r["service"]
            print(f"{r['id']:<24} {s['state']:<9} wanted={str(s.get('wanted')).lower():<5} "
                  f"port={s.get('port')} pid={s.get('pid')} restarts={s.get('restarts')}")
        if not rows:
            print("no plugin has a server")
        return 0
    if cmd == "restart" and len(rest) == 1:
        row = plugins.restart_server(rest[0], "engineer")["plugin"]
        print(json.dumps(row.get("service"), indent=2))
        return 0
    if cmd == "ports":
        print(json.dumps(servers.read_ports(), indent=2, sort_keys=True))
        return 0
    if cmd == "gateway-state":
        doc = servers.refresh_gateway_state()
        print(json.dumps(doc, sort_keys=True, default=str))
        return 0
    if cmd == "ensure-gateway":
        out = servers.ensure_gateway_current(reconcile_after="--reconcile" in rest)
        print(json.dumps(out, sort_keys=True))
        return 1 if out.get("action") == "failed" else 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except plugins.PluginError as exc:
        print(f"plugin-servers: {exc.message}", file=sys.stderr)
        sys.exit(1)
