#!/usr/bin/env python3
"""Render the static user units from systemd/ and install them.

  gen-units            write every rendered unit whose installed copy differs,
                       then `systemctl --user daemon-reload` if any changed
  gen-units --dry-run  say which would change, write nothing
  gen-units NAME...    only these units (`loam-reviewer.service`, ...)
  gen-units --help     this text, and nothing else

The templates' tokens are filled from lib/loam_config.py (lib/loam_units.py
says which). It enables nothing it rewrites: a timer that was already
installed is left as it stands, armed or not. A timer it writes for the
first time, one a release has just added, it arms (``loam_units.arm_timer``,
so it does not fire on the spot), because the installer arms every timer it
renders and an update must leave a box with what a fresh install has; an
update run by an older release's code knows nothing of the new timer. The
routine local commit is the one exception: on a box whose crontab already
commits a tree by hand (lib/loam_autocommit.py) it is written and not armed.
bin/check-drift compares the installed units against the same rendering.

A unit this repository has retired (`loam_units.RETIRED`) and that is still
installed is stopped, disabled and removed by a full run (not one naming
units), so an update to a release without it leaves nothing behind.
"""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import loam_config as lc  # noqa: E402
import loam_units  # noqa: E402


def main(argv: list[str]) -> int:
    if "-h" in argv or "--help" in argv:
        print(__doc__.strip())
        return 0
    unknown_flags = [a for a in argv if a.startswith("-") and a not in ("--dry-run", "--fresh-install")]
    if unknown_flags:
        print(f"gen-units: unknown option {unknown_flags[0]} (--help says what it takes)",
              file=sys.stderr)
        return 2
    dry = "--dry-run" in argv
    names = [a for a in argv if not a.startswith("-")]
    if "--fresh-install" in argv and not (lc.USER_UNIT_DIR / loam_units.API_UNIT).exists():
        marker = loam_units.split_marker()
        if not dry:
            marker.parent.mkdir(parents=True, exist_ok=True)
            marker.touch()
        units = loam_units.rendered(split=True)
    else:
        units = loam_units.rendered()
    unknown = [n for n in names if n not in units]
    if unknown:
        print(f"gen-units: no template for {', '.join(unknown)}", file=sys.stderr)
        return 2
    changed, new_timers = [], []
    for name, text in units.items():
        if names and name not in names:
            continue
        path = lc.USER_UNIT_DIR / name
        try:
            same = path.read_text(encoding="utf-8") == text
        except FileNotFoundError:
            same = False
            if name.endswith(".timer"):
                new_timers.append(name)
        if same:
            continue
        changed.append(name)
        if not dry:
            lc.USER_UNIT_DIR.mkdir(parents=True, exist_ok=True)
            tmp = path.with_suffix(path.suffix + ".gen-units")
            tmp.write_text(text, encoding="utf-8")
            tmp.replace(path)
    verb = "would write" if dry else "wrote"
    print(f"gen-units: {verb} {len(changed)} of {len(units)}"
          + (f": {', '.join(changed)}" if changed else ""))
    if changed and not dry:
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
    if not names:
        gone = loam_units.retire(dry=dry)
        if gone:
            print(f"gen-units: {'would retire' if dry else 'retired'} {', '.join(gone)}")
    for timer in new_timers:
        if timer == "loam-autocommit.timer" and hand_routine():
            print(f"gen-units: {timer} not armed: this box's crontab commits by hand")
            continue
        if dry:
            print(f"gen-units: would arm {timer} (new)")
            continue
        print(f"gen-units: armed {timer} (new): {loam_units.arm_timer(timer)}")
    return 0


def hand_routine() -> bool:
    import loam_autocommit  # noqa: PLC0415
    return any(loam_autocommit.hand_routine(t) for t in loam_autocommit.ORDER)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
