#!/usr/bin/env python3
"""Post into a Loam thread from a wake, a cron or a turn (2026-11-08).

    thread post <thread-id|general> <text> [--bulletin] [--by <persona>]
                [--reply-to <message-id>] [--starter-week]
    thread rename <thread-id> <title> [--by <persona>]
    thread branch <thread-id> <message-id> [--persona <p>] [--title <t>]
                  [--text <draft>] [--by <persona>]
    thread list

The author is ``LOAM_AGENT`` (or ``--by``). ``--bulletin`` marks a wake
bulletin ("woke"), which belongs in General, short, and only when there is
something worth saying. A post is appended to the thread's record in the
vault, then told to the broker (0.2.1): it shows in an open page at once,
and an @mention wakes the member it names as a reply's would, under the
same cap on turns between agents (until 0.2.1 a post gave nobody a turn).
A bulletin gives no turn. Boards are edited
as files. ``rename`` (2026-11-10) is the app's own rename -- the
details page's PATCH -- through ``loam_threads.update``: the record's
``title:``, its file name, and the board's file and ``board:`` key move
together, General refuses, and the open app sees it on its list stream's
two-second look at the records. Like the app's, it leaves no line in the
thread. ``--reply-to m12`` (2026-11-11) makes the post a reply to message
m12 of that thread, as the app's reply does; a text opening with ``↩ m12``
means the same, the marker taken off. An id the thread does not hold is
refused. Ids are Loam's linkage: the app shows the quoted words, and a
post names an earlier message by its words, never by its id (2026-11-17). ``branch`` (2026-11-11) is the app's Branch into a new thread:
a new thread with ``--persona`` (the source's default if not given) and the
source message attached to the owner's composer. An explicit ``--text`` can
be left there unsent. The source gains a link when the owner sends with the
quote still attached. Prints one
JSON object. ``mcp__engineer__thread`` calls this.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import loam_threads as threads  # noqa: E402


def tell_broker(thread_id: str, message_id: str, by: str) -> dict | None:
    """Tell the broker a post is in the record (0.2.1): it goes on the
    thread's stream, and its @mentions wake the members named as a reply's
    do (`ThreadEngine.posted`, under the agents' chain cap). None when the
    broker did not answer: the post stands, and gives nobody a turn."""
    import http.client  # noqa: PLC0415
    try:
        import loam_broker as cfg  # noqa: PLC0415
        conn = http.client.HTTPConnection(cfg.BIND_ADDR, cfg.PORT, timeout=15)
        conn.request("POST", f"/v1/threads/{thread_id}/posted",
                     body=json.dumps({"message": message_id, "by": by}),
                     headers={"Authorization": f"Bearer {cfg.read_token()}",
                              "Content-Type": "application/json"})
        resp = conn.getresponse()
        body = json.loads(resp.read() or b"{}")
        if resp.status != 200:
            print(f"thread: the broker answered {resp.status} for the post: "
                  f"{body.get('error') or body}", file=sys.stderr)
            return None
        return body if isinstance(body, dict) else None
    except (OSError, ValueError) as exc:
        print(f"thread: the broker was not told of the post ({exc}); it gives "
              f"nobody a turn", file=sys.stderr)
        return None


def main() -> int:
    ap = argparse.ArgumentParser(prog="thread")
    sub = ap.add_subparsers(dest="action", required=True)
    post = sub.add_parser("post")
    post.add_argument("thread")
    post.add_argument("text")
    post.add_argument("--bulletin", action="store_true")
    post.add_argument("--reply-to", default="")
    post.add_argument("--starter-week", action="store_true")
    post.add_argument("--by", default=os.environ.get("LOAM_AGENT", ""))
    ren = sub.add_parser("rename")
    ren.add_argument("thread")
    ren.add_argument("title")
    ren.add_argument("--by", default=os.environ.get("LOAM_AGENT", ""))
    br = sub.add_parser("branch")
    br.add_argument("thread")
    br.add_argument("message")
    br.add_argument("--persona", default="")
    br.add_argument("--title", default="")
    br.add_argument("--text", default="")
    br.add_argument("--by", default=os.environ.get("LOAM_AGENT", ""))
    sub.add_parser("list")
    args = ap.parse_args()
    try:
        threads.ensure_general()
        if args.action == "list":
            rows = [{"id": r["id"], "title": r["title"],
                     "members": [m["persona"] for m in r["members"]],
                     "board": str(threads.VAULT / r["board"]),
                     "files": threads.thread_files.locations(r)}
                    for r in threads.listing()]
            print(json.dumps({"ok": True, "threads": rows}))
            return 0
        by = (args.by or "").strip().lower()
        if by not in threads.roster():
            raise threads.ThreadError(
                400, "who is posting? set LOAM_AGENT or pass --by <persona>")
        if args.action == "branch":
            source = args.thread.strip()
            persona = args.persona.strip().lower() or None
            meta = threads.branch(source, args.message.strip(), persona,
                                   title=args.title.strip() or None, draft=args.text)
            print(f"thread: {by} opened a branch composer from {source} at {args.message} "
                  f"in {meta['id']}", file=sys.stderr)
            print(json.dumps({"ok": True, "thread": meta["id"], "title": meta["title"],
                              "persona": meta["default"], "from": source,
                              "message": args.message.strip(),
                              "record": str(threads.record_path(meta["id"]))}))
            return 0
        if args.action == "rename":
            if args.thread.strip().lower() == threads.GENERAL_ID:
                raise threads.ThreadError(400, "General can't be renamed")
            if not args.title.strip():
                raise threads.ThreadError(400, "the title is empty")
            before = threads.read(args.thread)[0]["title"]
            meta = threads.update(args.thread, title=args.title)
            path = threads.record_path(args.thread)
            print(f"thread: {by} renamed {args.thread} {before!r} -> "
                  f"{meta['title']!r}", file=sys.stderr)
            print(json.dumps({"ok": True, "thread": args.thread,
                              "title": meta["title"], "was": before,
                              "record": str(path),
                              "board": str(threads.VAULT / meta["board"])}))
            return 0
        if not args.text.strip():
            raise threads.ThreadError(400, "the text is empty")
        occasion = {}
        if args.starter_week:
            import loam_starter as starter  # noqa: PLC0415
            if (os.environ.get("LOAM_WAKE") != "reflection"
                    or os.environ.get("CLAUDE_PROJECT_DIR") != str(threads.AI_LABS / by)
                    or args.bulletin):
                raise threads.ThreadError(400, "the starter week is a reflection post")
            try:
                running = json.loads((threads.lc.STATE / "wake" / f"{by}.running").read_text())
            except (OSError, ValueError):
                running = {}
            chat = None
            if isinstance(running, dict) and running.get("lane") == "reflection":
                chat = starter.week_one_chat(by, running.get("ts"))
            if not chat or chat[0] != args.thread:
                raise threads.ThreadError(409, "the starter week is not due in this chat")
            occasion = {"occasion": starter.WEEK_ONE}
        else:
            meta, _, _ = threads.read(args.thread)
            if by not in meta["members"]:
                threads.update(args.thread, add=[by])
        text, marked = threads.take_reply_mark(args.text)
        reply_to = args.reply_to.strip() or marked
        if not reply_to:
            text = args.text
        # Images it shows, as a reply's (2026-11-18): ![words](path) lines.
        text, images = threads.reply_images(text)
        if not text.strip() and not images:
            raise threads.ThreadError(400, "the text is empty")
        msg, made = threads.append_once(args.thread, by, text,
                                        kind="bulletin" if args.bulletin else "message",
                                        **({"reply_to": reply_to} if reply_to else {}),
                                        **({"attachments": images} if images else {}),
                                        **occasion)
        told = tell_broker(args.thread, msg["id"], by) if made and not args.bulletin else None
        print(json.dumps({"ok": True, "thread": args.thread, "message": msg,
                          **({"woke": told.get("woke", [])} if told else {})}))
        return 0
    except threads.ThreadError as exc:
        print(json.dumps({"ok": False, "error": exc.message}))
        return 1


if __name__ == "__main__":
    sys.exit(main())
