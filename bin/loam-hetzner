#!/usr/bin/env python3
"""Call the Hetzner Cloud API for a project connected in Settings."""

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
import loam_contributions  # noqa: E402
import loam_hetzner  # noqa: E402
from loam_keys import HETZNER_PLUGIN  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("project")
    parser.add_argument("method")
    parser.add_argument("path")
    parser.add_argument("--body-stdin", action="store_true", help="read a JSON object from stdin")
    args = parser.parse_args()
    if not any(p["id"] == HETZNER_PLUGIN for p in loam_contributions.active()):
        result = {"ok": False, "error": "Turn on Hetzner Cloud in Settings › Plugins."}
    else:
        try:
            body = json.load(sys.stdin) if args.body_stdin else None
        except ValueError:
            result = {"ok": False, "error": "Provide a JSON object on stdin."}
        else:
            result = loam_hetzner.call(args.project, args.method, args.path, body)
    print(json.dumps(result, ensure_ascii=False))
    return 0 if result["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())
