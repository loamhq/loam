#!/usr/bin/env python3
"""Provision one agent onto the Claude Code runtime. Derives, never copies.

Move 1's prompt was written for one persona and switched to another by find-and-replace;
the replace missed the two tasks that compose identity, and as written it
would have stood the second up wearing the first's soul. It was caught by reading. At
four agents that does not scale, so nothing here is ever edited from another
agent's copy: every per-agent value is read from that agent's own files at
build time, and the only input is the name.

Usage: provision <agent> [<wake HH:MM>] [--dry-run]
       provision --engineer [--dry-run]
       provision --reviewer [--dry-run]
       provision --codex [<agent>...] [--dry-run]
       provision --antigravity [<agent>...] [--dry-run]
       provision --project <name> --repo new|<url> [--project-file <path>]
           [--vault-folder <Folder> [--vault-write]]
       provision --project <name> --rerender
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import loam_config as lc  # noqa: E402

AI_LABS = lc.WORKSPACES
VAULT = lc.VAULT
# All personas and the platform engineer import the same reach file by absolute path.
REACH = lc.WORKSPACES / "_shared" / "reach.md"
AGENTS = lc.ROOT
CLAUDE_JSON = lc.HOME / ".claude.json"
# Import this checkout's library first so provisioning and its tests use the same
# revision.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

# The launcher and generator share the engineer's model setting in loam_engineer.
from loam_engineer import ENGINEER_MODEL  # noqa: E402
import loam_skills  # noqa: E402

# The limit has ONE definition and this is not it -- lib/loam_memory.py is,
# because the hook that enforces it and the wake that reports it both import
# from there and none of the three may disagree. What provision owns is
# putting the number where the agent can READ it: agents cannot read
# the runtime's checkout, so a constant living only in the enforcing layer
# is invisible to the party expected to keep it. CLAUDE.md is the one file
# that is operator-owned, unwritable by the agent, and present in every run.
import loam_deploy  # noqa: E402  the browser's URL and server name, one home
import loam_provider_memory as provider_memory  # noqa: E402  L8: the memory pins
import loam_contributions as contributions  # noqa: E402  L4: what plugins add


def die(msg: str) -> None:
    print(f"provision: {msg}", file=sys.stderr)
    sys.exit(1)


def skills_shape(workspace: Path) -> str:
    """folder-form (<skill>/SKILL.md), single-file (<skill>.md), or absent."""
    skills = workspace / "skills"
    if not skills.is_dir():
        return "absent"
    folders = [d for d in skills.iterdir() if d.is_dir() and (d / "SKILL.md").is_file()]
    singles = [
        f for f in skills.iterdir()
        if f.is_file() and f.suffix == ".md" and not f.name.startswith("_")
    ]
    if folders and singles:
        return "mixed"
    if folders:
        return "folder"
    if singles:
        return "single-file"
    return "empty"


def skills_line() -> str:
    """Point every workspace at the shared library. Generate the pointer in operator-owned
    instructions so personal files stay under their author's control."""
    system = VAULT / lc.vault_folder("system")
    return (f"**Shared skills.** Beside your own `skills/`, every provider "
            f"lists you two shared shelves: `{system}/{loam_skills.OWN_DIR}/`, "
            f"{lc.OWNER_NAME}'s and every agent's, and "
            f"`{system}/{loam_skills.LOAM_DIR}/skills/`, Loam's own (how Loam "
            f"works and how to use it well; each update replaces it); your own "
            f"skill wins over a shared one of the same name, and `loam-skills` "
            f"says the rest.")


def claude_md(display: str, workspace: Path) -> str:
    """Render the shared persona instructions and imports for every lane."""
    import loam_loading  # noqa: PLC0415
    return f"""You are {display}.

@soul.md

@{loam_loading.LOAM_TEXT}

@{loam_loading.owner_page()}

@config.md

@{loam_loading.MAP}

---

**Surface:** Claude Code, on the server that holds the vault. {lc.OWNER_NAME}
reaches you in Loam's app; on a schedule you wake by yourself with no one
watching. Markdown renders, and wiki-links like [[Note Name]]
stay as written.

**Your workspace** is `{workspace}/`. `CLAUDE.md`, `agent.json`, `.mcp.json`,
`.claude/`, `.codex/` and `.agents/` are the runtime's: how you are
assembled. Above, in order: your soul; Loam's text; the owner's words, the
page every agent loads (`{loam_loading.owner_page()}`) and then your own
(`config.md`); and your map (`{loam_loading.MAP}`). Those load on every run,
in a conversation, at a wake and in a cron alike. Any `_always.md`,
`_active.md` or `_reflection.md` still in your workspace no longer loads:
it is an ordinary file of yours, to keep, fold in or delete.

What you can reach and use is in the shared file below, which any agent may
edit; what the owner's plugins add is at the end of this file:

@{REACH}

{skills_line()}

**If you are already a subagent, call `Agent` synchronously or not at all.**
A background subagent that launches background children ends before they
do and returns a hollow report.

Both trees auto-commit every 15 minutes, so a bad edit is recoverable.
""" + _plugin_words(workspace)


def _plugin_words(workspace: Path) -> str:
    """Include instructions contributed by enabled plugins, in the plugins' own words."""
    words = contributions.lane_prompt("persona", workspace.name)
    return f"\n{words}\n" if words else ""


def settings(workspace: Path) -> dict:
    ws = str(workspace)
    plugin_tools = [f"mcp__{s}" for s in contributions.lane_servers("persona", workspace.name)]
    import loam_profile  # noqa: PLC0415
    try:
        card = json.loads((workspace / "agent.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        card = {}
    return {
        # Use the agent profile's model when a conversation has no explicit model override.
        "model": loam_profile.claude_model(card),
        "permissions": {
            "defaultMode": "acceptEdits",
            "additionalDirectories": [str(VAULT), str(AI_LABS)],
            # Persona filesystem access follows the current role and provider settings.
            "deny": [
                "CronCreate",
                "CronDelete",
                "ScheduleWakeup",
                "RemoteTrigger",
                # The shared browser's one tool that runs arbitrary Playwright
                # code inside the browser container's Node process rather
                # than driving a page. The container is the wall either way
                # (no capabilities, its own network, 1 GB), but a persona's
                # sight is pages, snapshots and screenshots; this is denied
                # by full name so the server-wide allow below cannot reach it.
                f"mcp__{loam_deploy.BROWSER_SERVER_NAME}__browser_run_code_unsafe",
            ],
            # Keep the project settings consistent with the permission mode selected by each
            # launcher.
            "allow": [
                # Apply the persona's tool grants consistently across its working directories.
                "Bash",
                "BashOutput",
                "KillShell",
                "Read",
                "Edit",
                "Write",
                "NotebookEdit",
                "Glob",
                "Grep",
                "mcp__loam__read_epub",
                "mcp__loam__delete_file",
                "mcp__loam__restore_file",
                "mcp__loam__move_file",
                "mcp__composition__generate_pdf",
                "mcp__composition__typst_fonts",
                "mcp__composition__render_typst_pages",
                # Register browser capabilities by server so newly supported tools follow the same
                # grant.
                f"mcp__{loam_deploy.BROWSER_SERVER_NAME}",
                # Register the engineer tool set by server so every lane receives the current interface.
                "mcp__engineer",
                # A plugin's tools, by server, for the engineer's reason: an
                # unallowed MCP call prompts, and a session nobody is watching
                # hangs on it.
                # (lib/loam_contributions.py).
                *plugin_tools,
                # Web reach. Native tools, so nothing in the runtime design
                # accounted for them and they landed in the middle category:
                # neither allowed nor denied, which means they prompt -- and a
                # headless wake has nobody to answer a prompt. The standing
                # nightly market & research sweep is the job that found this,
                # and D9 sized the whole 02:00-05:00 grid around that sweep
                # being the longest-running wake.
                #
                # Deliberately unscoped. WebFetch supports domain-scoped
                # grants and one would be wrong here: the sweep's whole job is
                # fetching sources it has not seen before, so an allowlist
                # would fail on exactly the material worth finding, and fail
                # it the same silent way the missing grant did.
                #
                # Granted to every agent, not just the one that needs it
                # today. These configs are byte-identical apart from the
                # agent's own name, and that invariant is worth more than a
                # narrower grant.
                "WebSearch",
                "WebFetch",
                # A background subagent must retain the parent persona's identity and working context.
                "Task",
                # Grant the skill loader for workspace skills and bundled CLI skills on unattended
                # lanes too.
                "Skill",
            ],
        },
        # Skills are not tools, so the deny list above cannot reach them -- and
        # two bundled ones reopen exactly the door it closes. `/schedule`
        # creates recurring runs on Anthropic's infrastructure; `/loop` re-runs
        # a prompt on an interval. A reflection wake that decides to schedule
        # its own follow-up is not a far-fetched turn.
        #
        # `skillOverrides` is the per-skill seam (values: on / name-only /
        # user-invocable-only / off). "off" removes the skill from the model's
        # skill list AND from slash-command dispatch; an attempt returns
        # `Skill "schedule" is disabled via skillOverrides.` The alternative,
        # CLAUDE_CODE_DISABLE_BUNDLED_SKILLS, is all-or-nothing and would take
        # the agents' own authored skills down with it -- those are identity
        # infrastructure, not conveniences.
        #
        # When an agent wakes stays an operator decision, expressed in systemd
        # units.
        "skillOverrides": {
            "schedule": "off",
            "loop": "off",
        },
        # Three claude.ai cloud connectors -- Gmail, Google Calendar, Google
        # Drive -- were arriving on every agent's MCP surface. Nobody added
        # them: they are account-level connectors auto-fetched into every
        # project. Inert today because OAuth cannot complete headless, but the
        # surface should be what we chose, not what arrived.
        #
        # This gates ONLY auto-fetched connectors, and it is read per settings
        # source, so setting it here removes them from the five agents without
        # touching the owner's own Claude usage anywhere else.
        "disableClaudeAiConnectors": True,
        "enableAllProjectMcpServers": True,
        "outputStyle": "none",
        # Auto memory off. It gives nothing a plain file cannot: no relevance
        # recall fires on this build (the machinery is in the binary behind a
        # server-side flag that can switch on with no release), its index
        # truncates SILENTLY at 200 lines / 25,000 characters, and it was
        # kept precisely because it supposedly could not outgrow its
        # transport -- it can, it just fails quietly rather than loudly.
        #
        "autoMemoryEnabled": False,
        # Register the hooks that apply the runtime's file boundary and workspace conventions.
        "hooks": {
            "Stop": [{"hooks": [_hook("transcript_capture.py", 120)]}],
            "SessionEnd": [{"hooks": [_hook("transcript_capture.py", 120)]}],
            "PostToolUse": [{"matcher": "*", "hooks": [
                _hook("loading_size.py", 15)]}],
        },
    }


def _hook(script: str, timeout: int) -> dict:
    return {
        "type": "command",
        "command": f"/usr/bin/python3 {AGENTS}/hooks/{script}",
        "timeout": timeout,
    }


def _guard_hook() -> dict:
    """Render the same boundary hook wherever it is required. Refuse the call if the guard
    times out or fails."""
    return {**_hook("boundary_guard.py", 15), "onFailure": "block"}


def mcp_config(name: str, workspace: Path) -> dict:
    return {
        "mcpServers": {
            "loam": {
                "command": f"{lc.MCP_VENV}/bin/python",
                "args": [f"{AGENTS}/mcp/read_epub_server.py"],
                "env": {
                    "LOAM_EPUB_ROOTS": f"{VAULT}:{workspace}",
                    "LOAM_AGENT": name,
                    "LOAM_AGENT_WORKSPACE": str(workspace),
                    "LOAM_VAULT": str(VAULT),
                    "LOAM_AI_LABS": str(AI_LABS),
                    # Keep Python bytecode outside the checkout.
                    "PYTHONPYCACHEPREFIX": str(lc.PYCACHE),
                },
            },
            "composition": {
                "command": f"{lc.MCP_VENV}/bin/python",
                "args": [f"{AGENTS}/mcp/composition_server.py"],
                "env": {
                    "LOAM_AGENT": name,
                    "LOAM_AGENT_WORKSPACE": str(workspace),
                    "LOAM_VAULT": str(VAULT),
                    "LOAM_AI_LABS": str(AI_LABS),
                    # Keep Python bytecode outside the checkout.
                    "PYTHONPYCACHEPREFIX": str(lc.PYCACHE),
                },
            },
            # Briefing returns the job ID immediately. Results are delivered to the originating
            # thread or lane.
            "engineer": {
                "command": f"{lc.MCP_VENV}/bin/python",
                "args": [f"{AGENTS}/mcp/engineer_server.py"],
                "timeout": 600000,
                "env": {
                    "LOAM_AGENT": name,
                    "LOAM_AGENT_WORKSPACE": str(workspace),
                    "LOAM_VAULT": str(VAULT),
                    "LOAM_AI_LABS": str(AI_LABS),
                    # Keep Python bytecode outside the checkout.
                    "PYTHONPYCACHEPREFIX": str(lc.PYCACHE),
                },
            },
            # All personas use the same loopback browser service.
            loam_deploy.BROWSER_SERVER_NAME: {
                "type": "http",
                "url": loam_deploy.BROWSER_URL,
            },
            # Include enabled plugins here so all providers render the same server set.
            **contributions.lane_servers("persona", name),
        }
    }


# Generate the Codex workspace settings from the same tool and provider declarations
# used for the other runtimes.
CODEX_HOME = lc.STATE / "broker" / "codex"
CODEX_INSTALL = lc.HOME / ".local" / "share" / "codex"

# Explicitly forward the environment a stdio server needs to find the user systemd bus
# and the calling lane.
CODEX_ENV_VARS = {"engineer": ["XDG_RUNTIME_DIR", "DBUS_SESSION_BUS_ADDRESS",
                               "LOAM_WAKE"]}
# Passed through by name at run time, never copied at render time:
# antigravity_mcp writes the render's own value of each variable above into
# the file, and a render from inside an engineer job would have fixed
# `LOAM_WAKE=engineer:<job>` into every later Antigravity brief.
RUN_TIME_ONLY_VARS = {"LOAM_WAKE"}


def _toml(value) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, (list, tuple)):
        return "[" + ", ".join(_toml(v) for v in value) + "]"
    if isinstance(value, dict):
        return "{ " + ", ".join(f"{_toml_key(k)} = {_toml(v)}"
                                for k, v in value.items()) + " }"
    return json.dumps(str(value), ensure_ascii=False)


def _toml_key(key: str) -> str:
    return key if re.fullmatch(r"[A-Za-z0-9_-]+", key) else json.dumps(key)




# The hook events codex_config carries over from the Claude settings. Codex
# has no SessionEnd; its Stop fires at the end of every turn, as Claude's does.
CODEX_HOOK_EVENTS = ("PostToolUse", "Stop")


def codex_config(name: str, workspace: Path) -> str:
    claude = settings(workspace)
    deny = claude["permissions"]["deny"]
    out = [
        "# Rendered by bin/provision --codex from the sources of .mcp.json and",
        "# .claude/settings.json. The runtime's, how the persona is assembled;",
        "# a hand-edit is drift and bin/check-drift says so.",
        "",
        f"model_instructions_file = {_toml(CODEX_HOME / 'instructions' / f'{name}.md')}",
        'approval_policy = "never"',
        'sandbox_mode = "danger-full-access"',
        'web_search = "live"',
        "",
        # Keep account connectors separate from the workspace's configured tool set.
        "[features]",
        "apps = false",
        # Enable interactive questions in ordinary conversations so the page can render their
        # answers.
        "default_mode_request_user_input = true",
        "",
    ]

    for server, spec in mcp_config(name, workspace)["mcpServers"].items():
        out.append(f"[mcp_servers.{_toml_key(server)}]")
        if spec.get("type") == "http":
            out.append(f"url = {_toml(spec['url'])}")
        else:
            out.append(f"command = {_toml(spec['command'])}")
            out.append(f"args = {_toml(spec.get('args', []))}")
        if "timeout" in spec:
            # .mcp.json's `timeout` is milliseconds for a tool call.
            out.append(f"tool_timeout_sec = {spec['timeout'] // 1000}")
        # A tool the Claude settings deny by full name is disabled here.
        prefix = f"mcp__{server}__"
        off = [d[len(prefix):] for d in deny if d.startswith(prefix)]
        if off:
            out.append(f"disabled_tools = {_toml(off)}")
        # Derive the provider's per-tool settings from its declared server capabilities.
        out.append('default_tools_approval_mode = "approve"')
        if spec.get("env"):
            out.append(f"env = {_toml(spec['env'])}")
        if server in CODEX_ENV_VARS:
            out.append(f"env_vars = {_toml(CODEX_ENV_VARS[server])}")
        out.append("")

    # The same hook scripts, one rule with two callers. SessionEnd has no
    # Codex event; Stop fires at the end of every turn, which is when the
    # Claude Stop hook writes too.
    for event, groups in claude["hooks"].items():
        if event not in CODEX_HOOK_EVENTS:
            continue
        for group in groups:
            out.append(f"[[hooks.{event}]]")
            if "matcher" in group:
                out.append(f"matcher = {_toml(group['matcher'])}")
            out.append("")
            for hook in group["hooks"]:
                out += [f"[[hooks.{event}.hooks]]",
                        f"type = {_toml(hook['type'])}",
                        f"command = {_toml(hook['command'])}",
                        f"timeout = {hook['timeout']}", ""]
    return "\n".join(out).rstrip() + "\n"


def provision_codex(names: list[str], dry: bool = False) -> None:
    """Write `.codex/` for each named persona, or every provisioned one:
    `config.toml` and `skills -> ../skills`, as `.claude/` has it."""
    if not names:
        names = sorted(p.parent.name for p in AI_LABS.glob("*/agent.json"))
    for name in names:
        workspace = AI_LABS / name
        if not (workspace / "agent.json").is_file():
            die(f"no provisioned agent at {workspace}")
        text = codex_config(name, workspace)
        if dry:
            print(f"[dry-run] {workspace}/.codex/config.toml ({len(text)}B)")
            continue
        (workspace / ".codex").mkdir(exist_ok=True)
        changed = write_if_changed(workspace / ".codex" / "config.toml", text)
        link = workspace / ".codex" / "skills"
        if (workspace / "skills").is_dir() and not (
                link.is_symlink() and str(link.readlink()) == "../skills"):
            if link.is_symlink() or link.exists():
                link.unlink()
            link.symlink_to("../skills")
            changed = True
        print(f"  {name}: .codex/ {'written' if changed else 'unchanged'}")


# Render the server configuration and skills in the workspace layout the provider reads.
def antigravity_mcp(name: str, workspace: Path) -> dict:
    out = {}
    for server, spec in mcp_config(name, workspace)["mcpServers"].items():
        if spec.get("type") == "http":
            entry = {"serverUrl": spec["url"]}
        else:
            entry = {"command": spec["command"], "args": spec.get("args", [])}
            env = dict(spec.get("env") or {})
            if server in CODEX_ENV_VARS:
                for var in CODEX_ENV_VARS[server]:
                    if var in RUN_TIME_ONLY_VARS:
                        continue
                    if os.environ.get(var):
                        env[var] = os.environ[var]
            if env:
                entry["env"] = env
        if "timeout" in spec:
            entry["timeoutSeconds"] = spec["timeout"] // 1000
        out[server] = entry
    return {"mcpServers": out}


def provision_antigravity(names: list[str], dry: bool = False) -> None:
    if not names:
        names = sorted(p.parent.name for p in AI_LABS.glob("*/agent.json"))
    for name in names:
        workspace = AI_LABS / name
        if not (workspace / "agent.json").is_file():
            die(f"no provisioned agent at {workspace}")
        text = json.dumps(antigravity_mcp(name, workspace), indent=2) + "\n"
        if dry:
            print(f"[dry-run] {workspace}/.agents/mcp_config.json ({len(text)}B)")
            continue
        (workspace / ".agents").mkdir(exist_ok=True)
        changed = write_if_changed(workspace / ".agents" / "mcp_config.json", text)
        # A personal skill takes precedence over a shared skill with the same name.
        if loam_skills.render_view(workspace):
            changed = True
        print(f"  {name}: .agents/ {'written' if changed else 'unchanged'}")




def write_if_changed(path: Path, content: str) -> bool:
    """Never rewrite a file with content it already has.

    Provisioning a sixth agent must leave the five live ones alone, and an
    identical-content rewrite still bumps mtime, still shows up in `git
    status`, and still invites a needless daemon-reload.
    """
    if path.exists() and path.read_text(encoding="utf-8") == content:
        print(f"  unchanged {path}")
        return False
    path.write_text(content, encoding="utf-8")
    print(f"  wrote {path}")
    return True


USER_SETTINGS = lc.CLAUDE_HOME / "settings.json"

# All launch paths read these user settings, including interactive runs. check-drift
# compares against this same mapping. Keep the shared executable pinned and pause on a
# model refusal while allowing the CLI to report it. Disable account skill and plugin
# sync at user scope so unrelated account changes cannot alter every persona's tools.
USER_SETTINGS_CLAUSES: dict = {
    "env": {"DISABLE_AUTOUPDATER": "1", **provider_memory.CLAUDE_ENV},
    "switchModelsOnFlag": False,
    "syncClaudeAiSkills": False,
    "syncClaudeAiPlugins": False,
    # Claude Code's own memory, off (first release L8): auto memory and the
    # background consolidation, which follows a server-side default unless
    # set. lib/loam_provider_memory.py owns the values.
    **provider_memory.CLAUDE_SETTINGS,
}


def user_settings_gaps(live: dict) -> list[str]:
    """Which clauses of USER_SETTINGS_CLAUSES the live settings do not hold.

    One level of nesting is all the clauses use, and all they may use: `env`
    merges key by key because the CLI and its own migrations write into that
    block too, and replacing it wholesale would drop whatever they put there.
    """
    gaps = []
    for key, wanted in USER_SETTINGS_CLAUSES.items():
        if isinstance(wanted, dict):
            have = live.get(key) or {}
            gaps += [f"{key}.{k}" for k, v in wanted.items() if have.get(k) != v]
        elif live.get(key) != wanted:
            gaps.append(key)
    return gaps


def ensure_user_settings() -> None:
    """Apply USER_SETTINGS_CLAUSES to ~/.claude/settings.json.

    Same write discipline as ensure_trust: never write when it is already
    right, and replace atomically. This file is smaller and less contended
    than ~/.claude.json, but it is read by every live session and a partial
    read would take the whole settings file down with it.
    """
    try:
        settings = json.loads(USER_SETTINGS.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        settings = {}
    gaps = user_settings_gaps(settings)
    if not gaps:
        print("  user settings clauses already held; file untouched")
        return
    for key, wanted in USER_SETTINGS_CLAUSES.items():
        if isinstance(wanted, dict):
            settings[key] = {**(settings.get(key) or {}), **wanted}
        else:
            settings[key] = wanted
    # Create the provider directory for a fresh install before sign-in.
    USER_SETTINGS.parent.mkdir(parents=True, exist_ok=True)
    tmp = USER_SETTINGS.with_name(USER_SETTINGS.name + ".provision-tmp")
    tmp.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, USER_SETTINGS)
    print(f"  user settings: applied {', '.join(gaps)} "
          f"in {USER_SETTINGS} (atomic replace)")


MANAGED_SETTINGS = Path("/etc/claude-code/managed-settings.json")

# Machine-managed settings must be installed with their required owner and mode.
MANAGED_SETTINGS_TEXT = """\
{
  "pluginConfigs": {
    "cc-plugin-sec-default@builtin": {
      "options": { "allowManagedModsOnly": true }
    }
  }
}
"""


def install_managed_settings(dry: bool) -> None:
    """Install MANAGED_SETTINGS_TEXT at /etc as root, 0644, when it differs.
    Staged under state/ and moved in by `sudo install`, which replaces the
    file whole, so a CLI starting meanwhile reads the old file or the new."""
    try:
        if MANAGED_SETTINGS.read_text(encoding="utf-8") == MANAGED_SETTINGS_TEXT:
            print(f"  {MANAGED_SETTINGS} already holds the generator's bytes; untouched")
            return
    except OSError:
        pass
    if dry:
        print(f"  [dry-run] would install {MANAGED_SETTINGS}")
        return
    stage = lc.STATE / f"managed-settings.{os.getpid()}.json"
    stage.write_text(MANAGED_SETTINGS_TEXT, encoding="utf-8")
    try:
        subprocess.run(["sudo", "-n", "install", "-D", "-o", "root", "-g", "root",
                        "-m", "0644", str(stage), str(MANAGED_SETTINGS)], check=True)
    finally:
        stage.unlink(missing_ok=True)
    print(f"  installed {MANAGED_SETTINGS} (root 0644)")


# Grant repository trust and approval for external instruction imports.
TRUST_FLAGS = ("hasTrustDialogAccepted", "hasClaudeMdExternalIncludesApproved",
               "hasClaudeMdExternalIncludesWarningShown")


def ensure_trust(workspace: Path, *extra: Path) -> None:
    """Grant trust at the repository root and preserve concurrent session updates to the
    user configuration."""
    wanted = tuple(dict.fromkeys(
        [str(AI_LABS), str(workspace)] + [str(p) for p in extra]))
    # A fresh install may not have a provider configuration file yet.
    if not CLAUDE_JSON.exists():
        CLAUDE_JSON.write_text("{}\n", encoding="utf-8")
    for attempt in range(3):
        stat_before = CLAUDE_JSON.stat()
        cfg = json.loads(CLAUDE_JSON.read_text())
        projects = cfg.setdefault("projects", {})
        missing = [
            key for key in wanted
            if not all(projects.get(key, {}).get(flag) for flag in TRUST_FLAGS)
        ]
        if not missing:
            print("  trust already accepted; ~/.claude.json untouched")
            return
        for key in missing:
            projects.setdefault(key, {}).update({flag: True for flag in TRUST_FLAGS})
        stat_now = CLAUDE_JSON.stat()
        if (stat_now.st_mtime_ns, stat_now.st_size) != (
            stat_before.st_mtime_ns, stat_before.st_size
        ):
            continue  # a live session wrote while we were reading; re-read
        tmp = CLAUDE_JSON.with_name(CLAUDE_JSON.name + ".provision-tmp")
        tmp.write_text(json.dumps(cfg, indent=2))
        os.replace(tmp, CLAUDE_JSON)
        print(f"  trust granted for {', '.join(missing)} (atomic replace)")
        return
    die(
        "~/.claude.json is being rewritten by live sessions faster than this "
        "can safely update it. Retry when the box is quieter."
    )


NONE_STYLE = """\
---
name: none
description: Operator-owned empty style. Wakes select it so the conversation lane does not load.
keep-coding-instructions: true
---
"""


def render_persona_loading(workspace: Path, display: str) -> None:
    import loam_loading  # noqa: PLC0415
    if loam_loading.ensure_owner_page():
        print(f"  made {loam_loading.owner_page()}")
    write_if_changed(workspace / "CLAUDE.md", claude_md(display, workspace))
    styles = workspace / ".claude" / "output-styles"
    styles.mkdir(parents=True, exist_ok=True)
    write_if_changed(workspace / ".claude" / "settings.json",
                     json.dumps(settings(workspace), indent=2) + "\n")
    write_if_changed(styles / "none.md", NONE_STYLE)


# Platform engineer provisioning

ENGINEER = AGENTS / "engineer"

# The two operator-authored halves, and where they are settled. They are
# COPIED verbatim -- byte-for-byte, frontmatter and all -- and never composed,
# rewritten or trimmed. `role.md` is one source for every engineer; the
# project file is this engineer's own. check-drift diffs both against these
# paths, so an edit to the vault copy shows up as drift here rather than as a
# divergence nobody notices.
ENGINEER_ROLE_SRC = VAULT / lc.vault_folder("projects") / "Loam" / "engineer" / "role.md"
ENGINEER_PROJECT_SRC = (
    VAULT / lc.vault_folder("projects") / "Loam" / "engineer" / "projects" / "loam.md"
)

# Installed systems use the shipped engineer files when development sources are
# unavailable.
ENGINEER_SHIPPED = AGENTS / "engineer" / "install"
ENGINEER_SEEDS = (("role.md", ENGINEER_ROLE_SRC), ("project.md", ENGINEER_PROJECT_SRC))
ENGINEER_SEEDED = lc.STATE / "engineer" / "seeded.json"

# Keep the engineer's role, project and shared reach imports in their load order.
ENGINEER_CLAUDE_MD = f"@role.md\n\n@project.md\n\n@{REACH}\n"

# Two lines of operator voice, and then it is the engineer's. Nobody else
# writes in here -- not provision, not a persona, not the operator session.
# It is committed with the repo (decision 21), so it is written for a reader
# who has never met this box.
ENGINEER_MEMORY_HEADER = """\
This is the runtime's memory of itself, written by the platform engineer and
by nobody else. What was found by building, which premises expired when, and
what a rebuild costs.
"""


def engineer_settings() -> dict:
    ws = str(ENGINEER)
    return {
        # Provision and launch the engineer with the same model pin.
        "model": ENGINEER_MODEL,
        "permissions": {
            "defaultMode": "acceptEdits",
            # The platform project root is the engineer/ subdirectory. Its runtime source and tools
            # live in the parent checkout.
            "additionalDirectories": [str(AGENTS), str(VAULT), str(AI_LABS),
                                      str(lc.PLUGINS)],
            "deny": [
                f"Edit(//{VAULT}/{lc.vault_folder('conversations')}/**)".replace("///", "//"),
                # Operator-authored, and the engineer's own composition. It
                # may not edit what it is. `role.md` and `project.md` are
                # settled with the owner and copied verbatim; an engineer that
                # could rewrite its own role has no role.
                f"Edit(//{ws}/CLAUDE.md)".replace("///", "//"),
                f"Edit(//{ws}/role.md)".replace("///", "//"),
                f"Edit(//{ws}/project.md)".replace("///", "//"),
                f"Edit(//{ws}/agent.json)".replace("///", "//"),
                f"Edit(//{ws}/.claude/**)".replace("///", "//"),
                # The operator's file of public apps (Move 10, decision 8).
                # The owner writes it; the engineer reads it through the
                # generator and never writes it. Outside the engineer's three
                # roots anyway, so the boundary guard refuses it too -- this
                # is the declarative, non-promptable form of the same rule.
                # Bash can still `tee` it, and that line is held by
                # engineer/role.md and nothing mechanical.
                f"Edit(//{loam_deploy.PUBLIC_FILE})".replace("///", "//"),
                f"Write(//{loam_deploy.PUBLIC_FILE})".replace("///", "//"),
                # Same three as every persona, and for a stronger reason
                # here: this is the one project on the box that COULD arrange
                # its own future execution, because it has Bash and sudo. It
                # is reachable only in conversation (decision 7) and that has
                # to be true by construction rather than by nobody trying.
                "CronCreate",
                "CronDelete",
                "ScheduleWakeup",
                "RemoteTrigger",
            ],
            # The engineer's role requires shell access in addition to file edits.
            "allow": [
                "Bash",
                "BashOutput",
                "KillShell",
                "WebSearch",
                "WebFetch",
            # Explicit, not left to the permission mode, and that is the
            # whole reason it is here. An unallowed tool call in a headless
            # job raises a permission prompt with nobody to answer it, and
            # such a prompt has no timeout -- the job would sit until its
            # wall clock rather than fail. A refusal would be safe; a hang is
            # not, and the wall clock is what bounds the cost of fanning out.
            "Task",
            ],
        },
        # `/schedule` creates recurring runs on Anthropic's infrastructure and
        # `/loop` re-runs a prompt on an interval. Skills are not tools, so the
        # deny list above cannot reach them, and both reopen exactly the door
        # decision 7 closes.
        "skillOverrides": {
            "schedule": "off",
            "loop": "off",
        },
        "disableClaudeAiConnectors": True,
        # No MCP servers. The engineer has Bash; a tool that wraps a shell
        # command for an agent that already has the shell is a second way to
        # be wrong. It is also, deliberately, not given the engineer tool --
        # an engineer cannot brief an engineer.
        "enableAllProjectMcpServers": False,
        "autoMemoryEnabled": False,
        # ONE hook, and the absence of the other two is the design.
        #
        # `transcript_capture.py` is NOT here. An engineer job is not a
        # conversation: nobody is on the other side of it, and its durable
        # record is the receipt, which lands in the vault under the project
        # it belongs to. Filing it under `15_CONVERSATIONS/` would put a
        # build log in the record of what the owner and their personas said to
        # each other. Two things keep it out and either would do: the hook is
        # not registered here, and bin/engineer-job sets
        # `LOAM_WAKE=engineer:<job-id>`, which the hook's own gate refuses
        # (it files only when the value is exactly "conversation"). Belt and
        # braces, because the failure is silent and permanent.
        "hooks": {
            "PreToolUse": [{"matcher": "*", "hooks": [
                _guard_hook()]}],
        },
    }


def engineer_config() -> dict:
    """`agent.json` for a project that is not an agent.

    Same filename on purpose: `lib/loam_memory.load_config` and the
    PreToolUse guard both read `agent.json` from the project root, and giving
    the engineer a differently-named file would mean a second reader in the
    one place that must never guess wrong about who is calling. `kind` is
    what the guard branches on; `project` is the vault folder its receipts
    land under.
    """
    return {
        "name": "engineer",
        "kind": "engineer",
        "display": "Engineer",
        "project": "Loam",
        "workspace": str(ENGINEER),
        "vault": str(VAULT),
        "ai_labs": str(AI_LABS),
    }


def _sha(text: str) -> str:
    import hashlib  # noqa: PLC0415
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def seed_engineer_sources(dry: bool = False) -> dict[str, str]:
    """The vault's role and project file for the engineer, from what this
    release ships. Returns {name: what happened}: `seeded` (there was none),
    `current`, `updated` (still the last seeded text, now the new one), or
    `kept` (the owner's own: changed since seeding, or never seeded here).
    """
    try:
        record = json.loads(ENGINEER_SEEDED.read_text(encoding="utf-8"))
        record = record if isinstance(record, dict) else {}
    except (OSError, ValueError):
        record = {}
    said: dict[str, str] = {}
    for name, dst in ENGINEER_SEEDS:
        src = ENGINEER_SHIPPED / name
        if not src.is_file():
            continue
        shipped = src.read_text(encoding="utf-8")
        if not dst.exists():
            said[name] = "seeded"
        else:
            have = _sha(dst.read_text(encoding="utf-8"))
            if have == _sha(shipped):
                said[name] = "current"
            elif record.get(name) == have:
                said[name] = "updated"
            else:
                said[name] = "kept"
        if said[name] in ("seeded", "updated"):
            print(f"  {said[name]} {dst} from {src}")
            if not dry:
                dst.parent.mkdir(parents=True, exist_ok=True)
                dst.write_text(shipped, encoding="utf-8")
                record[name] = _sha(shipped)
        elif said[name] == "current":
            record[name] = _sha(shipped)
        else:
            print(f"  kept {dst}: it is this install's own, not the text "
                  f"{src} ships")
    if not dry and said:
        ENGINEER_SEEDED.parent.mkdir(parents=True, exist_ok=True)
        text = json.dumps(record, indent=2, sort_keys=True) + "\n"
        if not ENGINEER_SEEDED.exists() or ENGINEER_SEEDED.read_text(encoding="utf-8") != text:
            ENGINEER_SEEDED.write_text(text, encoding="utf-8")
    return said


def ensure_engineer_excluded() -> None:
    """The engineer's rendered files are never the repository's: on the
    install's own checkout they sit in `info/exclude`, so `git status` shows
    nothing and an update reads the tree as clean (the first install's
    exclude carried them by hand since first release L16)."""
    done = subprocess.run(["git", "-C", str(AGENTS), "rev-parse", "--git-common-dir"],
                          capture_output=True, text=True, check=False)
    if done.returncode:
        return
    common = Path(done.stdout.strip())
    exclude = (common if common.is_absolute() else AGENTS / common) / "info" / "exclude"
    have = exclude.read_text(encoding="utf-8") if exclude.is_file() else ""
    lines = [f"/{name}" for name in (*lc.ENGINEER_HARNESS, *lc.REVIEWER_HARNESS)]
    missing = [ln for ln in lines if ln not in have.splitlines()]
    if not missing:
        return
    exclude.parent.mkdir(parents=True, exist_ok=True)
    exclude.write_text(
        have + ("" if not have or have.endswith("\n") else "\n")
        + "# bin/provision --engineer: the engineer's rendered files.\n"
        + "".join(f"{ln}\n" for ln in missing), encoding="utf-8")
    print(f"  excluded {', '.join(missing)} in {exclude}")


# A release checkout can lack Git identity. Seed the engineer's fallback identity
# before its first commit.
ENGINEER_GIT_NAME = "Loam engineer"
ENGINEER_GIT_EMAIL = "engineer+loam@noreply.local"


def ensure_engineer_identity() -> None:
    def get(key: str) -> str:
        return subprocess.run(["git", "-C", str(AGENTS), "config", key],
                              capture_output=True, text=True, check=False).stdout.strip()
    if subprocess.run(["git", "-C", str(AGENTS), "rev-parse", "--git-dir"],
                      capture_output=True, check=False).returncode:
        return
    if get("user.name") and get("user.email"):
        return
    for key, value in (("user.name", ENGINEER_GIT_NAME), ("user.email", ENGINEER_GIT_EMAIL)):
        subprocess.run(["git", "-C", str(AGENTS), "config", "--local", key, value], check=True)
    print(f"  the checkout commits as {ENGINEER_GIT_NAME} <{ENGINEER_GIT_EMAIL}>")


def ensure_engineer() -> None:
    """Provision the platform engineer alongside agents so an existing install gains updated
    engineer files."""
    if not (ENGINEER_SHIPPED / "role.md").is_file():
        return
    try:
        provision_engineer()
    except (Exception, SystemExit) as exc:  # noqa: BLE001
        print(f"  the engineer was not provisioned: {exc}", file=sys.stderr)


def provision_engineer(dry: bool = False) -> None:
    print(f"engineer project at {ENGINEER}")
    seed_engineer_sources(dry)
    def source(dst: Path, name: str) -> Path:
        # A dry run seeds nothing, so it reads what a real run would write.
        return dst if dst.is_file() or not dry else ENGINEER_SHIPPED / name
    role_src = source(ENGINEER_ROLE_SRC, "role.md")
    project_src = source(ENGINEER_PROJECT_SRC, "project.md")
    for src in (role_src, project_src):
        if not src.is_file():
            die(f"{src} is missing; refusing to provision the engineer")
    role = role_src.read_text(encoding="utf-8")
    project = project_src.read_text(encoding="utf-8")
    print(f"  role={role_src} ({len(role):,} chars)")
    print(f"  project={project_src} ({len(project):,} chars)")
    if dry:
        print("  [dry-run] no files written")
        return

    (ENGINEER / ".claude").mkdir(parents=True, exist_ok=True)
    (ENGINEER / "memory").mkdir(parents=True, exist_ok=True)
    lc.JOBS.mkdir(parents=True, exist_ok=True)
    ensure_engineer_excluded()
    ensure_engineer_identity()

    # Verbatim, both of them. write_if_changed rather than an unconditional
    # copy so a re-provision that changes nothing leaves no mtime behind.
    write_if_changed(ENGINEER / "role.md", role)
    write_if_changed(ENGINEER / "project.md", project)
    write_if_changed(ENGINEER / "CLAUDE.md", ENGINEER_CLAUDE_MD)
    write_if_changed(ENGINEER / "agent.json",
                     json.dumps(engineer_config(), indent=2) + "\n")
    write_if_changed(ENGINEER / ".claude" / "settings.json",
                     json.dumps(engineer_settings(), indent=2) + "\n")

    # Written once and then the engineer's.
    # if it exists it belongs to the engineer from then on.
    index = ENGINEER / "memory" / "MEMORY.md"
    if index.exists():
        print(f"  unchanged {index} (engineer-owned)")
    else:
        index.write_text(ENGINEER_MEMORY_HEADER, encoding="utf-8")
        print(f"  seeded {index}")

    provision_app_scope(role)

    # Trust the repository root so the provider honors the engineer's additional working
    # directories.
    ensure_trust(ENGINEER, AGENTS)
    # Box-wide, so every provision path applies them: the clauses hold for
    # this lane as much as for a persona's, and `--engineer` is a command
    # that gets run on its own.
    ensure_user_settings()
    print(f"  provisioned the engineer: project files, no units")
    print(f"  it has no timer and no unit of its own — "
          f"bin/engineer-job creates a transient one per job.")


# An app-scoped platform job starts in the app folder of its isolated tree.
APP_PROJECT_SHIPPED = ENGINEER_SHIPPED / "app-project.md"


def app_scope_render(role: str) -> dict[str, str]:
    """What `app/` gets, path -> content. One function so provision writes
    it and check-drift compares against it."""
    return {
        "CLAUDE.md": (TEMPLATE / "CLAUDE.md").read_text(encoding="utf-8"),
        "role.md": role,
        "project.md": APP_PROJECT_SHIPPED.read_text(encoding="utf-8"),
        ".claude/settings.json": json.dumps(project_settings(), indent=2) + "\n",
    }


def provision_app_scope(role: str) -> None:
    import loam_engineer as eng  # noqa: PLC0415
    home = AGENTS / eng.APP_SCOPE
    if not (home / "package.json").is_file() or not APP_PROJECT_SHIPPED.is_file():
        return
    if harness_tracked(AGENTS, eng.APP_SCOPE):
        print(f"  {home} commits its harness; left alone")
        return
    for rel, content in app_scope_render(role).items():
        target = home / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        write_if_changed(target, content)
    if exclude_harness(AGENTS, eng.APP_SCOPE):
        print(f"  excluded the app-only scope's harness in {AGENTS / '.git/info/exclude'}")


# Reviewer provisioning

REVIEWER = AGENTS / "reviewer"
# Copy the reviewer instructions from the enabled plugin.
REVIEWER_INSTRUCTIONS_SRC = AGENTS / "plugins" / "reviewer" / "instructions.md"
REVIEWER_STATE = lc.REVIEWER_STATE
REVIEWER_MODEL = "fable"      # the personas' tier: the job is judging prose
HISTORY_SERVER_NAME = "history"


def reviewer_settings() -> dict:
    ws = str(REVIEWER)
    return {
        "model": REVIEWER_MODEL,
        "permissions": {
            "defaultMode": "acceptEdits",
            # Read reach: every persona's workspace, the commons and the
            # vault. Write reach: the state directory and nothing else. The
            # grants below make the first true; the deny rules make the
            # second true, and they are the non-promptable kind -- the
            # operator's public-apps file in Move 10 is the precedent.
            "additionalDirectories": [str(AI_LABS), str(VAULT), str(REVIEWER_STATE)],
            "deny": [
                # The whole of ai-labs, the commons included. Deny beats
                # allow and there is no negation, so a carve-out for
                # `commons/<agent>/inbox/` cannot be declared; enumerating
                # the personas instead would be a roster written down, the
                # thing the boundary guard exists to avoid. So the reviewer
                # writes its note into its OWN outbox and bin/review, which
                # is not the model, delivers it. That is the trade: a total
                # deny and a postman, rather than a partial deny and trust.
                f"Edit(//{AI_LABS}/**)".replace("///", "//"),
                f"Write(//{AI_LABS}/**)".replace("///", "//"),
                f"Edit(//{VAULT}/**)".replace("///", "//"),
                f"Write(//{VAULT}/**)".replace("///", "//"),
                # The transcripts. The owner scoped the reviewer to what a
                # persona wrote about itself, not what it said in
                # conversation (Move 11 prompt, §What it reads); the
                # instruction file says so, and this is the wall behind the
                # sentence. Every other agent's deny on this path fences
                # writes; the reviewer's fences reads too.
                f"Read(//{VAULT}/{lc.vault_folder('conversations')}/**)".replace("///", "//"),
                # Its own home: the instruction file, this settings file,
                # agent.json. It may not edit what it is.
                f"Edit(//{ws}/**)".replace("///", "//"),
                f"Write(//{ws}/**)".replace("///", "//"),
                "NotebookEdit",
                # No hands. Bash would route around every rule above; the
                # web and subagents are not this job; scheduling is the
                # operator's, as for every agent.
                "Bash",
                "BashOutput",
                "KillShell",
                "WebSearch",
                "WebFetch",
                "Task",
                "CronCreate",
                "CronDelete",
                "ScheduleWakeup",
                "RemoteTrigger",
            ],
            # Register all tools contributed by the history server.
            "allow": [f"mcp__{HISTORY_SERVER_NAME}"],
        },
        "skillOverrides": {"schedule": "off", "loop": "off"},
        "disableClaudeAiConnectors": True,
        "enableAllProjectMcpServers": True,
        "autoMemoryEnabled": False,
        # The guard, for the refusal text and for any write tool the deny
        # rules do not name. No transcript hook: a review is not a
        # conversation, and bin/review sets LOAM_WAKE so the hook's own gate
        # would refuse it anyway.
        "hooks": {
            "PreToolUse": [{"matcher": "*", "hooks": [
                _guard_hook()]}],
        },
    }


def reviewer_config() -> dict:
    """`agent.json` for the reviewer. `kind` is what the guard branches on;
    `state` is the one directory it may write."""
    return {
        "name": "reviewer",
        "kind": "reviewer",
        "display": "Reviewer",
        "workspace": str(REVIEWER),
        "state": str(REVIEWER_STATE),
        "vault": str(VAULT),
        "ai_labs": str(AI_LABS),
    }


def reviewer_mcp_config() -> dict:
    """One server: read-only git history of ai-labs (mcp/history_server.py).
    A shell cannot be made read-only, and provenance is a fact source the
    reviewer must have."""
    return {
        "mcpServers": {
            HISTORY_SERVER_NAME: {
                # The shim, not the venv: this file is committed (reviewer/),
                # and the venv's place is the install's (lib/loam_config.py).
                "command": f"{AGENTS}/bin/mcp-python",
                "args": [f"{AGENTS}/mcp/history_server.py"],
                "env": {"LOAM_HISTORY_REPO": str(AI_LABS)},
            },
        }
    }


def reviewer_instructions() -> str:
    """Fill the reviewer plugin's path placeholders with the locations for this install."""
    text = REVIEWER_INSTRUCTIONS_SRC.read_text(encoding="utf-8")
    for key, value in (("@WORKSPACES@", AI_LABS), ("@VAULT@", VAULT),
                       ("@REVIEWER_STATE@", REVIEWER_STATE), ("@ROOT@", AGENTS)):
        text = text.replace(key, str(value))
    return text


def provision_reviewer(dry: bool = False) -> None:
    print(f"reviewer project at {REVIEWER}")
    instruction = REVIEWER / "CLAUDE.md"
    src = REVIEWER_INSTRUCTIONS_SRC
    if not src.is_file() or not src.read_text(encoding="utf-8").strip():
        die(f"{src} is missing or empty; it is the reviewer's whole behaviour, "
            f"the reviewer plugin's instructions, written by hand")
    print(f"  instruction={instruction} <- {src} ({src.stat().st_size:,}B, the plugin's prose)")
    if dry:
        print("  [dry-run] no files written")
        return
    REVIEWER.mkdir(parents=True, exist_ok=True)
    write_if_changed(instruction, reviewer_instructions())
    (REVIEWER / ".claude").mkdir(parents=True, exist_ok=True)
    for sub in ("memory", "runs", "notes"):
        (REVIEWER_STATE / sub).mkdir(parents=True, exist_ok=True)
    write_if_changed(REVIEWER / "agent.json",
                     json.dumps(reviewer_config(), indent=2) + "\n")
    write_if_changed(REVIEWER / ".mcp.json",
                     json.dumps(reviewer_mcp_config(), indent=2) + "\n")
    write_if_changed(REVIEWER / ".claude" / "settings.json",
                     json.dumps(reviewer_settings(), indent=2) + "\n")
    ensure_trust(REVIEWER, AGENTS)
    ensure_user_settings()
    # The schedule page lists the review lane once its timer is installed;
    # the row is derived from the installed timer, never typed here.
    from loam_cron import write_schedule_page  # noqa: PLC0415
    if write_schedule_page(VAULT):
        print(f"  rewrote {VAULT}/{lc.vault_folder('projects')}/Loam/infrastructure/schedule.md")
    print(f"  provisioned the reviewer: config, settings, one MCP server; "
          f"state under {REVIEWER_STATE} (gitignored)")
    print(f"  its lane is the static unit loam-reviewer.service ({AGENTS}/systemd/, "
          f"bin/gen-units); its timer is the reviewer plugin's, on while it is on")


# ---------------------------------------------------------------------------
# Project engineers. Rendered INTO a project's repo, on a persona's brief, by
# the platform engineer (phase-5 closing plan, decisions 3, 5, 20, 21; the
# Move 9 prompt, section 7).
#
# A project engineer is self-contained: a stranger cloning the repo with
# Claude Code gets the same engineer with nothing from this box present. So
# nothing rendered below may name this runtime, the vault, a persona, the owner
# or this machine -- and `render_craft` refuses to emit output that does.
# What this runtime adds -- the brief, the receipt, the deploy key -- arrives
# at job time from bin/engineer-job, never from the repo.
# ---------------------------------------------------------------------------

TEMPLATE = AGENTS / "engineer-template" / "repo"

# The words a rendered craft file may not contain, whatever role.md says
# tomorrow. This is what makes the rendering safe to run unread: a new line
# in the source that means something only here fails the render loudly
# instead of leaking into every project on the next run.
# The owner's own name joins them when one is configured ("the owner", the
# default, is a phrase the rendered file may use).
CRAFT_FORBIDDEN = (
    *((lc.OWNER_NAME,) if lc.get("owner.name") else ()), "persona", "Loam", "vault", lc.USER, "commons",
    "15_CONVERSATIONS",
)

# Sentence-level substitutions, exact. Each maps a sentence of role.md in its
# runtime form to the same sentence for an engineer whose whole world is its
# repo. Exact rather than word-level because "his" and "him" cannot be
# replaced mechanically without reading the sentence, and a rendering that
# guessed at pronouns would misgender the project owner in every repo. When
# role.md changes one of these sentences the substitution misses, the
# forbidden-word check fails, and the table is updated by hand -- which is
# the one moment a human should be reading the output anyway.
CRAFT_SUBSTITUTIONS = tuple((a.replace("@OWNER@", lc.OWNER_NAME), b) for a, b in (
    ('"Needs @OWNER@\'s input" goes back to the persona, who asks him.',
     '"Needs the project owner\'s input" goes back to whoever briefed you, '
     'who asks them.'),
    ("Default: go and do the thing, @OWNER@ reviews after it is running. The "
     "brief can loosen or tighten it for one job on his say-so, and the "
     "receipt records his words.",
     "Default: go and do the thing, the project owner reviews after it is "
     "running. The brief can loosen or tighten it for one job on their "
     "say-so, and the receipt records their words."),
    ("The persona never does this and @OWNER@ never has to.",
     "Whoever briefed you never does this and the project owner never has to."),
    ("Expose anything publicly without @OWNER@'s direct yes.** Behind the "
     "login is free: private and shared exposure on the persona's brief, and "
     "an agent's own subdomain needs nobody's word. Anything reachable on the "
     "open web without the login: ask @OWNER@ first, and act only on his "
     "direct yes, which the brief quotes with its date; a yes for one thing "
     "is not a yes for the next. A repo's visibility is exposure: you create "
     "private, and make one public only on that same yes. *(@OWNER@, "
     "2026-11-08: anything reachable on the open web without the login waits "
     "for his yes each time. It replaces \"public is @OWNER@'s hands only\" "
     "of 2026-09-05.)*",
     "Expose anything publicly without the project owner's direct yes.** "
     "Private and shared exposure on the brief of whoever briefed you. "
     "Anything reachable on the open web without a login: the owner is asked "
     "first, and you act only on their direct yes, which the brief quotes "
     "with its date; a yes for one thing is not a yes for the next. A repo's "
     "visibility is exposure: you create private, and make one public only "
     "on that same yes."),
    # Scope the standing publication grant to the platform engineer and the approved
    # repositories.
    (" @OWNER@'s standing yes (2026-11-18 17:20 PT): a new version of a "
     "plugin that is already public in `loamhq/plugins` and already listed "
     "in the marketplace may be tagged and its listing moved to it without "
     "asking him again, when the brief says it is such a version. It does "
     "not cover anything new to the public: a new plugin, repo or listing, "
     "or a new version that widens what the plugin touches or reaches (its "
     "declared permissions, network, files or keys). Those still wait for "
     "his direct yes, quoted with its date. *(@OWNER@, 2026-11-18 17:20 PT, "
     "in thread t-6daf5a6f, answering whether to give it: \"Agreed. yes\".)*",
     ""),
    ("Write a credential into an image, a repo, or the vault.",
     "Write a credential into an image, a repo, or the project's documentation."),
    ("Nothing in the project depends on the vault, on Loam, or on a persona "
     "existing. Loam is how the project gets its hands today; the project "
     "must not know that.",
     "Nothing in the project depends on anything outside the repo."),
    ("A brief from a persona is not a message that evaporates",
     "A brief is not a message that evaporates"),
    ("never about @OWNER@ or the personas",
     "never about the project owner or whoever briefs you"),
    ("a decision for @OWNER@", "a decision for the project owner"),
))

# Keep generated project harness files local to their checkout through the repository's
# exclude file.
HARNESS_PATHS = ("CLAUDE.md", "role.md", "project.md", "memory/", ".claude/")

CRAFT_UNTRACKED_SUBSTITUTIONS = (
    ("the design and its decisions, how to build and run it, and your own "
     "memory of the project.",
     "the design and its decisions, and how to build and run it."),
    ("**Your memory lives in the repo**, committed with the code, readable "
     "by any contributor.",
     "**Your memory lives in your working copy**, in `memory/`, and is never "
     "committed: like this file, it is excluded from the repository, which "
     "carries the project and nothing about how it is worked on."),
)

# Paragraphs of "What you are" that are the role in its runtime form and are
# replaced, not rendered. Matched on their opening words.
CRAFT_DROP_PARAGRAPHS = (
    "You are an engineer for Loam",
    "You are not a persona.",
    "**You have no vault.**",
)

# Bullets of "What you never do" that only mean something inside this
# runtime. Matched on the bold lead. Everything not listed is kept, so a new
# line in the source flows through (or trips the forbidden-word check).
CRAFT_DROP_NEVER = (
    "Author an agent's self",
    f"Reach {lc.OWNER_NAME} directly",
    "Run unattended",
    "Touch `15_CONVERSATIONS/`",
    "Start a wake or cron service",
)

# What replaces the dropped opening. One paragraph for what the engineer is,
# one for its reach. The last sentence of the first is kept from the source's
# second paragraph because it is the whole of what an engineer has.
CRAFT_OPENING = (
    "You are the engineer for this project: the hands of whoever holds it. "
    "You are a Claude Code project with a role, a project file, and a memory "
    "of your project. Whoever holds the project briefs you, you do the work, "
    "you return a receipt. What you have is a standard of evidence.",
    "**Your repo is your whole world.** Your project file names the "
    "repository you work in and what you must leave alone; what you need to "
    "know beyond it arrives in the brief.",
)

# Remove operator-attribution asides when rendering the portable project role.
CRAFT_ATTRIBUTION_RE = re.compile(fr"\s*\*\([^()]*{lc.OWNER_NAME}[^()]*\)\*")

CRAFT_MARK = (
    "*Rendered from the shared engineer role, revision `{rev}`, on {date}. "
    "Generated, never edited by hand: a change belongs in the source and "
    "reaches every project on the next render.*"
)
CRAFT_MARK_RE = re.compile(r"revision `([0-9a-f]+(?:\+dirty)?)`, on (\d{4}-\d{2}-\d{2})")


class CraftError(Exception):
    """The rendering would leak this runtime into a project. Never written."""


def _split_sections(text: str) -> tuple[list[str], list[tuple[str, str]]]:
    """(pre-section lines, [(H2 title, body)]) of a markdown file."""
    text = re.sub(r"\A---\r?\n.*?\r?\n---\r?\n", "", text, count=1, flags=re.DOTALL)
    pre: list[str] = []
    sections: list[tuple[str, list[str]]] = []
    for line in text.splitlines():
        if line.startswith("## "):
            sections.append((line[3:].strip(), []))
        elif sections:
            sections[-1][1].append(line)
        else:
            pre.append(line)
    return pre, [(t, "\n".join(b).strip("\n")) for t, b in sections]


def _paragraphs(body: str) -> list[str]:
    return [p.strip() for p in re.split(r"\n\s*\n", body) if p.strip()]


def render_craft(role_text: str, rev: str, date: str,
                 harness_tracked: bool = False) -> str:
    """The project-neutral half of role.md. Mechanical; refuses to leak.
    `harness_tracked` keeps the memory sentences for a checkout that still
    commits its harness; every new project excludes it."""
    pre, sections = _split_sections(role_text)
    title = next((l for l in pre if l.startswith("# ")), "# The engineer — role file")

    out: list[str] = [title, "", CRAFT_MARK.format(rev=rev, date=date), ""]
    for heading, body in sections:
        out += [f"## {heading}", ""]
        if heading == "What you are":
            kept = [p for p in _paragraphs(body)
                    if not p.startswith(CRAFT_DROP_PARAGRAPHS)]
            for para in (*CRAFT_OPENING, *kept):
                out += [para, ""]
        elif heading == "What you never do":
            # One bullet per line in the source, no blank lines between, so
            # paragraphs are the wrong unit here; a bullet is a line that
            # starts with "- " plus any continuation lines under it.
            items: list[list[str]] = []
            for line in body.splitlines():
                if line.startswith("- ") or not items:
                    items.append([line])
                else:
                    items[-1].append(line)
            for item in items:
                lead = re.match(r"-\s+\*\*(.+?)[.:]?\*\*", item[0])
                if lead and lead.group(1).startswith(CRAFT_DROP_NEVER):
                    continue
                out.extend(item)
            out.append("")
        else:
            out += [body, ""]

    text = "\n".join(out).rstrip("\n") + "\n"
    for old, new in CRAFT_SUBSTITUTIONS:
        text = text.replace(old, new)
    if not harness_tracked:
        for old, new in CRAFT_UNTRACKED_SUBSTITUTIONS:
            if old not in text:
                raise CraftError(
                    f"role.md no longer carries the sentence "
                    f"CRAFT_UNTRACKED_SUBSTITUTIONS replaces ({old[:60]!r}…), "
                    f"so the render would say the memory is committed or say "
                    f"nothing. Nothing written. Update the table in bin/provision.")
            text = text.replace(old, new)
    text = CRAFT_ATTRIBUTION_RE.sub("", text)

    leaks = [
        (n, line) for n, line in enumerate(text.splitlines(), 1)
        if any(w.lower() in line.lower() for w in CRAFT_FORBIDDEN)
    ]
    if leaks:
        shown = "\n".join(f"  line {n}: {line[:120]}" for n, line in leaks[:6])
        raise CraftError(
            f"the rendered role still names this runtime on {len(leaks)} "
            f"line(s); role.md has changed in a way CRAFT_SUBSTITUTIONS does "
            f"not cover. Nothing written. Update the table in bin/provision "
            f"and re-run.\n{shown}")
    return text


def craft_source_rev() -> str:
    """The vault commit that last touched role.md, `+dirty` if the working
    copy differs from it. This is what the mark records, so a reader of a
    rendered copy can find the exact source it came from."""
    rel = ENGINEER_ROLE_SRC.relative_to(VAULT)
    rev = subprocess.run(
        ["git", "-C", str(VAULT), "log", "-1", "--format=%h", "--", str(rel)],
        capture_output=True, text=True, check=False).stdout.strip() or "unknown"
    dirty = subprocess.run(
        ["git", "-C", str(VAULT), "status", "--porcelain", "--", str(rel)],
        capture_output=True, text=True, check=False).stdout.strip()
    return rev + ("+dirty" if dirty else "")


def craft_mark_of(rendered: str) -> tuple[str, str] | None:
    """(rev, date) read back from a rendered file, for check-drift."""
    m = CRAFT_MARK_RE.search(rendered)
    return (m.group(1), m.group(2)) if m else None


def project_settings() -> dict:
    """Render portable project settings using root-relative paths. Supply install-specific
    guards and job directories at launch."""
    return {
        "permissions": {
            "defaultMode": "acceptEdits",
            "deny": [
                "Edit(/CLAUDE.md)",
                "Edit(/role.md)",
                "Edit(/project.md)",
                "Edit(/.claude/**)",
                "CronCreate",
                "CronDelete",
                "ScheduleWakeup",
                "RemoteTrigger",
            ],
            "allow": [
                "Bash",
                "BashOutput",
                "KillShell",
                "WebSearch",
                "WebFetch",
                "Task",
            ],
        },
        "skillOverrides": {"schedule": "off", "loop": "off"},
        "disableClaudeAiConnectors": True,
        "enableAllProjectMcpServers": False,
        "autoMemoryEnabled": False,
    }


def project_render(name: str, project_file: str | None,
                   rev: str, date: str,
                   harness_tracked: bool = False) -> dict[str, str]:
    """Every file the template puts in a checkout, path -> content. One
    function so provision writes it and check-drift compares against it."""
    shipped = ENGINEER_SHIPPED / "role.md"
    if not ENGINEER_ROLE_SRC.is_file() or (
            shipped.is_file() and ENGINEER_ROLE_SRC.read_text(encoding="utf-8")
            == shipped.read_text(encoding="utf-8")):
        # Use the shipped project engineer role when there is no development role to render.
        die("a project engineer is rendered from the shared engineer role, and "
            "this install's role (the one Loam ships) has no rendering for a "
            "project engineer yet. Nothing was written.")
    role = ENGINEER_ROLE_SRC.read_text(encoding="utf-8")
    skeleton = (TEMPLATE / "project.md").read_text(encoding="utf-8")
    return {
        "CLAUDE.md": (TEMPLATE / "CLAUDE.md").read_text(encoding="utf-8"),
        "role.md": render_craft(role, rev, date, harness_tracked),
        "project.md": project_file if project_file is not None
        else skeleton.replace("{name}", name),
        "memory/MEMORY.md": (TEMPLATE / "memory" / "MEMORY.md").read_text(
            encoding="utf-8"),
        ".claude/settings.json": json.dumps(project_settings(), indent=2) + "\n",
    }


def harness_tracked(checkout: Path, subdir: str | None = None) -> bool:
    """Detect older repositories that still track their harness so reprovisioning preserves
    the existing layout."""
    return subprocess.run(
        ["git", "-C", str(checkout), "ls-files", "--error-unmatch",
         f"{subdir}/role.md" if subdir else "role.md"],
        capture_output=True, text=True, check=False).returncode == 0


EXCLUDE_HEADER = "# This checkout's engineering setup: on disk, never in the repository."


def exclude_harness(checkout: Path, subdir: str | None = None) -> bool:
    """Append HARNESS_PATHS (under a folder project's folder) to
    `.git/info/exclude`, once. True if written."""
    exclude = checkout / ".git" / "info" / "exclude"
    current = exclude.read_text(encoding="utf-8") if exclude.is_file() else ""
    have = {line.strip() for line in current.splitlines()}
    pre = f"/{subdir}" if subdir else ""
    # A folder project's memory is the repository's own (Loam's app keeps
    # `app/memory/` in Loam's history), so it is never excluded.
    paths = [p for p in HARNESS_PATHS if not (subdir and p == "memory/")]
    missing = [f"{pre}/{p}" for p in paths if f"{pre}/{p}" not in have]
    if not missing:
        return False
    exclude.parent.mkdir(parents=True, exist_ok=True)
    block = ([] if EXCLUDE_HEADER in have else [EXCLUDE_HEADER]) + missing
    sep = "" if not current or current.endswith("\n\n") else (
        "\n" if current.endswith("\n") else "\n\n")
    exclude.write_text(current + sep + "\n".join(block) + "\n", encoding="utf-8")
    return True


def readme_stub(name: str) -> str:
    """The first commit of a new project's repository, and all of it."""
    return f"# {name}\n"


def rerender_project(name: str) -> None:
    """Re-render a registered project's generated harness files -- CLAUDE.md,
    role.md, .claude/settings.json -- into its checkout. project.md and the
    memory are not generated and are left alone. Refused for a checkout that
    tracks its harness: there the render is a change to the project's
    repository, which is its engineer's."""
    import loam_engineer as eng  # noqa: PLC0415
    record_path = eng.project_record_path(name)
    if not record_path.is_file():
        die(f"{name} is not registered ({record_path} missing)")
    project = eng.load_project_record(record_path)
    root = project.root
    # A folder project keeps its harness and exclude rules in the same checkout.
    sub = project.subdir
    home = root / sub if sub else root
    if harness_tracked(root, sub):
        die(f"{home} commits its harness; a re-render there changes the "
            f"project's repository, which is its engineer's. Nothing written.")
    rev, date = craft_source_rev(), datetime.now().strftime("%Y-%m-%d")
    files = project_render(name, None, rev, date)
    for rel in ("CLAUDE.md", "role.md", ".claude/settings.json"):
        target = home / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        write_if_changed(target, files[rel])
    if exclude_harness(root, sub):
        print(f"  excluded the harness in {root / '.git/info/exclude'}")


def _parse_repo(url: str) -> tuple[str, str]:
    m = re.match(r"^(?:git@github\.com:|https://github\.com/)([^/]+)/([^/]+?)(?:\.git)?/?$", url)
    if not m:
        die(f"not a GitHub repo url: {url!r} (want git@github.com:owner/name.git "
            f"or https://github.com/owner/name)")
    return m.group(1), m.group(2)


def provision_project(name: str, repo_arg: str, project_file: Path | None,
                      dry: bool = False, *, vault_folder: str | None = None,
                      vault_write: bool = False) -> None:
    """Create or connect the repo, key it, render the engineer into the
    checkout (excluded from the repository), start an empty repo with a
    README stub, register.

    Order matters and each step is reported as it happens, because a persona
    reads this output in a receipt and a failure halfway must say how far it
    got. Nothing is written into the repo before the key exists, and nothing
    is registered before the push has landed.
    """
    import loam_engineer as eng  # noqa: PLC0415
    import loam_github as gh  # noqa: PLC0415

    if not eng.PROJECT_NAME_RE.match(name):
        die(f"project name {name!r}: lowercase letters, digits and hyphens only")
    record_path = eng.project_record_path(name)
    if record_path.exists():
        die(f"{name} is already registered at {record_path}; retire it first")
    checkout = eng.PROJECT_CHECKOUTS / name
    if checkout.exists():
        die(f"{checkout} already exists; refusing to render over it")
    key = Path.home() / ".ssh" / f"loam-project-{name}"
    if key.exists():
        die(f"{key} already exists; refusing to overwrite a key")
    if project_file is not None and not project_file.is_file():
        die(f"no project file at {project_file}")
    explicit_folder = vault_folder
    vault_folder = vault_folder_for(name, vault_folder)
    vault_record = {"vault_folder": vault_folder} if vault_folder else {}
    if vault_write:
        if not explicit_folder:
            die("--vault-write requires an explicit --vault-folder")
        vault_record = {"vault_folder": explicit_folder, "vault_write": True}
        project = eng.Project(name, checkout, checkout, platform=False, record=vault_record)
        if project.vault_write_dir() is None:
            die(f"--vault-write needs an existing directory under "
                f"{lc.vault_folder('projects')}/: {explicit_folder!r}")

    me = gh.whoami()
    owner = me["login"]
    print(f"github: {owner} ({me['kind']} token"
          + (f", scopes {', '.join(me['scopes'])}" if me["scopes"] else "")
          + (f", expires {me['expires']}" if me["expires"] else "") + ")")

    rev, date = craft_source_rev(), datetime.now().strftime("%Y-%m-%d")
    body = project_file.read_text(encoding="utf-8") if project_file else None
    files = project_render(name, body, rev, date)   # raises CraftError before any side effect
    print(f"render: role.md from {ENGINEER_ROLE_SRC} @ {rev}; "
          f"project.md {'from ' + str(project_file) if project_file else 'skeleton'}")

    if dry:
        target = (f"{owner}/{name} (new, private)" if repo_arg == "new"
                  else "/".join(_parse_repo(repo_arg)) + " (existing)")
        print(f"  [dry-run] would {'create' if repo_arg == 'new' else 'connect'} "
              f"{target}, key {key}, checkout {checkout}, register {record_path}")
        for path, content in files.items():
            print(f"  [dry-run] {path}: {len(content):,} chars (excluded)")
        if vault_record:
            print(f"  [dry-run] vault folder {explicit_folder!r}, job write={vault_write}")
        print(f"  [dry-run] README.md: {len(readme_stub(name)):,} chars "
              f"(the only commit, if the repo is empty)")
        return

    # 1. The repo. Private, always; an existing one is refused if it is not.
    if repo_arg == "new":
        repo = gh.create_private_repo(
            name, f"{name} — its engineer's repo, provisioned {date}")
        print(f"created {repo['full_name']} private={repo['private']} "
              f"visibility={repo['visibility']} id={repo['id']}")
        # Not fatal: the repo exists and the deploy key below still reaches
        # it. Only an engineer's https push needs the repo in the installation.
        try:
            outcome = gh.add_to_installation(repo)
            if outcome == "added":
                print(f"added {repo['full_name']} to the GitHub app's installation "
                      f"(selected repositories); a token for it was minted")
            elif outcome == "covered":
                print(f"{repo['full_name']} is in the GitHub app's installation "
                      f"(all repositories); a token for it was minted")
            else:
                print("the GitHub integration is not connected; the deploy key "
                      "is the only way in")
        except gh.GitHubError as exc:
            print(f"warning: {repo['full_name']} is not in the GitHub app's "
                  f"installation ({exc}); add it on GitHub, or set the "
                  f"installation to All repositories")
    else:
        r_owner, r_name = _parse_repo(repo_arg)
        repo = gh.get_repo(r_owner, r_name)
        if repo is None:
            die(f"{r_owner}/{r_name} does not exist or the token cannot see it")
        if not repo.get("private"):
            die(f"{repo['full_name']} is {repo.get('visibility')}. Connecting a "
                f"repository that is not private is {lc.OWNER_NAME}'s call, not the "
                f"engineer's; nothing done.")
        print(f"connected {repo['full_name']} private={repo['private']} "
              f"visibility={repo['visibility']} id={repo['id']}")
    r_owner, r_name = repo["owner"]["login"], repo["name"]

    # 2. The key. One per project, write access to this repo and nothing else.
    pub = gh.generate_ssh_key(key, f"loam-project-{name}@{os.uname().nodename}")
    dk = gh.add_deploy_key(r_owner, r_name, f"engineer for {name} (deploy key)",
                           pub, read_only=False)
    print(f"deploy key {dk['id']} added ({key}, read_only={dk['read_only']})")

    # 3. The checkout, through the key. An empty repo clones with a warning
    #    and no branch; a repo with history clones as it is.
    checkout.parent.mkdir(parents=True, exist_ok=True)
    gh.git(["clone", "-q", repo["ssh_url"], str(checkout)], checkout.parent, key=key)
    if gh.git(["rev-parse", "--verify", "HEAD"], checkout, check=False).returncode != 0:
        gh.git(["checkout", "-q", "-b", repo.get("default_branch") or "main"], checkout)
    gh.git(["config", "user.name", f"{name} engineer"], checkout)
    gh.git(["config", "user.email", f"engineer+{name}@noreply.local"], checkout)
    gh.git(["config", "core.sshCommand", gh.ssh_command(key)], checkout)
    print(f"checkout {checkout} on {gh.git(['branch', '--show-current'], checkout).stdout.strip()}")

    # 4. The render, into the checkout and out of the repository: excluded
    #    before it is written, so no `git add` can ever pick it up.
    #    memory/MEMORY.md is seeded once and then the engineer's.
    exclude_harness(checkout)
    print(f"excluded {', '.join(HARNESS_PATHS)} in .git/info/exclude")
    for rel, content in files.items():
        target = checkout / rel
        if rel == "memory/MEMORY.md" and target.exists():
            print(f"  unchanged {target} (engineer-owned)")
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        write_if_changed(target, content)

    # 5. An empty repo gets one commit, a README stub, and nothing else; a
    #    repo with history is neither committed to nor pushed.
    branch = gh.git(["branch", "--show-current"], checkout).stdout.strip()
    if gh.git(["rev-parse", "--verify", "HEAD"], checkout, check=False).returncode != 0:
        (checkout / "README.md").write_text(readme_stub(name), encoding="utf-8")
        gh.git(["add", "README.md"], checkout)
        gh.git(["commit", "-q", "-m", "Start the repository"], checkout)
        gh.git(["push", "-q", "-u", "origin", branch], checkout, key=key)
        head = gh.git(["rev-parse", "HEAD"], checkout).stdout.strip()
        print(f"pushed {branch} @ {head[:12]} (README stub) to {repo['ssh_url']}")
    else:
        print(f"{repo['full_name']} has history; nothing committed or pushed")

    # 6. Register. Last, so a record always describes a project that exists.
    record = {
        "name": name,
        "repo": repo["full_name"],
        "remote": repo["ssh_url"],
        "html_url": repo["html_url"],
        "checkout": str(checkout),
        "deploy_key": str(key),
        "deploy_key_id": dk["id"],
        "role_source_rev": rev,
        "provisioned": date,
        **vault_record,
    }
    # Preserve the project's test command across reprovisioning. Landing requires it.
    if record_path.is_file():
        prior = json.loads(record_path.read_text(encoding="utf-8"))
        if prior.get("test_command"):
            record["test_command"] = prior["test_command"]
        # A project flipped back to Claude Code stays flipped.
        if prior.get("runtime") in eng.RUNTIMES:
            record["runtime"] = prior["runtime"]
    record_path = write_record(record_path, record)
    (eng.PROJECT_STATE / name / "jobs").mkdir(parents=True, exist_ok=True)
    ensure_trust(checkout)
    print(f"registered {record_path}; jobs at {eng.PROJECT_STATE / name / 'jobs'}")
    # The launcher reads the registry on each call.
    print(f"mcp__engineer__brief accepts project={name!r} from the next call "
          f"in every open conversation: bin/engineer-job reads the registry "
          f"per call, and the persona-side tool holds no list of its own. "
          f"Nothing needs restarting.")


# What an adopted repository may not already track: a path the harness would
# be written over. `.codex/` is listed although nothing renders one today,
# because the brief that made adoption named it and a stranger's repo may.
ADOPT_CLASHES = HARNESS_PATHS + (".codex/",)


def write_record(record_path: Path, record: dict) -> Path:
    """Publish a complete local registry record without staging it in git."""
    record_path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8",
                                     dir=record_path.parent, delete=False) as handle:
        pending = Path(handle.name)
        try:
            handle.write(json.dumps(record, indent=2) + "\n")
            handle.close()
            pending.replace(record_path)
        finally:
            pending.unlink(missing_ok=True)
    return record_path


def commit_identity(login: str, name: str | None = None,
                    email: str | None = None) -> dict:
    """A `commit_identity` for the GitHub account ``login``
    (lib/loam_commit_identity.py): its profile name unless ``name`` is given, and
    its noreply address -- which GitHub attributes to the account whatever
    else is verified on it -- unless ``email`` is. The id is read from the
    API, never typed."""
    import loam_github_app as app  # noqa: PLC0415
    import loam_commit_identity  # noqa: PLC0415
    try:
        _, user = app.api("GET", f"/users/{login}", app.user_token())
    except app.IntegrationError as exc:
        die(f"--commit-as {login}: {exc}")
    name = name or (user.get("name") or "").strip()
    if not name:
        die(f"{login} has no name on their GitHub profile; pass --commit-name")
    return {"name": name,
            "email": email or loam_commit_identity.noreply_email(user["id"], user["login"]),
            "github_login": user["login"]}


def set_commit_identity(name: str, identity: dict, dry: bool = False) -> None:
    """Write ``identity`` into a registered project's record and its
    canonical checkout's git config. Its next job commits as that person."""
    import loam_engineer as eng  # noqa: PLC0415
    import loam_github as gh  # noqa: PLC0415
    record_path = eng.project_record_path(name)
    if not record_path.is_file():
        die(f"{name} is not registered")
    record = json.loads(record_path.read_text(encoding="utf-8"))
    print(f"{name}: commits and pull requests as {identity['name']} "
          f"<{identity['email']}> (GitHub {identity['github_login']}); was "
          f"{record.get('commit_identity') or 'the engineer'}")
    if record.get("landing") != "pull_request":
        print("  note: this project lands on its own main, so only its commits "
              "change; there is no pull request to open as anyone")
    if dry:
        print("  [dry-run] nothing written")
        return
    record["commit_identity"] = identity
    record_path.write_text(json.dumps(record, indent=2) + "\n", encoding="utf-8")
    checkout = Path(record["checkout"])
    gh.git(["config", "user.name", identity["name"]], checkout)
    gh.git(["config", "user.email", identity["email"]], checkout)


def vault_folder_for(name: str, given: str | None,
                     vault: Path | None = None) -> str | None:
    """Return the configured vault folder for receipts, or fall back to the project name."""
    top = lc.vault_folder("projects")
    projects = (vault or VAULT) / top
    folder = given or name
    if "/" in folder or folder in ("", ".", ".."):
        die(f"--vault-folder {folder!r}: one folder name under {top}")
    existing = [p.name for p in projects.iterdir() if p.is_dir()] if projects.is_dir() else []
    twins = [e for e in existing if e.lower() == folder.lower() and e != folder]
    if twins:
        die(f"{top}/{twins[0]}/ exists and {top}/{folder}/ would be "
            f"its case-only twin; pass --vault-folder {twins[0]}")
    return given if given and given != name else None


def adopt_project(name: str, repository: str, project_file: Path | None,
                  test_command: str | None = None, dry: bool = False,
                  identity: dict | None = None,
                  vault_folder: str | None = None) -> None:
    """Adopt an upstream repository through its authorized GitHub installation, provision
    the project engineer and configure pull-request landing."""
    import shutil  # noqa: PLC0415
    import loam_engineer as eng  # noqa: PLC0415
    import loam_github as gh  # noqa: PLC0415
    import loam_github_app as app  # noqa: PLC0415

    if not eng.PROJECT_NAME_RE.match(name):
        die(f"project name {name!r}: lowercase letters, digits and hyphens only")
    if not re.match(r"^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$", repository):
        die(f"--adopt takes owner/name, not {repository!r}")
    record_path = eng.project_record_path(name)
    if record_path.exists():
        die(f"{name} is already registered at {record_path}; retire it first")
    checkout = eng.PROJECT_CHECKOUTS / name
    if checkout.exists():
        die(f"{checkout} already exists; refusing to render over it")
    if project_file is not None and not project_file.is_file():
        die(f"no project file at {project_file}")
    vault_folder = vault_folder_for(name, vault_folder)

    try:
        inst = app.installation_for(app.load(), repository)
        token = app.read_token(repository)["token"]
        _, repo = app.api("GET", f"/repos/{repository}", token)
    except app.IntegrationError as exc:
        die(f"{repository}: {exc}")
    print(f"installation {inst['installation_id']} on {inst.get('account')} "
          f"({inst.get('repository_selection')} repositories) reaches "
          f"{repo['full_name']}")
    if not repo.get("private"):
        die(f"{repo['full_name']} is {repo.get('visibility')}. Adopting a "
            f"repository that is not private is {lc.OWNER_NAME}'s call, not the "
            f"engineer's; nothing done.")
    base = repo.get("default_branch") or "main"
    remote = gh.https_remote(repo["full_name"])

    rev, date = craft_source_rev(), datetime.now().strftime("%Y-%m-%d")
    body = project_file.read_text(encoding="utf-8") if project_file else None
    files = project_render(name, body, rev, date)
    print(f"render: role.md from {ENGINEER_ROLE_SRC} @ {rev}; "
          f"project.md {'from ' + str(project_file) if project_file else 'skeleton'}")
    if dry:
        print(f"  [dry-run] would clone {remote} ({base}) to {checkout}, "
              f"exclude and render {', '.join(files)}, register {record_path} "
              f"with landing pull_request; nothing pushed, ever")
        return

    # 1. The clone, with the token in this process's environment only.
    checkout.parent.mkdir(parents=True, exist_ok=True)
    cloned = subprocess.run(["git", "clone", "-q", remote, str(checkout)],
                            env=app.git_token_env(token), capture_output=True,
                            text=True, check=False, timeout=600)
    if cloned.returncode != 0:
        shutil.rmtree(checkout, ignore_errors=True)
        die(f"cloning {remote} failed: "
            f"{(cloned.stderr or '').replace(token, '***').strip()[:400]}")
    if gh.git(["rev-parse", "--verify", "HEAD"], checkout, check=False).returncode != 0:
        shutil.rmtree(checkout, ignore_errors=True)
        die(f"{repo['full_name']} is empty; there is nothing to adopt. Nothing kept.")

    # 2. Their history must not already hold a path the harness writes.
    clashes = gh.git(["ls-files", "--", *ADOPT_CLASHES], checkout).stdout.split()
    if clashes:
        shutil.rmtree(checkout, ignore_errors=True)
        die(f"{repo['full_name']} already tracks {', '.join(sorted(clashes)[:8])}; "
            f"the engineer's harness would be written over its files. Nothing "
            f"kept. Adopting it needs the harness somewhere else, which is a "
            f"decision for {lc.OWNER_NAME}.")

    # 3. The local `main` is the remote's default branch, whatever it is
    #    called, because every job is cut from `main` (lib/loam_worktree.py).
    if base != "main":
        gh.git(["branch", "-m", base, "main"], checkout)
        gh.git(["branch", "--set-upstream-to", f"origin/{base}", "main"], checkout)
    who = identity or {"name": f"{name} engineer",
                       "email": f"engineer+{name}@noreply.local"}
    gh.git(["config", "user.name", who["name"]], checkout)
    gh.git(["config", "user.email", who["email"]], checkout)
    head = gh.git(["rev-parse", "HEAD"], checkout).stdout.strip()
    print(f"checkout {checkout}: main = origin/{base} @ {head[:12]}")

    # 4. The render, excluded before it is written.
    exclude_harness(checkout)
    print(f"excluded {', '.join(HARNESS_PATHS)} in .git/info/exclude")
    for rel, content in files.items():
        target = checkout / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        write_if_changed(target, content)
    status = gh.git(["status", "--porcelain"], checkout).stdout.strip()
    if status:
        die(f"the render shows in {checkout}'s status, which means it would "
            f"reach a commit:\n{status}")

    # 5. Register. No deploy key, no deploy lane, and landing by pull request.
    record = {
        "name": name,
        "repo": repo["full_name"],
        "remote": remote,
        "html_url": repo["html_url"],
        "checkout": str(checkout),
        "landing": "pull_request",
        "default_branch": base,
        "adopted": date,
        "role_source_rev": rev,
        "provisioned": date,
    }
    if test_command:
        record["test_command"] = test_command
    if identity:
        record["commit_identity"] = identity
    if vault_folder:
        record["vault_folder"] = vault_folder
    record_path = write_record(record_path, record)
    (eng.PROJECT_STATE / name / "jobs").mkdir(parents=True, exist_ok=True)
    ensure_trust(checkout)
    print(f"registered {record_path} (landing: pull request against {base}"
          + (f"; tests: {test_command}" if test_command else
             "; no test_command, so each pull request says it is untested")
          + f"); jobs at {eng.PROJECT_STATE / name / 'jobs'}; receipts to "
          f"{VAULT / lc.vault_folder('projects') / (vault_folder or name) / 'receipts'}")


def deployment_blocker(name: str, deploy_dir: Path | None = None) -> str | None:
    """Explain which deployment record must be retired before retiring its project."""
    record = (deploy_dir or loam_deploy.DEPLOY) / name / "deploy.toml"
    if record.is_file():
        return (f"{name} still has a deployment record at {record}. Tear the "
                f"deployment down first: stop and remove its container and "
                f"images (`docker compose -f {record.parent}/compose.yaml down "
                f"--rmi all`), `git rm -r {record.parent}`, `sudo bin/gen-deploy`, "
                f"check-drift green; then retire. --force does not skip this.")
    return None


def retire_project(name: str, delete_repo: bool, force: bool) -> None:
    """Undo provision_project. The checkout is refused while it holds work
    the remote does not, unless forced; the repo is deleted only when asked.
    A live deployment record refuses outright: see deployment_blocker."""
    import shutil  # noqa: PLC0415
    import loam_engineer as eng  # noqa: PLC0415
    import loam_github as gh  # noqa: PLC0415

    record_path = eng.project_record_path(name)
    if not record_path.is_file():
        die(f"{name} is not registered ({record_path} missing)")
    blocker = deployment_blocker(name)
    if blocker:
        die(blocker)
    project = eng.load_project_record(record_path)
    owner, r_name = project.repo.split("/", 1)
    if delete_repo and project.pull_request:
        die(f"{project.repo} is not Loam's: {name} adopted it. --delete-repo "
            f"is refused; retire without it.")

    if project.root.is_dir() and not force:
        dirty = gh.git(["status", "--porcelain"], project.root, check=False).stdout.strip()
        unpushed = gh.git(["log", "--oneline", "@{u}..HEAD"], project.root,
                          check=False).stdout.strip()
        if dirty or unpushed:
            die(f"{project.root} has uncommitted or unpushed work:\n"
                f"{dirty}\n{unpushed}\n--force retires it anyway.")

    key_id = project.record.get("deploy_key_id")
    if key_id and gh.get_repo(owner, r_name) is not None:
        gh.delete_deploy_key(owner, r_name, int(key_id))
        print(f"deleted deploy key {key_id} from {project.repo}")
    if delete_repo:
        gh.delete_repo(owner, r_name)
        print(f"deleted {project.repo}: GET now -> "
              f"{'404' if gh.get_repo(owner, r_name) is None else 'STILL THERE'}")
    if project.deploy_key:
        for p in (project.deploy_key, project.deploy_key.with_suffix(".pub")):
            if p.exists():
                p.unlink()
        print(f"removed {project.deploy_key} and .pub")
    if project.root.is_dir():
        shutil.rmtree(project.root)
        print(f"removed {project.root}")
    state = eng.PROJECT_STATE / name
    if state.is_dir():
        shutil.rmtree(state)
        print(f"removed {state}")
    remove_trust(project.root)
    record_path.unlink()
    print(f"unregistered {record_path}")


def remove_trust(workspace: Path) -> None:
    """The inverse of ensure_trust, with the same three rules: no write when
    there is nothing to remove, re-check the file has not moved, replace
    atomically. A retired checkout's trust entry is a path that no longer
    exists being pre-approved for whatever lands there next."""
    key = str(workspace)
    for _ in range(3):
        stat_before = CLAUDE_JSON.stat()
        cfg = json.loads(CLAUDE_JSON.read_text())
        projects = cfg.get("projects") or {}
        if key not in projects:
            return
        del projects[key]
        stat_now = CLAUDE_JSON.stat()
        if (stat_now.st_mtime_ns, stat_now.st_size) != (
            stat_before.st_mtime_ns, stat_before.st_size
        ):
            continue
        tmp = CLAUDE_JSON.with_name(CLAUDE_JSON.name + ".provision-tmp")
        tmp.write_text(json.dumps(cfg, indent=2))
        os.replace(tmp, CLAUDE_JSON)
        print(f"  trust removed for {key} (atomic replace)")
        return
    print(f"  could not remove trust for {key}: ~/.claude.json kept moving; "
          f"remove the entry by hand")


def main() -> None:
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    dry = "--dry-run" in sys.argv
    if "--project" in sys.argv:
        argv = sys.argv[1:]

        def opt(flag: str) -> str | None:
            return argv[argv.index(flag) + 1] if flag in argv and argv.index(flag) + 1 < len(argv) else None

        name = opt("--project") or die("usage: provision --project <name> --repo new|<url> "
                                       "[--project-file <path>] [--dry-run]")
        if "--retire" in argv:
            retire_project(name, "--delete-repo" in argv, "--force" in argv)
            return
        if "--rerender" in argv:
            rerender_project(name)
            return
        identity = (commit_identity(opt("--commit-as"), opt("--commit-name"),
                                    opt("--commit-email"))
                    if opt("--commit-as") else None)
        if "--adopt" in argv:
            if "--vault-write" in argv:
                die("--vault-write is available with --repo")
            pf = opt("--project-file")
            adopt_project(name, opt("--adopt") or die("--adopt <owner>/<name>"),
                          Path(pf) if pf else None, opt("--test-command"), dry,
                          identity, opt("--vault-folder"))
            return
        if identity:
            set_commit_identity(name, identity, dry)
            return
        repo_arg = opt("--repo") or die(
            "usage: provision --project <name> --repo new|<url> "
            "[--project-file <path>] [--vault-folder <Folder> [--vault-write]] [--dry-run]\n"
            "       provision --project <name> --adopt <owner>/<name> "
            "[--project-file <path>] [--test-command <cmd>] [--vault-folder <Folder>]\n"
            "           [--commit-as <github-login> [--commit-name <name>] "
            "[--commit-email <email>]] [--dry-run]\n"
            "       provision --project <name> --commit-as <github-login> "
            "[--commit-name <name>] [--commit-email <email>] [--dry-run]\n"
            "       provision --project <name> --retire [--delete-repo] [--force]\n"
            "       provision --project <name> --rerender")
        pf = opt("--project-file")
        provision_project(name, repo_arg, Path(pf) if pf else None, dry,
                          vault_folder=opt("--vault-folder"), vault_write="--vault-write" in argv)
        return
    if "--migrate-persona-maps" in sys.argv:
        if args or dry:
            die("usage: provision --migrate-persona-maps")
        import loam_agents  # noqa: PLC0415
        import loam_map_migration  # noqa: PLC0415
        import loam_profile  # noqa: PLC0415
        import loam_schedule  # noqa: PLC0415
        loam_map_migration.main()
        for name in loam_agents.archived(AI_LABS):
            workspace = AI_LABS / name
            display = loam_profile.self_name(name, loam_agents.card(name, AI_LABS))
            render_persona_loading(workspace, display)
            loam_schedule.adopt_default(name)
        return
    # Use the same engineer renderer that the drift check reads.
    if "--engineer" in sys.argv:
        if args:
            die("usage: provision --engineer [--dry-run]")
        provision_engineer(dry)
        return
    if "--codex" in sys.argv:
        provision_codex([a.lower() for a in args], dry)
        return
    if "--antigravity" in sys.argv:
        provision_antigravity([a.lower() for a in args], dry)
        return
    if "--managed-settings" in sys.argv:
        if args:
            die("usage: provision --managed-settings [--dry-run]")
        install_managed_settings(dry)
        return
    if "--reviewer" in sys.argv:
        if args:
            die("usage: provision --reviewer [--dry-run]")
        provision_reviewer(dry)
        return
    if len(args) not in (1, 2):
        die("usage: provision <agent> [<wake HH:MM>] [--dry-run]\n"
            "       provision --engineer [--dry-run]\n"
            "       provision --reviewer [--dry-run]\n"
            "       provision --managed-settings [--dry-run]")
    name, wake = args[0].lower(), (args[1] if len(args) == 2 else None)
    if wake is not None and not re.match(r"^\d{2}:\d{2}$", wake):
        die(f"wake must be HH:MM; got {wake!r}")

    workspace = AI_LABS / name
    if not workspace.is_dir():
        die(f"no workspace at {workspace}")
    for required in ("soul.md", "config.md"):
        if not (workspace / required).is_file():
            die(f"{workspace}/{required} is missing; refusing to provision")

    # Seed a new reflection record with the requested time. An existing schedule record
    # owns its time.
    reflection_record = workspace / "crons" / "reflection.md"
    if reflection_record.exists():
        import loam_cron  # noqa: PLC0415
        cron = loam_cron.read_cron(name, "reflection")
        hhmm = loam_cron.reflection_hhmm(cron.schedule_text)
        if wake is not None and hhmm != wake:
            die(f"{reflection_record} says {cron.schedule_text}, not {wake}. "
                f"The record is the reflection's time; change it there "
                f"(bin/schedule).")
        wake = hhmm
    elif wake is None:
        die(f"{name} has no daily reflection record yet; give its time: "
            f"provision {name} <HH:MM>")

    display = name.capitalize()
    try:
        _card = json.loads((workspace / "agent.json").read_text(encoding="utf-8"))
        _card = _card if isinstance(_card, dict) else {}
    except (OSError, ValueError):
        _card = {}
    # Workspace files retain the original name. A profile rename changes the display name.
    import loam_profile  # noqa: PLC0415
    own_name = loam_profile.self_name(name, _card)
    shape = skills_shape(workspace)

    print(f"agent={name} display={display} wake={wake} skills={shape}")
    print(f"  soul={workspace/'soul.md'} ({(workspace/'soul.md').stat().st_size}B)")
    print(f"  config={workspace/'config.md'} ({(workspace/'config.md').stat().st_size}B)")
    if dry:
        print("  [dry-run] no files written")
        return

    (workspace / ".claude").mkdir(parents=True, exist_ok=True)
    (workspace / "memory").mkdir(parents=True, exist_ok=True)

    # Preserve owner-selected profile fields when regenerating the workspace.
    import loam_profile  # noqa: PLC0415
    try:
        existing = json.loads((workspace / "agent.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        existing = {}
    (workspace / "agent.json").write_text(loam_profile.render_agent({
        "name": name,
        "display": display,
        "workspace": str(workspace),
        "vault": str(VAULT),
        **(loam_profile.kept(existing) if isinstance(existing, dict) else {}),
    }), encoding="utf-8")

    render_persona_loading(workspace, own_name)
    (workspace / ".claude" / "settings.local.json").write_text(
        json.dumps({"autoMemoryDirectory": str(workspace / "memory")}, indent=2) + "\n",
        encoding="utf-8")
    (workspace / ".mcp.json").write_text(
        json.dumps(mcp_config(name, workspace), indent=2) + "\n", encoding="utf-8")

    link = workspace / ".claude" / "skills"
    if (workspace / "skills").is_dir():
        if link.is_symlink() or link.exists():
            link.unlink()
        link.symlink_to("../skills")
    # The shared shelves for Claude Code, one folder of links above every
    # workspace, where Claude Code finds them and lets the persona's own
    # skill of the same name win (first release L7).
    loam_skills.render_claude_shelf()

    ensure_trust(workspace)
    ensure_user_settings()
    provision_codex([name])
    provision_antigravity([name])
    ensure_engineer()

    # Reconcile the reflection from its schedule record. Keep the existing record when
    # provisioning again.
    import loam_schedule  # noqa: PLC0415
    record = loam_schedule.record_path(name, "reflection")
    if not record.exists():
        loam_schedule.change(name, "reflection",
                             loam_schedule.reflection_record(wake),
                             actor="engineer", lane="engineer",
                             reason=f"provisioned with its reflection at {wake}")
        print(f"  wrote {record} (its wake units follow it)")
    else:
        if loam_schedule.adopt_default(name):
            print(f"  {record}: its instruction is now Loam's default")
        loam_schedule.reconcile([name])

    # The vault's schedule page carries both lanes in one table, and this is
    # one generator of it; the schedule reconciler is the other and
    # rewrites the same page on every change; whichever runs last is right,
    # because both derive every row from disk rather than editing in place.
    from loam_cron import write_schedule_page  # noqa: PLC0415
    if write_schedule_page(VAULT):
        print(f"  rewrote {VAULT}/{lc.vault_folder('projects')}/Loam/infrastructure/schedule.md")

    print(f"  provisioned {name}: project files; its daily wake is its record's")


if __name__ == "__main__":
    # Hold the relevant live lock while changing a project checkout or its installed
    # runtime files.
    import loam_lock  # noqa: E402
    _named = [a for a in sys.argv[1:] if not a.startswith("--")]
    _lock = _named[0] if "--project" in sys.argv and _named else "Loam"
    with loam_lock.live(_lock, "provision " + " ".join(sys.argv[1:])):
        main()
