#!/usr/bin/env python3
"""Arm or disarm the Remote Control servers by the Claude Code sign-in.

A Remote Control server (`loam-rc-<agent>.service`, bin/gen-rc-units) can only
run on the Claude Code login file, `~/.claude/.credentials.json`: a setup
token cannot hold a Remote Control session. Until 2026-11-14 a box with no
sign-in yet restarted each server every ten seconds for as long as it had
none (56 times in one install rehearsal; forever on a box that only uses
Codex). Now the sign-in itself arms them (first release L6):

- **The unit** carries `ConditionPathExists=` on the login file. Started
  without one -- at provisioning, at boot -- it is skipped, which is not a
  failure, so nothing restarts it and nothing loops.
- **`loam-claude-signin.path`** watches the file (PathChanged: its creation, every
  rewrite, its removal, even before `~/.claude/` exists) and runs this.
- **This**, when the file is there: starts every enabled server that has not
  run since its condition last failed, or never ran -- the ones waiting for a
  sign-in. One that is running, or that someone stopped while it was signed
  in, is left as it is. A successful sign-in from the app
  (`POST /v1/providers/claude-code/login/code`) and one at the CLI both land
  the file, so both arm every agent's server.
- **When the file is gone** (a sign-out, from the app or the CLI), it looks
  again after a moment, so that a rewrite is never read as a sign-out, and
  then stops every running server. Each is still enabled, and is written
  down in `<state>/rc-arm.json`: a server stopped while it ran keeps its
  condition's last answer, `yes`, so the sign-in could not otherwise tell it
  from one stopped by hand (measured 2026-11-14). The next sign-in starts
  the ones written down and clears the list.

On a box that is signed in, nothing changes: every server is running, and a
token refresh's rewrite of the file finds nothing waiting.

  rc-arm            what the file says, done
  rc-arm --dry-run  say what it would do, do nothing
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import loam_config as lc  # noqa: E402

CREDENTIALS = lc.CLAUDE_HOME / ".credentials.json"
DISARMED = lc.STATE / "rc-arm.json"
PATTERN = "loam-rc-*.service"
RECHECK_S = 3.0


def systemctl(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["systemctl", "--user", *args], capture_output=True,
                          text=True, check=False, timeout=60)


def enabled_servers(run=systemctl) -> list[str]:
    out = run("list-unit-files", PATTERN, "--state=enabled", "--no-legend",
              "--plain").stdout
    return sorted(line.split()[0] for line in out.splitlines() if line.strip())


def state(unit: str, run=systemctl) -> dict[str, str]:
    out = run("show", unit, "-p", "ActiveState", "-p", "ConditionResult").stdout
    return dict(line.split("=", 1) for line in out.splitlines() if "=" in line)


def waiting(s: dict[str, str]) -> bool:
    """Inactive, and its condition did not pass the last time it was asked
    (or it was never started): a server waiting for a sign-in."""
    return s.get("ActiveState") == "inactive" and s.get("ConditionResult") != "yes"


def disarmed(path: Path) -> list[str]:
    """The servers a sign-out stopped, which the next sign-in starts."""
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []
    names = data.get("stopped") if isinstance(data, dict) else None
    return [n for n in names if isinstance(n, str)] if isinstance(names, list) else []


def write_disarmed(path: Path, units: list[str]) -> None:
    if not units:
        path.unlink(missing_ok=True)
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps({"stopped": sorted(set(units)),
                               "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())},
                              indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, path)


def plan(signed_in: bool, run=systemctl, stopped: list[str] | None = None
         ) -> list[tuple[str, str]]:
    """[(verb, unit)]: what the file's state asks for. ``stopped`` is what
    the last sign-out stopped."""
    out = []
    for unit in enabled_servers(run):
        s = state(unit, run)
        if signed_in and (waiting(s) or (unit in (stopped or [])
                                         and s.get("ActiveState") == "inactive")):
            out.append(("start", unit))
        elif not signed_in and s.get("ActiveState") in ("active", "activating", "reloading"):
            out.append(("stop", unit))
    return out


def main(argv: list[str], run=systemctl, credentials: Path = CREDENTIALS,
         sleep=time.sleep, record: Path = DISARMED) -> int:
    dry = "--dry-run" in argv
    signed_in = credentials.is_file()
    if not signed_in:
        sleep(RECHECK_S)
        signed_in = credentials.is_file()
    stopped = disarmed(record)
    steps = plan(signed_in, run, stopped)
    why = "signed in" if signed_in else "no Claude Code sign-in"
    if not steps:
        print(f"rc-arm: {why}; nothing to do")
        if signed_in and stopped and not dry:
            write_disarmed(record, [])
        return 0
    for verb, unit in steps:
        if dry:
            print(f"rc-arm: {why}; would {verb} {unit}")
            continue
        done = run(verb, "--no-block", unit)
        print(f"rc-arm: {why}; {verb} {unit}"
              + ("" if done.returncode == 0 else f" failed: {done.stderr.strip()[:200]}"))
    if not dry:
        write_disarmed(record, [] if signed_in else
                       stopped + [u for verb, u in steps if verb == "stop"])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
