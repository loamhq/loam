#!/usr/bin/env python3
"""Report what is wrong with an agent's auto-loaded files. Never refuse.

Read once a day for every persona by the one check on a clock
(``bin/loam-check``, lib/loam_check.py, since 2026-11-19), which runs
``lane-check --json`` and makes each problem one of its facts. Until
2026-11-19 this was first ``bin/rc-preflight`` (the ``ExecStartPre=`` of each
Remote Control server) and then a step of ``bin/drift-watch``; both are gone.

**It reports and does nothing else.** It writes no log line and tells nobody:
what it finds is printed (``--json`` for the check), and the check is what
hands a problem to the agent that hears when Loam needs attention. It exits 0
whatever it finds, 2 only when it could not read the agent at all.

For an agent with a map (2026-11-18, lib/loam_loading.py) it sizes the map
and nothing else: the map loads as a CLAUDE.md import, with no style to lose.
For one without, the three things it can see, all of which fail by SILENCE
at runtime:

  over the limit     `_always.md` or `_active.md` past the character limit.
                     Nothing at runtime says so; the cost is just paid.
  missing            either file absent or empty. A dropped `@import` and a
                     dangling style symlink both load nothing and say
                     nothing (measured 2026-09-04: exit 0, no warning).
  style unparseable   the conversation symlink is broken, or `_active.md`
                     has lost the frontmatter keys the loader selects on. A
                     `name:` that disagrees with the selected style loads
                     NOTHING, silently -- indistinguishable from a missing
                     file from inside the session.

And one thing it warns about without calling it wrong (since 2026-09-07):

  near the limit     either file past ``NEAR_LIMIT_CHARS`` but not over the
                     limit: printed as a warning, never a fact. A file at
                     9,900 is not a broken layer and must not read as one.

This is the second instrument D4's 08-31 amendment asks for: the end-marker
convention is a check the artifact performs on itself by being read, so it is
structurally blind to the artifact being ABSENT. This one runs from outside
the session and sees absence, which is the worse of the two failures.

Usage: lane-check [--json] <agent-project-dir>
"""

from __future__ import annotations

import json
import sys
from pathlib import Path

# This file's own tree first (2026-11-09): run from a job's worktree, as
# its tests do, it must use the branch's lib, not main's. Live, the two
# are one path; the canonical line behind it serves a copy elsewhere.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import loam_config as lc  # noqa: E402

import loam_session as sess  # noqa: E402
from loam_memory import (  # noqa: E402
    CONVERSATION_LAYER,
    LIMIT_CHARS,
    ALWAYS_LAYER,
    STYLE_NAME,
    LayerError,
    load_config,
    near_limit,
    near_limit_reason,
    over_limit_reason,
    style_frontmatter_intact,
)

CHECKED = (ALWAYS_LAYER, CONVERSATION_LAYER)


def findings(workspace: Path) -> tuple[list[str], list[tuple[str, str]]]:
    """``(problems, warnings)``.

    A problem is something the session will silently run without; the
    daily check makes it a fact. A warning is ``(key, text)`` for a file
    that is within reach of the limit but not over it (since 2026-09-07);
    it is printed and is never a fact.
    """
    out: list[str] = []
    warnings: list[tuple[str, str]] = []

    # An agent with a map (2026-11-18, lib/loam_loading.py) loads its map
    # and none of the old files, and has no conversation style to lose. Its
    # one loading file is sized; an empty map is a real map, and nothing it
    # loads fails by silence (each is a CLAUDE.md import the wake's
    # identity gate checks).
    import loam_loading  # noqa: PLC0415
    if loam_loading.mapped(workspace):
        path = workspace / loam_loading.MAP
        try:
            size = len(path.read_text(encoding="utf-8"))
        except OSError as exc:
            return [f"`{loam_loading.MAP}` is unreadable: {exc}"], []
        if size > LIMIT_CHARS:
            out.append(over_limit_reason(loam_loading.MAP, size, path,
                                         "every lane loads it as always"))
        elif near_limit(size):
            warnings.append((f"`{loam_loading.MAP}`",
                             near_limit_reason(loam_loading.MAP, size, path)))
        return out, warnings

    for name in CHECKED:
        path = workspace / name
        try:
            text = path.read_text(encoding="utf-8")
        except OSError:
            out.append(
                f"`{name}` is missing or unreadable. It loads nothing and "
                f"says nothing; the session starts normally."
            )
            continue
        if not text.strip():
            out.append(f"`{name}` is empty.")
            continue
        if len(text) > LIMIT_CHARS:
            out.append(over_limit_reason(name, len(text), path,
                                         "every lane loads it as always"))
        elif near_limit(len(text)):
            warnings.append((f"`{name}`", near_limit_reason(name, len(text), path)))

    link = workspace / ".claude" / "output-styles" / f"{STYLE_NAME}.md"
    if not link.is_symlink() and not link.is_file():
        out.append(
            f"the conversation style at `{link}` does not exist, so no "
            f"conversation layer loads at all."
        )
    elif not link.exists():
        out.append(
            f"the conversation style symlink at `{link}` is dangling "
            f"(points at `{link.readlink()}`), so no conversation layer "
            f"loads at all."
        )
    else:
        try:
            body = link.read_text(encoding="utf-8")
        except OSError as exc:
            out.append(f"the conversation style at `{link}` is unreadable: {exc}")
        else:
            if not style_frontmatter_intact(body):
                out.append(
                    f"the conversation style at `{link}` has lost its "
                    f"frontmatter keys (name: {STYLE_NAME}, "
                    f"keep-coding-instructions: true). The loader selects by "
                    f"name and loads nothing when it disagrees — silently."
                )

    return out, warnings


# Where the alarm remembers what it last reported, one file per lane. Runtime
# state (agents/state/ is gitignored), never source. A test points this at a
# scratch directory.
MODEL_MEMORY = lc.STATE / "model-alarm"


def model_problem(workspace: Path) -> tuple[str, dict] | None:
    """The model finding for this lane, with the memory that marks it
    reported; None when the latest session is on the configured model, on a
    model a record shows was chosen, or has already been reported.

    The model the lane's last session actually ran on, against the model
    its own config names. Added 2026-09-25, after one persona's lane ran most of a
    conversation on Opus 4.8 while its settings said `fable`: the CLI's
    `switchModelsOnFlag` default retries a refused turn on another model
    and keeps the session there, announcing it in one warning line in the
    scroll. The owner caught that line by chance, and three earlier switches
    on two lanes since 2026-09-03 nobody caught at all.

    check-drift reports the same finding under Important, once, while it is
    new; this writes it to the failure log and under Urgent, once per
    session, where the owner already looks. The comparison itself is loam_session's, shared with
    check-drift so the two cannot disagree.

    **Once per session** (2026-09-28). comms dedupes on a line's text only
    while that line is still in the file, so once a reader tidied it away
    the next run wrote it back: the same four stale sessions reached Urgent
    on 09-26, 09-27 and 09-28, and the failure log took them every night. A drifted session is a fact about the past by the
    time a start reads it; saying it again the next night tells nobody
    anything. So a lane's last report is kept in ``MODEL_MEMORY/<lane>.json``
    as the session and its newest dated record, and a finding is raised only
    for a DIFFERENT session whose newest record is LATER than that one. A
    session that goes on drifting after it was reported is not reported
    again; check-drift, run by hand, still shows it for as long as it is the
    lane's latest.
    """
    # The model is the persona's profile's (agent.json, Settings > Agents),
    # by the rule every launch path takes (loam_profile.claude_model,
    # 2026-11-19). Until then this read settings.json, which said `fable`
    # for every persona whatever the profile said: a persona set to Opus
    # was told its own Opus wakes were drift, and a chat that fell back to
    # settings.json's Fable looked right.
    import loam_profile  # noqa: PLC0415
    try:
        card = json.loads((workspace / "agent.json").read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        card = {}
    configured = loam_profile.claude_model(card)
    if not configured or configured in ("best", "opusplan"):
        return None
    seen = sess.effective_model(workspace)
    if seen is None:
        return None
    # A chat that asked for a model is a choice, not a drift. Imported
    # here rather than at module load, so the fewer modules that can fail
    # before findings() is even reached, the better.
    from loam_broker import chosen_model  # noqa: PLC0415
    verdict, _ = sess.model_verdict(
        configured, seen, chosen_model(Path(seen.session).stem))
    if verdict != "drift":
        return None
    # A scheduled lane (a wake, a cron, a fact or a result heard) runs on the
    # agent's own model in agent.json (loam_profile.lane_choice), which the
    # owner sets in Settings; a conversation runs on settings.json's. Both
    # are configured, so a session on either is not drift (2026-11-19: the lead agent's
    # attention runs on `opus` read as drift against settings.json's `fable`,
    # a new "drift" for every scheduled session).
    try:
        import loam_profile  # noqa: PLC0415
        agent = json.loads((workspace / "agent.json").read_text(encoding="utf-8"))
        lane_model = loam_profile.lane_choice(agent, loam_profile.WAKE_MODEL_DEFAULT)[0]
    except (OSError, ValueError, ImportError):
        lane_model = None
    if lane_model and sess.model_matches(lane_model, seen.model):
        return None
    try:
        last = json.loads((MODEL_MEMORY / f"{workspace.name}.json")
                          .read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        last = {}
    if seen.session == last.get("session") or seen.last <= last.get("last", ""):
        return None
    # THE CAUSE GOES IN THE FIRST SENTENCE. `loam_inbox.snippet()` keeps the
    # first sentence and drops the rest, and record_failure() below prefixes
    # every problem with what ran the check (see `origin`) -- which names
    # when it ran, not what went wrong. The first version of this finding
    # put the cause in a second sentence, so the comms line read "Remote
    # Control start: the last session on this lane ran on `claude-opus-4-8`,
    # but this agent's config names `fable`." (2026-09-26, when this ran at
    # each Remote Control start) and its first reader reasonably concluded
    # that the start had passed the model. It had not:
    # the switch happens mid-session on a refused turn, and no launch path on
    # this box passes a model at all. A line that invites the wrong repair is
    # worse than a quiet one, so the sentence that survives truncation has to
    # be the whole story.
    #
    # The refusal head is used only when the refusal is what the last turn
    # ran on. One persona's 09-03 session carried a refusal to `claude-opus-4-8` and
    # ended on `claude-opus-5`, and the line put the refusal's name on the
    # other model (2026-09-26 to 09-28).
    #
    # Both heads are kept under ~175 characters so they survive
    # snippet()'s 200-char cap with the prefix in front of them.
    if seen.refusal and seen.refusal_to == seen.model:
        head = (
            f"a refusal mid-conversation moved an EARLIER session off "
            f"`{configured}` onto `{seen.model}`; not this run, and no "
            f"launch path chose it"
        )
        tail = (
            f" The cause is the CLI's `switchModelsOnFlag`, from the "
            f"session's own record: {seen.refusal}."
        )
    else:
        head = (
            f"an EARLIER session on this lane ran on `{seen.model}` while "
            f"this agent's config names `{configured}`; nothing on "
            f"this box asked for that model"
        )
        tail = ""
    text = head + "." + tail + f" Session: `{seen.session}`."
    return text, {"session": seen.session, "last": seen.last,
                  "model": seen.model}


def remember(lane: str, memory: dict) -> None:
    """Mark a model finding reported. Best-effort: a memory that cannot be
    written costs one repeated line tomorrow, never a start."""
    try:
        MODEL_MEMORY.mkdir(parents=True, exist_ok=True)
        (MODEL_MEMORY / f"{lane}.json").write_text(
            json.dumps(memory, indent=2) + "\n", encoding="utf-8")
    except OSError as exc:
        print(f"lane-check: could not remember the model finding ({exc})",
              file=sys.stderr)


def report(project: Path) -> dict:
    """``{"agent", "problems", "warnings"}`` for one agent's project folder.
    A model finding is remembered as reported (``remember``) once it is in
    a report. Raises LayerError, KeyError or OSError when the agent cannot
    be read."""
    config = load_config(project)
    agent = config["name"]
    workspace = Path(config["workspace"])
    # The shape on disk, rendered before it is read (2026-11-18).
    import loam_loading  # noqa: PLC0415
    loam_loading.quiet_refresh(workspace)
    problems, warnings = findings(workspace)
    model = model_problem(workspace)
    if model:
        problems.append(model[0])
        remember(workspace.name, model[1])
    return {"agent": agent, "problems": problems,
            "warnings": [text for _, text in warnings]}


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    as_json = "--json" in argv
    rest = [a for a in argv if a != "--json"]
    if len(rest) != 1:
        print("usage: lane-check [--json] <agent-project-dir>", file=sys.stderr)
        return 2
    try:
        found = report(Path(rest[0]).resolve())
    except (LayerError, KeyError, OSError) as exc:
        print(f"lane-check: could not read {rest[0]} ({exc})", file=sys.stderr)
        return 2
    if as_json:
        print(json.dumps(found))
        return 0
    agent = found["agent"]
    for warning in found["warnings"]:
        print(f"lane-check: {agent}: warning: {warning}")
    for problem in found["problems"]:
        print(f"lane-check: {agent}: {problem}")
    if not found["problems"]:
        print(f"lane-check: {rest[0]} OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
