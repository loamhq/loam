#!/usr/bin/env python3
"""Tell the people who make Loam: a bug, a feature request, or an idea.

  loam report bug --title "…" [--body "…" | --body-file F | stdin] [--patch [RANGE]] [--json]
  loam report feature --title "…" [--body …] [--json]
  loam report idea --title "…" [--body …] [--json]     anything else: I wish, I love, this confused me
  loam report scrub [--json] < text      what would be taken out of a text

Drafts are saved locally. Show the exact saved preview, then ask the owner.
  loam report preview ID [--json]
  loam report send ID --yes       approved frozen preview, when the relay is configured
  loam report track ID ISSUE_URL  after the owner submits the GitHub form
  loam report offer TOPIC         one offer per topic (including a Market offer)
  loam report decline TOPIC       remember the decision
  loam report check               check submitted issues for news

`--patch` adds the diff of this checkout's own commits since the running
release (or of RANGE), for a bug this install's engineer has fixed already.
The rules are lib/loam_feedback.py; the skill is loam-filing-a-bug-or-feature.
Exit 0 with the report, 2 when it cannot be made (the reason on stderr).
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import sqlite3
from contextlib import closing
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import loam_config as lc
import loam_feedback as fb
import loam_report_delivery as delivery
from loam_report_diagnostics import instant


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(prog="loam report", description=__doc__.split("\n\n")[0])
    ap.add_argument("kind", choices=[*fb.KINDS, "scrub", "preview", "send", "track", "offer", "decline", "check"])
    ap.add_argument("values", nargs="*")
    ap.add_argument("--yes", action="store_true", help="the owner approved this exact preview")
    ap.add_argument("--diagnostics", action=argparse.BooleanOptionalAction, default=None,
                    help="include runtime diagnostics (default for bugs)")
    ap.add_argument("--at", help="hour ending at this ISO time with zone, for recent errors")
    ap.add_argument("--title")
    ap.add_argument("--body")
    ap.add_argument("--body-file")
    ap.add_argument("--patch", nargs="?", const=True, default=False,
                    help="add this checkout's own commits since the release (or RANGE)")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args(argv)

    expected = {"preview": 1, "send": 1, "track": 2, "offer": 1, "decline": 1}
    if len(args.values) != expected.get(args.kind, 0):
        ap.error("wrong number of arguments for " + args.kind)
    if args.kind == "preview":
        with closing(delivery.database()) as db:
            report = delivery.saved(db, args.values[0])
        print(json.dumps(report, indent=2) if args.json else fb.show(report))
        return 0
    if args.kind == "send":
        print(delivery.send(args.values[0], args.yes))
        return 0
    if args.kind == "track":
        print(delivery.track(*args.values))
        return 0
    if args.kind in {"offer", "decline"}:
        print(delivery.offer(args.values[0], args.kind == "decline"))
        return 0
    if args.kind == "check":
        delivery.check()
        return 0

    if args.kind == "scrub":
        text, removed = fb.scrub(sys.stdin.read())
        if args.json:
            print(json.dumps({"text": text, "removed": removed}, indent=2))
        else:
            print(text)
            print("\nTaken out: " + ("; ".join(f"{k} ({v})" for k, v in sorted(removed.items()))
                                     or "nothing"), file=sys.stderr)
        return 0

    body = args.body
    if args.body_file:
        body = Path(args.body_file).read_text(encoding="utf-8")
    elif body is None and not sys.stdin.isatty():
        body = sys.stdin.read()
    at = instant(args.at) if args.at else None
    report = delivery.save(fb.draft(args.kind, args.title or "", body or "", patch=args.patch,
                                    diagnostics=args.diagnostics, at=at))
    print(json.dumps(report, indent=2) if args.json else fb.show(report))
    return 0


if __name__ == "__main__":
    if os.geteuid() == 0 and lc.UID != 0:
        os.initgroups(lc.USER, lc.GID)
        os.setgid(lc.GID)
        os.setuid(lc.UID)
        os.environ.update(HOME=str(lc.HOME), XDG_RUNTIME_DIR=str(lc.RUNTIME_DIR))
    try:
        sys.exit(main(sys.argv[1:]))
    except (ValueError, OSError, sqlite3.Error) as exc:
        print(f"loam report: {exc}", file=sys.stderr)
        sys.exit(2)
