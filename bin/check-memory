#!/usr/bin/env python3
"""Report memory headroom and the box's memory history. Reads only.

Written 2026-09-02 after four global OOM kills (08-26, 08-30, 08-31, 09-01).
The reasoning is in vault/40_PROJECTS/Loam/research/memory-headroom-investigation.md;
the numbers this script judges against are HERE, not there, so the note cites
the script rather than restating values that would then drift.

What this exists for: every one of those four kills was a GLOBAL out-of-memory
kill -- the box, not a cgroup. Per-unit MemoryMax cannot see that coming and
did not stop it. Until 2026-11-19 the largest term was the Remote Control
sessions alive at once, and this counted them per agent; Remote Control was
retired that day, every conversation is now the broker's (admitted by the
box's memory, lib/loam_broker.py), and what is left here is the headroom the
wake grid will run on and the history behind it.

Since 2026-10-13 it also reads the box's history, logs/memsample.jsonl,
written every 5 minutes by bin/memsample: the last 24 h peak per unit and
the disk delta per mount and per big holder since the day before
(`history_report`). A history that has stopped is a warning, because the
last time it stopped (09-03) nobody noticed for six weeks.

Usage:  check-memory [--quiet]
Exit:   0 healthy   1 warning   2 critical
"""

from __future__ import annotations

import datetime as dt
import importlib.machinery
import importlib.util
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import loam_config as lc  # noqa: E402

CG = lc.USER_SLICE / "app.slice"


def _memsample():
    """bin/memsample as a module: its history() is the one reader of its
    file, so the format has one owner."""
    path = str(Path(__file__).resolve().parent / "memsample")
    loader = importlib.machinery.SourceFileLoader("memsample", path)
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("memsample", loader))
    loader.exec_module(mod)
    return mod


memsample = _memsample()

# --- Thresholds. Every one of these is measured, not chosen. ---------------

# Peak resident set of the heaviest wake on the grid. Measured directly since
# 2026-09-02, when bin/wake began recording peak_mb per run. The high across
# all ledgers (logs/wake-*.jsonl) as of 2026-09-10 is one persona's reflection lane at
# 758 MB (129 turns, 2026-09-06); the next two are that same lane again at
# 732 MB (2026-09-08) and Iris at 682 MB (2026-09-03), which was the previous
# value of this constant and the high across the first full grid.
#
# The original 682 replaced a reconstructed figure of 625 MB, inferred from the
# task table in the 2026-08-31 OOM dump. That was explicitly a lower bound
# taken at the instant of a kill, and the first night of real measurement
# exceeded it -- the expected direction for a lower bound, and the reason to
# stop using one. When a ledger records a higher peak than this, raise it here;
# this number is the max of the record, not an estimate.
WAKE_PEAK_MB = 758

# The session broker carries every web conversation in its own cgroup,
# admitted by the box's memory (lib/loam_broker.py, since 2026-11-09). Until
# 2026-11-16 the unit had a MemoryHigh (80% of RAM), past which the kernel
# throttles every session at once, and 90% of it was a warning. It has none
# now, so the warning stays quiet; it is kept because the High is read from
# the cgroup, never restated here, and would speak again if one came back.
BROKER_UNIT = "loam-session-broker"
BROKER_HIGH_WARN = 0.90

# Samples are 5 minutes apart; three missed in a row is a sampler that has
# stopped, not one that is late.
HISTORY_STALE = dt.timedelta(minutes=15)
DAY = dt.timedelta(hours=24)

# Unit kinds that are a fresh cgroup per run, so the cgroup's own memory.peak
# is that run's peak and catches what falls between two samples. The broker
# lives for days, so its is the sampled current.
PER_RUN = ("wake", "cron", "engineer", "reviewer")


def kind(unit: str) -> str:
    rest = unit.removeprefix("loam-")
    return "broker" if unit == BROKER_UNIT else rest.split("-", 1)[0]


def history_report(rows: list[dict], at: dt.datetime) -> tuple[list[str], list[str]]:
    """(lines, warnings) from the sampler's history at time `at`.

    Peak per unit over the last 24 h: the broker by name,
    and for each per-run kind the heaviest run. Disk: each mount's used now
    against the newest sample at least 24 h older, and each holder's latest
    daily `du` against the one before it.
    """
    rows = [r for r in rows if "units" in r]
    if not rows:
        return (["history          none -- logs/memsample.jsonl has no samples"],
                ["no memory history: is loam-memsample.timer running?"])
    stamp = [(dt.datetime.fromisoformat(r["ts"]), r) for r in rows]
    last_t, last = stamp[-1]
    warnings = []
    if at - last_t > HISTORY_STALE:
        warnings.append(f"memory history stopped: newest sample is {last['ts']}; "
                        f"is loam-memsample.timer running?")
    window = [r for t, r in stamp if t >= at - DAY]
    lines = [f"peak 24h         {len(window)} samples, every 5 min"]

    peaks: dict[str, tuple[int, int | None]] = {}       # unit -> (peak, high)
    for r in window:
        for unit, u in r["units"].items():
            v = u.get("peak") if kind(unit) in PER_RUN else u.get("cur")
            if v is not None and v > peaks.get(unit, (-1, None))[0]:
                peaks[unit] = (v, u.get("high"))

    def fmt(unit: str) -> str:
        v, high = peaks[unit]
        of = f" of {high} high ({v * 100 // high}%)" if high else ""
        return f"{v} MB{of}"

    for unit in sorted(peaks):
        if kind(unit) == "broker":
            lines.append(f"  {unit.removeprefix('loam-'):<18}{fmt(unit)}")
    for k in PER_RUN:
        runs = [u for u in peaks if kind(u) == k]
        if runs:
            top = max(runs, key=lambda u: peaks[u][0])
            lines.append(f"  {k + ' max':<18}{fmt(top)}  {top.removeprefix('loam-')}"
                         f"  ({len(runs)} run{'s' if len(runs) != 1 else ''})")
    if BROKER_UNIT in peaks:
        v, high = peaks[BROKER_UNIT]
        if high and v >= high * BROKER_HIGH_WARN:
            warnings.append(f"session broker peaked at {v} MB in 24 h, "
                            f"{v * 100 // high}% of its {high} MB MemoryHigh")

    older = [(t, r) for t, r in stamp if t <= last_t - DAY]
    base_t, base = older[-1] if older else stamp[0]
    lines.append(f"disk delta       since {base['ts'][:16]}"
                 + ("" if older else " (the oldest sample; under 24 h of history)"))
    for mount, m in last.get("mounts", {}).items():
        before = base.get("mounts", {}).get(mount)
        delta = f"{m['used'] - before['used']:+} MB" if before else "new"
        lines.append(f"  {mount:<18}{m['used']} MB used of {m['size']} MB ({delta})")
    daily = [r for r in rows if "holders" in r]
    if daily:
        now_h, prev = daily[-1], (daily[-2] if len(daily) > 1 else None)
        lines.append(f"holders          du {now_h['ts'][:16]}"
                     + (f" vs {prev['ts'][:16]}" if prev else " (the first)"))
        for name, v in now_h["holders"].items():
            p = prev["holders"].get(name) if prev else None
            delta = f" ({v - p:+} MB)" if v is not None and p is not None else ""
            lines.append(f"  {name:<18}{'--' if v is None else v} MB{delta}")
    return lines, warnings


def mb(path: Path) -> int:
    try:
        return int(path.read_text().strip()) // 1048576
    except (OSError, ValueError):
        return 0


def meminfo() -> dict:
    out = {}
    for line in Path("/proc/meminfo").read_text().splitlines():
        k, _, v = line.partition(":")
        out[k] = int(v.split()[0]) // 1024
    return out


def main() -> int:
    quiet = "--quiet" in sys.argv
    mi = meminfo()

    avail = mi.get("MemAvailable", 0)
    swap_free = mi.get("SwapFree", 0)
    swap_total = mi.get("SwapTotal", 0)
    headroom = avail + swap_free

    warnings, criticals = [], []

    wakes_that_fit = headroom // WAKE_PEAK_MB

    if headroom < WAKE_PEAK_MB:
        criticals.append(
            f"headroom {headroom} MB is below the heaviest wake's {WAKE_PEAK_MB} MB -- "
            f"a wake tonight would risk a global OOM kill")
    elif headroom < WAKE_PEAK_MB * 2:
        warnings.append(
            f"headroom {headroom} MB fits one wake but not two overlapping "
            f"({WAKE_PEAK_MB} MB each)")
    if swap_total and swap_free < swap_total * 0.15:
        criticals.append(
            f"swap {swap_free}/{swap_total} MB free -- swap reached zero in all "
            f"four global OOM kills")

    hist_lines, hist_warnings = history_report(
        memsample.history(), dt.datetime.now().astimezone())
    warnings += hist_warnings

    if not quiet:
        print(f"app.slice        {mb(CG / 'memory.current'):>7} MB"
              f"{mb(CG / 'memory.peak'):>6} MB peak"
              f"   (memory.max = {(CG / 'memory.max').read_text().strip()})")
        print(f"RAM              {mi.get('MemTotal', 0) - avail:>7} MB used of "
              f"{mi.get('MemTotal', 0)} MB, {avail} MB available")
        print(f"swap             {swap_total - swap_free:>7} MB used of {swap_total} MB")
        print(f"headroom         {headroom:>7} MB (available + free swap) "
              f"= {wakes_that_fit} wake(s) of {WAKE_PEAK_MB} MB")
        print()
        for line in hist_lines:
            print(line)
        print()

    for msg in criticals:
        print(f"CRITICAL: {msg}")
    for msg in warnings:
        print(f"WARNING:  {msg}")
    if not criticals and not warnings:
        print("OK -- headroom is within measured limits")

    return 2 if criticals else (1 if warnings else 0)


if __name__ == "__main__":
    sys.exit(main())
