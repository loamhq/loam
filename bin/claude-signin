#!/usr/bin/env python3
"""Notice the Claude Code sign-in, and write down what it is now.

``loam-claude-signin.path`` watches the Claude Code login file,
``~/.claude/.credentials.json`` (PathChanged: its creation, every rewrite,
its removal, even before ``~/.claude/`` exists), and runs this on each
change. A sign-in from the app (``POST /v1/providers/claude-code/login/code``)
and one at the CLI both land the file; a sign-out from either removes it.

What it does today is record the state in ``<state>/claude-signin.json``
(``{"signed_in", "at"}``) and print it to the unit's journal. It starts and
stops nothing. From 2026-11-14 to 2026-11-19 it was ``bin/rc-arm`` and armed
the Remote Control servers by it; Remote Control was retired on 11-19 (the
owner: "I don't use it through app anymore"). The watch was kept because a
sign-in is the moment to decide whether agents can run, and that decision
belongs here when it is made. The providers page does not depend on this:
the broker reads the login file itself (``loam_broker.CREDENTIALS_PATH``).

When the file is gone it looks again after a moment, so that a rewrite is
never read as a sign-out.

  claude-signin            notice and record
  claude-signin --dry-run  say what it sees, write nothing
"""

from __future__ import annotations

import json
import os
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import loam_config as lc  # noqa: E402

CREDENTIALS = lc.CLAUDE_HOME / ".credentials.json"
RECORD = lc.STATE / "claude-signin.json"
RECHECK_S = 3.0


def signed_in(credentials: Path = CREDENTIALS, sleep=time.sleep) -> bool:
    """Whether Claude Code is signed in; an absence is read twice."""
    if credentials.is_file():
        return True
    sleep(RECHECK_S)
    return credentials.is_file()


def write(record: Path, state: bool) -> dict:
    data = {"signed_in": state,
            "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    record.parent.mkdir(parents=True, exist_ok=True)
    tmp = record.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    os.replace(tmp, record)
    return data


def main(argv: list[str], credentials: Path = CREDENTIALS,
         sleep=time.sleep, record: Path = RECORD) -> int:
    state = signed_in(credentials, sleep)
    print(f"claude-signin: {'signed in' if state else 'no Claude Code sign-in'}")
    if "--dry-run" not in argv:
        write(record, state)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
