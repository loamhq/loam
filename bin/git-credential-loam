#!/usr/bin/env python3
"""A git credential helper: a fresh GitHub App installation token for one repo.

Added 2026-09-30 with the GitHub integration (lib/loam_github_app.py). A
project engineer's job is launched with git configured to reach
``git@github.com:`` remotes over https and to ask this helper for the password
(see ``git_env_for`` in bin/engineer-job). The helper asks the session broker
for an installation token scoped to the ONE repository the launcher named in
``LOAM_GIT_REPO``, carrying what the installation has accepted less
administration (``project_permissions`` in lib/loam_github_app.py), and
hands it to git on stdout. So:

  - no token is in a remote URL or in the checkout's config;
  - no token is in the job's transcript: git reads this process's stdout,
    the session never sees it;
  - a request for any other repository, or any other host, gets no answer,
    and git fails the way it fails for a wrong password.

``store`` and ``erase`` are accepted and ignored: the broker mints a fresh
token for every ask, so there is nothing for git to keep.

Environment: ``LOAM_GIT_REPO`` (owner/name, required), and for tests only
``LOAM_BROKER_URL`` and ``LOAM_BROKER_TOKEN_FILE``.
"""

from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import loam_broker as cfg  # noqa: E402


def read_request(stream) -> dict[str, str]:
    fields: dict[str, str] = {}
    for line in stream:
        line = line.rstrip("\n")
        if not line:
            break
        key, _, value = line.partition("=")
        fields[key] = value
    return fields


def say(message: str) -> None:
    print(f"git-credential-loam: {message}", file=sys.stderr)


def main(argv: list[str]) -> int:
    op = argv[1] if len(argv) > 1 else ""
    request = read_request(sys.stdin)
    if op != "get":
        return 0
    if request.get("protocol") != "https" or request.get("host") != "github.com":
        return 0
    wanted = os.environ.get("LOAM_GIT_REPO", "").strip()
    path = request.get("path", "").strip("/")
    if path.endswith(".git"):
        path = path[:-4]
    if not wanted:
        say("LOAM_GIT_REPO is not set; answering nothing")
        return 0
    if path and path.lower() != wanted.lower():
        say(f"this job may reach {wanted}, not {path}; answering nothing")
        return 0

    base = os.environ.get("LOAM_BROKER_URL") or f"http://{cfg.BIND_ADDR}:{cfg.PORT}"
    token_file = Path(os.environ.get("LOAM_BROKER_TOKEN_FILE") or cfg.TOKEN_PATH)
    try:
        bearer = token_file.read_text(encoding="utf-8").strip()
    except OSError as exc:
        say(f"cannot read the broker's token: {exc.strerror}")
        return 0
    req = urllib.request.Request(
        base + "/v1/integrations/github/token", method="POST",
        data=json.dumps({"repository": wanted}).encode(),
        headers={"Authorization": f"Bearer {bearer}",
                 "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            answer = json.loads(resp.read())
    except urllib.error.HTTPError as exc:
        try:
            reason = json.loads(exc.read()).get("error")
        except ValueError:
            reason = None
        say(f"the broker answered {exc.code}: {reason or exc.reason}")
        return 0
    except (urllib.error.URLError, OSError, ValueError) as exc:
        say(f"could not ask the broker: {exc}")
        return 0
    token = answer.get("token")
    if not token:
        say("the broker answered without a token")
        return 0
    sys.stdout.write(f"protocol=https\nhost=github.com\n"
                     f"username=x-access-token\npassword={token}\n\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
