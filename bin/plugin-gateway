#!/usr/bin/env python3
"""The address of every server plugin: /x/<id>/ (2026-11-13), the share door
/s/<token> (2026-11-16), and on-demand wake/sleep supervision (2026-11-23).

Caddy sends `/x/*` on the app's host (loam-ui, and its staging copy) here,
behind the same login as the page (lib/loam_deploy.py, PLUGIN_GATEWAY).
For on-demand plugins (the default unless `server.always_on: true` or
`box.listener` is declared), this gateway also holds each plugin's stable
front loopback port (`ports.json["ports"]`, exposed to agent tools as
`LOAM_PLUGIN_URL` and cross-plugin services as `/v1/plugin-services`) and
wakes the plugin's transient unit (`loam-plugin-<id>.service`) on its backend
port on the first request from `/x/<id>/`, `/s/<token>`, or direct loopback.

Concurrent first calls coalesce onto a single start; calls arriving during
idle shutdown wait for the stop to complete and wake the server cleanly;
in-flight requests, streaming responses, and WebSockets hold the plugin awake
until all active connections finish and a full quiet period (`PLUGIN_IDLE_S`,
default 10 minutes) elapses.

One request per connection to the plugin on `/x/<id>/` (`Connection: close`
on the way up), so a connection never carries two plugins' requests; a
WebSocket's upgrade goes through and is piped as it is. Direct loopback
connections on a plugin's front port are piped transparently without adding
or altering any HTTP header.
"""

from __future__ import annotations

import asyncio
import errno
import json
import os
import re
import signal
import subprocess
import sys
import time
from pathlib import Path
from typing import Callable

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

import loam_plugin_servers as servers  # noqa: E402

_PLUGIN_SERVERS_BIN = Path(__file__).resolve().parent / "plugin-servers"
_state_cache: dict = {"mtime": None, "doc": None}


def _load_gateway_state(*, force_refresh: bool = False) -> dict:
    """Read gateway.json; only invoke bin/plugin-servers in a short-lived
    subprocess when missing or stale so PyYAML never enters this daemon's heap."""
    path = servers.gateway_state_path()
    stale = force_refresh or servers.gateway_state_stale()
    if not stale:
        try:
            mt = path.stat().st_mtime
            if _state_cache["mtime"] == mt and isinstance(_state_cache["doc"], dict):
                return _state_cache["doc"]
        except OSError:
            stale = True
    if stale:
        try:
            done = subprocess.run(
                [sys.executable, str(_PLUGIN_SERVERS_BIN), "gateway-state"],
                capture_output=True, text=True, timeout=30,
            )
            if done.returncode == 0 and done.stdout.strip():
                doc = json.loads(done.stdout)
                if isinstance(doc, dict):
                    try:
                        _state_cache["mtime"] = path.stat().st_mtime
                    except OSError:
                        _state_cache["mtime"] = None
                    _state_cache["doc"] = doc
                    return doc
        except Exception as exc:  # noqa: BLE001
            print(f"plugin-gateway refresh state: {exc!r}", file=sys.stderr, flush=True)
    doc = servers.read_gateway_state() or {"wanted": {}, "door_owner": None}
    try:
        _state_cache["mtime"] = path.stat().st_mtime
    except OSError:
        _state_cache["mtime"] = None
    _state_cache["doc"] = doc
    return doc


def _wanted_from_state(*, force_refresh: bool = False) -> dict[str, dict]:
    doc = _load_gateway_state(force_refresh=force_refresh)
    wanted = doc.get("wanted")
    return dict(wanted) if isinstance(wanted, dict) else {}

DOOR_PATH = re.compile(r"^/s/([A-Za-z0-9_-]{32,64})(/[^?#]*)?(\?[^#]*)?$")
DOOR_METHODS = {"GET", "HEAD", "POST", "PATCH", "DELETE"}
DOOR_HEADERS = {"host", "content-type", "content-length", "accept", "accept-language",
                "user-agent", "x-loam-share", "x-loam-agent-name", "x-forwarded-for",
                "origin", "range"}
DOOR_BODY_MAX = 2 * 1024 * 1024
_owner_cache = {"at": 0.0, "pid": None}

HEAD_MAX = 64 * 1024
PATH = re.compile(r"^/x/([a-z][a-z0-9-]*)(/[^?#]*)?(\?.*)?$")
SAFE_METHODS = {"GET", "HEAD", "OPTIONS"}
HOP = {"connection", "keep-alive", "proxy-connection", "te", "trailer",
       "x-forwarded-prefix", "x-loam-door"}

PLUGIN_IDLE_S = float(os.environ.get("LOAM_PLUGIN_IDLE_S") or 600)
WAKE_TIMEOUT_S = float(os.environ.get("LOAM_PLUGIN_WAKE_TIMEOUT_S") or 30)


def cross_origin(method: str, lines: list[str]) -> bool:
    """Whether a request a page caused, from a page of another origin, could
    change something: the app's /api/* rule, for every plugin server."""
    head = {}
    for line in lines:
        if ":" in line:
            name, value = line.split(":", 1)
            head.setdefault(name.strip().lower(), value.strip())
    if method.upper() in SAFE_METHODS and "upgrade" not in head:
        return False
    site, origin, host = head.get("sec-fetch-site"), head.get("origin"), head.get("host", "")
    if site and site not in ("same-origin", "none"):
        return True
    return bool(origin) and origin not in (f"https://{host}", f"http://{host}")


def answer(status: int, reason: str, text: str, extra: str = "") -> bytes:
    body = (text + "\n").encode()
    return (f"HTTP/1.1 {status} {reason}\r\nContent-Type: text/plain; charset=utf-8\r\n"
            f"Content-Length: {len(body)}\r\nCache-Control: no-store\r\n{extra}"
            f"Connection: close\r\n\r\n").encode() + body


async def pipe(
    reader: asyncio.StreamReader,
    writer: asyncio.StreamWriter,
    on_activity: Callable[[], None] | None = None,
) -> None:
    try:
        while True:
            chunk = await reader.read(65536)
            if not chunk:
                break
            if on_activity is not None:
                on_activity()
            writer.write(chunk)
            await writer.drain()
    except (ConnectionError, asyncio.IncompleteReadError, asyncio.CancelledError):
        pass
    finally:
        try:
            if writer.can_write_eof():
                writer.write_eof()
        except (OSError, RuntimeError):
            pass


class _Slot:
    def __init__(
        self,
        *,
        pid: str,
        front_port: int,
        backend_port: int | None,
        spec: dict | None,
        on_demand: bool,
        awake: bool = False,
    ) -> None:
        self.pid = pid
        self.front_port = front_port
        self.backend_port = backend_port
        self.spec = spec
        self.on_demand = on_demand
        self.lock = asyncio.Lock()
        self.active = 0
        self.awake = awake
        self.last_active = time.monotonic()
        self.direct_server: asyncio.Server | None = None


class GatewaySupervisor:
    """Coordinates on-demand wake, direct loopback listeners, and idle sleep."""

    def __init__(
        self,
        *,
        idle_s: float = PLUGIN_IDLE_S,
        wake_timeout_s: float = WAKE_TIMEOUT_S,
        managed_fn: Callable[[], bool] | None = None,
        wanted_fn: Callable[[], dict[str, dict]] | None = None,
        start_fn: Callable[..., dict] | None = None,
        stop_fn: Callable[[str], dict] | None = None,
        status_fn: Callable[[str], dict] | None = None,
    ) -> None:
        self.idle_s = idle_s
        self.wake_timeout_s = wake_timeout_s
        self._managed_fn = managed_fn or servers.managed
        self._wanted_fn = wanted_fn or _wanted_from_state
        self._start_fn = start_fn or servers.start
        self._stop_fn = stop_fn or servers.stop
        self._status_fn = status_fn or servers.status
        self.slots: dict[str, _Slot] = {}
        self._sync_lock = asyncio.Lock()
        self._last_sync = 0.0

    def _is_managed(self) -> bool:
        try:
            return bool(self._managed_fn())
        except Exception:
            return False

    async def sync(self, *, bind_direct: bool = True, force_refresh: bool = False) -> None:
        """Align slot metadata and direct front-port listeners with wanted_servers()."""
        async with self._sync_lock:
            self._last_sync = time.monotonic()
            ports = servers.read_ports()
            if not self._is_managed():
                # Standalone / unmanaged mode (tests): keep port table only, no lifecycle.
                for pid in list(self.slots):
                    if pid not in ports:
                        await self._close_direct(self.slots.pop(pid))
                for pid, fport in ports.items():
                    if pid not in self.slots:
                        self.slots[pid] = _Slot(
                            pid=pid, front_port=fport, backend_port=None,
                            spec=None, on_demand=False, awake=True,
                        )
                    else:
                        self.slots[pid].front_port = fport
                        self.slots[pid].on_demand = False
                return

            try:
                if force_refresh and self._wanted_fn is _wanted_from_state:
                    want = await asyncio.to_thread(_wanted_from_state, force_refresh=True)
                else:
                    want = await asyncio.to_thread(self._wanted_fn)
            except Exception as exc:
                print(f"plugin-gateway sync wanted: {exc!r}", file=sys.stderr, flush=True)
                return

            ports = servers.read_ports()
            backends = servers.read_backend_ports()
            wanted_ids = set(want)

            # Remove listeners for plugins turned off or removed.
            for pid in list(self.slots):
                if pid not in wanted_ids:
                    slot = self.slots.pop(pid)
                    await self._close_direct(slot)

            for pid, spec in sorted(want.items()):
                always_on = bool(spec.get("always_on"))
                fport = ports.get(pid)
                if fport is None:
                    try:
                        fport = await asyncio.to_thread(servers.port_for, pid)
                    except Exception as exc:
                        print(f"plugin-gateway port_for {pid}: {exc!r}", file=sys.stderr, flush=True)
                        continue
                bport = None
                if not always_on:
                    bport = backends.get(pid)
                    if bport is None:
                        try:
                            bport = await asyncio.to_thread(servers.backend_port_for, pid)
                        except Exception as exc:
                            print(f"plugin-gateway backend_port_for {pid}: {exc!r}", file=sys.stderr, flush=True)
                            continue

                slot = self.slots.get(pid)
                if slot is None:
                    # On startup / newly observed on-demand plugin: check if its backend unit is already running.
                    already_up = False
                    if not always_on:
                        try:
                            st = await asyncio.to_thread(self._status_fn, pid)
                            already_up = st.get("state") in ("running", "starting")
                        except Exception:
                            already_up = False
                    slot = _Slot(
                        pid=pid, front_port=fport, backend_port=bport,
                        spec=spec, on_demand=not always_on,
                        awake=always_on or already_up,
                    )
                    self.slots[pid] = slot
                else:
                    if slot.front_port != fport or slot.on_demand != (not always_on):
                        await self._close_direct(slot)
                    slot.front_port = fport
                    slot.backend_port = bport
                    slot.spec = spec
                    slot.on_demand = not always_on
                    if always_on:
                        slot.awake = True

                if bind_direct and slot.on_demand and slot.direct_server is None:
                    await self._bind_direct(slot)
                elif (not slot.on_demand) and slot.direct_server is not None:
                    await self._close_direct(slot)

    async def _close_direct(self, slot: _Slot) -> None:
        srv = slot.direct_server
        slot.direct_server = None
        if srv is not None:
            srv.close()
            try:
                await asyncio.wait_for(srv.wait_closed(), timeout=2.0)
            except Exception:
                pass

    async def _bind_direct(self, slot: _Slot) -> None:
        pid = slot.pid
        async def _on_conn(r: asyncio.StreamReader, w: asyncio.StreamWriter) -> None:
            await direct_handle(pid, r, w, supervisor=self)

        try:
            slot.direct_server = await asyncio.start_server(_on_conn, "127.0.0.1", slot.front_port)
            return
        except OSError as exc:
            if exc.errno != errno.EADDRINUSE:
                print(f"plugin-gateway direct bind {pid}:{slot.front_port}: {exc!r}",
                      file=sys.stderr, flush=True)
                return
        # Upgrade path: an older pre-sleep unit may still hold the front port.
        try:
            uport = await asyncio.to_thread(servers.unit_port, pid)
            if uport == slot.front_port and slot.backend_port != slot.front_port:
                await asyncio.to_thread(self._stop_fn, pid)
                slot.awake = False
                for _ in range(20):
                    try:
                        slot.direct_server = await asyncio.start_server(_on_conn, "127.0.0.1", slot.front_port)
                        return
                    except OSError:
                        await asyncio.sleep(0.1)
        except Exception as exc:
            print(f"plugin-gateway upgrade takeover {pid}:{slot.front_port}: {exc!r}",
                  file=sys.stderr, flush=True)

    async def resolve_slot(self, pid: str) -> _Slot | None:
        if not self._is_managed():
            fport = servers.read_ports().get(pid)
            if fport is None:
                return None
            return _Slot(pid=pid, front_port=fport, backend_port=None,
                         spec=None, on_demand=False, awake=True)
        slot = self.slots.get(pid)
        if slot is None:
            await self.sync(bind_direct=True)
            slot = self.slots.get(pid)
        return slot

    async def connect(
        self,
        pid: str,
        *,
        timeout: float = 5.0,
    ) -> tuple[_Slot | None, asyncio.StreamReader, asyncio.StreamWriter]:
        """Connect to plugin `pid`, waking it transparently if it is an asleep on-demand plugin."""
        slot = await self.resolve_slot(pid)
        if slot is None:
            raise LookupError(f"no plugin {pid!r} has a server here")

        if not slot.on_demand or slot.backend_port is None or slot.spec is None:
            reader, writer = await asyncio.wait_for(
                asyncio.open_connection("127.0.0.1", slot.front_port), timeout,
            )
            return None, reader, writer

        # Claim active count BEFORE acquiring slot.lock so a concurrent reaper
        # cannot put the server to sleep between check and connect; if a stop is
        # already in progress under slot.lock, we wait for it and re-wake cleanly.
        slot.active += 1
        slot.last_active = time.monotonic()
        try:
            if slot.awake:
                try:
                    reader, writer = await asyncio.wait_for(
                        asyncio.open_connection("127.0.0.1", slot.backend_port), 2.0,
                    )
                    slot.last_active = time.monotonic()
                    return slot, reader, writer
                except (OSError, asyncio.TimeoutError):
                    pass  # fell asleep or crashed externally; wake under lock

            reader, writer = await self._wake_and_connect(slot)
            slot.last_active = time.monotonic()
            return slot, reader, writer
        except Exception:
            slot.active -= 1
            slot.last_active = time.monotonic()
            raise

    async def _wake_and_connect(
        self,
        slot: _Slot,
    ) -> tuple[asyncio.StreamReader, asyncio.StreamWriter]:
        async with slot.lock:
            assert slot.backend_port is not None and slot.spec is not None
            if slot.awake:
                try:
                    return await asyncio.wait_for(
                        asyncio.open_connection("127.0.0.1", slot.backend_port), 2.0,
                    )
                except (OSError, asyncio.TimeoutError):
                    slot.awake = False

            await asyncio.to_thread(self._start_fn, slot.pid, slot.spec, port=slot.backend_port)
            deadline = time.monotonic() + self.wake_timeout_s
            last_state_check = time.monotonic()
            last_err: Exception | None = None
            while time.monotonic() < deadline:
                try:
                    pair = await asyncio.wait_for(
                        asyncio.open_connection("127.0.0.1", slot.backend_port), 1.0,
                    )
                    slot.awake = True
                    slot.last_active = time.monotonic()
                    return pair
                except (OSError, asyncio.TimeoutError) as exc:
                    last_err = exc
                now = time.monotonic()
                if now - last_state_check >= 0.5:
                    last_state_check = now
                    try:
                        st = await asyncio.to_thread(self._status_fn, slot.pid)
                        if st.get("state") == "failing":
                            raise ConnectionError(f"{slot.pid}'s server failed during start")
                    except ConnectionError:
                        raise
                    except Exception:
                        pass
                await asyncio.sleep(0.025)
            raise TimeoutError(
                f"{slot.pid}'s server did not listen on 127.0.0.1:{slot.backend_port} "
                f"within {self.wake_timeout_s:.0f}s ({last_err})"
            )

    def touch(self, slot: _Slot | None) -> None:
        if slot is not None:
            slot.last_active = time.monotonic()

    def release(self, slot: _Slot | None) -> None:
        if slot is not None:
            slot.active = max(0, slot.active - 1)
            slot.last_active = time.monotonic()

    async def reap_once(self) -> list[str]:
        """Stop on-demand plugins that have had zero active connections for `idle_s`."""
        slept: list[str] = []
        now = time.monotonic()
        for slot in list(self.slots.values()):
            if not (slot.on_demand and slot.awake and slot.active == 0):
                continue
            if now - slot.last_active < self.idle_s:
                continue
            async with slot.lock:
                if not (slot.on_demand and slot.awake and slot.active == 0):
                    continue
                if time.monotonic() - slot.last_active < self.idle_s:
                    continue
                slot.awake = False
                try:
                    await asyncio.to_thread(self._stop_fn, slot.pid)
                    slept.append(slot.pid)
                except Exception as exc:
                    print(f"plugin-gateway sleep {slot.pid}: {exc!r}", file=sys.stderr, flush=True)
        return slept

    async def close_all(self) -> None:
        for slot in list(self.slots.values()):
            await self._close_direct(slot)


_SUPERVISOR = GatewaySupervisor()


async def direct_handle(
    pid: str,
    reader: asyncio.StreamReader,
    writer: asyncio.StreamWriter,
    *,
    supervisor: GatewaySupervisor | None = None,
) -> None:
    """Transparent TCP wake-and-proxy on a sleeping plugin's front loopback port."""
    sup = supervisor or _SUPERVISOR
    slot: _Slot | None = None
    up_writer: asyncio.StreamWriter | None = None
    try:
        try:
            slot, up_reader, up_writer = await sup.connect(pid)
        except Exception as exc:
            print(f"plugin-gateway direct {pid}: {exc!r}", file=sys.stderr, flush=True)
            return
        touch = lambda: sup.touch(slot)  # noqa: E731
        upward = asyncio.create_task(pipe(reader, up_writer, on_activity=touch))
        await pipe(up_reader, writer, on_activity=touch)
        upward.cancel()
        try:
            await upward
        except asyncio.CancelledError:
            pass
    except Exception as exc:  # noqa: BLE001
        print(f"plugin-gateway direct {pid}: {exc!r}", file=sys.stderr, flush=True)
    finally:
        if up_writer is not None:
            try:
                up_writer.close()
            except Exception:
                pass
        sup.release(slot)
        try:
            await writer.drain()
            writer.close()
        except Exception:
            pass


async def handle(
    reader: asyncio.StreamReader,
    writer: asyncio.StreamWriter,
    *,
    supervisor: GatewaySupervisor | None = None,
) -> None:
    sup = supervisor or _SUPERVISOR
    slot: _Slot | None = None
    up_writer: asyncio.StreamWriter | None = None
    try:
        try:
            head = await reader.readuntil(b"\r\n\r\n")
        except asyncio.LimitOverrunError:
            writer.write(answer(431, "Request Header Fields Too Large", "headers too large"))
            return
        except asyncio.IncompleteReadError:
            return
        lines = head.decode("latin-1").split("\r\n")
        try:
            method, target, version = lines[0].split(" ", 2)
        except ValueError:
            writer.write(answer(400, "Bad Request", "not an HTTP request"))
            return
        if target == "/up":
            writer.write(answer(200, "OK", "ok"))
            return
        m = PATH.match(target)
        if not m:
            writer.write(answer(404, "Not Found", "a plugin's address is /x/<id>/"))
            return
        pid, rest, query = m.group(1), m.group(2), m.group(3) or ""
        if rest is None:
            writer.write(answer(308, "Permanent Redirect", f"/x/{pid}/",
                                f"Location: /x/{pid}/{query}\r\n"))
            return
        if cross_origin(method, lines[1:]):
            writer.write(answer(403, "Forbidden",
                                "a plugin's server takes changes from its own origin's pages only",
                                "Vary: Sec-Fetch-Site, Origin\r\n"))
            return
        headers = []
        upgrade = False
        for line in lines[1:]:
            if not line:
                continue
            name = line.split(":", 1)[0].strip().lower()
            if name == "upgrade":
                upgrade = True
            if name in HOP:
                continue
            headers.append(line)
        headers.append("Connection: upgrade" if upgrade else "Connection: close")
        headers.append(f"X-Forwarded-Prefix: /x/{pid}")
        up_head = f"{method} {rest}{query} {version}\r\n" + "\r\n".join(headers) + "\r\n\r\n"
        try:
            slot, up_reader, up_writer = await sup.connect(pid)
        except LookupError:
            writer.write(answer(404, "Not Found", f"no plugin {pid!r} has a server here"))
            return
        except (OSError, asyncio.TimeoutError, TimeoutError, ConnectionError):
            writer.write(answer(502, "Bad Gateway",
                                f"{pid}'s server is not answering: it is off, starting "
                                f"or failing (Settings > Plugins shows which)"))
            return
        up_writer.write(up_head.encode("latin-1"))
        await up_writer.drain()
        # The exchange is over when the plugin's side ends: the request went
        # up with `Connection: close`, so the plugin closes after answering
        # (and a WebSocket's end closes it too). The client's side is left
        # open by Caddy's keep-alive and would never end on its own.
        touch = lambda: sup.touch(slot)  # noqa: E731
        upward = asyncio.create_task(pipe(reader, up_writer, on_activity=touch))
        await pipe(up_reader, writer, on_activity=touch)
        upward.cancel()
        try:
            await upward
        except asyncio.CancelledError:
            pass
    except Exception as exc:  # noqa: BLE001 -- one request never takes the gateway
        print(f"plugin-gateway: {exc!r}", file=sys.stderr, flush=True)
    finally:
        if up_writer is not None:
            try:
                up_writer.close()
            except Exception:
                pass
        sup.release(slot)
        try:
            await writer.drain()
            writer.close()
        except Exception:  # noqa: BLE001
            pass


def door_owner() -> str | None:
    """The plugin holding the door, read from gateway.json at most every 5 seconds."""
    now = time.monotonic()
    if now - _owner_cache["at"] > 5:
        try:
            owner = _load_gateway_state().get("door_owner")
            _owner_cache["pid"] = owner if isinstance(owner, str) else None
        except Exception as exc:  # noqa: BLE001 -- no owner is a closed door
            print(f"plugin-gateway: door owner: {exc!r}", file=sys.stderr, flush=True)
            _owner_cache["pid"] = None
        _owner_cache["at"] = now
    return _owner_cache["pid"]


def door_headers(lines: list[str]) -> list[str] | None:
    """The browser's headers that may pass the door, or None to refuse."""
    out = []
    for line in lines:
        if not line or ":" not in line:
            continue
        name, value = line.split(":", 1)
        low = name.strip().lower()
        value = value.strip()
        if low in ("upgrade", "transfer-encoding"):
            return None
        if low == "content-length" and (not value.isdigit() or int(value) > DOOR_BODY_MAX):
            return None
        if low in DOOR_HEADERS:
            out.append(f"{name.strip()}: {value}")
        elif low == "cookie":
            keep = [c.strip() for c in value.split(";") if c.strip().startswith("loam_share=")]
            if keep:
                out.append("Cookie: " + "; ".join(keep[:1]))
        elif low == "authorization" and value.lower().startswith("bearer lak_"):
            out.append(f"Authorization: {value}")
    return out


async def door(
    reader: asyncio.StreamReader,
    writer: asyncio.StreamWriter,
    *,
    supervisor: GatewaySupervisor | None = None,
) -> None:
    """The share door's port: `/s/<token>…` to the door's plugin, nothing else."""
    sup = supervisor or _SUPERVISOR
    slot: _Slot | None = None
    up_writer: asyncio.StreamWriter | None = None
    try:
        try:
            head = await reader.readuntil(b"\r\n\r\n")
        except asyncio.LimitOverrunError:
            writer.write(answer(431, "Request Header Fields Too Large", "headers too large"))
            return
        except asyncio.IncompleteReadError:
            return
        lines = head.decode("latin-1").split("\r\n")
        try:
            method, target, version = lines[0].split(" ", 2)
        except ValueError:
            writer.write(answer(400, "Bad Request", "not an HTTP request"))
            return
        m = DOOR_PATH.match(target)
        if not m or method not in DOOR_METHODS:
            writer.write(answer(404, "Not Found", "not found", "X-Robots-Tag: noindex\r\n"))
            return
        pid = door_owner()
        if not pid:
            writer.write(answer(404, "Not Found", "not found", "X-Robots-Tag: noindex\r\n"))
            return
        headers = door_headers(lines[1:])
        if headers is None:
            writer.write(answer(413, "Payload Too Large", "that request is not taken here",
                                "X-Robots-Tag: noindex\r\n"))
            return
        token, rest, query = m.group(1), m.group(2) or "/", m.group(3) or ""
        length = next((int(h.split(":", 1)[1]) for h in headers if h.lower().startswith("content-length:")), 0)
        headers += ["X-Loam-Door: 1", f"X-Forwarded-Prefix: /s/{token}", "Connection: close"]
        up_head = f"{method} /door/{token}{rest}{query} {version}\r\n" + "\r\n".join(headers) + "\r\n\r\n"
        body = await reader.readexactly(length) if length else b""
        try:
            slot, up_reader, up_writer = await sup.connect(pid)
        except LookupError:
            writer.write(answer(404, "Not Found", "not found", "X-Robots-Tag: noindex\r\n"))
            return
        except (OSError, asyncio.TimeoutError, TimeoutError, ConnectionError):
            writer.write(answer(502, "Bad Gateway", "this page is not answering just now",
                                "X-Robots-Tag: noindex\r\n"))
            return
        up_writer.write(up_head.encode("latin-1") + body)
        await up_writer.drain()
        touch = lambda: sup.touch(slot)  # noqa: E731
        await pipe(up_reader, writer, on_activity=touch)
    except Exception as exc:  # noqa: BLE001 -- one request never takes the gateway
        print(f"plugin-gateway door: {exc!r}", file=sys.stderr, flush=True)
    finally:
        if up_writer is not None:
            try:
                up_writer.close()
            except Exception:
                pass
        sup.release(slot)
        try:
            await writer.drain()
            writer.close()
        except Exception:  # noqa: BLE001
            pass


async def _housekeep(sup: GatewaySupervisor, wake_sync: asyncio.Event, stop: asyncio.Event) -> None:
    interval = max(0.25, min(5.0, sup.idle_s / 4.0))
    while not stop.is_set():
        try:
            await asyncio.wait_for(wake_sync.wait(), timeout=interval)
            wake_sync.clear()
            _owner_cache["at"] = 0.0
        except asyncio.TimeoutError:
            pass
        if stop.is_set():
            break
        try:
            await sup.sync(bind_direct=True)
            await sup.reap_once()
        except Exception as exc:
            print(f"plugin-gateway housekeep: {exc!r}", file=sys.stderr, flush=True)


async def main() -> None:
    port = int(sys.argv[1]) if len(sys.argv) > 1 else servers.GATEWAY_PORT
    door_port = int(sys.argv[2]) if len(sys.argv) > 2 else servers.DOOR_PORT
    startup_fp = servers.gateway_code_fingerprint()
    pid_path = servers.gateway_pid_path()
    try:
        pid_path.parent.mkdir(parents=True, exist_ok=True)
        pid_path.write_text(f"{os.getpid()}\n", encoding="utf-8")
    except OSError:
        pass

    wake_sync = asyncio.Event()
    stop = asyncio.Event()
    loop = asyncio.get_running_loop()
    try:
        loop.add_signal_handler(signal.SIGHUP, wake_sync.set)
    except (NotImplementedError, OSError):
        pass
    for sig in (signal.SIGTERM, signal.SIGINT):
        try:
            loop.add_signal_handler(sig, stop.set)
        except (NotImplementedError, OSError):
            pass

    await _SUPERVISOR.sync(bind_direct=True, force_refresh=True)
    server = await asyncio.start_server(handle, "127.0.0.1", port, limit=HEAD_MAX)
    door_server = await asyncio.start_server(door, "127.0.0.1", door_port, limit=HEAD_MAX)
    try:
        servers.write_gateway_running(pid=os.getpid(), fingerprint=startup_fp)
    except OSError:
        pass
    task = asyncio.create_task(_housekeep(_SUPERVISOR, wake_sync, stop))
    print(json.dumps({
        "listening": f"127.0.0.1:{port}",
        "door": f"127.0.0.1:{door_port}",
        "direct": sorted(s.pid for s in _SUPERVISOR.slots.values() if s.direct_server is not None),
    }), flush=True)
    try:
        await stop.wait()
    finally:
        task.cancel()
        try:
            await task
        except asyncio.CancelledError:
            pass
        await _SUPERVISOR.close_all()
        server.close()
        door_server.close()
        try:
            await asyncio.gather(server.wait_closed(), door_server.wait_closed())
        except Exception:
            pass
        try:
            if pid_path.read_text(encoding="utf-8").strip() == str(os.getpid()):
                pid_path.unlink(missing_ok=True)
        except OSError:
            pass
        try:
            rec = servers.read_gateway_running()
            if rec and rec.get("pid") == os.getpid():
                servers.gateway_running_path().unlink(missing_ok=True)
        except OSError:
            pass


if __name__ == "__main__":
    asyncio.run(main())
