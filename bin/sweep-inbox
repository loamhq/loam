#!/usr/bin/env python3
"""Daily expiry inside the owner's inbox. Runtime-independent.

**Why `archive/` ages on ctime and the commons ages on mtime.** A commons
note is written in place, so its mtime *is* its age. An archived file is not:
The owner moves a note they wrote in March into `archive/` in September, and both
a same-filesystem `mv` and a file-sync transfer preserve the sender's mtime,
so mtime says "March" and the file would be deleted at the next sweep --
before they could ever fish it back. The clock has to start when the file
entered the archive, and that is what ctime records: a rename updates it, and
so does the create a file sync performs on this side when the move happens on
another device. It cannot be set backwards by any tool, and everything that bumps it
spuriously (a chmod, a re-download) over-retains, which is the safe direction.
`git add`/`commit` -- all vault-autocommit does -- touches neither.
"""

from __future__ import annotations

import argparse
import sys
import time
from datetime import timedelta
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import loam_config as lc  # noqa: E402

VAULT = lc.VAULT
ARCHIVE = f"{lc.vault_folder('inbox')}/archive"

ARCHIVE_WINDOW = timedelta(days=30)

# Structure, never a swept item -- same role README.md plays in the commons.
PRESERVED_NAMES = frozenset({"README.md", ".gitkeep"})

def is_sweepable(path: Path) -> bool:
    return (
        path.is_file()
        and path.name not in PRESERVED_NAMES
        and not path.name.startswith(".")
    )


def sweep_archive(root: Path, window: timedelta, now: float, dry_run: bool) -> int:
    """Delete files that entered the archive more than `window` ago."""
    if not root.exists():
        print(f"archive sweep: {root} does not exist, nothing to do")
        return 0
    cutoff = now - window.total_seconds()
    removed = 0
    for path in sorted(root.rglob("*")):
        if not is_sweepable(path):
            continue
        try:
            st = path.stat()
        except OSError as exc:
            print(f"  cannot stat {path} ({exc}); skipping", file=sys.stderr)
            continue
        if st.st_ctime >= cutoff:
            continue
        if not dry_run:
            try:
                path.unlink()
            except OSError as exc:
                print(f"  cannot remove {path} ({exc}); skipping", file=sys.stderr)
                continue
        removed += 1
        print(f"  {'would remove' if dry_run else 'removed'} "
              f"{path.relative_to(root)} (in archive "
              f"{(now - st.st_ctime) / 86400:.1f}d, content "
              f"{(now - st.st_mtime) / 86400:.1f}d old)")
    print(f"archive sweep: {removed} file(s) older than {window.days}d "
          f"{'would be removed' if dry_run else 'removed'} from {root}")
    return removed


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--vault", type=Path, default=VAULT)
    ap.add_argument("--archive-days", type=int, default=ARCHIVE_WINDOW.days)
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--now", type=float, default=None,
                    help="override the clock (unix ts); for verification")
    args = ap.parse_args()

    now = args.now if args.now is not None else time.time()

    sweep_archive(args.vault / ARCHIVE, timedelta(days=args.archive_days),
                  now, args.dry_run)
    return 0


if __name__ == "__main__":
    sys.exit(main())
