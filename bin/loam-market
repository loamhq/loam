#!/usr/bin/env python3
"""The marketplace: what it lists, and asking for a plugin to be listed.

  loam market list [--refresh] [--json]
      What the marketplace lists now, each marked installed or not. Install
      one with its link, as any link (Settings › Market, or `bin/settings
      plugin.install`).
  loam market search [words…] [--kind theme|extension|app|agent|skill] [--json]
      What the Market lists that answers the words, best first: the Market
      page's own search. Each result carries `card`, the line that shows its
      listing card in a reply (a line of its own). Nothing listed, or nothing
      matching, says so; offer to build it then.
  loam market link <any GitHub link> [--json]
      What a link someone shared holds, read as the app's install sheet reads
      it, installing nothing: a repository's address is enough (owner/repo,
      a .git address, a /tree/, /blob/ or release link all work). It finds the
      newest release and the plugin's folder; a branch is read at the commit
      it is on now, and `note` says so. The answer carries `card`, the line
      that shows an install card for it in a reply (a line of its own); a
      repository of several plugins answers each, with its own card.
  loam market share <plugin id> <owner/name> [--json]
      Share a plugin from the owner's plugins folder by link: its folder is
      pushed to that GitHub repository (the owner makes it on github.com;
      whether it is public is their yes) as <id>/ at the tag v<version>,
      through the GitHub account connected in Settings › Connections. The
      answer is the link anyone installs it by.
  loam market request <link at a tag> --description "one sentence" [--json]
      The listing for the plugin at that link, read from the plugin itself,
      and a link to GitHub that proposes it to the marketplace as a pull
      request. Nothing is sent: show the owner the listing; on their yes,
      give them the link. They open it signed in to their own GitHub account
      and press Propose, which opens a pull request to the marketplace.

The rules are lib/loam_marketplace.py; the format is docs/plugins.md, "The
marketplace". Exit 0, or 2 with the reason on stderr.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import loam_marketplace as mk  # noqa: E402
import loam_plugins  # noqa: E402


def extras(e: dict) -> list[str]:
    """The creator's links and the cover, a line each, when a listing has them."""
    links = (e.get("creator") or {}).get("links") or []
    out = [f"{e['author']}: " + ", ".join(f"{x['label']} {x['url']}" for x in links)] if links else []
    if e.get("downloads"):
        n = e["downloads"]
        out.append(f"{n:,} download" + ("s" if n != 1 else ""))
    cover = e.get("cover_url") or e.get("cover")
    if cover and cover.startswith("https://"):
        out.append(f"cover: {cover}")
    return out


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(prog="loam market", description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="verb", required=True)
    ls = sub.add_parser("list")
    ls.add_argument("--refresh", action="store_true")
    ls.add_argument("--json", action="store_true")
    se = sub.add_parser("search")
    se.add_argument("words", nargs="*")
    se.add_argument("--kind", default="all")
    se.add_argument("--limit", type=int, default=mk.SEARCH_LIMIT)
    se.add_argument("--refresh", action="store_true")
    se.add_argument("--json", action="store_true")
    ln = sub.add_parser("link")
    ln.add_argument("link")
    ln.add_argument("--json", action="store_true")
    sh = sub.add_parser("share")
    sh.add_argument("plugin")
    sh.add_argument("repository")
    sh.add_argument("--json", action="store_true")
    rq = sub.add_parser("request")
    rq.add_argument("link")
    rq.add_argument("--description", required=True,
                    help="one sentence, at most 200 characters, saying what it does")
    rq.add_argument("--json", action="store_true")
    args = ap.parse_args(argv)

    if args.verb == "list":
        out = mk.listing(refresh=args.refresh)
        if args.json:
            print(json.dumps(out, indent=2))
            return 0
        if out["state"] == "off":
            print("The marketplace is turned off on this install (marketplace.list is empty).")
        elif out["state"] == "unreachable":
            print(f"The marketplace could not be read: {out['message']}")
        elif not out["plugins"]:
            print("Nothing is listed in the marketplace yet.")
        for e in out["plugins"]:
            mark = f"installed {e['installed_version'] or ''}".strip() if e["installed"] else ""
            print(f"{e['name']} ({e['id']}), by {e['author']} · {', '.join(e['kind'])}"
                  f"{' · ' + mark if mark else ''}")
            if e.get("description"):
                print(f"  {e['description']}")
            for line in extras(e):
                print(f"  {line}")
            print(f"  {e['link']}")
        for why in out["skipped"]:
            print(f"(left out: {why})", file=sys.stderr)
        return 0

    if args.verb == "search":
        try:
            out = mk.search(" ".join(args.words), args.kind, args.limit, args.refresh)
        except (ValueError, mk.SearchError) as exc:
            if args.json:
                print(json.dumps({"ok": False, "error": str(exc)}))
                return 2
            print(exc, file=sys.stderr)
            return 2
        if args.json:
            print(json.dumps(out, indent=2, ensure_ascii=False))
            return 0
        print(out["say"])
        for e in out["results"]:
            state = "installed" if e["installed"] else "" if e["installable"] else "listed, not installable yet"
            print(f"\n{e['name']} ({e['id']}), by {e['author']} · {', '.join(e['kind'])}"
                  f"{' · ' + state if state else ''}")
            if e["description"]:
                print(f"  {e['description']}")
            for line in extras(e):
                print(f"  {line}")
            print(f"  card: {e['card']}")
        return 0

    if args.verb == "link":
        try:
            out = mk.read_link(args.link)
        except loam_plugins.PluginError as exc:
            if args.json:
                print(json.dumps({"ok": False, "error": exc.message,
                                  "reason": exc.detail.get("reason")}))
                return 2
            print(f"loam market: {exc.message}", file=sys.stderr)
            return 2
        if args.json:
            print(json.dumps(out, indent=2, ensure_ascii=False))
            return 0
        if out.get("choose"):
            print(f"github.com/{out['repo']} holds {len(out['choose'])} plugins:")
            for c in out["choose"]:
                print(f"\n{c['name']} ({c.get('id') or c['path']})"
                      + (f", version {c['version']}" if c.get("version") else "")
                      + (" · its PLUGIN.md cannot be read" if c.get("broken") else ""))
                if c.get("description"):
                    print(f"  {c['description']}")
                if c.get("card"):
                    print(f"  card: {c['card']}")
            return 0
        print(f"{out['name']} ({out['id']}) {out['version']}, by {out['author']} · "
              f"{', '.join(out['kind'] or [])}")
        if out.get("description"):
            print(f"  {out['description']}")
        if out.get("note"):
            print(f"  {out['note']}")
        if out.get("installable") is False:
            print(f"  {out['why']}")
        print(f"  pinned at: {out['link']}")
        print(f"  card: {out['card']}")
        return 0

    if args.verb == "share":
        try:
            out = mk.share(args.plugin, args.repository)
        except mk.ShareError as exc:
            print(f"loam market: {exc}", file=sys.stderr)
            return 2
        if args.json:
            print(json.dumps(out, indent=2))
            return 0
        print(f"Shared {out['id']} {out['version']} to {out['repo']} at {out['tag']}.")
        print(f"The link to install it by: {out['link']}")
        if out["public"] is False:
            print("The repository is private, so the link works only for its owner. "
                  "Making it public is the owner's direct yes (on github.com, the "
                  "repository's Settings › Danger zone › Change visibility).")
        return 0

    try:
        out = mk.listing_request(args.link, args.description)
    except (ValueError, loam_plugins.PluginError) as exc:
        print(f"loam market: {getattr(exc, 'message', exc)}", file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(out, indent=2))
        return 0
    print(f"The listing for {out['repo']}, as listings/{out['entry']['id']}.json:\n")
    print(json.dumps(out["entry"], indent=2, ensure_ascii=False))
    print("\nOn the owner's yes, give them this link. GitHub opens the file filled in; "
          "they press Propose, and then Create pull request:")
    print(out["url"])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
