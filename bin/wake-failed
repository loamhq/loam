#!/usr/bin/env python3
"""Record failures that outlive the wake, cron or engineer process that would report them.

A wake or cron removes its marker when bookkeeping finishes. A surviving
marker identifies an unfinished run and the vault it actually used. Import
the wrapper's append logic so both paths write the same record. The engineer
launcher has its own receipt recovery path."""

from __future__ import annotations

import importlib.machinery
import importlib.util
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import loam_config as lc  # noqa: E402

AGENTS = lc.ROOT
UNIT_PREFIX = "loam-wake-"
CRON_PREFIX = "loam-cron-"
# The transient unit one engineer job runs in. It is not a wake and not a
# cron, and it is here for the one failure the launcher cannot report on
# itself: bin/engineer-job writes its own receipt from a `finally`, so every
# Python-level exit is already on the record and only a SIGKILL leaves the
# marker behind. That is the same discriminator the wake half uses.
#
# The engineer never reaches the owner -- its interlocutor is the persona that
# briefed it, and that is the role file's line, not a convenience. What lands
# in the failure log here is not the engineer speaking: it is systemd
# observing a unit death from outside the dead process, in the same file every
# other unit death on this box is recorded in.
ENGINEER_PREFIX = "loam-engineer-"
REVIEWER_UNIT = "loam-reviewer"


def lane_of(unit: str) -> tuple[str, str]:
    """``(agent, lane)`` from the failed unit's name.

    The cron half defers to lib/loam_cron, which resolves the agent against
    the live roster rather than splitting on the first dash -- both an agent
    name and a cron name may contain one, and only the roster knows the seam.
    """
    if unit.startswith(UNIT_PREFIX):
        return unit[len(UNIT_PREFIX):], "reflection"
    if unit.startswith(ENGINEER_PREFIX):
        # Checked BEFORE the cron prefix would ever be reached and before any
        # roster lookup, because "engineer" is not on the roster: it has no
        # ai-labs workspace, no soul and no wake. The job id is the lane.
        return "engineer", f"job:{unit[len(ENGINEER_PREFIX):]}"
    if unit == REVIEWER_UNIT:
        # The reviewer (Move 11): one static unit, not a persona and not on
        # the roster. bin/review drops the same marker a wake does.
        return "reviewer", "review"
    if unit.startswith(CRON_PREFIX):
        from loam_cron import split_unit  # noqa: PLC0415
        agent, name = split_unit(unit)
        return agent, f"cron:{name}"
    raise ValueError(f"not a Loam wake or cron unit: {unit}")


# bin/engineer-job's TIMEOUT_EXIT. Restated rather than imported, because
# importing the launcher to read one constant would make this handler fail
# with it; tests/test_engineer_timeout.py asserts the two agree.
ENGINEER_TIMEOUT_EXIT = 124


def engineer_marker(state_dir: Path, lane: str) -> Path | None:
    """The run marker of the engineer job this lane names, or None.

    An engineer's marker is named for its LOCK, not its job --
    `engineer.running` for the platform engineer, `engineer-<project>.running`
    for a project's -- and the job id is inside it. Until 2026-09-30 this
    handler looked only at `engineer.running`, so a project engineer's
    SIGKILL went unrecorded, and one that died while the platform engineer
    was mid-job was reported as the platform engineer's death, with its live
    marker unlinked. Matching the lane inside the marker is the only reading
    that names the job that died.
    """
    for marker in sorted(state_dir.glob("engineer*.running")):
        try:
            if json.loads(marker.read_text(encoding="utf-8")).get("lane") == lane:
                return marker
        except (OSError, json.JSONDecodeError):
            continue
    return None


def load_wake():
    """Import bin/wake for its failure-recording functions. It has no .py
    suffix, so it needs an explicit loader -- the same trick bin/check-drift
    uses to read the generators."""
    loader = importlib.machinery.SourceFileLoader("wake", str(AGENTS / "bin" / "wake"))
    spec = importlib.util.spec_from_loader("wake", loader)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def unit_property(unit: str, name: str) -> str:
    out = subprocess.run(
        ["systemctl", "--user", "show", unit, "-p", name, "--value"],
        capture_output=True, text=True, check=False,
    )
    return out.stdout.strip()


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: wake-failed <failed-unit-name>", file=sys.stderr)
        return 64

    unit = sys.argv[1].removesuffix(".service")
    try:
        agent, lane = lane_of(unit)
    except Exception as exc:  # noqa: BLE001 -- a bad unit name must not raise
        print(exc, file=sys.stderr)
        return 64

    wake = load_wake()
    if agent == "engineer":
        # bin/engineer-job exits TIMEOUT_EXIT when the wall clock cut its
        # session and has written that job's whole record itself. The unit
        # declares the code a success, so this is reached only by a unit
        # started before it did; either way a timeout is an outcome, not a
        # death.
        if unit_property(f"{unit}.service", "ExecMainStatus") == str(ENGINEER_TIMEOUT_EXIT):
            return 0
        marker = engineer_marker(wake.STATE_DIR, lane)
    else:
        marker = wake.STATE_DIR / f"{agent}.running"
    if marker is None or not marker.exists():
        # The wrapper lived long enough to record its own outcome. Silence
        # here is the correct output: the failure is already on the record.
        return 0

    try:
        run_state = json.loads(marker.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        run_state = {}
    started = run_state.get("ts", "unknown")
    vault = Path(run_state.get("vault") or lc.VAULT)
    # The marker's own record of the lane wins over the unit name: the marker
    # was written by the run that died, and the unit name is what systemd
    # happened to hand this handler. They agree in every ordinary case, and
    # when they do not, the dead run's own account is the one to keep.
    lane = run_state.get("lane", lane)

    result = unit_property(unit, "Result") or "unknown"
    code = unit_property(unit, "ExecMainCode")
    status = unit_property(unit, "ExecMainStatus")

    reason = (
        f"{lane} died mid-run without recording anything (started {started}; "
        f"systemd result={result} code={code} status={status}). Whatever it "
        f"had already written to disk stands; the rest of the run is lost. "
        f"result=oom-kill means the box ran out of memory and the kernel's "
        f"OOM order took this run first; no agent run has a memory ceiling "
        f"of its own (2026-11-16)."
    )
    print(reason, file=sys.stderr)
    payload = {
        "ts": started, "ok": False, "stage": "died_mid_run", "lane": lane,
        "systemd_result": result, "exec_main_code": code,
        "exec_main_status": status, "reported_by": "wake-failed",
    }
    if agent == "reviewer":
        from loam_inbox import record_fault  # noqa: PLC0415
        record_fault(agent, vault, reason)
        with (lc.LOGS / "reviewer.jsonl").open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(payload) + "\n")
    else:
        wake.record_failure(agent, vault, reason)
        wake.log_line(agent, payload)
        # The schedule log's fire line, which bin/wake's `finally` never got
        # to write (2026-10-14): Activity shows the run as killed, not absent.
        import loam_schedule  # noqa: PLC0415
        import loam_cron  # noqa: PLC0415
        record = (lane[len("cron:"):] if lane.startswith("cron:")
                  else loam_cron.REFLECTION)
        loam_schedule.record_fire(
            agent, record, "killed", lane=lane, started=started,
            stage=f"systemd result={result} code={code} status={status}",
            reported_by="wake-failed")

    if result == "oom-kill":
        import loam_limits  # noqa: PLC0415
        subj = {"agent": agent, "lane": lane, "unit": unit}
        if lane.startswith("job:"):
            subj["job"] = lane[len("job:"):]
        loam_limits.record_safe(
            "oom_kill",
            outcome="killed",
            subject=subj,
            detail={"source": "systemd_onfailure", "systemd_result": result,
                    "returncode": int(status) if status.isdigit() else None},
        )

    # The marker has served its purpose. Leaving it would make the next
    # failure of any kind look like a second unrecorded death.
    marker.unlink(missing_ok=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
