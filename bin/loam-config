#!/usr/bin/env python3
"""The install's configuration, for shell scripts and people.

  loam-config get KEY      one value (`paths.vault`, `owner.name`, ...)
  loam-config show         every key this install answers for, `key = value`
  loam-config path         the config file read

Values come from lib/loam_config.py, which reads /etc/loam/loam.toml (or
$LOAM_CONFIG) and fills a missing key with the fresh install's layout.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import loam_config as lc  # noqa: E402


def main(argv: list[str]) -> int:
    if len(argv) == 2 and argv[0] == "get":
        values = lc.as_dict()
        if argv[1] not in values:
            print(f"loam-config: no key {argv[1]!r}", file=sys.stderr)
            return 2
        print(values[argv[1]])
        return 0
    if argv == ["show"]:
        for key, value in lc.as_dict().items():
            print(f"{key} = {value}")
        return 0
    if argv == ["path"]:
        print(lc.CONFIG_FILE)
        return 0
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
