#!/usr/bin/env python3
"""Tell the agent that hears when something in Loam needs attention a fact.

  loam tell "<what happened>" [--by <who says so>] [--key <same-fact key>]
            [--evidence <where to look>]

For a plugin, a script or a timer: the fact goes to the agent the owner
chose in Settings › Agents (the first agent by default) as the input of a
run, told once; nothing is posted anywhere, and that agent decides what to
do and whether the owner hears of it (lib/loam_attention.py, docs/plugins.md).
Prints what happened: told, repeat (the same fact, not yet quiet for three
days), or failed.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import loam_attention  # noqa: E402


def main(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="loam tell", description=__doc__.split("\n\n")[0])
    p.add_argument("fact", help="what happened, in plain words")
    p.add_argument("--by", default="loam", help="who says so: a plugin's id, a script's name")
    p.add_argument("--key", default=None,
                   help="what makes two tellings the same fact (default: the "
                        "fact's first sentence with its numbers out)")
    p.add_argument("--evidence", default=None, help="where to look: a path, a log, a command")
    args = p.parse_args(argv)
    said = loam_attention.tell(args.fact, by=args.by, key=args.key, evidence=args.evidence)
    print(said)
    return 1 if said.startswith("failed") else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
