#!/usr/bin/env python3
"""The claim, and the login's one-time codes relayed to the owner.

A system service on loopback (`loam-claim.service`, port 8934), root because
both halves touch the login's own files. Caddy reaches it on two paths of the
app's host and on nothing else (lib/loam_deploy.py, `[edge]`):

  /claim                  OUTSIDE the login, rendered only while the install
                          is unclaimed (/etc/loam/claim exists).
    GET                   the self-contained claim page
    GET ?status           the stage of setup, without account information
    POST {token, username, password}
                          validate the one-time link and start setup. The
                          account is saved and the login started in a worker;
                          once the gated app takes over, this route is gone.

  /_loam/login-code       BEHIND the login, ahead of the browser's subnet.
    GET                   the newest one-time code the login wrote to its
                          file notifier, to the signed-in owner and nobody
                          else (Remote-User, set by the gate, must be the
                          users file's one admin). This is how a person
                          without a shell adds a passkey: Authelia asks for
                          a code it "emailed", and this box has no mail.

  /_loam/passkeys         BEHIND the login, ahead of the browser's subnet, on
                          every app-shell host (2026-11-17).
    GET                   {"passkeys": [{id, description, created_at,
                          last_used_at}]}: the signed-in person's own, from
                          the login's own API, asked with that person's own
                          session cookie and nothing else, so the login
                          decides whose list it is. The app's Settings ›
                          Sign-in shows it (app/public/passkey.js).
    DELETE /_loam/passkeys/<id>
                          the login's own removal, passed through the same
                          way; the login asks for the elevated session it
                          always asks for. The app does not call it today:
                          its Remove opens the portal's settings.

docs/install.md has the page contract both answer to. First release L12.
"""

from __future__ import annotations

import datetime as dt
import hmac
import json
import os
import re
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

# No bytecode beside the code: anything in the checkout a release did not
# put there refuses the next update (L13's clean-tree rule).
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import loam_config as lc  # noqa: E402
import loam_deploy as dep  # noqa: E402
import loam_install as li  # noqa: E402

ROOT = Path(__file__).resolve().parent.parent
USERNAME_RE = re.compile(r"^[a-z][a-z0-9_-]{1,31}$")
MIN_PASSWORD = 10
MAX_BODY = 8192
# A wrong token is answered slowly, and a run of them is refused for a while:
# the token is 192 bits, so this is manners, not the lock.
FAILS: list[float] = []
FAIL_WINDOW, FAIL_LIMIT = 600, 20
LOCK = threading.Lock()
# The durable boundary is CLAIMED_FILE. In-memory stages only describe the
# current worker or a failure that the next submission or startup can retry.
CLAIM_STAGE = "open"
CODE_MAX_AGE = 15 * 60   # a code older than this is not shown


def log(msg: str) -> None:
    print(f"loam-claim: {msg}", flush=True)


def run(argv: list[str], **kw) -> subprocess.CompletedProcess:
    return subprocess.run(argv, capture_output=True, text=True, check=False, **kw)


# ---------------------------------------------------------------------------
# The login's files, in its native data directory
# ---------------------------------------------------------------------------

def volume_dir() -> Path | None:
    """Host directory holding users_database.yml and notification.txt:
    authelia_data_dir() directly on native installs (zero Docker), falling back
    to Docker's authelia-data volume only while a legacy compose file still
    stands and Docker is already running."""
    native = dep.authelia_data_dir()
    if native.is_dir() or not dep.AUTHELIA_COMPOSE.exists():
        return native
    if dep.docker_active():
        import loam_data_disk as dd  # noqa: PLC0415
        return dd.docker_volume_path("authelia-data", run=run)
    return native


def users() -> dict:
    vol = volume_dir()
    if vol is None:
        return {}
    try:
        import yaml  # noqa: PLC0415
        doc = yaml.safe_load((vol / "users_database.yml").read_text(encoding="utf-8")) or {}
    except (OSError, ValueError):
        return {}
    return doc.get("users") or {}


def hash_password(password: str) -> str:
    """argon2id by Authelia's own native binary over a PTY, so the password
    never appears in argv, environment or disk, and Docker is never woken."""
    return dep.hash_password(password)


def write_users(username: str, display: str, digest: str) -> None:
    import pwd  # noqa: PLC0415
    domain = dep.domain()
    text = (
        "# The login's users. Written by the claim (bin/loam-claim); Authelia\n"
        "# rewrites it when the password changes. Lives outside every repo.\n"
        "users:\n"
        f"  {username}:\n"
        "    disabled: false\n"
        f"    displayname: {json.dumps(display)}\n"
        f"    password: '{digest}'\n"
        f"    email: '{username}@{domain}'\n"
        "    groups:\n"
        "      - 'admins'\n")
    data_dir = volume_dir() or dep.authelia_data_dir()
    try:
        pw = pwd.getpwnam(dep.AUTHELIA_USER)
        uid, gid = pw.pw_uid, pw.pw_gid
    except KeyError:
        uid, gid = os.geteuid(), os.getegid()
    data_dir.parent.mkdir(parents=True, mode=0o755, exist_ok=True)
    data_dir.mkdir(mode=0o700, exist_ok=True)
    if os.geteuid() == 0:
        os.chown(data_dir, uid, gid)
    os.chmod(data_dir, 0o700)
    target = data_dir / "users_database.yml"
    tmp = target.with_name(f".users_database.yml.new.{os.getpid()}")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
        if os.geteuid() == 0:
            os.chown(tmp, uid, gid)
        os.chmod(tmp, 0o600)
        os.replace(tmp, target)
    except Exception:
        tmp.unlink(missing_ok=True)
        raise


def finish_claim() -> None:
    """Start the portal and switch the edge. Startup retries an unfinished claim."""
    global CLAIM_STAGE
    for attempt in range(1, 6):
        try:
            res = run([sys.executable, str(ROOT / "bin" / "gen-deploy")], timeout=900)
            log(f"gen-deploy after the claim (try {attempt}): exit {res.returncode}")
            if res.returncode == 0:
                return  # The browser sees the now-gated /claim redirect.
            log((res.stdout[-1500:] + res.stderr[-1500:]).strip())
        except (OSError, subprocess.SubprocessError) as exc:
            log(f"gen-deploy after the claim (try {attempt}): {exc}")
        if attempt < 5:
            time.sleep(10 * attempt)
    CLAIM_STAGE = "finish_failed"


def prepare_owner() -> None:
    res = run(["runuser", "-u", lc.USER, "--", "env", f"XDG_RUNTIME_DIR={lc.RUNTIME_DIR}",
               sys.executable, "-B", str(ROOT / "bin/loam-claim"),
               "--prepare-owner"], cwd=str(lc.HOME), timeout=300)
    if res.returncode:
        raise RuntimeError("preparing the owner's first day failed: " + res.stderr.strip()[-300:])


def save_claim(username: str, password: str) -> None:
    global CLAIM_STAGE
    try:
        write_users(username, lc.OWNER_NAME, hash_password(password))
        prepare_owner()
        when = dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")
        temp = dep.CLAIMED_FILE.with_suffix(".new")
        temp.write_text(json.dumps({"username": username, "at": when}) + "\n", encoding="utf-8")
        temp.replace(dep.CLAIMED_FILE)
    except (OSError, RuntimeError, subprocess.SubprocessError) as exc:
        log(f"could not save claim: {exc}")
        CLAIM_STAGE = "save_failed"
        return

    try:
        li.CLAIM_FILE.unlink(missing_ok=True)
    except OSError as exc:
        log(f"could not remove the spent claim token: {exc}")
    log("claim saved, starting sign-in")
    CLAIM_STAGE = "starting_login"
    finish_claim()

def unfinished_claim() -> bool:
    """Claimed, but the live Caddyfile still carries the claim block."""
    try:
        live = dep.CADDYFILE.read_text(encoding="utf-8")
    except OSError:
        return False
    return not dep.unclaimed() and (dep.CLAIM_MARKER in live or dep.claim_edge_backup().exists())


# ---------------------------------------------------------------------------
# The notifier's file: the newest one-time code
# ---------------------------------------------------------------------------

# Authelia 4.39's message puts the code alone on a line between two rules of
# dashes ("----...\nYJPUQML7\n----..."), read off the real file in the first
# rehearsal. The second form is a lone line of capitals and digits, for a
# version that drops the rules. Case-sensitive: a word of the prose ("should")
# matched a case-blind first try.
CODE_RES = (
    re.compile(r"(?m)^-{8,}\s*\n\s*([A-Z0-9]{6,16})\s*\n\s*-{8,}"),
    re.compile(r"(?m)^\s*([A-Z0-9]{6,16})\s*$"),
)


def newest_code() -> dict:
    """{"code", "subject", "at", "age_seconds"} from the notifier's file, or
    {"code": None} when it holds none recent enough to be the live one."""
    vol = volume_dir()
    path = vol / "notification.txt" if vol else None
    try:
        text = path.read_text(encoding="utf-8", errors="replace") if path else ""
        mtime = path.stat().st_mtime if path else 0
    except OSError:
        return {"code": None}
    # The file notifier writes one message per send; take the last one.
    blocks = re.split(r"(?m)^(?=Date: )", text)
    last = blocks[-1] if blocks else ""
    subject = (re.search(r"(?m)^Subject:\s*(.+)$", last) or [None, ""])[1].strip()
    code = None
    for pat in CODE_RES:
        m = pat.search(last)
        if m:
            code = m.group(1)
            break
    age = int(time.time() - mtime)
    if code is None or age > CODE_MAX_AGE:
        return {"code": None}
    return {"code": code, "subject": subject,
            "at": dt.datetime.fromtimestamp(mtime, dt.timezone.utc).isoformat(timespec="seconds"),
            "age_seconds": age}


# ---------------------------------------------------------------------------
# The signed-in person's passkeys, from the login's own API
# ---------------------------------------------------------------------------

AUTHELIA = f"http://127.0.0.1:{dep.AUTHELIA_PORT}"
WEBAUTHN_API = "/api/secondfactor/webauthn/credentials"
WEBAUTHN_ONE = "/api/secondfactor/webauthn/credential"   # singular: one, by id
PASSKEY_FIELDS = ("id", "description", "created_at", "last_used_at")
CREDENTIAL_ID_RE = re.compile(r"^[0-9]{1,12}$")


def session_cookie(header: str | None) -> str | None:
    """The login's session cookie out of a Cookie header, alone: no other
    cookie the browser sends this host goes on to the login."""
    for part in (header or "").split(";"):
        name, _, value = part.strip().partition("=")
        if name == dep.SESSION_COOKIE and value:
            return value
    return None


def portal_for(host: str | None) -> str:
    """The login's portal for the cookie domain the request's host is in:
    the session is per cookie domain, and the login reads which one from
    the host it is asked on."""
    cfg = dep.config()
    host = (host or "").split(":")[0].lower()
    domains = [cfg["domain"]]
    try:
        domains += list(dep.extra_domains(dep.records()))
    except Exception:  # noqa: BLE001 - the main domain stands without them
        pass
    for dom in sorted(domains, key=len, reverse=True):
        if host == dom or host.endswith("." + dom):
            return f"{cfg['auth_host']}.{dom}"
    return f"{cfg['auth_host']}.{cfg['domain']}"


def ask_login(method: str, path: str, cookie: str, host: str | None,
              client: str | None, base: str | None = None) -> tuple[int, dict]:
    """One request to the login's API as the browser would make it on its
    portal: (status, JSON body, or {} when it sent none)."""
    req = urllib.request.Request(
        (base or AUTHELIA) + path, method=method, headers={
            "Cookie": f"{dep.SESSION_COOKIE}={cookie}",
            "X-Forwarded-Host": portal_for(host),
            "X-Forwarded-Proto": "https",
            "X-Forwarded-For": client or "127.0.0.1",
            "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=10) as res:
            status, raw = res.status, res.read()
    except urllib.error.HTTPError as exc:
        status, raw = exc.code, exc.read()
    try:
        body = json.loads(raw or b"{}")
    except ValueError:
        body = {}
    return status, body if isinstance(body, dict) else {}


def passkeys(cookie: str, host: str | None, client: str | None,
             base: str | None = None) -> tuple[int, dict]:
    """(status, answer) for GET /_loam/passkeys: the four fields the app
    reads, and nothing of the key itself."""
    status, body = ask_login("GET", WEBAUTHN_API, cookie, host, client, base)
    if status != 200 or body.get("status") != "OK":
        return (403 if status in (401, 403) else 502), {
            "error": "the login did not list this session's passkeys"}
    rows = body.get("data") or []
    return 200, {"passkeys": [{k: row.get(k) for k in PASSKEY_FIELDS}
                              for row in rows if isinstance(row, dict)]}


def remove_passkey(cookie: str, cred: str, host: str | None, client: str | None,
                   base: str | None = None) -> tuple[int, dict]:
    """(status, answer) for DELETE /_loam/passkeys/<id>: the login's own
    removal, its answer passed on (an elevation it wants is its 403)."""
    status, body = ask_login("DELETE", f"{WEBAUTHN_ONE}/{cred}", cookie, host,
                             client, base)
    if status == 200 and body.get("status") == "OK":
        return 200, {"ok": True}
    return status if 400 <= status < 500 else 502, {
        "error": body.get("message") or "the login did not remove it",
        "login_status": status}


# ---------------------------------------------------------------------------
# The page
# ---------------------------------------------------------------------------

def page() -> bytes:
    # Use the page from this release so it and the service share a protocol.
    return (ROOT / "app" / "public" / "claim.html").read_bytes()


# ---------------------------------------------------------------------------
# The server
# ---------------------------------------------------------------------------

class Handler(BaseHTTPRequestHandler):
    server_version = "loam-claim"
    sys_version = ""

    def log_message(self, fmt, *args):   # no request line carries a secret, but say little
        log(f"{self.command} {self.path.split('?')[0]} {args[1] if len(args) > 1 else ''}")

    def send(self, status: int, body: bytes, ctype: str = "application/json") -> None:
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        if ctype.startswith("text/html"):
            self.send_header("Content-Security-Policy",
                             "default-src 'none'; style-src 'unsafe-inline'; font-src data:; "
                             "script-src 'unsafe-inline'; connect-src 'self'; "
                             "form-action 'self'; frame-ancestors 'none'; base-uri 'none'")
        self.end_headers()
        self.wfile.write(body)

    def json(self, status: int, obj: dict) -> None:
        self.send(status, json.dumps(obj).encode())

    def do_GET(self):  # noqa: N802
        path, _, query = self.path.partition("?")
        if path == dep.CLAIM_PATH:
            if query == "status":
                return self.json(200, {"stage": CLAIM_STAGE})
            if not dep.unclaimed() and CLAIM_STAGE == "open":
                return self.json(410, {"error": "This Loam already has its owner. Sign in instead."})
            return self.send(200, page(), "text/html; charset=utf-8")
        if path == dep.RELAY_PATH:
            return self.relay()
        if path == dep.PASSKEYS_PATH:
            return self.passkeys()
        return self.json(404, {"error": "not found"})

    def signed_in(self) -> str | None:
        """The login's session cookie, when the gate let a signed-in person
        through (Remote-User is the gate's), else None and a 401 sent."""
        cookie = session_cookie(self.headers.get("Cookie"))
        if not (self.headers.get("Remote-User") or "").strip() or not cookie:
            self.json(401, {"error": "sign in to see your passkeys"})
            return None
        return cookie

    def client(self) -> str | None:
        return (self.headers.get("X-Forwarded-For") or "").split(",")[0].strip() or None

    def passkeys(self) -> None:
        cookie = self.signed_in()
        if cookie is None:
            return
        try:
            status, body = passkeys(cookie, self.headers.get("Host"), self.client())
        except (OSError, urllib.error.URLError) as exc:
            log(f"passkeys: the login did not answer: {exc}")
            status, body = 502, {"error": "the login did not answer"}
        return self.json(status, body)

    def do_DELETE(self):  # noqa: N802
        path = self.path.split("?")[0]
        prefix = dep.PASSKEYS_PATH + "/"
        cred = path[len(prefix):] if path.startswith(prefix) else ""
        if not CREDENTIAL_ID_RE.match(cred):
            return self.json(404, {"error": "not found"})
        cookie = self.signed_in()
        if cookie is None:
            return
        try:
            status, body = remove_passkey(cookie, cred, self.headers.get("Host"),
                                          self.client())
        except (OSError, urllib.error.URLError) as exc:
            log(f"passkeys: the login did not answer: {exc}")
            status, body = 502, {"error": "the login did not answer"}
        return self.json(status, body)

    def relay(self) -> None:
        who = (self.headers.get("Remote-User") or "").strip()
        known = users()
        owners = {name for name, u in known.items()
                  if not u.get("disabled") and "admins" in (u.get("groups") or [])}
        if not who or who not in owners:
            return self.json(403, {"error": "only the owner, signed in, sees the login's codes"})
        return self.json(200, newest_code())

    def do_POST(self):  # noqa: N802
        global CLAIM_STAGE
        if self.path.split("?")[0] != dep.CLAIM_PATH:
            return self.json(404, {"error": "not found"})
        try:
            length = int(self.headers.get("Content-Length") or 0)
            if not 0 < length <= MAX_BODY:
                raise ValueError
            body = json.loads(self.rfile.read(length))
            token, username, password = (body[k] for k in ("token", "username", "password"))
            if not all(isinstance(field, str) for field in (token, username, password)):
                raise ValueError
            token_bytes = token.encode()
            password.encode()  # Reject lone Unicode surrogates before starting a worker.
        except (KeyError, ValueError, TypeError):
            return self.json(400, {"error": "That did not arrive whole. Try again."})

        with LOCK:
            if not dep.unclaimed():
                return self.json(410, {"error": "This Loam already has its owner. Sign in instead."})
            now = time.time()
            FAILS[:] = [t for t in FAILS if now - t < FAIL_WINDOW]
            if len(FAILS) >= FAIL_LIMIT:
                return self.json(429, {"error": "Too many tries. Wait ten minutes, then open the link again."})
            want = li.claim_token() or ""
            if not want or not hmac.compare_digest(token_bytes, want.encode()):
                FAILS.append(now)
                time.sleep(1)
                return self.json(403, {"error": "This link is not the right one for this Loam. "
                                                "Open the whole link the installer printed."})
            if CLAIM_STAGE == "saving":
                return self.json(409, {"error": "A sign-in is already being saved."})
            username = username.strip().lower()
            if not USERNAME_RE.fullmatch(username):
                return self.json(400, {"error": "Use 2 to 32 letters, numbers, hyphens or underscores "
                                                "for your username, starting with a letter."})
            if len(password) < MIN_PASSWORD:
                return self.json(400, {"error": f"Choose a password of at least {MIN_PASSWORD} characters."})
            if len(password) > 256:
                return self.json(400, {"error": "That password is longer than Loam accepts (256)."})
            CLAIM_STAGE = "saving"
            threading.Thread(target=save_claim, args=(username, password), daemon=True).start()
        self.json(202, {"ok": True})


def main() -> int:
    global CLAIM_STAGE
    if sys.argv[1:] == ["--prepare-owner"] and os.geteuid() == lc.UID:
        import loam_claim_start
        loam_claim_start.prepare()
        return 0
    if os.geteuid() != 0:
        print("loam-claim: runs as root (loam-claim.service)", file=sys.stderr)
        return 2
    server = ThreadingHTTPServer(("127.0.0.1", dep.CLAIM_PORT), Handler)
    log(f"listening on 127.0.0.1:{dep.CLAIM_PORT} "
        f"({'unclaimed' if dep.unclaimed() else 'claimed'})")
    if unfinished_claim():
        log("the claim was made but its render did not finish; finishing it")
        CLAIM_STAGE = "starting_login"
        threading.Thread(target=finish_claim, daemon=True).start()
    server.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())
