now_iso = cfg.now_iso


# -- the record's derived fields -------------------------------------------
#
# A record read off disk by a broker that did not start it has to answer the
# same questions as a live one, so the rules live here rather than inside
# Session: `known()` applies them to a JSON file and `Session.__init__`
# applies them to itself, and there is one copy of each.

# What a status means, and it is the page's whole vocabulary for a session:
#
#   working      a turn is in flight and the model is generating
#   waiting      the turn's result has arrived and the session is parked on
#                background work it launched -- nothing is being generated
#   needs_input  a permission is pending and the turn is paused on it
#   done         idle after a result that succeeded
#   failed       the last result was an error, or the process ended other
#                than by request
#   idle         started, no turn yet
STATUSES = ("working", "waiting", "needs_input", "done", "failed", "idle")
# How soon after start, and how often, the broker looks for a job receipt
# no waiting call carried (Server.deliver_owed).
DELIVER_FIRST_S = 20
DELIVER_EVERY_S = 30


def running_model(session) -> str | None:
    """The model a live session's CLI says it is on: Claude's `system/init`
    model, Codex's or Antigravity's translator's. None before it has said."""
    said = getattr(session, "_init_model", None)
    if isinstance(said, str) and said:
        return said
    for name in ("_codex", "_agy"):
        model = getattr(getattr(session, name, None), "model", None)
        if isinstance(model, str) and model:
            return model
    return None

# The record was written while something was happening and the process is now
# gone, so that something did not finish. A page that read `working` off a
# record whose broker restarted three days ago would draw a spinner forever.
UNFINISHED = ("working", "needs_input")


def recovered_status(stored: str | None, turns: list) -> str:
    """The status of a session whose process is gone, from its stored one."""
    if stored in UNFINISHED:
        return "failed"
    if stored == "waiting":
        # Not UNFINISHED, and the difference is the whole point of the word
        # (2026-09-25). A record stored `waiting` is a record whose last turn
        # ENDED -- `result` arrived, it succeeded, the answer is there to read
        # -- and the only thing outstanding was a background child of a
        # process that no longer exists. Nothing more is coming, which is what
        # `done` says. Calling it `failed` would put the red ring on a
        # conversation that answered, which is the 09-22 defect in a new
        # place; calling it `waiting` would park a row forever on work that
        # died with its process. A turn that was still in flight was stored
        # `working`, not `waiting`, and is still answered `failed` above.
        return "done"
    if stored in STATUSES:
        return stored
    # A record written before statuses existed (2026-09-18). It has turns or
    # it does not, and that is the whole of what can honestly be said.
    return "done" if turns else "idle"


# The one sum, in lib/loam_broker.py because the adoption module needs the
# same arithmetic over an adopted session's own assistant messages -- two
# copies of a sum is two answers to one question the day somebody changes
# one. Named here so the rest of this file reads as though it were local,
# which it was until the second reader appeared.
context_used = cfg.context_used


def context_window(envelope: dict, model: str | None) -> int | None:
    """The context window of the model a turn ran on, as the CLI states it.

    Read out of the result envelope's ``modelUsage`` **by name**, which is the
    one thing that dict can be asked without guessing: it lists every model the
    process billed, including the CLI's own small-model calls, and a real turn
    on this box answered
    ``{"claude-haiku-4-5-20251001": {contextWindow: 200000},
       "claude-fable-5-1": {contextWindow: 1000000}}``
    (session 49db688c, 2026-09-22). Picking out of that without a name would
    have called a 1M session a 200k one, which is the same trap `model` on a
    turn record documents.

    ``None`` when the turn named no model or the envelope carries no row for
    it. The persona's settings are not consulted: "the settings say fable" and
    "this turn ran on fable with a 1M window" are different claims.
    """
    rows = envelope.get("modelUsage")
    if not model or not isinstance(rows, dict):
        return None
    row = rows.get(model)
    if not isinstance(row, dict):
        return None
    window = row.get("contextWindow")
    if isinstance(window, (int, float)) and not isinstance(window, bool):
        return int(window)
    return None


def compaction_event(session_id: str, boundary: dict) -> dict:
    """The log entry a page draws a compaction divider from.

    Read off the CLI's own ``system``/``compact_boundary``, whose shape on
    2.1.281 was taken from a probe on this box (2026-09-30), not from the
    docs: ``compact_metadata`` carries ``trigger`` ("manual" for ``/compact``,
    "auto" when the window is reached), ``pre_tokens``, ``post_tokens``,
    ``cumulative_dropped_tokens`` and ``duration_ms``, beside the uuids of the
    messages it kept. A number the marker does not carry is null here rather
    than a guess. ``seq`` is the log's own, added by ``emit``.
    """
    meta = boundary.get("compact_metadata")
    meta = meta if isinstance(meta, dict) else {}

    def count(name: str) -> int | None:
        value = meta.get(name)
        if isinstance(value, (int, float)) and not isinstance(value, bool):
            return int(value)
        return None

    trigger = meta.get("trigger")
    return {"type": "broker.compaction",
            "session_id": session_id,
            "at": now_iso(),
            "trigger": trigger if isinstance(trigger, str) else None,
            "tokens_before": count("pre_tokens"),
            "tokens_after": count("post_tokens"),
            "duration_ms": count("duration_ms")}


def history_bytes(origin: str | None, cli_session_id: str | None,
                  source_size: int | None) -> int | None:
    """How many bytes of history a first message into this session re-sends.

    An adopted record that has never been spoken to here is a reading of the
    Claude Code app's own session file, and the first message into it forks
    that file -- so the whole conversation is read back into a model's context
    before a word of the new turn is answered. The size of that file is what
    says how much. The page turns it into money; this says only the bytes.

    ``None`` for everything else, and that is the honest answer rather than a
    zero: a session the broker started has its history in this broker's log and
    resumes without re-sending it, and a session already forked runs on a file
    of the CLI's own.
    """
    if origin != adoption.ORIGIN_APP or cli_session_id:
        return None
    return source_size if isinstance(source_size, int) else None


def with_context(turn: dict) -> dict:
    """One turn record, answered with the context keys whether or not it was
    written with them. Turns taken before 2026-09-22 carry neither figure, and
    a page must not have to ask whether `context` is missing because the turn
    spent no tokens."""
    context = turn.get("context")
    if not isinstance(context, dict):
        context = {}
    turn["context"] = {"used": context.get("used"),
                       "window": context.get("window")}
    return turn


# The most turns a list row carries (2026-11-09). See `list_row`.
LIST_TURNS_MAX = 10


def _tail_turns(turns: list) -> list:
    """The last turns, back to the ones a list row is read for: the latest
    turn (its cost), the latest that names a `model`, and the latest context
    reading -- walking back past a compaction (both figures null) to the
    turn before it that states a window, as a page computing the context
    does. At most `LIST_TURNS_MAX`."""
    need_model = need_context = True
    after_compaction = False
    start = len(turns)
    for i in range(len(turns) - 1, max(-1, len(turns) - 1 - LIST_TURNS_MAX), -1):
        turn = turns[i] if isinstance(turns[i], dict) else {}
        start = i
        if isinstance(turn.get("model"), str) and turn["model"]:
            need_model = False
        context = turn.get("context") if isinstance(turn.get("context"), dict) else {}
        used, window = context.get("used"), context.get("window")
        if need_context:
            if after_compaction:
                if isinstance(window, (int, float)):
                    need_context = False
            elif used is None and window is None and context:
                after_compaction = True
            elif isinstance(used, (int, float)):
                need_context = False
        if not need_model and not need_context:
            break
    return turns[start:]


def list_row(meta: dict) -> dict:
    """A record as the listing and the live list carry it (2026-11-09): every
    field but `turns`, which is cut to its tail (`_tail_turns`), with
    `turns_total` saying how many the record has. The whole of `turns` is on
    `GET /v1/sessions/<id>` and the session's own stream; `?turns=all` on
    the list routes answers it there too, for a client that read it whole.
    Before this `GET /v1/sessions` was 3.5 MB on this box, 2.1 MB of it
    turns."""
    turns = meta.get("turns")
    if not isinstance(turns, list):
        return meta
    return {**meta, "turns": _tail_turns(turns), "turns_total": len(turns)}


def normalise(meta: dict) -> dict:
    """A record read off disk, answered with every field the interface has.

    A record is only rewritten when its session is touched, so the box is
    full of files written before these fields existed. A client must not have
    to ask whether a key is missing because the session has no title or
    because the session predates titles: every record the interface answers
    carries every key, and the value says the rest.
    """
    meta["status"] = recovered_status(meta.get("status"), meta.get("turns") or [])
    meta.setdefault("provider", cfg.DEFAULT_PROVIDER)
    meta.setdefault("title", None)
    # What named it, added 2026-09-22 when the broker stopped titling and
    # started reading the vault's title instead. Null on a record written
    # before it, which says only that nothing recorded where its name came
    # from -- see `sync_titles`, which is what such a record gets once.
    meta.setdefault("title_source", None)
    meta.setdefault("last_message", None)
    meta.setdefault("last_event_at", None)
    # Where the session came from, added 2026-09-20 with adoption. A record
    # written before it is one the broker started itself, which is the only
    # kind there was.
    meta.setdefault("origin", adoption.ORIGIN_UI)
    meta.setdefault("source", None)
    # How many of the session's events are translated from that file rather
    # than logged here. Null for everything the broker started itself.
    meta.setdefault("replayed", None)
    # The reading of that file the record was made from, added 2026-09-21 so
    # that a later read can tell whether the conversation has moved on since.
    # Null on a record written before it, which reads as "never measured".
    meta.setdefault("source_size", None)
    meta.setdefault("source_mtime", None)
    # The fork, added 2026-09-20 with the first message into an adopted
    # session. Null on every other record: a session the broker started runs
    # under its own id, and the two fields exist to say when it does not.
    meta.setdefault("cli_session_id", None)
    meta.setdefault("forked_from", None)
    # The provider's own thread, added 2026-10-01 with Codex: the id
    # `thread/resume` takes. Null on every Claude Code record, whose
    # conversation is resumed by the record's own id.
    meta.setdefault("thread_id", None)
    # This chat's model and effort, added 2026-09-21 with the + menu. Null on
    # a record written before it, which is what every session was: the
    # persona's own setting, nothing overridden.
    meta.setdefault("model", None)
    meta.setdefault("effort", None)
    meta["pinned"] = bool(meta.get("pinned"))
    meta["archived"] = bool(meta.get("archived"))
    # How far this session has been read, added 2026-09-22. A record written
    # before it reads as 0 -- unread to the end -- which is what a chat
    # nobody has opened on this interface actually is.
    meta["seen_seq"] = int(meta.get("seen_seq") or 0)
    # How many background tasks are running behind this session's turn, added
    # 2026-09-22. Zero here without looking at what the file says, and that is
    # not a default but a fact: a record read off disk is a record no process
    # of this broker's is behind, and a background task dies with the process
    # that launched it. A record left saying 2 by a broker that was killed
    # would otherwise draw a badge for two subagents that stopped days ago.
    meta["background_tasks"] = 0
    # Whether a process is behind this session, added 2026-09-25. False here
    # for the same reason the count above is zero, and it is a fact and not a
    # default: a record read off disk is a record this broker has no process
    # for, so nothing in the file can make it live. A record left saying
    # `true` by a broker that was killed would otherwise put a row in the "in
    # RAM" filter for a process that died days ago.
    meta["live"] = False
    # What a first message into this record would re-send, in bytes. Derived
    # rather than stored, so it cannot disagree with the reading it comes from.
    meta["history_bytes"] = history_bytes(meta.get("origin"),
                                          meta.get("cli_session_id"),
                                          meta.get("source_size"))
    meta["turns"] = [with_context(turn) for turn in (meta.get("turns") or [])
                     if isinstance(turn, dict)]
    return meta


def from_log(path: Path) -> dict:
    """What a record written before these fields existed can still be told by
    its own event log.

    Added 2026-09-18. ``normalise`` fills the keys and cannot fill the
    content, so every session on the box from before this morning drew as
    "New chat" with no status box -- caused in a real browser. The log is
    the durable copy of the conversation and it holds all three answers, so
    they are read from it rather than left null forever.

    The rules, and each is the same rule the live path already uses:

    - ``title`` is the opening words of the first thing a PERSON said. That
      is ``broker.user_message``, the broker's own event, which is why it
      exists; a ``user`` event is a tool result unless its content is prose,
      and a session logged before ``broker.user_message`` (2026-09-16) has
      only tool results, so its title stays null rather than becoming the
      first page of a file the agent happened to read.
    - ``last_message`` is the last TOP-LEVEL assistant text, cut to
      ``LAST_MESSAGE_CHARS``. A subagent's sentence is machinery.
    - ``result_ok`` is the last ``result`` envelope's verdict, judged the
      way ``_handle`` judges a live one, and ``None`` when the log holds no
      result at all.
    - ``last_seq`` is the highest number in the log, which is what the
      record's position field means.
    """
    found = {"title": None, "last_message": None, "result_ok": None,
             "last_seq": 0}
    if not path.exists():
        return found
    with path.open(encoding="utf-8") as handle:
        for line in handle:
            line = line.strip()
            if not line:
                continue
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            kind = event.get("type")
            seq = event.get("seq")
            if isinstance(seq, int) and seq > found["last_seq"]:
                found["last_seq"] = seq
            if found["title"] is None and kind == "broker.user_message":
                found["title"] = first_words(event.get("text") or "") or None
            elif found["title"] is None and kind == "user":
                content = (event.get("message") or {}).get("content")
                # A list holding a tool_result is the CLI feeding itself, not
                # a person speaking -- three real sessions were read end to
                # end on 2026-09-16 and every `user` event in all three was
                # one of those. Prose here is a person only if nothing in the
                # message is machinery.
                if not (isinstance(content, list) and any(
                        isinstance(block, dict)
                        and block.get("type") == "tool_result"
                        for block in content)):
                    found["title"] = first_words(
                        loam_transcript._text_of(content)) or None
            elif kind == "assistant" and event.get("parent_tool_use_id") is None:
                said = loam_transcript._text_of(
                    (event.get("message") or {}).get("content"))
                if said:
                    found["last_message"] = said[:cfg.LAST_MESSAGE_CHARS]
            elif kind == "result":
                found["result_ok"] = not (
                    bool(event.get("is_error"))
                    or (event.get("subtype") or "success") != "success")
    return found


def backfill(meta: dict, log_path: Path) -> bool:
    """Fill a record from its log, in place. True if anything changed.

    Only what the record does not already say: a title a person wrote, a
    last message this broker recorded and a status it stored are all facts
    about the session and outrank anything re-derived from the log.

    The position field is the exception and is corrected upward, never down.
    ``record_seq`` is defined as the number of the last event in the log, and
    a record that says less than its own log is a record that will renumber
    from there when the session is resumed -- which is the duplicate-seq
    defect of 2026-09-16, and one session on this box (a probe killed
    mid-turn that day) still carries it: the file says 1 and the log ends at
    51. Raising it costs nothing and makes a resume of that session
    replayable; lowering it could never be right.
    """
    found = from_log(log_path)
    before = dict(meta)
    if not meta.get("title") and found["title"]:
        meta["title"] = found["title"]
    if not meta.get("last_message") and found["last_message"]:
        meta["last_message"] = found["last_message"]
    # A record with no stored status is answered by recovered_status, which
    # can only say "it has turns or it does not". The log says more: whether
    # the last turn actually succeeded. A record that stored one keeps it --
    # the rules in recovered_status apply to it on the way out.
    if not meta.get("status") and found["result_ok"] is not None:
        meta["status"] = "done" if found["result_ok"] else "failed"
    position = int(meta.get("record_seq") or meta.get("seq") or 0)
    meta.pop("seq", None)
    meta["record_seq"] = max(position, found["last_seq"])
    return meta != before


def backfill_records() -> tuple[int, int]:
    """Every record on the box, filled from its log once, at start.

    Once rather than on every read: the answer cannot change (a log this
    broker is not writing to does not grow), and the listing reads thirteen
    files today and several hundred one day -- one of them a 725-line log --
    on a route a phone hits on every pull-to-refresh. Written back, so the
    work is paid once per record and not once per boot.

    Returns (records seen, records changed) for the line at startup. A file
    that cannot be read or written is reported and skipped: a backfill is a
    convenience and must never be the reason a broker will not start.
    """
    seen = changed = 0
    for path in sorted(cfg.SESSION_DIR.glob("*.json")):
        seen += 1
        try:
            meta = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            print(f"backfill: {path.name}: unreadable ({exc})",
                  file=sys.stderr, flush=True)
            continue
        session_id = meta.get("session_id") or path.stem
        if not backfill(meta, cfg.SESSION_DIR / f"{session_id}.jsonl"):
            continue
        try:
            path.write_text(json.dumps(meta, indent=2), encoding="utf-8")
        except OSError as exc:
            print(f"backfill: {path.name}: not written ({exc})",
                  file=sys.stderr, flush=True)
            continue
        changed += 1
    return seen, changed


def sync_titles() -> tuple[int, list[tuple[str, str, str]]]:
    """Every record's title made the vault's title, once, at start.

    The broker used to name a session with its own model call and the
    transcript writer named the same conversation with another, so the home
    screen and the vault disagreed about what a conversation was called --
    "Household note and image attachment" on one and "Attachment check" on
    the other, 2026-09-22. The broker's call is gone; this is what the records
    written by it get.

    What is never touched: a title a person typed. It is marked
    ``title_source: "person"`` on the record from the rename onward. A record
    written before that field existed carries no mark at all, and the honest
    reading is that nothing on it records a rename -- every title on the box
    when this landed came from one of the two titlers. So they are synced, and
    each change is printed with both names, because a title the machine got
    wrong is recoverable from the line and a silent overwrite is not.

    Returns (records seen, [(id, was, now)]). Fail-soft per record: a file
    that will not read or write is reported and skipped, because a title is a
    convenience and must never be the reason the broker will not start.
    """
    seen = 0
    changed: list[tuple[str, str, str]] = []
    for path in sorted(cfg.SESSION_DIR.glob("*.json")):
        seen += 1
        try:
            meta = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            print(f"titles: {path.name}: unreadable ({exc})",
                  file=sys.stderr, flush=True)
            continue
        if meta.get("title_source") == "person":
            continue
        session_id = meta.get("session_id") or path.stem
        # The fork's id when there is one: that is the CLI session whose turns
        # are being filed, and so the id the writer's sidecar is under. A
        # Codex thread's turns are filed under its thread id.
        filed = adoption.transcript_title(
            meta.get("cli_session_id") or meta.get("thread_id") or session_id)
        if not filed or filed == meta.get("title"):
            if filed and meta.get("title_source") != "vault":
                meta["title_source"] = "vault"
            else:
                continue
        else:
            changed.append((session_id, meta.get("title") or "", filed))
            meta["title"] = filed
            meta["title_source"] = "vault"
        try:
            path.write_text(json.dumps(meta, indent=2), encoding="utf-8")
        except OSError as exc:
            print(f"titles: {path.name}: not written ({exc})",
                  file=sys.stderr, flush=True)
    return seen, changed


def prune_fork_duplicates() -> list[tuple[str, str]]:
    """The records a scan made of the broker's own forks, removed once.

    Between the fork landing (2026-09-20) and the scan learning about it
    (2026-09-22), replying to an adopted session left a second record of the
    same conversation: the CLI wrote the fork into its own session file, and
    the next scan found a file with a person in it, today's date on it and no
    record against its id. Four such records on this box, and the home screen
    drew one of them beside the conversation it was a copy of -- "Loam phase
    six planning", pinned and in Recent at once.

    A record is one of these when all four hold:

    - another record names it as the fork it drives (``cli_session_id``)
    - it says it came from the app (``origin``) -- what the scan writes
    - nothing has been said into it through this broker: no log of its own
    - it has never been forked itself (``cli_session_id`` of its own), which
      would make it a conversation somebody has gone on having here

    **Only the record goes.** The session file it points at is the CLI's, and
    this module does not write near one; it is also the fork's own history,
    which the record that survives now replays. Returns [(id, title)], both
    printed at start, because a record removed without its name is a thing
    nobody can check afterwards.
    """
    records: dict[str, dict] = {}
    for path in sorted(cfg.SESSION_DIR.glob("*.json")):
        try:
            meta = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            print(f"prune: {path.name}: unreadable ({exc})",
                  file=sys.stderr, flush=True)
            continue
        records[meta.get("session_id") or path.stem] = meta
    driven = {meta.get("cli_session_id") for meta in records.values()
              if meta.get("cli_session_id")}
    removed: list[tuple[str, str]] = []
    for session_id in sorted(driven & set(records)):
        meta = records[session_id]
        if meta.get("origin") != adoption.ORIGIN_APP:
            continue
        if meta.get("cli_session_id"):
            continue
        log = cfg.SESSION_DIR / f"{session_id}.jsonl"
        try:
            if log.exists() and log.stat().st_size:
                continue                # spoken into here; not a bare copy
        except OSError:
            continue
        try:
            (cfg.SESSION_DIR / f"{session_id}.json").unlink()
            # An empty log of our own beside it is the broker's, not the
            # CLI's, and a log with no record is reachable by nothing.
            log.unlink(missing_ok=True)
        except OSError as exc:
            print(f"prune: {session_id}: not removed ({exc})",
                  file=sys.stderr, flush=True)
            continue
        removed.append((session_id, meta.get("title") or ""))
    return removed


def parse_iso(value, fallback: float) -> float:
    """A record's UTC string back to an epoch, or the fallback."""
    try:
        return datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ").replace(
            tzinfo=timezone.utc).timestamp()
    except (TypeError, ValueError):
        return fallback


def first_words(text: str) -> str:
    """The stand-in title a session wears until the titler has answered.

    The first message's opening words, on one line. A session must never be
    nameless on the page -- the design draws a title on every row, and the
    first thing a person recognises their own session by is what they said to
    start it.
    """
    line = " ".join((text or "").split())
    if len(line) <= cfg.TITLE_FALLBACK_CHARS:
        return line
    cut = line[:cfg.TITLE_FALLBACK_CHARS].rsplit(" ", 1)[0]
    return (cut or line[:cfg.TITLE_FALLBACK_CHARS]) + "…"


def _without_image_bytes(blocks: list) -> tuple[list, int]:
    """`blocks` with every base64 image's `data` taken out, and how many
    characters went. A tool result's own `content` is a list of the same
    blocks, so this walks into it; nothing else nests images."""
    out, cut = [], 0
    for block in blocks:
        if not isinstance(block, dict):
            out.append(block)
            continue
        source = block.get("source")
        if (block.get("type") == "image" and isinstance(source, dict)
                and source.get("type") == "base64"
                and isinstance(source.get("data"), str)):
            data = source["data"]
            source = {k: v for k, v in source.items() if k != "data"}
            source["omitted_chars"] = len(data)
            out.append({**block, "source": source})
            cut += len(data)
            continue
        inner = block.get("content")
        if block.get("type") == "tool_result" and isinstance(inner, list):
            inner, n = _without_image_bytes(inner)
            if n:
                out.append({**block, "content": inner})
                cut += n
                continue
        out.append(block)
    return out, cut


def for_the_wire(event: dict) -> dict:
    """An event as a client is sent it: the log's copy, less image bytes.

    **A tool result can carry megabytes of base64 pictures** -- `Read` of a
    PDF hands the model each page as a JPEG -- and the log keeps them, because
    the log is the record. No client draws them: the page shows a tool's
    result as text, and a picture the persona looked at is a file it named.
    They were still sent, and that is the 2026-10-15 chat that showed none of
    its replies: a persona read a course's PDFs, seven `user` events of 0.6-3.2 MB
    put 16 MB of a 17 MB log in front of both replies, and a phone opening
    the chat gave up on the window before it got past the pictures.

    So the `data` of a base64 image inside a `user` event is cut here, on the
    way out, and only here. The block keeps its type and `media_type` and says
    `omitted_chars`, so a reader can tell a picture was there and how big.
    The same picture's second copy goes too: `Read` of an image file also
    puts it in `tool_use_result.file.base64`, which no client reads and which
    was 34 MB of one 75 MB persona's log. That key becomes `base64_omitted_chars`.
    The event is copied when there is something to cut and is otherwise the
    same object: the log, the live subscribers' queues and every other
    stream's copy are untouched.
    """
    if event.get("type") != "user":
        return event
    out = event
    message = event.get("message")
    content = message.get("content") if isinstance(message, dict) else None
    if isinstance(content, list):
        blocks, cut = _without_image_bytes(content)
        if cut:
            out = {**out, "message": {**message, "content": blocks}}
    result = event.get("tool_use_result")
    file = result.get("file") if isinstance(result, dict) else None
    if isinstance(file, dict) and isinstance(file.get("base64"), str):
        file = {k: v for k, v in file.items() if k != "base64"}
        file["base64_omitted_chars"] = len(result["file"]["base64"])
        out = {**out, "tool_use_result": {**result, "file": file}}
    return out


CHOOM = "/usr/bin/choom"


def first_to_go(argv: list[str]) -> list[str]:
    """A chat's command line, run at `cfg.CHILD_OOM_SCORE_ADJ` (2026-11-09):
    ``choom`` sets the score and execs, so the pid is the CLI's and every MCP
    server it starts inherits it. Under a memory emergency the kernel then
    ends a chat before the broker, an RC server, a job or the system. Without
    ``choom`` on the box the line is unchanged and the unit's 500 holds."""
    if not os.access(CHOOM, os.X_OK):
        return list(argv)
    return [CHOOM, "-n", str(cfg.CHILD_OOM_SCORE_ADJ), "--", *argv]


NUMBER_WORDS = ("no", "one", "two", "three", "four", "five", "six", "seven",
                "eight", "nine", "ten", "eleven", "twelve")

BUSY_WORDS = {"working": "mid-turn", "needs_input": "waiting on you",
              "waiting": "waiting on work it started",
              "starting": "starting up"}


def number_word(n: int) -> str:
    return NUMBER_WORDS[n] if 0 <= n < len(NUMBER_WORDS) else str(n)


def join_names(names: list[str]) -> str:
    if len(names) <= 1:
        return "".join(names)
    return ", ".join(names[:-1]) + " and " + names[-1]


def busy_clause(busy: list[dict]) -> str:
    """``Ada and Iris are mid-turn, Pax is waiting on you``: who holds the
    seats, by what they are doing, in a person's words."""
    groups: dict[str, list[str]] = {}
    for row in busy:
        word = BUSY_WORDS.get(row.get("status"), "busy")
        name = cfg.agent_card(row["agent"])["name"]
        groups.setdefault(word, [])
        if name not in groups[word]:
            groups[word].append(name)
    parts = [f"{join_names(names)} {'is' if len(names) == 1 else 'are'} {word}"
             for word, names in groups.items()]
    return ", ".join(parts)


def cap_sentence(agent: str, busy: list[dict], reason: str = "memory") -> str:
    """What a person reads when a start cannot be admitted (2026-11-09): the
    box is short of memory and every session on it is busy, so nothing idle
    could be ended for it. No route and no id: the `hint` beside it carries
    those for an API caller."""
    who = cfg.agent_card(agent)["name"]
    clause = busy_clause(busy)
    n = len(busy)
    held = (f"all {number_word(n)} session{'s' if n != 1 else ''} on it "
            f"{'are' if n != 1 else 'is'} busy" if n else "nothing on it can be ended")
    why = ("the box is short of memory" if reason == "memory"
           else f"the box is at its backstop of {cfg.MAX_SESSIONS} sessions")
    return (f"There's no room for {who} right now: {why} and {held}"
            f"{f' ({clause})' if clause else ''}. Try again when one "
            f"finishes.")


class BrokerError(Exception):
    """Returned to the client as a 4xx with this text. Never a stack trace:
    the client is a web app and its user is a person."""

    def __init__(self, status: int, message: str,
                 detail: dict | None = None) -> None:
        super().__init__(message)
        self.status = status
        self.message = message
        # Fields answered beside `error`, for a client that wants more than
        # the sentence (admission's 429: `reason`, `memory`, `busy`, `hint`).
        self.detail = detail or {}


# -- the card a pending request draws ---------------------------------------
#
# Every pending request is one of two kinds (2026-10-01): an `approval` (may
# this run? Allow/Deny, as every card was before) or a `question` (the person
# picks or types an answer). A question's request carries `questions` in the
# one shape lib/loam_questions.py makes from the provider's own, and the event
# carries them, with the provider's sentence as `message`. The rest of the
# event is unchanged, so a page that predates `kind` still draws a card.

def _questions_of(req: dict) -> list[dict] | None:
    asked = req.get("questions")
    return asked if isinstance(asked, list) and asked else None


def _request_event(event: dict, req: dict) -> dict:
    asked = _questions_of(req)
    event["kind"] = "question" if asked is not None else "approval"
    if asked is not None:
        event["message"] = req.get("question_message")
        event["questions"] = asked
    return event


# How a pending request closed (2026-10-05). `allow` and `deny` are a
# person's answers; the rest are the ways a request closes with nobody
# answering, and every one of them is written to the log, so no log is ever
# left holding a request that never closes -- a page replaying one would draw
# it as a live card forever. `expired`: the broker denied it after
# PERMISSION_WAIT_S (lib/loam_broker.py) and the process lives on. `cancelled`:
# the provider withdrew it. `ended`: the process ended with it open, for any
# reason -- the reaper, DELETE, a crash, the broker's own shutdown.
CLOSED_UNANSWERED = ("expired", "cancelled", "ended")


def _resolved_event(session_id: str, request_id: str, behavior: str,
                    req: dict, message: str | None,
                    answers: dict | None, scope: str | None = None) -> dict:
    event = {"type": "broker.permission_resolved",
             "session_id": session_id,
             "request_id": request_id,
             "behavior": behavior,
             "tool_name": req.get("tool_name"),
             "message": message if behavior in ("deny", "expired") else None,
             "kind": "question" if _questions_of(req) is not None else "approval"}
    if scope is not None:
        # The allow carried rules for the rest of this process
        # (`updatedPermissions`), so a page can say "Allowed for this chat".
        event["scope"] = scope
    if answers is not None:
        # The event is written to the session's log, so a secret's answer is
        # not on it: it went to the provider and nowhere else.
        secret = {q["id"] for q in _questions_of(req) or [] if q.get("secret")}
        event["answers"] = {qid: (None if qid in secret else values)
                            for qid, values in answers.items()}
    return event


def _not_saved_reason(exc: OSError) -> str:
    """The sentence a page shows for a turn the broker could not write down."""
    if exc.errno == errno.ENOSPC:
        return "couldn't save this reply: the server's disk is full"
    return f"couldn't save this reply: {exc.strerror or exc}"


class Session:
    """One persona session and the process behind it.

    The id is chosen HERE, before the process starts, and passed as
    ``--session-id``. The CLI would otherwise mint one and only reveal it in
    the ``system/init`` message, which means a client that asked for a session
    could not name the thing it had just asked for until the model answered.
    Choosing it up front also makes the resume path the same id, not a second
    one to map.
    """

    def __init__(self, agent: str, session_id: str | None = None,
                 provider: str | None = None, model: str | None = None,
                 effort: str | None = None) -> None:
        self.agent = agent
        self.id = session_id or str(uuid.uuid4())
        self.provider = provider or cfg.DEFAULT_PROVIDER
        # This chat's model and effort, per the design's + menu. Null is not
        # "unknown" and not "fable": it is "the persona's own setting", which
        # is the honest state, because nothing goes on the launch line and the
        # CLI reads the persona's settings.json itself. Writing a default in
        # here would pin every session to whatever this file said on the day
        # it was started, and the owner changing a persona's model would then
        # change nothing they could see.
        self.model = model or None
        self.effort = effort or None
        self.workspace = cfg.workspace(agent)
        self.proc: asyncio.subprocess.Process | None = None
        self.seq = 0
        self.subscribers: set[asyncio.Queue] = set()
        self.pending: dict[str, dict] = {}     # request_id -> can_use_tool request
        self.turns: list[dict] = []            # one record per result envelope
        self.created = now_iso()
        self.last_activity = time.time()
        self.state = "starting"
        self.exit_code: int | None = None
        self.resumed = False
        # What the page draws a row from, and all of it follows the session
        # across devices because it is on the record and not in a browser.
        self.title: str | None = None
        # Where that title came from, which is what decides whether anything
        # may replace it. `None` is the stand-in -- the opening words of the
        # first message -- `"vault"` is the name the transcript writer filed
        # this conversation under, and `"person"` is a rename, which outranks
        # both and is never overwritten by anything here.
        self.title_source: str | None = None
        self.pinned = False
        self.archived = False
        # How far down this conversation has been read. It is on the record
        # and not in a browser for the same reason the title is: one person,
        # one box, and a chat read on the phone must not come back unread on
        # the laptop. 0 is "nothing read", which is what every session was
        # before this field existed and is the honest state for one nobody
        # has opened.
        self.seen_seq = 0
        self.last_message: str | None = None
        self.last_event_at: str | None = None
        # Where this session came from, and the file its history is in.
        #
        # For a session the broker started, both are the defaults: it was
        # born here and its history is this broker's own log. For a session
        # adopted from the Claude Code app, `source` is the CLI's own session
        # file -- read to make the record and not read again, until the job
        # that replays it. See lib/loam_adopt.py.
        self.origin = adoption.ORIGIN_UI
        self.source: str | None = None
        # How many of this session's events come out of that file. It is the
        # first `replayed` numbers of the stream, and the broker's own log
        # begins at `replayed + 1` -- which is what makes a turn taken here
        # later append to the history rather than renumber on top of it.
        # `None` means nothing has been translated for this session.
        self.replayed: int | None = None
        # The reading of that file the record was made from: how big it was
        # and when it was last touched. A file the broker does not write is a
        # file that grows behind the record's back -- the owner goes on talking
        # in the app -- so every read of this record asks these two numbers
        # whether the reading still holds. Null for a session the broker
        # started, whose history is its own log. See `refresh_from_source`.
        self.source_size: int | None = None
        self.source_mtime: int | None = None
        # The CLI session this broker actually drives, when it is not this
        # record's own id. It is set for one kind of session only: an adopted
        # one, which is forked rather than resumed the first time anybody
        # sends into it, because its own id names a file the app may still be
        # writing. `forked_from` is the app session the fork came out of --
        # the same id this record wears, said where a reader of the record
        # will look for it rather than left to be inferred.
        #
        # Null on everything else, and that is the test the launch line asks:
        # a session with no `cli_session_id` that came from the app has not
        # been forked yet. See `argv`.
        self.cli_session_id: str | None = None
        self.forked_from: str | None = None
        # The provider's own name for this conversation when it is not the
        # record's id. Codex mints a thread id at `thread/start` and resumes
        # by it (2026-10-01); a Claude Code session runs under the record's
        # own id and leaves this null.
        self.thread_id: str | None = None
        # What status() reads. A turn is in flight from the moment a person's
        # message goes in -- or the CLI writes the `system`/`init` that opens
        # one -- until its result comes back out.
        self._turn_active = False
        # How long this session may sit idle before the reaper ends it, when
        # it is not `cfg.CLASSIC_IDLE_S`. The thread engine sets
        # `cfg.THREAD_IDLE_S` on the sessions its turns use (2026-11-09).
        # Held in memory only: a broker restart ends every process anyway.
        self.idle_timeout_s: float | None = None
        # Whether a message this session sends its harness opens with the
        # clock line (lib/loam_clock.py, 2026-11-09). A thread turn's prompt
        # carries its own, so the thread engine turns this off.
        self.tell_time = True
        # The background tasks the CLI says are live behind this session right
        # now, as it states them (`system`/`background_tasks_changed`): a list
        # of `{task_id, task_type, description}`. The record answers the count;
        # the stream carries both. Never restored from the file: a background
        # task is a child of a process, and this object has no process yet.
        self.background_tasks: list[dict] = []
        # When the broker first saw each background task, by task id
        # (2026-11-10): the CLI's events carry no time, and a page saying
        # "waiting on 2 background tasks" says since when.
        self._task_seen: dict[str, str] = {}
        # Task ids that have left that list without their notification having
        # arrived yet, against the moment each left. The session is still
        # waiting while one of these is outstanding -- the notification is what
        # wakes the persona for another turn -- and `_settle` is the backstop
        # that stops one that never comes from pinning the row on `waiting`.
        self._awaiting: dict[str, float] = {}
        # Tasks whose notification has already landed (2026-11-10): the CLI
        # sends it BEFORE the list empties as often as after (396 of 684
        # tasks in this box's logs), and a task notified first must not be
        # awaited -- it held `working_behind` for the whole settle window
        # after the reply, and a thread turn read its last `result` as "more
        # to come" and waited on nothing.
        self._notified: dict[str, float] = {}
        # A task notification has fired and no result has closed a turn since,
        # which means another turn is on its way whether or not it has started.
        self._resuming = False
        self._settle = None
        # The usage of the last top-level assistant message of the turn being
        # read, which is the last request that turn made and so the reading of
        # how full the context was when it ended. See `context_used`.
        self._turn_usage: dict | None = None
        # What a compaction inside the turn being read left behind: the
        # marker's `post_tokens`, and the model the `init` after it named.
        # See the result branch of `_handle`.
        self._compacted_to: int | None = None
        self._init_model: str | None = None
        self._last_result_ok: bool | None = None
        # Whether the log is known to end on a newline. Not known until the
        # first write looks: a log a failed write tore, under this broker or
        # an earlier one, ends mid-line, and the next event appended to it
        # would be glued onto the fragment and lost to every replay. See
        # `_append`.
        self._log_ends_clean = False
        # Why something in this turn could not be written down, if it could
        # not. Read at the turn's `result`, which then counts as failed.
        self._unsaved: str | None = None
        self._stop_requested = False
        self._restored_status: str | None = None
        # Whether this session has the name it is going to keep, and whether
        # somebody is currently looking for one. The second exists because the
        # look is now a poll spanning a minute and a turn can end inside it:
        # two tasks reading the same file would only race to agree.
        self._titled = False
        self._titling = False
        # Set by the Broker so that a record written here reaches the live
        # list. A Session built without one (a test, a probe) simply has no
        # listeners, which is not an error.
        self.on_record_change = None
        self._write_lock = asyncio.Lock()
        cfg.SESSION_DIR.mkdir(parents=True, exist_ok=True)
        # A resumed session is the SAME session, so it is the same event log
        # and the same numbering. Starting from zero over an existing log
        # produced two events numbered 19 and a client that asked for
        # everything after 24 and was handed turn one again -- caused
        # 2026-09-16, and it is the failure that makes reconnection worthless,
        # because seq is the only thing a client has to say where it was.
        # The turn records are carried across for the same reason: they are
        # the session's, not the process's.
        if self.meta_path.exists():
            try:
                prior = json.loads(self.meta_path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                prior = {}
            # ``seq`` is what records written before 2026-09-16 called it;
            # reading both is what keeps a session started under the old name
            # from restarting its numbering at zero, which is the defect the
            # comment above describes.
            self.seq = int(prior.get("record_seq") or prior.get("seq") or 0)
            self.turns = list(prior.get("turns") or [])
            self.created = prior.get("created") or self.created
            # Everything a person put on the record stays on it. A title they
            # renamed, a pin, an archive and the provider the session was
            # started on all survive an end and a resume, because they are
            # facts about the session and not about the process.
            self.title = prior.get("title") or None
            self.title_source = prior.get("title_source") or None
            self.pinned = bool(prior.get("pinned"))
            self.archived = bool(prior.get("archived"))
            self.seen_seq = int(prior.get("seen_seq") or 0)
            self.provider = provider or prior.get("provider") or self.provider
            # The chat's model and effort survive the process, which is the
            # whole point of storing them on the record: a session ended
            # yesterday on opus comes back on opus. An argument given now
            # outranks the file -- that is a person picking on the launch --
            # and a record written before 2026-09-21 says neither, which
            # reads as the persona's default and is what it was.
            self.model = model or prior.get("model") or None
            self.effort = effort or prior.get("effort") or None
            self.last_message = prior.get("last_message") or None
            self.last_event_at = prior.get("last_event_at") or None
            # An adopted session is adopted for good: where it came from and
            # which file its history is in are facts about the session and
            # outlive any one process.
            self.origin = prior.get("origin") or adoption.ORIGIN_UI
            self.source = prior.get("source") or None
            replayed = prior.get("replayed")
            self.replayed = int(replayed) if replayed else None
            # What the file behind it looked like when it was last read. A
            # record written before 2026-09-21 says neither, which reads as
            # "never measured" and is refreshed once on the next read.
            size, mtime = prior.get("source_size"), prior.get("source_mtime")
            self.source_size = int(size) if isinstance(size, int) else None
            self.source_mtime = int(mtime) if isinstance(mtime, int) else None
            # Which CLI session this record drives outlives the process that
            # forked it. Without this a broker restart would fork the app's
            # session a second time and the turns taken here would be in a
            # file nothing points at.
            self.cli_session_id = prior.get("cli_session_id") or None
            self.forked_from = prior.get("forked_from") or None
            self.thread_id = prior.get("thread_id") or None
            # When this session was last active is a fact about the session,
            # and the listing is sorted by it. Left at "now" -- which is what
            # a fresh object gets -- a PATCH would rewrite it, and pinning a
            # session from July would jump it to the top of the home screen
            # as though somebody had just spoken to it. Caused on the live
            # broker, 2026-09-18, by pinning a two-day-old session.
            self.last_activity = parse_iso(prior.get("last_activity"),
                                           self.last_activity)
            # A session is done being named when its name came from the vault
            # or from a person. A record wearing the stand-in opening words is
            # not: the writer may have filed it since, and the next turn's
            # result looks again. Before title_source existed (2026-09-22) any
            # title counted, which is why a session that ran before its
            # transcript was written kept the opening words forever.
            self._titled = self.title_source in ("vault", "person")
            # No process of ours is behind this record until start() says so,
            # so the session is not running whatever the file says.
            self.state = "exited"
            self._restored_status = recovered_status(
                prior.get("status"), self.turns)

    # -- persistence -------------------------------------------------------
    #
    # Two files per session. The .jsonl is the event log and is what a
    # reconnecting client is replayed from; the .json is the record the
    # listing reads, so listing sessions never has to parse an event log.

    @property
    def log_path(self) -> Path:
        return cfg.SESSION_DIR / f"{self.id}.jsonl"

    @property
    def meta_path(self) -> Path:
        return cfg.SESSION_DIR / f"{self.id}.json"

    def is_live(self) -> bool:
        """Is a process of this broker's behind this session right now.

        Residency and nothing else: whether this session's ~450 MB are in RAM
        at this moment. Read off the process object -- the broker's own
        process table -- and never inferred from ``status``, which is about
        the turn: a ``done`` session with a warm idle process IS live, and a
        record left saying ``working`` by a broker that has since restarted
        is NOT.

        Both halves, and each one catches what the other cannot. A process
        object whose ``returncode`` is set is gone, however recently, and
        ``state`` does not say so until ``_reap`` gets the line -- so a
        session whose CLI has just died is not live. And ``stop()`` sets
        ``state`` before the kill it may have to fall back on, so a session
        the broker has finished with is not live either, whatever its
        ``returncode`` reads for the next few milliseconds. Neither direction
        may claim residency: 450 MB the box cannot use is not 450 MB in use.
        """
        return (self.state == "running" and self.proc is not None
                and self.proc.returncode is None)

    def meta(self) -> dict:
        """The session record: what the listing answers and what the snapshot
        spreads flat.

        The position field is ``record_seq`` and not ``seq``. Same number,
        same meaning -- the last event's number -- under a name that cannot
        be read as this item's own identity, because the record is sent on
        the event stream as ``broker.session`` and a client that applied a
        `seq` once dropped the real event wearing it. See the module
        docstring.
        """
        return {
            "session_id": self.id,
            "agent": self.agent,
            "provider": self.provider,
            # Null on both means the persona's own setting, which is what a
            # client draws as the unticked menu. GET /v1/providers says what
            # the other rows are.
            "model": self.model,
            "effort": self.effort,
            "origin": self.origin,
            "source": self.source,
            "replayed": self.replayed,
            "source_size": self.source_size,
            "source_mtime": self.source_mtime,
            # What a first message into this session would re-send to the
            # model, in bytes: the app's own session file, for an adopted
            # record nobody has spoken to here yet. Null for every other kind.
            "history_bytes": history_bytes(self.origin, self.cli_session_id,
                                           self.source_size),
            "cli_session_id": self.cli_session_id,
            "forked_from": self.forked_from,
            "thread_id": self.thread_id,
            "workspace": str(self.workspace),
            "created": self.created,
            "last_activity": datetime.fromtimestamp(
                self.last_activity, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "last_event_at": self.last_event_at,
            "state": self.state,
            # Whether this session is resident in RAM right now, read off the
            # process table (`is_live`). `state` is the lifecycle word the
            # record was written with and goes stale in a file; this is the
            # answer to "is it holding 450 MB", which is the question the cap
            # is about and the one a page filters on. Never absent and never
            # null: false is the answer for every session no process is
            # behind, which is most of a home screen.
            "live": self.is_live(),
            "status": self.status(),
            "title": self.title,
            # What named it: null for the stand-in opening words, "vault" for
            # the name the transcript writer filed, "person" for a rename.
            "title_source": self.title_source,
            "last_message": self.last_message,
            "pinned": self.pinned,
            "archived": self.archived,
            "exit_code": self.exit_code,
            "record_seq": self.seq,
            # How far this one has been read, against `record_seq`, which is
            # how far it goes. Unread is `seen_seq < record_seq`, and the
            # page does that subtraction rather than being handed a boolean
            # that would be wrong the moment the next event landed.
            "seen_seq": self.seen_seq,
            # How many background tasks are running behind this session right
            # now. An integer and never absent: 0 is the answer for a session
            # that has none, and a page reads one number rather than asking
            # whether a key is missing because there are none or because the
            # record predates the field.
            "background_tasks": len(self.background_tasks),
            "turns": [with_context(turn) for turn in self.turns],
            "pending_permissions": list(self.pending),
        }

    def task_started_at(self, task_id: str) -> str:
        """When the broker first saw a background task (UTC ISO). Set as the
        CLI's list names it (`_set_background_tasks`); a task added another
        way (Codex's root calls) is stamped the first time it is asked for,
        which is when the engine hears its `broker.background_tasks`."""
        seen = getattr(self, "_task_seen", None)
        if seen is None:
            seen = self._task_seen = {}
        return seen.setdefault(task_id, datetime.now(timezone.utc)
                               .strftime("%Y-%m-%dT%H:%M:%SZ"))

    def working_behind(self) -> bool:
        """Is something still coming that no result has accounted for.

        True is what makes `status` answer `waiting` rather than `done` once
        the turn's own result has landed; with the turn still open it changes
        nothing, because a turn in flight is `working` either way.

        The three shapes, and each one of them is a chat the owner watched go to
        its done state while the persona was still working (2026-09-22):

        - **a live background task.** The persona launched a subagent with
          ``run_in_background``, its own turn ended and the CLI emitted
          ``result`` -- minutes or tens of minutes before the subagent
          finishes and the answer arrives.
        - **a task that has left the CLI's list without notifying yet.** The
          list empties one event before the notification, and a status
          computed in between would flicker to `done` and back inside a
          millisecond.
        - **a notification that has fired.** It is the CLI handing the persona
          another turn; the turn's own `system`/`init` follows it. Cleared by
          the `result` that ends that turn.

        Stale entries are dropped here as well as by `_settle`, so a record
        read after the backstop's window has passed answers the truth even if
        nothing has saved it since.
        """
        if self._awaiting:
            cutoff = time.monotonic() - cfg.BACKGROUND_SETTLE_S
            self._awaiting = {task: seen for task, seen
                              in self._awaiting.items() if seen > cutoff}
        return bool(self.background_tasks or self._awaiting or self._resuming)

    def busy(self) -> str | None:
        """Why this live session may not be ended to make room, or None when
        it may (2026-11-09): mid-turn, asking a person, or waiting on work it
        launched. What admission's eviction and the idle stops ask."""
        if self.pending:
            return "needs_input"
        if self._turn_active:
            return "working"
        if self.working_behind():
            return "waiting"
        return None

    def status(self) -> str:
        """One word for what this session is doing, which is what the home
        screen draws a row from. The vocabulary is STATUSES above.

        ``needs_input`` outranks ``working`` deliberately: a paused turn is
        in flight, and a page that drew a spinner for it would hide the one
        thing the person has to do for it to continue.

        ``working`` is the CLI's turn being open: the model is generating.

        ``waiting`` is what sits between that and ``done`` (2026-09-25). The
        turn's ``result`` has arrived and something is still coming -- a
        background task the session launched, or a notification that has not
        landed yet -- so `working_behind` is true and the session is parked
        until its children report. Until today both of those answered
        ``working``, which held the row off ``done`` correctly and then told a
        small untruth about what the session was doing: the owner watched their
        own chat sit on a state that says "generating" while its agent had
        ended its turn and was blocked on two background jobs, and read the
        row as finished, because the cues that say "generating" are the
        page's and are keyed to the live stream, not to this word. An agent
        that is writing and an agent that is waiting on its children are two
        things a person reads differently, so they are two words.
        `background_tasks` is unchanged and stays a separate field: it says
        what is being waited ON, and the count is not the state.

        ``state`` is not this and stays beside it: ``state`` is whether a
        process exists, ``status`` is what the session is. An exited session
        is ``done`` if its last turn succeeded -- it has an answer to read
        and its id resumes -- and ``failed`` only if something went wrong.
        """
        if self.pending:
            return "needs_input"
        if self.state == "running":
            if self._turn_active:
                return "working"
            if self.working_behind():
                return "waiting"
        elif self._restored_status is not None:
            # A record this broker did not start. What it was doing is over.
            return self._restored_status
        elif (self.state == "exited" and not self._stop_requested
                and self._last_result_ok is None):
            # It ended before it ever answered anything, and nobody asked it
            # to. That is a failure and there is nothing else it could be.
            #
            # **What is NOT a failure, since 2026-09-22: a process ended from
            # outside while the session was idle with a good answer on it.**
            # A persona's reply answered at
            # 19:27:13Z, sat idle, and had its process killed at 19:49:02Z when
            # systemd restarted the broker -- the unit sets no KillMode, so
            # SIGTERM goes to every process in the cgroup and the CLI child
            # gets it at the same instant the broker does. `_reap` ran before
            # `stop()` had recorded that the end was asked for, so this branch
            # answered `failed` and the home screen drew the red ring on a
            # conversation that was complete and fine.
            #
            # It is the same rule the README already states for an ended
            # session -- "it has an answer to read and its id resumes" -- and
            # the exception here was contradicting it. A turn that was in
            # flight when the process went is still `failed`: `_reap` sets
            # `_last_result_ok` False for it, because the person sent a message
            # and got no answer.
            return "failed"
        if self._last_result_ok is None:
            return "idle"
        return "done" if self._last_result_ok else "failed"

    def save(self) -> None:
        """Write the record, and tell the live list it changed.

        Every change to a record goes through here, so this is the one place
        ``GET /v1/sessions/events`` has to be fed from: a status, a title, a
        last message, a pin, an archive and a brand-new session are all a
        record being written. Hanging the fan-out off the write rather than
        off each caller is what keeps the live list from silently missing the
        next field somebody adds.
        """
        # Announced even when the write fails (a full disk, 2026-10-22): the
        # record in memory is the truth a page should see, and a `failed`
        # turn that stayed unsaid because the disk was full would be the
        # stranded chat over again. The error still goes to the caller.
        try:
            self.meta_path.write_text(json.dumps(self.meta(), indent=2),
                                      encoding="utf-8")
        finally:
            if self.on_record_change is not None:
                self.on_record_change(self)

    # -- the process -------------------------------------------------------

    def argv(self, resume: bool) -> list[str]:
        """The launch line, and every flag on it is load-bearing.

        Not here, on purpose: --settings (the persona's own settings must
        load, and an override would silence outputStyle),
        --append-system-prompt-file (that is a wake's lane, not a
        conversation's), --disallowed-tools (a conversation has the owner in it;
        the unattended restrictions are bin/wake's and do not belong on a
        surface someone is watching).

        **--model and --effort are here only when this chat asked for them**
        (2026-09-21). They were in the paragraph above until then, and the
        reason they left it is unchanged: the persona's settings name the
        model, so a session nobody has chosen for passes neither flag and the
        CLI reads that file. What a person picks in the + menu is on the
        record, and a record that names one is a person having overridden it
        for this chat and no other.

        **Three endings, and an adopted session has two of them.** A session
        of the broker's own is started under an id chosen here
        (``--session-id``) and resumed under it. A session adopted from the
        Claude Code app is never resumed under its own id at all: the first
        launch is ``--resume <the app's id> --fork-session``, which reads that
        conversation and continues it in a NEW session file of the CLI's own,
        leaving the app's untouched; every launch after that resumes the id
        the CLI minted for the fork. ``resume`` is not consulted for an
        adopted session because there is only one way to drive one and it is
        this, whichever way the route was called.

        The fork's id is not asked for. ``--session-id`` alongside
        ``--resume --fork-session`` is accepted by the CLI's parser, and what
        it does with it is not documented and not something to find out by
        assuming: the id arrives in the ``system``/``init`` message either
        way, and reading it back is the one answer that cannot be wrong. See
        ``_handle``.
        """
        # The flags are cfg.CLAUDE_STREAM_FLAGS, one authority shared with the
        # provider follower's smoke test (2026-11-11). Among them,
        # --permission-prompt-tool stdio routes a permission prompt onto the
        # control channel instead of auto-denying it. Without it the CLI
        # denies anything that would prompt and reports it in
        # permission_denials -- caused 2026-09-16.
        argv = [cfg.CLAUDE, *cfg.CLAUDE_STREAM_FLAGS]
        if self.model:
            argv += ["--model", self.model]
        if self.effort:
            argv += ["--effort", self.effort]
        if self.origin == adoption.ORIGIN_APP:
            if self.cli_session_id is None:
                argv += ["--resume", self.id, "--fork-session"]
            else:
                argv += ["--resume", self.cli_session_id]
        elif resume:
            argv += ["--resume", self.id]
        else:
            argv += ["--session-id", self.id]
        return argv

    async def start(self, resume: bool = False) -> None:
        if not (self.workspace / "agent.json").is_file():
            raise BrokerError(404, f"no agent named {self.agent!r}")
        if (self.origin == adoption.ORIGIN_APP
                and self.cli_session_id is None
                and not (self.source and Path(self.source).is_file())):
            # An adopted record with nothing behind it to fork. `argv` would
            # ask the CLI to resume a conversation it cannot find, and the
            # process would start and die -- which reads on the page as a
            # session that failed a turn rather than one that was never
            # there. Asked only before the fork: afterwards this session runs
            # on a file of the CLI's own and the app's is history it already
            # holds.
            raise BrokerError(
                409,
                f"session {self.id} was adopted from the Claude Code app and "
                f"the session file it was read out of is gone, so there is "
                f"nothing to fork from. Start a new session with the same "
                f"agent instead.")
        # The shared skills, current for this start (first release L7): the
        # Claude shelf above the workspaces and this persona's view. Never
        # fails a start (lib/loam_skills.py).
        await asyncio.to_thread(loam_skills.quiet_refresh, self.workspace)
        env = dict(os.environ)
        env["DISABLE_AUTOUPDATER"] = "1"
        env["CLAUDE_PROJECT_DIR"] = str(self.workspace)
        # No compaction window is set: the CLI's own automatic compaction,
        # near the model's window being full, is the only automatic one, and
        # anything earlier is a person pressing compact (the owner, 2026-09-30,
        # undoing the 400k of the same morning). See "Compaction" in
        # broker/README.md.
        # LOAM_WAKE is not set. See the module docstring: absent means
        # "conversation" to hooks/transcript_capture.py, and this is one.
        env.pop("LOAM_WAKE", None)
        # Which broker session this CLI is, for what it calls: the engineer's
        # brief reads it to say which thread a job came from (2026-11-12,
        # lib/loam_waiters.py). The same on every engine.
        env[loam_waiters.SESSION_ENV] = self.id
        # Which surface this conversation is being held on, for the transcript
        # the writer files. Nothing in the session file says: a broker session
        # is the same CLI in the same workspace under the same hooks as a
        # conversation the owner has in the Claude Code app, which is why the
        # first 157 transcripts all read `surface: claude-code` and a Loam
        # conversation could not be told from a Remote Control one. This is
        # the only party that knows, so this is where it is said.
        env[loam_transcript.SURFACE_ENV_VAR] = loam_transcript.SURFACE_LOAM_UI
        if self.origin == adoption.ORIGIN_APP:
            # A conversation that began in the app and is now being held here.
            # The surface is where it is happening; the origin is where it
            # came from, and only this kind has one to state.
            env[loam_transcript.ORIGIN_ENV_VAR] = adoption.ORIGIN_APP
        else:
            env.pop(loam_transcript.ORIGIN_ENV_VAR, None)
        self.resumed = resume
        # A process of ours exists again, so the status recovered from the
        # file is no longer what this session is; it is what it was.
        self._restored_status = None
        self._stop_requested = False
        self._turn_active = False
        # A new process has no children yet, whatever the last one left behind.
        self._clear_background()
        # A process that has just started is active. Without this a session
        # resumed after a day carries a day-old last_activity into a reaper
        # that ends anything idle for an hour, and it would be killed inside
        # the minute.
        self.last_activity = time.time()
        # This is the process boundary, and it is the only thing that knows
        # where the CLI's running cost total starts over. See _cost_delta.
        self._process_cost = None
        self.proc = await asyncio.create_subprocess_exec(
            *first_to_go(self.argv(resume)),
            cwd=str(self.workspace),
            stdin=asyncio.subprocess.PIPE,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE,
            env=env,
            # The CLI writes one JSON object per line and some of those lines
            # are a whole tool result. asyncio's default 64 KiB stream limit
            # raises on the first big one and there is no way to recover the
            # line, so the limit is set where it can be set at all.
            limit=16 * 1024 * 1024,
        )
        self.state = "running"
        self.save()
        asyncio.create_task(self._pump_stdout())
        asyncio.create_task(self._pump_stderr())
        # The SDK handshake. The CLI answers with its commands and output
        # styles; what matters is that the channel is open in both directions
        # before the first user message arrives.
        await self.send_raw({"type": "control_request",
                             "request_id": f"init-{self.id}",
                             "request": {"subtype": "initialize", "hooks": None}})

    async def send_raw(self, obj: dict) -> None:
        if self.proc is None or self.proc.stdin is None or self.state != "running":
            raise BrokerError(409, f"session {self.id} is not running")
        async with self._write_lock:
            self.proc.stdin.write((json.dumps(obj) + "\n").encode())
            await self.proc.stdin.drain()

    async def send_message(self, text: str,
                           attachments: list[dict] | None = None) -> int:
        """A person's words, into the process AND into the durable log.

        ``broker.user_message`` exists because the CLI does not echo what a
        person sent: ``--replay-user-messages`` is deliberately not passed
        (see ``argv``), and a ``user`` event on this stream is a tool result.
        So without this event the log holds one side of a conversation, and a
        client replaying a session it did not watch live shows answers with
        no questions -- caused 2026-09-16 by reopening a session in the app.
        A client must still render the message it just typed; this is not an
        echo for the sender, it is the record for everyone else and for
        later.

        Emitted BEFORE the text reaches the CLI's stdin, so the replay reads
        in the order the conversation happened: the person's line, then
        whatever the session did about it. The refusal send_raw would make is
        made here first, because a message the CLI never received must not be
        in the log as one a person sent.

        Returns the event's own seq, which is what the route answers with.
        Reading self.seq after the fact would be a lie under load: the CLI's
        pump is a task on this loop and may number an event of its own
        between the emit and the reply, and a sender told the wrong number
        cannot recognise its own line on the stream.

        **Attachments are named, and images are also shown.** Every attached
        file is named by its vault path in the text, because a path is what a
        persona can act on: it reads a PDF, a CSV or a file of code with Read,
        in its own time, and a big file does not have to cross this pipe to be
        useful. An image is different -- the persona cannot see a PNG by
        reading it -- so an image is ALSO base64'd into the message as an
        image content block, the shape the CLI's stream-json input takes
        (`content` as a list of blocks; verified against the CLI 2.1.270).
        The path is still named for an image, so the persona can say where the
        picture it is looking at lives.
        """
        if self.proc is None or self.proc.stdin is None or self.state != "running":
            raise BrokerError(409, f"session {self.id} is not running")
        attachments = attachments or []
        event = {"type": "broker.user_message",
                 "session_id": self.id,
                 "text": text}
        if attachments:
            event["attachments"] = attachments
        await self.emit(event)
        await self.send_raw({"type": "user",
                             "message": {"role": "user",
                                         "content": self._content(
                                             self._timed(text), attachments)}})
        self.last_activity = time.time()
        # The turn is in flight from here until its result comes back, which
        # is what makes the row say `working` the instant the message lands
        # rather than when the model gets round to answering.
        self._turn_active = True
        if self.title is None:
            self.title = first_words(
                text or (f"Attached {attachments[0]['name']}"
                         if attachments else ""))
        self.save()
        return event["seq"]

    # Whether this engine takes a person's words into a turn in flight
    # (2026-11-14). See `steer`.
    STEERS = True

    async def steer(self, text: str,
                    attachments: list[dict] | None = None) -> int | None:
        """Words for the turn in flight, at its next safe boundary; the seq
        of the ``broker.user_message`` (``steered: true``) that records them,
        or None when there is no turn in flight to take them (the caller
        then starts a turn of its own, as for any message).

        Claude Code reads stdin while a turn runs (verified on 2.1.325,
        2026-11-14): a user message written while a tool runs is taken in
        after that tool's result and answered in the same turn, one
        ``result``; one written after the model's last words and before its
        ``result`` opens a second harness turn of its own (``init`` 0.1 s
        after the first ``result``). Either way the running tool is never
        cut and nothing is dropped; the thread engine watches for the
        second shape (``STEER_FOLLOW_S``)."""
        if (not self._turn_active or self.proc is None or self.proc.stdin is None
                or self.state != "running"):
            return None
        attachments = attachments or []
        event = {"type": "broker.user_message", "session_id": self.id,
                 "text": text, "steered": True}
        if attachments:
            event["attachments"] = attachments
        await self.emit(event)
        await self.send_raw({"type": "user",
                             "message": {"role": "user",
                                         "content": self._content(
                                             self._timed(text), attachments)}})
        self.last_activity = time.time()
        return event["seq"]

    def _content(self, text: str, attachments: list[dict]) -> str | list[dict]:
        """What goes to the CLI as the user message's `content`.

        A string when there is nothing attached -- which is every message this
        interface carried before 2026-09-21, and the shape stays exactly as it
        was rather than becoming a one-block list for no reason. Otherwise the
        blocks: the person's words, the paths, and an image block per image
        small enough for the API to take.
        """
        if not attachments:
            return text
        lines = [text] if text else []
        lines.append("Attached to this message"
                     " (files on disk, readable with Read):")
        blocks: list[dict] = []
        for item in attachments:
            note = f"- {item['path']} ({item['type']}, {human_size(item['size'])})"
            inline = (item["type"] in cfg.INLINE_IMAGE_TYPES
                      and item["size"] <= cfg.INLINE_IMAGE_MAX_BYTES)
            if inline:
                note += " -- the image itself is attached below"
                blocks.append({
                    "type": "image",
                    "source": {"type": "base64", "media_type": item["type"],
                               "data": base64.b64encode(
                                   Path(item["path"]).read_bytes()).decode()},
                })
            elif item["type"] in cfg.INLINE_IMAGE_TYPES:
                note += (f" -- too big to show inline "
                         f"(over {human_size(cfg.INLINE_IMAGE_MAX_BYTES)})")
            lines.append(note)
        return [{"type": "text", "text": "\n".join(lines)}] + blocks

    async def set_choices(self, changes: dict) -> list[str]:
        """This chat's model and effort, changed where the change has to
        land: on the record, and -- while a process is up -- in the process.

        A running CLI does not re-read its launch flags, so telling it is the
        only way a change takes effect before the next launch, and the CLI's
        own way of being told is its slash commands. ``/model opus`` and
        ``/effort high`` are sent as a user message on the same stdin a
        person's words go down, value and all, which is what the headless
        docs say those commands take in ``-p`` mode. Verified by causing
        2026-09-21 on this box: a session started on sonnet, PATCHed to opus,
        answered the next message with ``claude-opus-5`` on its turn record.

        Not through ``send_message``: a command is not something a person
        said, and putting it in the event log as ``broker.user_message``
        would draw "/model opus" in the transcript as though the owner had
        typed it into the chat. The record's own change is how a client
        learns, and it arrives on the live list as ``broker.session``.

        **Clearing goes back to the persona's setting at the next launch,
        not now.** ``/model`` with no value opens a picker, and there is
        nobody at this end of the pipe to pick; the record says null from
        here and the next process simply carries no flag. The caller says so
        in the answer rather than leaving it to be discovered.

        Returns the commands actually sent, which is what the route reports.
        """
        sent = []
        for field, command in (("model", "/model"), ("effort", "/effort")):
            if field not in changes:
                continue
            value = changes[field]
            setattr(self, field, value)
            if value and self.state == "running":
                await self.send_raw({
                    "type": "user",
                    "message": {"role": "user",
                                "content": f"{command} {value}"}})
                sent.append(f"{command} {value}")
        # last_activity is deliberately left alone, as it is for a pin or a
        # rename: picking a model for a session from Tuesday is not the
        # session having been spoken to, and the home screen is sorted by
        # when it was. Caused by a pin, 2026-09-18; the same trap.
        self.save()
        return sent

    async def answer_permission(self, request_id: str, behavior: str,
                                message: str | None = None,
                                updated_input: dict | None = None,
                                answers: dict | None = None,
                                updated_permissions: list | None = None,
                                resolved_as: str | None = None) -> None:
        """Answer a pending request. ``resolved_as`` is the broker's own
        name for an answer nobody gave (``expired``), which goes to the CLI
        as the deny it is and onto the stream under that name.

        ``updated_permissions`` is the CLI's own ``PermissionUpdate`` list, as
        it proposed it in ``permission_suggestions``, put on the
        ``control_response`` unaltered beside ``updatedInput``. Never made up
        here; the route has already refused any destination but ``session``."""
        req = self.pending.get(request_id)
        if req is None:
            raise BrokerError(404, f"no permission request {request_id} is pending")
        asked = _questions_of(req)
        scope = None
        if behavior == "allow" and asked is not None:
            # A question is answered with its answers, keyed by question
            # text as the CLI's own prompt keys them. Checked before the
            # request leaves `pending`, so a 400 leaves the card answerable.
            try:
                checked = questions_fmt.check(asked, answers)
            except questions_fmt.AnswerError as exc:
                raise BrokerError(400, str(exc)) from None
            response = {"behavior": "allow",
                        "updatedInput": questions_fmt.to_claude(
                            req.get("input") or {}, asked, checked)}
        elif behavior == "allow":
            checked = None
            response = {"behavior": "allow",
                        "updatedInput": updated_input
                        if updated_input is not None else req.get("input", {})}
            if updated_permissions:
                response["updatedPermissions"] = updated_permissions
                scope = "session"
        else:
            checked = None
            # A declined question is told to the model in the CLI's words,
            # not as a refused permission.
            response = {"behavior": "deny",
                        "message": message or (questions_fmt.CLAUDE_DECLINED
                                               if asked is not None
                                               else "Denied from the client.")}
        self.pending.pop(request_id, None)
        await self.send_raw({"type": "control_response",
                             "response": {"subtype": "success",
                                          "request_id": request_id,
                                          "response": response}})
        self.last_activity = time.time()
        # The answer is on the wire, so every client watching this session is
        # told the card is gone -- including the one that did not answer it.
        # Without this, a second device holds a card for a request that no
        # longer exists until the next broker.session event happens to
        # reconcile it, and there is no reason a second device should have to
        # guess. Emitted AFTER the control_response, so it says what happened
        # rather than what is about to; the CLI's own resumed events may
        # interleave, and a client orders by seq anyway.
        await self.emit(_resolved_event(self.id, request_id,
                                        resolved_as or behavior, req,
                                        message, checked, scope))
        self.save()

    async def expire_permissions(self, now: float) -> list[str]:
        """Deny every request that has waited ``PERMISSION_WAIT_S``, with a
        sentence that tells the model what happened and what to do. The
        process lives and the turn finishes on its own; this is the reaper's
        answer to a session that is asking, where ending it is the answer to
        one that is idle. Returns the ids it expired."""
        expired = []
        for request_id, req in list(self.pending.items()):
            asked_at = req.get("raised_at", self.last_activity)
            if now - asked_at < cfg.PERMISSION_WAIT_S:
                continue
            await self.answer_permission(
                request_id, "deny", cfg.PERMISSION_EXPIRED_MESSAGE,
                resolved_as="expired")
            expired.append(request_id)
        return expired

    async def close_pending(self, behavior: str) -> None:
        """Close every request still pending with ``behavior`` on the stream
        and nothing sent to the provider: the process that asked is gone or
        going. Taken off ``pending`` before anything is emitted, so a second
        caller -- `stop` and `_reap` both get here when a process is ended --
        finds nothing and writes nothing twice."""
        closing = list(self.pending.items())
        self.pending.clear()
        for request_id, req in closing:
            await self.emit(_resolved_event(self.id, request_id, behavior,
                                            req, None, None))
        if closing:
            self.save()

    # -- the stream --------------------------------------------------------

    async def _raise_request(self, req: dict, event: dict) -> None:
        """Put a pending request's event on the stream, and keep it on the
        broker's copy of the request as it went out (2026-11-08). A session's
        own stream replays it from the log; a thread's stream has no log, and
        its opening ``thread.snapshot`` carries ``pending_events()`` instead,
        so a page opened after the question was asked can still draw it."""
        req["event"] = event
        await self.emit(event)

    def _timed(self, text: str) -> str:
        """What the harness is sent for a person's text: the clock first,
        unless this session's prompts carry their own. The log keeps the
        text as typed."""
        if not self.tell_time or (text or "").lstrip().startswith("/"):
            # A slash command typed into a chat is the harness's to read
            # first; a line in front of it would make it prose.
            return text
        return loam_clock.stamp(text)

    def pending_events(self) -> list[dict]:
        """Every request still open, as the ``broker.permission_request``
        that raised it, oldest first."""
        return [dict(req["event"]) for req in self.pending.values()
                if isinstance(req.get("event"), dict)]

    async def emit(self, event: dict) -> None:
        """Number it, write it down, hand it to whoever is listening.

        Written to disk BEFORE it is fanned out, because the disk copy is what
        a client that was not connected gets replayed from. A client that saw
        an event the log does not have would be a client that cannot recover
        by reconnecting, which is the one property this whole file is for.

        **One conversation wears one id on the wire.** A forked session's
        process states its own id on every envelope it writes, and that id is
        not this record's: a client keying events by ``session_id`` would read
        the history it was replayed and the turn it just took as two
        different threads. So an event naming the CLI's fork is rewritten to
        name the record. Nothing is hidden by it -- the fork's id is on the
        record as ``cli_session_id``, and each turn record keeps the id the
        process reported for the turn that ran.
        """
        if (self.cli_session_id is not None
                and event.get("session_id") == self.cli_session_id):
            event["session_id"] = self.id
        self.seq += 1
        event["seq"] = self.seq
        # When this session last showed any sign of life. `last_activity` is
        # not the same thing and never was: it is bumped by a client answering
        # a permission and by the reaper's arithmetic, so a page asking "it
        # says working -- when did it last actually do something?" has to ask
        # this one. A working session whose last event was twenty minutes ago
        # is a different thing from one that is mid-sentence, and a spinner
        # cannot say which.
        self.last_event_at = now_iso()
        try:
            self._append(event)
        except OSError as exc:
            self._not_saved(event, exc)
        for queue in list(self.subscribers):
            queue.put_nowait(event)

    def _append(self, event: dict) -> None:
        """One event, one line, and the line starts at the start of a line.

        **A write that fails can leave half a line behind.** On 2026-10-22
        `/` filled mid-stream and the log of session f3069d8e was left ending
        `{"type": "stream_event", "ev` with no newline; the next event,
        the owner's message, was appended onto it, and every replay since has
        skipped the pair as one unparsable line. So until a write is known to
        have finished, the next one looks at the file's last byte first and
        starts a fresh line if it has to. It costs one read per session after
        each failure, and one at the first write after a broker start.
        """
        data = (json.dumps(event) + "\n").encode("utf-8")
        with self.log_path.open("ab") as handle:
            if not self._log_ends_clean and handle.tell() > 0:
                with self.log_path.open("rb") as tail:
                    tail.seek(-1, os.SEEK_END)
                    if tail.read(1) != b"\n":
                        data = b"\n" + data
            self._log_ends_clean = False
            handle.write(data)
            handle.flush()
        self._log_ends_clean = True

    def _not_saved(self, event: dict, exc: OSError) -> None:
        """An event the log could not take. Never fatal to the session.

        Until 2026-10-22 this raised out of `emit` and killed the reader
        that called it: with `/` full, session f3069d8e's `_pump_stdout` died
        on one event, the persona went on answering into a pipe nobody read,
        and the record sat on `working` for the hour until the reaper. Now the
        event still goes to every page that is watching -- it is lost only to
        a later replay -- the reader goes on reading, and the turn it belongs
        to is marked failed at its `result` with a sentence a page can show.

        The first failure in a turn also puts ``broker.write_failed`` on the
        live stream: the reason, and the ``seq`` it started at. Like
        ``broker.session`` it is not an event and is never logged, because
        the log is the thing that is failing.
        """
        reason = _not_saved_reason(exc)
        print(f"log: {self.id[:8]}: seq {event.get('seq')} not written ({exc})",
              file=sys.stderr, flush=True)
        if self._unsaved is None:
            self._unsaved = reason
            notice = {"type": "broker.write_failed", "session_id": self.id,
                      "reason": reason, "from_seq": event.get("seq")}
            for queue in list(self.subscribers):
                queue.put_nowait(notice)
        self._log_ends_clean = False

    def snapshot(self) -> dict:
        """The record as a stream item, and the only item here that is not an
        event: no number, no line in the log, nothing to dedupe against.

        A client applies it every time it arrives and keeps the latest.
        """
        return {"type": "broker.session", **self.meta()}

    def broadcast_snapshot(self) -> None:
        """Hand the current record to everyone watching, without logging it.

        Called when a turn record is written, because the turn's real cost
        (``cost_delta_usd``) and the model it ran on live in the record and
        not in the CLI's ``result`` envelope -- the broker computes the first
        and reads the second back. Without this a page that wants to price
        the turn that just ended has to re-fetch the record and match it to
        an event by hand; asked for by the app's engineer 2026-09-16.

        Deliberately not ``emit``: a snapshot in the log would be replayed as
        a stale record in the middle of a transcript, and numbering it would
        put back the collision that removing ``seq`` just fixed. A client
        that was not connected loses nothing, because the snapshot it gets
        at connect is by definition newer.
        """
        event = self.snapshot()
        for queue in list(self.subscribers):
            queue.put_nowait(event)

    async def _pump_stdout(self) -> None:
        assert self.proc is not None and self.proc.stdout is not None
        while True:
            line = await self.proc.stdout.readline()
            if not line:
                break
            text = line.decode("utf-8", "replace").strip()
            if not text:
                continue
            try:
                obj = json.loads(text)
            except json.JSONDecodeError:
                await self.emit({"type": "broker.exit",
                                 "error": "unparsable line from the CLI",
                                 "raw": text[:2000]})
                continue
            try:
                await self._handle(obj)
            except OSError as exc:
                # A record that could not be written (`save` on a full disk)
                # is the same failure as an event that could not be, and it
                # must not end the reader either: the process would go on
                # answering into a pipe nobody reads (2026-10-22). The event
                # itself has been handled as far as it got.
                print(f"pump: {self.id[:8]}: {exc}", file=sys.stderr,
                      flush=True)
                if self._unsaved is None:
                    self._unsaved = _not_saved_reason(exc)
        await self._reap()

    async def _handle(self, obj: dict) -> None:
        kind = obj.get("type")
        if kind == "system" and obj.get("subtype") == "init":
            model = obj.get("model")
            if isinstance(model, str) and model:
                self._init_model = model
            # **Where a fork says what it is called.** The CLI mints the
            # forked session's id and states it here, in the first thing it
            # says; nothing else on the stream is authoritative about it and
            # the launch line never asked for a particular one (see `argv`).
            #
            # Only an adopted session can reach the body of this: every other
            # session was started under an id chosen here, and an init
            # message naming a different one would be a surprise to report
            # rather than a fact to record.
            said = obj.get("session_id")
            if (self.origin == adoption.ORIGIN_APP and isinstance(said, str)
                    and said and said != self.id
                    and said != self.cli_session_id):
                self.cli_session_id = said
                self.forked_from = self.id
                # Not saved here: `system` is one of the two kinds that save
                # below, after the event is on the stream, and one write is
                # enough.
            # **And where a turn opens.** The CLI writes an `init` ahead of
            # every turn in `--input-format stream-json` mode, not once per
            # process: a turn a person started, and equally a turn the CLI
            # opens by itself to hand the persona a task notification. Read off
            # this box's own logs, 2026-09-22 -- 26 inits across five processes
            # of one session, one before each turn and none at a launch nobody
            # had spoken to yet, which is why this cannot make an untouched
            # session read `working`.
            #
            # It is load-bearing for more than the resumed turn. A session that
            # was handed a notification emitted `result` at seq 1579 and opened
            # the real turn at `init` 1580, with the next result 900 events
            # later (session 940380fd): without this the row said `done` for
            # the whole of it.
            self._turn_active = True
        # The background tasks behind this turn, and the two events that end
        # one. See `working_behind` for what each means to a row on a screen.
        background_changed = False
        if kind == "system" and obj.get("subtype") == "background_tasks_changed":
            background_changed = self._set_background_tasks(obj.get("tasks"))
        if kind == "system" and obj.get("subtype") == "task_notification":
            # A task has reported, and the CLI's own note on the notification
            # says what it is for: it fires each time a background agent stops,
            # and the persona is given it as a turn of its own. So the session
            # is working from here until that turn's result.
            self._awaiting.pop(obj.get("task_id") or "", None)
            if obj.get("task_id"):
                self._notified[obj["task_id"]] = time.monotonic()
            self._resuming = True
        if kind == "control_request":
            request = obj.get("request") or {}
            if request.get("subtype") == "can_use_tool":
                request_id = obj["request_id"]
                # AskUserQuestion reaches this channel as a permission
                # prompt for that tool; it is a question, and the card that
                # answers it needs the questions, not Allow/Deny on the JSON.
                if request.get("tool_name") == questions_fmt.CLAUDE_TOOL:
                    asked = questions_fmt.from_claude(request.get("input") or {})
                    if asked is not None:
                        request = {**request, "questions": asked}
                # When it was asked, which is what PERMISSION_WAIT_S counts
                # from. On the broker's copy only; never on the event.
                request = {**request, "raised_at": time.time()}
                self.pending[request_id] = request
                self.last_activity = time.time()
                await self._raise_request(request, _request_event({
                    "type": "broker.permission_request",
                    "session_id": self.id,
                    "request_id": request_id,
                    "tool_name": request.get("tool_name"),
                    "display_name": request.get("display_name"),
                    "input": request.get("input"),
                    "description": request.get("description"),
                    "decision_reason": request.get("decision_reason"),
                    "decision_reason_type": request.get("decision_reason_type"),
                    "permission_suggestions": request.get("permission_suggestions"),
                    "tool_use_id": request.get("tool_use_id"),
                }, request))
                self.save()
            return
        if kind == "control_cancel_request":
            # The CLI withdrew a prompt (the turn was interrupted, or the tool
            # call went away). Drop it rather than leave a request the client
            # could still answer into nothing. Said on the stream, so the
            # card a page drew for it goes too (2026-10-05).
            request_id = obj.get("request_id", "")
            req = self.pending.pop(request_id, None)
            if req is not None:
                await self.emit(_resolved_event(self.id, request_id,
                                                "cancelled", req, None, None))
            self.save()
        if kind == "control_response":
            return  # the initialize handshake's answer; not the client's business
        if kind == "rate_limit_event" and self.provider == cfg.DEFAULT_PROVIDER:
            # The provider's own reading of the quota, which arrives here and
            # nowhere else: no route asks for it, the CLI volunteers it
            # mid-turn. Kept on disk so a restart -- or a day when nobody
            # takes a turn -- does not blank the providers page.
            try:
                cfg.keep_usage_event(obj, self.id)
            except OSError as exc:
                print(f"usage: could not record ({exc})", file=sys.stderr,
                      flush=True)
        if kind == "assistant":
            # The only place the model is stated. Read back, not assumed --
            # and only from a TOP-LEVEL message: one with a parent_tool_use_id
            # came from a subagent, which the persona's own settings may run
            # on a different model entirely, and the turn's model is the
            # turn's own.
            if obj.get("parent_tool_use_id") is None:
                model = (obj.get("message") or {}).get("model")
                if isinstance(model, str) and model:
                    self._turn_model = model
                # And the only place the context is stated. Each top-level
                # assistant message is a request the model answered, and its
                # `usage` says what that request's context held; the last one
                # of a turn is therefore the turn's high-water mark. The result
                # envelope's own `usage` is NOT this and cannot be used for it:
                # it is the turn's requests added up, so a three-request turn
                # on this box reported 101,905 where the last request's context
                # was 35,271 (session 49db688c, 2026-09-22), and a twenty-round
                # turn would have reported three million tokens in a one
                # million token window.
                usage = (obj.get("message") or {}).get("usage")
                if isinstance(usage, dict):
                    self._turn_usage = usage
                # What the status box on the home screen shows. Top-level for
                # the same reason: a subagent's sentence is machinery, and
                # what the person is owed is what the persona said to them.
                said = loam_transcript._text_of(
                    (obj.get("message") or {}).get("content"))
                if said:
                    self.last_message = said[:cfg.LAST_MESSAGE_CHARS]
                    self.save()
        if kind == "result":
            self._turn_active = False
            # A notification's turn is this turn, and it is over. Whatever the
            # persona was resuming for has been answered; if another task
            # reports there will be another notification.
            self._resuming = False
            # An envelope says how it went in two places and they disagree on
            # different days: `is_error` is the CLI's own flag and `subtype`
            # is "success" or one of the error subtypes. Either saying so is
            # enough to call the turn failed.
            self._last_result_ok = not (
                bool(obj.get("is_error"))
                or (obj.get("subtype") or "success") != "success")
            # What this turn cost in context, the broker's own arithmetic on
            # the CLI's own numbers: how full the window was at the turn's last
            # request, and how big the window is for the model it ran on. It is
            # on the turn record AND on the event that closes the turn, because
            # a page drawing "used of window" as the answer arrives should not
            # have to re-fetch a record to do it. The page renders; the broker
            # does the arithmetic and neither number is a guess.
            # Codex states a request's usage only after the message it
            # answered has closed, so its assistant events carry the request
            # before; the result's usage is the turn's last request
            # (`tokenUsage.last`), measured 2026-10-01.
            if obj.get("provider") == "codex" and obj.get("usage"):
                self._turn_usage = obj["usage"]
            context = {"used": context_used(self._turn_usage),
                       "window": context_window(obj, self._turn_model)}
            if self._turn_usage is None and self._compacted_to is not None:
                # A `/compact` turn states no usage of its own: no assistant
                # message answers it. What the context holds after it is the
                # marker's `post_tokens`, and the window is the one the `init`
                # after the marker named, read out of this envelope's
                # `modelUsage` like any other. Until 2026-10-01 this turn said
                # `{used: null}` and the record went on reading as full as the
                # turn before it (fac1b2dc: 446,773 after compacting to 12,954).
                context = {"used": self._compacted_to,
                           "window": context_window(obj, self._init_model)}
            obj["context"] = dict(context)
            # Point 5 of the brief: what the envelope reports, per turn, kept
            # where the listing can read it without parsing the event log.
            self.turns.append({
                "ts": now_iso(),
                "session_id": obj.get("session_id"),
                "subtype": obj.get("subtype"),
                "model": self._turn_model,
                "duration_ms": obj.get("duration_ms"),
                "num_turns": obj.get("num_turns"),
                "total_cost_usd": obj.get("total_cost_usd"),
                "process_start": self._process_cost is None,
                "cost_delta_usd": self._cost_delta(obj.get("total_cost_usd")),
                "context": context,
                "usage": obj.get("usage"),
                "permission_denials": obj.get("permission_denials"),
            })
            # The next turn's model and the next turn's context are the next
            # turn's to state. A turn whose top-level messages named neither
            # records null rather than inheriting the last turn's, because
            # "this turn ran on fable" is a claim about this turn.
            self._turn_model = None
            self._turn_usage = None
            self._compacted_to = None
        self.last_activity = time.time()
        await self.emit(obj)
        if kind == "result" and self._unsaved is not None:
            # Something this turn said is not in the log -- its own result
            # included, possibly -- so a page that opens it later is shown
            # less than happened. That is a failed turn whatever the CLI
            # thought of it, and the record says why (2026-10-22).
            self._last_result_ok = False
            self.turns[-1]["not_saved"] = self._unsaved
            self._unsaved = None
        if kind == "system" and obj.get("subtype") == "compact_boundary":
            # After the CLI's own marker, so the log holds both. See
            # compaction_event for the shape and where it came from.
            entry = compaction_event(self.id, obj)
            self._compacted_to = entry["tokens_after"]
            await self.emit(entry)
        if background_changed:
            # After the CLI's own event, so a client reads what changed and
            # then the count the broker keeps of it.
            await self.emit(self.background_event())
        try:
            if kind in ("result", "system"):
                self.save()
        finally:
            if kind == "result":
                # After the result event, so a client reads the turn's end and
                # then the record that prices it. See broadcast_snapshot. Sent
                # when the save failed too: the record is what says why.
                self.broadcast_snapshot()
        if kind == "result":
            if not self._titled and not self._titling:
                self._titling = True
                asyncio.create_task(self._title())

    # -- the tasks running behind a turn ------------------------------------
    #
    # Added 2026-09-22. The owner watched a chat go to its done state with the
    # persona still working: it had launched a background subagent, its own
    # turn had ended, and the answer arrived twenty minutes later. The CLI says
    # all of this on its own stream and the broker was not reading it.

    def _set_background_tasks(self, tasks) -> bool:
        """The CLI's live list of background tasks, taken as stated. True if
        the count changed.

        ``system``/``background_tasks_changed`` carries the WHOLE list every
        time -- `[]` when the last one ends -- so it is copied rather than
        added to and subtracted from: a broker keeping its own tally would
        drift from the CLI's the first time an event was missed, and the CLI is
        the only party that knows.

        A task that has left the list goes into `_awaiting` until its
        notification arrives, because the list empties one event BEFORE the
        notification fires (seq 10155 then 10157 of session 940380fd) and a
        status computed in between would say `done` and take it back inside the
        same millisecond.
        """
        if not isinstance(tasks, list):
            return False
        live = [task for task in tasks if isinstance(task, dict)]
        was = {task.get("task_id") for task in self.background_tasks}
        now = {task.get("task_id") for task in live}
        cutoff = time.monotonic() - cfg.BACKGROUND_SETTLE_S
        self._notified = {t: at for t, at in self._notified.items() if at > cutoff}
        for task_id in was - now:
            if task_id and task_id not in self._notified:
                self._awaiting[task_id] = time.monotonic()
        for task_id in now - was:
            if task_id:
                self.task_started_at(task_id)
        self._task_seen = {t: at for t, at in getattr(self, "_task_seen", {}).items()
                           if t in now}
        before, self.background_tasks = len(self.background_tasks), live
        if self._awaiting or self._resuming:
            self._arm_settle()
        return before != len(live)

    def background_event(self) -> dict:
        """What a client is told when the count changes.

        The count is the field the record carries and the one a page draws. The
        tasks are beside it because the CLI names them -- a description a
        person wrote in the brief that launched them -- and a client that wants
        to say *which* subagent is running should not have to parse the CLI's
        own event to find out. A client that only wants the badge reads
        `count` and ignores the rest.
        """
        return {"type": "broker.background_tasks",
                "session_id": self.id,
                "count": len(self.background_tasks),
                "tasks": [{"task_id": task.get("task_id"),
                           "task_type": task.get("task_type"),
                           "description": task.get("description")}
                          for task in self.background_tasks]}

    def _arm_settle(self) -> None:
        """The backstop under `_awaiting` and `_resuming`.

        Both are held open by an event that has always arrived in the same
        breath, and neither may hold a row on `waiting` for a session that is
        in fact finished -- which is the defect this whole point is about, with
        its sign flipped. So a timer: when it fires, whatever is still
        outstanding is dropped and the record is written if that changed what
        the session is. Re-armed on every change, cancelled when the process
        ends, and never a reason anything fails -- a Session built outside a
        running loop (a test, a probe) simply has no timer.
        """
        try:
            loop = asyncio.get_running_loop()
        except RuntimeError:
            return
        if self._settle is not None:
            self._settle.cancel()
        self._settle = loop.call_later(cfg.BACKGROUND_SETTLE_S, self._settled)

    def _settled(self) -> None:
        self._settle = None
        if not (self._awaiting or self._resuming):
            return
        self._awaiting.clear()
        self._resuming = False
        # Written without asking whether it changed anything. `working_behind`
        # has already stopped ANSWERING `waiting` for an entry this old, so the
        # comparison would say "no change" and leave the last record a client
        # was handed saying `waiting` for good -- which is the whole failure
        # this backstop exists to prevent, arrived at by a shortcut. It fires
        # only when a notification never came, which is never on this box.
        self.save()

    def _clear_background(self) -> None:
        """A process is gone, so its children are. Nothing outlives it: a
        background task is a child of the CLI process that launched it, and a
        record left saying two would draw a badge for two subagents that
        stopped when the process did."""
        if self._settle is not None:
            self._settle.cancel()
            self._settle = None
        self.background_tasks = []
        self._awaiting.clear()
        self._resuming = False

    async def _title(self) -> None:
        """Take this session's name from the transcript the writer filed.

        The vault's title IS the title. It was not always: this called the
        same titler the writer calls, on the reasoning that one function is
        one name -- and it is not, because the two calls read different text
        at different moments and answer differently. Caused 2026-09-22: one
        conversation was "Household note and image attachment" on the home
        screen and "Attachment check" in the vault. Two names for one
        conversation is two conversations to anybody reading, and there is no
        arbitrating between two model calls, so one of them had to stop. The
        writer's stays, because the vault is the record and the file is named
        once and never renamed; this one reads its answer.

        Polled rather than read once, because the writer is filing this same
        conversation on the same Stop hook and its titler has a 45s budget.
        Exhausting the waits is not a failure: the stand-in stays on the row
        and the next turn's result tries again. Fail-soft throughout -- a
        title is a convenience, and a session that cannot be named is not a
        session that has gone wrong.
        """
        try:
            for wait in cfg.TITLE_POLL_WAITS:
                await asyncio.sleep(wait)
                if self._titled:        # a person renamed it while we waited
                    return
                # The CLI session the writer files under, which is this
                # record's own id unless this session was forked out of an
                # adopted one -- then the turns are in the fork's file and
                # the transcript is filed under the fork's id. A Codex
                # thread is filed under its thread id (2026-10-01).
                title = await asyncio.to_thread(
                    adoption.transcript_title,
                    self.cli_session_id or self.thread_id or self.id)
                if title:
                    self.title = title
                    self.title_source = "vault"
                    self._titled = True
                    self.save()
                    return
        except Exception as exc:  # noqa: BLE001 - a title must never cost a session
            print(f"title: {self.agent}/{self.id[:8]}: {exc!r}",
                  file=sys.stderr, flush=True)
        finally:
            self._titling = False

    def _cost_delta(self, total: float | None) -> float | None:
        """What THIS turn cost, which ``total_cost_usd`` does not say.

        ``total_cost_usd`` is the process's running total and it resets at a
        resume, because a resume is a new process. Measured 2026-09-16: turn
        one $0.34253275, turn two $0.35690825 -- turn two cost the $0.0144
        difference, not $0.357 -- then a resume, and turn three reported
        $0.01428225. A client that subtracts for itself has to know where
        each process began, and nothing in the turn records says: the records
        carry across a resume on purpose, because they are the session's.
        The broker is the only party that knows, because it started the
        processes, so the subtraction is made here.

        **And a resume does not always reset it** (found 2026-10-13). The CLI
        now restores a resumed session's saved total, sometimes: of 99 first
        turns after a start in the broker's records, 86 reported the
        session's earlier total plus the turn (f3069d8e: $81.57, then $82.79
        on the first turn after a resume), and 13 started over from zero or
        from an older saved total (940380fd: $28.41, then $16.46, which is the
        $15.76 an earlier process ended at plus the turn). Until then the
        first turn after a start was recorded as its own delta, so each
        restore booked the whole session again: a week's deltas summed to
        about 7x what was spent. So the first turn of a process subtracts the
        largest base it could have started from that is not above its total:
        zero, or the total the session stood at when one of its earlier
        processes ended (see _cost_bases). That is exact for a restore and a
        reset alike; it undercounts only a reset whose single turn cost more
        than an earlier process's whole running total, which is the rare
        case where the other reading overcounted every time.

        Rounded to ten places to keep binary floating point out of a number
        displayed as money: 0.35690825 - 0.34253275 is 0.014375500000000018
        in doubles and $0.0143755 in fact. Ten places is two more than the
        CLI reports, so it rounds representation and never a real digit.

        ``None`` when the envelope did not report a total, because a cost the
        CLI did not state is not one to invent.
        """
        if not isinstance(total, (int, float)) or isinstance(total, bool):
            return None
        previous, self._process_cost = self._process_cost, float(total)
        if previous is None:
            base = max((b for b in self._cost_bases() if b <= total), default=0.0)
            return round(float(total) - base, 10)
        return round(float(total) - previous, 10)

    _process_cost: float | None = None   # the previous turn's total, THIS process

    def _cost_bases(self) -> set[float]:
        """Every running total a new process of this session could resume
        from: zero, and the last total of each earlier process, which is what
        the CLI saves when a process ends. Read off the turn records, which
        carry across a resume and a fork: a turn is a process's first when it
        says ``process_start``, or, before that key (2026-10-13), when its
        delta equals its total, which the old rule wrote for exactly those."""
        def total(t: dict) -> float | None:
            v = t.get("total_cost_usd")
            return float(v) if isinstance(v, (int, float)) and not isinstance(v, bool) else None

        def starts(t: dict) -> bool:
            if "process_start" in t:
                return bool(t["process_start"])
            return t.get("cost_delta_usd") is not None and t.get("cost_delta_usd") == t.get("total_cost_usd")

        priced = [t for t in self.turns if total(t) is not None]
        bases = {0.0}
        bases.update(total(a) for a, b in zip(priced, priced[1:]) if starts(b))
        if priced:
            bases.add(total(priced[-1]))   # the process before this one
        return bases

    # The model of the turn being read right now: the last top-level
    # ``assistant`` message's, reset to None when the turn's result is
    # recorded. A turn record's ``model`` is always this key and is never
    # absent; ``null`` means no top-level assistant message of that turn
    # named a model, which is the honest answer and not a gap to fill.
    #
    # What is deliberately NOT consulted, and the reason the rule is written
    # down at all: the result envelope's ``modelUsage`` is a dict of every
    # model the PROCESS billed, including the CLI's own small-model calls. A
    # real turn as ada came back
    # ``{"claude-haiku-4-5-20251001": ..., "claude-fable-5-1": ...}``
    # (caused 2026-09-16); picking out of that is a guess, and picking
    # alphabetically -- which this once did -- answered "fable" only because
    # f sorts before h, and would have called an Opus session Haiku. The
    # persona's settings are not consulted either: "the settings say fable"
    # and "this turn ran on fable" are different claims, and only the second
    # is evidence.
    _turn_model: str | None = None

    async def _pump_stderr(self) -> None:
        assert self.proc is not None and self.proc.stderr is not None
        while True:
            line = await self.proc.stderr.readline()
            if not line:
                break
            text = line.decode("utf-8", "replace").rstrip()
            if text:
                print(f"[{self.agent}/{self.id[:8]}] {text}", file=sys.stderr,
                      flush=True)

    async def _reap(self) -> None:
        assert self.proc is not None
        self.exit_code = await self.proc.wait()
        self.state = "exited"
        # A turn cut off here is failed below on its own account; what it
        # could not write down is not carried into the next process.
        self._unsaved = None
        # Every request still open is closed on the stream before
        # `broker.exit`, so the log never holds one that a replay would draw
        # as a live card (2026-10-05). A crash reaches this, as does a stop.
        await self.close_pending("ended")
        had_tasks = bool(self.background_tasks)
        self._clear_background()
        if had_tasks:
            # Said rather than left to be inferred from broker.exit: a client
            # drawing a badge from the count is told the count is zero by the
            # same event that has always told it, and not by a different one.
            await self.emit(self.background_event())
        if self._turn_active:
            # A turn that never produced a result did not finish, even if
            # somebody asked the process to end. The person sent a message
            # and got no answer, and `done` would be a lie about that.
            self._turn_active = False
            self._last_result_ok = False
        await self.emit({"type": "broker.exit", "session_id": self.id,
                         "exit_code": self.exit_code, "ts": now_iso()})
        self.save()
        for queue in list(self.subscribers):
            queue.put_nowait(None)

    async def stop(self) -> None:
        """End the process, keep the session. The id resumes: the CLI's own
        session file under ~/.claude holds the context, which is the whole
        reason `--session-id` is chosen up front."""
        # Set before the signal, because _reap runs as soon as the pipe
        # closes and asks this question: a process that ended because
        # somebody asked it to has not failed.
        self._stop_requested = True
        if self.proc is not None and self.proc.returncode is None:
            self.proc.terminate()
            try:
                async with asyncio.timeout(10):   # not wait_for: gh-86296
                    await self.proc.wait()
            except TimeoutError:
                self.proc.kill()
        # Here as well as in `_reap`, because the broker's own shutdown calls
        # this and may exit before the pump reads the closed pipe: the
        # closing events must be on the log by then (2026-10-05).
        await self.close_pending("ended")
        self.state = "exited"
        # Whatever it was running behind the turn went with it. `_reap` says
        # the same thing on the stream when the pipe closes; this is what the
        # record says, and the two must not disagree for even one write.
        self._clear_background()
        self.save()

    # -- staying in step with the app's own file ----------------------------
    #
    # Added 2026-09-21. An adopted record is a reading of a file this broker
    # does not write, and the owner goes on talking to the persona in the app,
    # so the reading goes stale the moment it is taken: they found a persona's
    # conversation drawn as it had been hours earlier. Three things keep it
    # current and all three are the same read of the same file -- a refresh on
    # every read of the record, a poll while somebody has the thread open, and
    # the scan for files nobody has adopted yet (`Broker.scan_for_new`).

    def followable(self) -> bool:
        """Is this record's history a file somebody else may still be writing.

        Four tests, and each one of them is a way this would do harm:

        - **adopted, with a file behind it.** A session the broker started has
          its history in its own log and there is nothing to follow.
        - **never forked** (`cli_session_id`). The fork read that conversation
          and went on in a file of its own; what the owner says in the app on
          that session after it is a branch this record does not follow, and
          the README says so. Following both would interleave two futures of
          one conversation.
        - **no log of this broker's own**, which is the same question
          `Broker._settled` asks and the same answer: the numbering above
          `replayed` belongs to events a client has already been handed, and
          re-counting the file under them would renumber history.
        - **no process of ours running it.** A fork's first event and a
          translated entry would both be numbered from `replayed + 1`, and one
          of the two would wear a number the other already had.
        """
        if self.origin != adoption.ORIGIN_APP or not self.source:
            return False
        if self.cli_session_id or self.proc is not None or self.state == "running":
            return False
        try:
            return not self.log_path.stat().st_size
        except OSError:
            return True

    def refresh_from_source(self) -> int:
        """Read the app's file again if it has grown, and hand what is new to
        whoever is listening. Returns how many events that was.

        The whole of point 1 and most of point 2 of this job. A stat decides:
        the record keeps the size and the mtime it last read, and

        - **both unchanged** -- nothing has touched the file, and that is the
          answer for 25 of the 26 adopted records on any given read.
        - **mtime moved, size the same** -- something on this box stamps old
          session files (`loam_adopt.last_timestamp` says what was measured
          and when), and a touch is not a turn. The new mtime is written down
          so the next read compares against what the file says now; nothing is
          parsed.
        - **the size moved** -- the conversation went on, and the record is
          made again out of the file: title, last message, activity and the
          count of what the file replays. That count is `replayed` and
          `record_seq` together, exactly as the scan sets them, because a
          record that promised a different number than the stream delivers is
          a record whose next turn overwrites the end of its own history.

        `save()` puts the new record on the live list, so a home screen open
        in a browser redraws the row without asking. The events past what has
        already been handed out go to this session's own listeners, numbered
        from where the record had reached -- so an open thread gains the turns
        the owner took in the app, in the same shapes as the replay and
        continuous with it.

        They are handed out and **not logged**. Writing them to the session's
        own log would give this record a log of the broker's own, which is the
        one thing that settles it against the scan and stops the follow: the
        file would stop being the only copy of that conversation and the next
        turn taken here would number on top of it.
        """
        if not self.followable():
            return 0
        path = Path(self.source)
        size, mtime = adoption.source_stat(path)
        if size is None:
            # The file is gone -- a login cleared out, a session deleted in the
            # app. The record and everything already handed out still stand.
            return 0
        if (size, mtime) == (self.source_size, self.source_mtime):
            return 0
        if size == self.source_size:
            self.source_mtime = mtime
            self.save()
            return 0
        already = self.replayed or 0
        summary = adoption.summarise(path, self.id, self.agent,
                                     after=already if self.subscribers else None)
        self.replayed = summary["events"]
        self.seq = summary["events"]
        self.last_event_at = summary["last_event_at"] or self.last_event_at
        self.last_activity = parse_iso(summary["last_event_at"],
                                       self.last_activity)
        if summary["last_message"]:
            self.last_message = summary["last_message"][:cfg.LAST_MESSAGE_CHARS]
        # A title somebody chose stays. The stand-in does not: the transcript
        # writer may have filed this conversation since the record was made,
        # and the opening words move if the file the record was read from was
        # replaced. So the stand-in is re-derived and anything that is not the
        # stand-in is left exactly as it is -- which is the same rule the scan
        # follows, said in terms of what can be recomputed.
        stand_in = first_words(summary["opening"] or "") or None
        if self.title_source != "person" and (not self.title
                                              or self.title == stand_in):
            filed = adoption.transcript_title(self.id)
            self.title = filed or stand_in
            self.title_source = "vault" if filed else None
        self.source_size, self.source_mtime = size, mtime
        self.save()
        fresh = summary["appended"]
        for number, event in enumerate(fresh, start=already + 1):
            event["seq"] = number
            self.fan_out(event)
        if fresh:
            # The record again, after the events rather than before them: it
            # now says `record_seq` for the last event that has just gone out,
            # and a snapshot promising events a client has not been handed is
            # a client that thinks it is behind.
            self.broadcast_snapshot()
        return len(fresh)

    def fan_out(self, event: dict) -> None:
        """Hand an event to this session's listeners without logging it.

        For events that are not this broker's to log: an adopted session's
        conversation lives in the app's own file and the file stays the only
        copy of it. `emit` is the other door and it writes first.
        """
        for queue in list(self.subscribers):
            queue.put_nowait(event)

    def watch(self, queue: asyncio.Queue) -> None:
        """Register a listener. (An adopted record nobody had written into
        was followed against the app's own file while a classic chat had it
        open; that follower retired with the classic view on 2026-11-12.)"""
        self.subscribers.add(queue)

    def unwatch(self, queue: asyncio.Queue) -> None:
        self.subscribers.discard(queue)

    def replay(self, since: int) -> list[dict]:
        """Everything numbered above `since`; 0 is the session from the
        beginning. Since the classic chat view retired (2026-11-12) nothing
        on the wire streams a session -- a thread is what is read -- but this
        is still the one reading of a session's whole numbered history, both
        halves of an adopted one, and what the suite reads the log through.

        **An adopted session has two halves and this is where they are one
        stream** (2026-09-20). The first `replayed` events are translated out
        of the CLI's own session file -- the conversation the owner had in the
        app, which this broker never logged because it never ran it -- and
        the broker's own log carries everything after that, numbered from
        `replayed + 1` because that is where `Session.seq` was left. So a
        session adopted today and taken a turn in tomorrow reads as one
        conversation, and a client that reconnects at `?from=` lands in the
        right place in whichever half it had reached.

        The translated half is read at every replay and written down nowhere:
        the file is the only copy of that conversation on this box and it
        stays that way. It is cut to `replayed` deliberately -- the app may
        have gone on writing to that file since the record was last read, and
        an extra translated event would wear a number the broker's own log has
        already given to something else. What the app has said since is
        picked up by the refresh this replay is preceded by (`load` calls it),
        so `replayed` is current as of a moment ago rather than as of the last
        broker start. Once the session has been forked and sent into, that
        stops: the conversation continues in the fork's own file, the app's
        file is the first `replayed` events and nothing more, and anything
        said in the app after that is a branch this record does not follow.
        """
        out = []
        if self.origin == adoption.ORIGIN_APP and self.source:
            limit = self.replayed
            seq = 0
            try:
                for event in adoption.iter_events(Path(self.source), self.id):
                    seq += 1
                    if limit is not None and seq > limit:
                        break
                    event["seq"] = seq
                    if seq > since:
                        out.append(event)
            except OSError as exc:
                # The file moved or the login was cleared out. The record and
                # the broker's own log are still readable, and a thread that
                # opens short is better than a chat that will not open.
                print(f"replay: {self.id[:8]}: {self.source}: {exc}",
                      file=sys.stderr, flush=True)
        if not self.log_path.exists():
            return out
        with self.log_path.open(encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    event = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if event.get("seq", 0) > since:
                    out.append(event)
        return out


def wake_envelope(task: dict) -> str:
    """What a woken Codex root is told a background task finished with: the
    tag Claude's CLI hands a persona its task notification in, so the model
    reads it as the same thing and the transcript writer drops it as the same
    thing (`loam_transcript._HARNESS_ENVELOPES`), not as the owner's words."""
    name = task.get("description") or task.get("task_type") or "A background task"
    said = (task.get("said") or "").strip() or "(it said nothing)"
    return ("<task-notification>\n"
            f"<task-id>{task.get('task_id')}</task-id>\n"
            "<status>completed</status>\n"
            f"<summary>{name} finished after your turn had ended. "
            "What it finished with is below.</summary>\n"
            f"<result>\n{said}\n</result>\n"
            "</task-notification>")


def command_description(command, limit: int = 60) -> str:
    """A root command left running, as its background task names it: the
    script inside the ``/bin/bash -lc '…'`` Codex wraps every command in,
    on one line, cut at ``limit`` characters."""
    if isinstance(command, list):
        argv = [str(part) for part in command]
        text = " ".join(argv)
    else:
        text = str(command or "")
        try:
            argv = shlex.split(text)
        except ValueError:
            argv = []
    if (len(argv) == 3 and os.path.basename(argv[0]) in ("bash", "sh", "zsh")
            and argv[1] in ("-c", "-lc")):
        text = argv[2]
    text = " ".join(text.split())
    return text if len(text) <= limit else text[:limit - 1].rstrip() + "…"


class CodexSession(Session):
    """A persona session on Codex (2026-10-01): ``codex app-server`` over
    stdio in the persona's workspace, in place of ``claude -p``.

    Everything a record is -- the log, the numbering, the status, the turn
    records, the title, the seen mark, pin and archive -- is ``Session``'s and
    unchanged. What differs is the wire. The app-server speaks JSON-RPC 2.0, so
    this keeps a table of requests in flight and answers the server's own
    requests (approvals); and its notifications are translated by
    ``loam_codex.Translator`` into the Claude CLI's event shapes and handed to
    ``Session._handle``, which does the bookkeeping exactly as it does for a
    Claude turn. One translation, and the page draws a Codex thread with the
    code that draws every other.

    The handshake is ``initialize`` / ``initialized``, then ``model/list``
    (kept, so the + menu is the list this binary offers), then
    ``thread/start`` with the workspace as ``cwd`` -- or ``thread/resume`` by
    the record's ``thread_id`` when it has one. One ``turn/start`` per
    message, carrying this chat's model and effort when it has picked them.

    **The persona is the same person here** (second Codex brief,
    2026-10-01): its instructions are regenerated from its own files at
    every start (``loam_codex.write_instructions``), and its tools, hooks and
    sandbox come from ``.codex/config.toml``, rendered by ``bin/provision
    --codex`` from the sources of ``.mcp.json`` and ``.claude/``. The
    workspace and the runtime's hooks are trusted in ``CODEX_HOME`` before
    the thread starts, because Codex loads neither otherwise. The transcript
    is the Claude one's writer, called by Codex's Stop hook on the rollout.

    **A subagent's thread is a background task, not the conversation**
    (2026-10-02). The root thread can spawn subagents, and the app-server
    puts their notifications on this same stream, each with its own
    ``threadId``. Until today every one of them was read as the root's: a
    subagent's ``turn/started`` reopened the row's turn, its
    ``turn/completed`` closed it while the root was still working, and the
    root's own ``turn/completed`` read as the session done while a subagent
    still held a tool call open. The owner watched exactly that on a persona's chat
    7bcccd28: the root ended its turn at 15:24:09Z saying the work was sent,
    its subagent sat on an engineer call for the next half hour, and the
    row said ``done`` with ``background_tasks`` 0 the whole time. So a turn on
    any thread but the record's is a background task -- in
    ``background_tasks`` from its ``turn/started`` to its ``turn/completed``
    -- which is the Claude mapping unchanged: ``waiting`` with the count once
    the root's turn is over, ``done`` when the last one ends. The subagent's
    items are still drawn as they always were. See ``_subagent_turn``.

    **And one that ends after the root's turn wakes the root** (2026-10-09).
    Codex hands a finished subagent's report to a root turn in flight, and
    to nothing otherwise: the report sat unread until the owner's next message
    (proved 10-02), so a persona could not brief from a subagent and hear
    the receipt the way a Claude persona hears its task notification. Now
    the broker does what the Claude CLI does: a ``system``/``task_notification``
    on the stream, then a root turn carrying the subagent's last message in
    a ``<task-notification>`` envelope (which the transcript writer drops,
    as it drops Claude's). The same holds for an MCP call the root left
    running when its turn ended -- a persona's a9c8ec2c, where a ``brief`` ran on
    for 23 minutes behind a row that said ``done`` -- and for a command the
    root left running (probe f35cc554's ``sleep 30``). See ``_wake``.
    """

    REQUEST_TIMEOUT_S = 60
    # How long a wake waits for others before it goes out, so two subagents
    # ending together give the root one turn; long enough for the root's own
    # `subagent-completed` item, which lands between a subagent's idle and its
    # `turn/completed`, to arrive first.
    WAKE_GATHER_S = 1.0
    # Every server request that asks a person something, each a permission
    # card on the page (`_server_request`). Anything else is refused, so a
    # turn is told no rather than left waiting on an answer nobody will
    # give. The elicitation was missing until 2026-10-01: it is how Codex
    # asks before an MCP tool call, and refusing it on the client's behalf
    # reached the model as "user rejected MCP tool call" with no card ever
    # drawn (a persona's thread 01a0f8a0, four calls). The two names without a
    # slash are the v1 protocol's, sent only to a v1 conversation; they are
    # here so that a change of protocol cannot reopen the same hole.
    APPROVALS = ("item/commandExecution/requestApproval",
                 "item/fileChange/requestApproval",
                 "item/permissions/requestApproval",
                 "mcpServer/elicitation/request",
                 "item/tool/requestUserInput",
                 "execCommandApproval",
                 "applyPatchApproval")

    def __init__(self, *args, **kwargs) -> None:
        super().__init__(*args, **kwargs)
        self.provider = "codex"
        self._rpc_next = 0
        self._waiters: dict[int, asyncio.Future] = {}
        self._codex = codex.Translator(self.id)
        # What each subagent thread is called, from the root's own
        # `subAgentActivity` item that started it (`/root/<task name>`): the
        # description a background task carries.
        self._agent_paths: dict[str, str] = {}
        # Which thread spawned each subagent, from the thread that item came
        # on: only the root's own children wake the root (see `_wake`).
        self._agent_parents: dict[str, str] = {}
        # The last thing each subagent said, which is what its wake carries.
        self._agent_said: dict[str, str] = {}
        # The id of the call that spawned each subagent thread (the
        # `subAgentActivity` item it started under): every event of that
        # thread is nested under it (`subagent_parent`).
        self._agent_calls: dict[str, str] = {}
        # The root's MCP calls and commands in flight (item id -> the
        # background task it would be), so one still open when the root's
        # turn ends can be a background task.
        self._root_calls: dict[str, dict] = {}
        # Wakes gathered in the `WAKE_GATHER_S` before one goes out.
        self._wakes: list[dict] = []
        self._wake_task: asyncio.Task | None = None

    def argv(self, resume: bool) -> list[str]:
        return [codex.CODEX, *codex.APP_SERVER_ARGV]

    async def start(self, resume: bool = False) -> None:
        if not (self.workspace / "agent.json").is_file():
            raise BrokerError(404, f"no agent named {self.agent!r}")
        env = codex.env()
        env.pop("LOAM_WAKE", None)
        env[loam_waiters.SESSION_ENV] = self.id
        # What the Claude session's hooks are given, for the same hooks: the
        # guard and the transcript writer find the persona by the project
        # directory, and the writer files the surface the broker states.
        env["CLAUDE_PROJECT_DIR"] = str(self.workspace)
        env[loam_transcript.SURFACE_ENV_VAR] = loam_transcript.SURFACE_LOAM_UI
        # The persona, assembled (2026-10-01): its instructions regenerated
        # from its own files, and its workspace trusted so the generated
        # `.codex/config.toml` -- tools, hooks, sandbox -- loads at all.
        if not (self.workspace / ".codex" / "config.toml").is_file():
            raise BrokerError(409, f"{self.agent} has no .codex/config.toml; "
                                   f"run bin/provision --codex {self.agent}")
        await asyncio.to_thread(codex.write_instructions, self.agent,
                                self.workspace)
        await asyncio.to_thread(loam_skills.quiet_refresh, self.workspace)
        await asyncio.to_thread(codex.write_trust, codex.persona_workspaces(),
                                codex.read_trusted_hooks())
        self.resumed = resume
        self._restored_status = None
        self._stop_requested = False
        self._turn_active = False
        self._clear_background()
        self._root_calls.clear()
        self._wakes.clear()
        self.last_activity = time.time()
        self._process_cost = None
        self.proc = await asyncio.create_subprocess_exec(
            *first_to_go(self.argv(resume)), cwd=str(self.workspace),
            stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE, env=env, limit=16 * 1024 * 1024,
            start_new_session=True)
        self.state = "running"
        asyncio.create_task(self._pump_stdout())
        asyncio.create_task(self._pump_stderr())
        try:
            await self.request("initialize", {
                "clientInfo": {"name": "loam-broker", "title": "Loam",
                               "version": "1"}})
            await self.notify("initialized")
            listed = await self.request("model/list", {})
            if isinstance(listed.get("data"), list):
                await asyncio.to_thread(codex.write_models, listed["data"])
            ws = str(self.workspace)
            # The runtime's hooks, trusted by the hash Codex computes for
            # them. A project hook Codex has not seen trusted does not run,
            # and an untrusted guard is no guard. Config is re-read per
            # request, so trust written here holds for the thread below.
            hooks = await self.request("hooks/list", {"cwds": [ws]})
            mine = codex.runtime_hooks(hooks.get("data"), self.workspace)
            prefix = str(self.workspace / ".codex" / "config.toml") + ":"
            trusted = {k: v for k, v in codex.read_trusted_hooks().items()
                       if not k.startswith(prefix)}
            await asyncio.to_thread(codex.write_trust,
                                    codex.persona_workspaces(),
                                    {**trusted, **mine})
            if self.thread_id:
                # A resumed thread keeps the instructions it started with
                # unless it is handed new ones; these are this start's.
                opened = await self.request("thread/resume", {
                    "threadId": self.thread_id, "cwd": ws,
                    "model": self.model, "excludeTurns": True,
                    "baseInstructions": codex.instructions(self.workspace),
                    "developerInstructions": codex.SUBAGENT_ASK})
            else:
                # Subagents on (2026-11-13): Loam's explicit ask, which is
                # what Codex's own multi-agent rule waits for
                # (loam_codex.SUBAGENT_ASK).
                opened = await self.request("thread/start", {
                    "cwd": ws, "model": self.model,
                    "developerInstructions": codex.SUBAGENT_ASK})
                self.thread_id = (opened.get("thread") or {}).get("id")
        except Exception:
            self._stop_requested = True
            if self.proc.returncode is None:
                codex.kill_group(self.proc.pid)
            self.state = "exited"
            raise
        self._codex.model = opened.get("model") or self.model
        self.save()

    # -- JSON-RPC ----------------------------------------------------------

    async def request(self, method: str, params: dict) -> dict:
        """One request, and its result. An error answer is a BrokerError
        carrying Codex's own message, because that sentence is the one a
        person can act on ("not logged in", "model not found")."""
        self._rpc_next += 1
        rpc_id = self._rpc_next
        future = asyncio.get_running_loop().create_future()
        self._waiters[rpc_id] = future
        try:
            await self.send_raw({"jsonrpc": "2.0", "id": rpc_id,
                                 "method": method, "params": params})
            async with asyncio.timeout(self.REQUEST_TIMEOUT_S):   # gh-86296
                answer = await future
        except TimeoutError:
            raise BrokerError(504, f"codex did not answer {method} in "
                                   f"{self.REQUEST_TIMEOUT_S}s") from None
        finally:
            self._waiters.pop(rpc_id, None)
        if "error" in answer:
            error = answer.get("error") or {}
            raise BrokerError(502, f"codex {method}: "
                                   f"{error.get('message') or error}")
        result = answer.get("result")
        return result if isinstance(result, dict) else {}

    async def notify(self, method: str, params: dict | None = None) -> None:
        message = {"jsonrpc": "2.0", "method": method}
        if params is not None:
            message["params"] = params
        await self.send_raw(message)

    async def _handle(self, obj: dict) -> None:
        method = obj.get("method")
        if method is None:
            # An answer to one of ours.
            future = self._waiters.get(obj.get("id"))
            if future is not None and not future.done():
                future.set_result(obj)
            return
        params = obj.get("params") if isinstance(obj.get("params"), dict) else {}
        if "id" in obj:
            await self._server_request(method, obj["id"], params)
            return
        if method == "serverRequest/resolved":
            # Codex withdrew or settled a request -- an interrupted turn takes
            # its approvals with it. Dropped, as a `control_cancel_request`
            # is for the CLI, and said on the stream the same way. One this
            # broker answered has already left `pending` and says nothing.
            for request_id, req in list(self.pending.items()):
                if req.get("rpc_id") == params.get("requestId"):
                    self.pending.pop(request_id, None)
                    await self.emit(_resolved_event(
                        self.id, request_id, "cancelled", req, None, None))
                    self.save()
            return
        if method == "account/rateLimits/updated":
            # The quota, an account reading rather than this thread's: kept
            # on disk for the providers row, and put on this chat's stream as
            # the `rate_limit_event` a Claude chat carries, so the page moves
            # the ring the way it already does for Claude.
            try:
                usage = codex.keep_rate_limits(params, self.id)
            except OSError as exc:
                print(f"usage: could not record codex ({exc})",
                      file=sys.stderr, flush=True)
                usage = None
            if usage is not None:
                await Session._handle(self, codex.rate_limit_event(usage, self.id))
            return
        item = params.get("item") if isinstance(params.get("item"), dict) else {}
        if (item.get("type") == "subAgentActivity" and item.get("agentThreadId")
                and item.get("agentPath")):
            self._agent_paths[item["agentThreadId"]] = item["agentPath"]
            if params.get("threadId"):
                self._agent_parents.setdefault(item["agentThreadId"],
                                               params["threadId"])
            # The call that spawned it: what the subagent's own events are
            # nested under (2026-11-13, see `subagent_parent`).
            if item.get("id") and item.get("kind") in (None, "started"):
                self._agent_calls.setdefault(item["agentThreadId"], item["id"])
        thread = params.get("threadId")
        if self.thread_id and thread and thread != self.thread_id:
            if (method == "item/completed" and item.get("type") in codex.MESSAGE_ITEMS
                    and isinstance(item.get("text"), str) and item["text"].strip()):
                self._agent_said[thread] = item["text"]
            # A subagent's thread. Its turn is a background task of this
            # session, and opening or closing it is not the root's turn
            # opening or closing; its token usage is its own context, not the
            # one the row's ring draws. Everything else -- its messages, its
            # tool calls and their results -- is translated as the root's
            # are, nested under the call that spawned it (`subagent_parent`),
            # so none of it is the persona's own words.
            if method == "turn/started":
                await self._subagent_turn(thread, True)
                return
            if method == "turn/completed":
                await self._subagent_turn(thread, False)
                return
            if method == "thread/status/changed":
                kind = (params.get("status") or {}).get("type")
                if kind in ("idle", "systemError", "notLoaded"):
                    await self._subagent_turn(thread, False)
                return
            if method == "thread/closed":
                await self._subagent_turn(thread, False)
                return
            if method == "thread/tokenUsage/updated":
                return
        # The root's MCP calls and commands. One still open when the root's
        # turn completes is a background task until its own `item/completed`,
        # which is then a wake: a9c8ec2c's `brief` ran 23 minutes past the
        # turn that made it, behind a row that said `done`, and probe
        # f35cc554's `sleep 30` 20 s past its turn the same way (a code cell
        # yields after 30 s and leaves its command running). Only these two:
        # a subagent's `subAgentActivity` and a `collabAgentToolCall`
        # straddle the root's turn end by a few events as a matter of course.
        late_call = None
        if (thread == self.thread_id and item.get("id")
                and item.get("type") in ("mcpToolCall", "commandExecution")):
            if method == "item/started":
                if item["type"] == "mcpToolCall":
                    task = {"task_type": "mcp_call",
                            "description": codex.tool_use(item).get("name")}
                else:
                    task = {"task_type": "local_bash",
                            "description": command_description(item.get("command"))}
                self._root_calls[item["id"]] = task
            elif method == "item/completed":
                self._root_calls.pop(item["id"], None)
                if any(task.get("task_id") == item["id"]
                       for task in self.background_tasks):
                    late_call = item
        if method == "turn/completed" and thread == self.thread_id:
            if (self._root_calls
                    and (params.get("turn") or {}).get("status") == "completed"):
                self.background_tasks = self.background_tasks + [
                    {"task_id": item_id, **task}
                    for item_id, task in self._root_calls.items()]
                await self.emit(self.background_event())
            self._root_calls.clear()
        parent = (self.subagent_parent(thread)
                  if self.thread_id and thread and thread != self.thread_id else None)
        for event in self._codex.feed(method, params, parent=parent):
            await Session._handle(self, event)
        if late_call is not None:
            content = codex.tool_result(late_call).get("content")
            if not isinstance(content, str):
                content = "\n".join(block.get("text") or "" for block in content or []
                                    if isinstance(block, dict))
            await self._task_ended(late_call["id"], content)

    def subagent_parent(self, thread: str) -> str:
        """The ``parent_tool_use_id`` a subagent thread's events carry
        (2026-11-13): the id of the call that spawned it, or a stand-in
        naming the thread when that call has not been seen (a resumed
        session's child, an event ahead of its spawn). Never null: a null
        parent is the persona speaking, and the thread engine posts a
        top-level message as the persona's reply. Until today every Codex
        subagent event went out with a null parent, so a subagent's
        sentence could post in a thread under the persona's name (receipt
        20261113-075745, gap 2). A grandchild's spawn arrives on its
        parent's thread, so its call id nests it under that child."""
        return self._agent_calls.get(thread) or f"codex-subagent:{thread}"

    async def _subagent_turn(self, thread: str, running: bool) -> None:
        """A subagent thread's turn opened or closed: the background list
        gains or loses it, and a client is told as it is for a Claude task.

        The list is the whole truth, kept here because Codex states no list of
        its own: a thread is in it from its ``turn/started`` to its
        ``turn/completed``. Nothing goes through `_awaiting`: that holds the
        gap before a Claude task's notification, and here the broker sends
        the notification itself, in the same breath (`_wake`)."""
        if not running:
            await self._task_ended(thread, self._agent_said.pop(thread, None))
            return
        live = [task for task in self.background_tasks
                if task.get("task_id") != thread]
        live.append({"task_id": thread, "task_type": "subagent",
                     "description": self._agent_paths.get(thread)})
        changed = len(live) != len(self.background_tasks)
        self.background_tasks = live
        self.last_activity = time.time()
        if changed:
            await self.emit(self.background_event())
            self.save()

    async def _task_ended(self, task_id: str, said: str | None) -> None:
        """A background task left the list: a subagent's turn, or a root MCP
        call or command that outlived its turn. Said to a client, and the root woken for
        it if it is the root's to hear. A subagent's end is signalled two or
        three times (idle, ``turn/completed``, ``thread/closed``); only the
        first finds it in the list."""
        task = next((task for task in self.background_tasks
                     if task.get("task_id") == task_id), None)
        self.last_activity = time.time()
        if task is None:
            return
        self.background_tasks = [other for other in self.background_tasks
                                 if other is not task]
        await self.emit(self.background_event())
        # A grandchild reports to the subagent that spawned it, not here.
        if self._agent_parents.get(task_id, self.thread_id) == self.thread_id:
            await self._wake(task, said)
        self.save()

    async def _wake(self, task: dict, said: str | None) -> None:
        """Hand the root what a finished task said, as Claude's CLI hands a
        persona its task notification: ``system``/``task_notification`` on the
        stream now, then a root turn whose input is the ``<task-notification>``
        envelope. The page draws the woken turn as it draws a Claude one --
        no ``broker.user_message``, an ``init``, the work, a ``result`` -- and
        the row goes ``waiting``/1 to ``working``/0 here, not via ``done``.

        A root mid-turn is not woken: Codex hands that turn the report itself.
        Tasks ending within ``WAKE_GATHER_S`` of each other share one turn;
        one ending after the wake's ``turn/start`` has gone joins that turn
        the same way, as Codex's own business. The ``turn/start`` is sent
        from a task of its own, because this runs on the stdout pump and the
        answer to it arrives on that pump."""
        if self.state != "running" or self._stop_requested or not self.thread_id:
            return
        if self._turn_active and self._wake_task is None:
            return
        self._turn_active = True
        await Session._handle(self, {
            "type": "system", "subtype": "task_notification",
            "session_id": self.id, "provider": "codex",
            "task_id": task.get("task_id"), "task_type": task.get("task_type"),
            "description": task.get("description"), "status": "completed",
            "summary": said})
        self._wakes.append({**task, "said": said})
        if self._wake_task is None:
            self._wake_task = asyncio.create_task(self._send_wake())

    async def _send_wake(self) -> None:
        await asyncio.sleep(self.WAKE_GATHER_S)
        wakes, self._wakes = self._wakes, []
        self._wake_task = None
        if not wakes or self.state != "running" or self._stop_requested:
            self._turn_active = False
            return
        params = {"threadId": self.thread_id, "input": [
            {"type": "text",
             "text": "\n\n".join(wake_envelope(wake) for wake in wakes)}]}
        if self.model:
            params["model"] = self.model
            self._codex.model = self.model
        if self.effort:
            params["effort"] = self.effort
        self.last_activity = time.time()
        try:
            started = await self.request("turn/start", params)
            turn_id = (started.get("turn") or {}).get("id")
            if turn_id:
                self._codex.turn_id = turn_id
        except BrokerError as exc:
            await Session._handle(self, self._codex.result(
                {"status": "failed", "error": {"message": exc.message}}))

    async def _server_request(self, method: str, rpc_id, params: dict) -> None:
        """Codex asking the client something. Each of ``APPROVALS`` is a
        permission card, answered on the existing permission route; a card
        nobody answers waits as a Claude one does, until the reaper declines
        it after ``PERMISSION_WAIT_S``. Anything else is
        refused so a turn never waits on a question nobody sees."""
        if method not in self.APPROVALS:
            print(f"[{self.agent}/{self.id[:8]}] codex asked {method}; refused",
                  file=sys.stderr, flush=True)
            await self.send_raw({"jsonrpc": "2.0", "id": rpc_id, "error": {
                "code": -32601, "message": f"{method} is not handled by this client"}})
            return
        request_id = f"codex-{rpc_id}"
        if method in ("item/commandExecution/requestApproval",
                      "execCommandApproval"):
            command = params.get("command")
            if isinstance(command, list):
                command = " ".join(str(c) for c in command)
            tool, payload = "Bash", {"command": command, "cwd": params.get("cwd")}
        elif method in ("item/fileChange/requestApproval", "applyPatchApproval"):
            tool, payload = "apply_patch", {"grantRoot": params.get("grantRoot")}
        elif method == "mcpServer/elicitation/request":
            # An MCP server asking, or Codex asking before an MCP call
            # (`_meta.codex_approval_kind`). The card shows Codex's own
            # sentence and whatever it says about the call.
            meta = params.get("_meta") if isinstance(params.get("_meta"), dict) else {}
            server = params.get("serverName")
            tool = f"mcp__{server}"
            payload = {"server": server, "message": params.get("message"),
                       "mode": params.get("mode"), "meta": meta}
            for key in ("url", "requestedSchema"):
                if params.get(key) is not None:
                    payload[key] = params[key]
        elif method == "item/tool/requestUserInput":
            tool, payload = "request_user_input", {"questions": params.get("questions")}
        else:
            tool, payload = "permissions", {"permissions": params.get("permissions"),
                                            "cwd": params.get("cwd")}
        req = {"codex_method": method, "rpc_id": rpc_id, "params": params,
               "tool_name": tool, "input": payload, "raised_at": time.time()}
        # A question for the person, in the one shape the page draws. An
        # elicitation is one only when it is a form with fields; Codex's own
        # MCP tool-call approval is an empty form and stays an approval.
        if method == "item/tool/requestUserInput":
            asked = questions_fmt.from_codex_input(params)
        elif method == "mcpServer/elicitation/request":
            asked = questions_fmt.from_elicitation(params)
        else:
            asked = None
        if asked is not None:
            req["questions"] = asked
            req["question_message"] = params.get("message")
        self.pending[request_id] = req
        self.last_activity = time.time()
        await self._raise_request(req, _request_event({
            "type": "broker.permission_request", "session_id": self.id,
            "request_id": request_id, "tool_name": tool, "display_name": None,
            "input": payload,
            "description": params.get("reason") or params.get("message"),
            "decision_reason": params.get("reason"),
            "decision_reason_type": None, "permission_suggestions": None,
            "tool_use_id": params.get("itemId"), "provider": "codex",
            "codex_method": method,
        }, req))
        self.save()

    async def answer_permission(self, request_id: str, behavior: str,
                                message: str | None = None,
                                updated_input: dict | None = None,
                                answers: dict | None = None,
                                updated_permissions: list | None = None,
                                resolved_as: str | None = None) -> None:
        # `updated_permissions` is the CLI's shape and Codex offers no
        # suggestions to echo, so it is not passed on and no scope is
        # claimed; `resolved_as` names an answer nobody gave, as for Claude.
        req = self.pending.get(request_id)
        if req is None:
            raise BrokerError(404, f"no permission request {request_id} is pending")
        allow = behavior == "allow"
        method = req["codex_method"]
        asked = _questions_of(req)
        checked = None
        if asked is not None:
            # A question: the page's answers, checked and put back in the
            # vendor's shape before the request leaves `pending`, so a 400
            # leaves the card answerable. requestUserInput has no way to
            # decline in its schema, so a deny is no answers.
            try:
                if allow:
                    checked = questions_fmt.check(asked, answers)
                if method == "item/tool/requestUserInput":
                    result = questions_fmt.to_codex_input(checked or {})
                elif allow:
                    result = questions_fmt.to_elicitation(req["params"], checked)
                else:
                    result = {"action": "decline"}
            except questions_fmt.AnswerError as exc:
                raise BrokerError(400, str(exc)) from None
        elif method == "item/permissions/requestApproval":
            # Allowing grants what was asked for, for this turn; denying
            # grants nothing. Codex's own scopes beyond `turn` are not offered
            # because the card has no control for them.
            result = {"permissions": (req["params"].get("permissions") or {})
                      if allow else {}, "scope": "turn"}
        elif method == "mcpServer/elicitation/request":
            # A form's fields come back as the card's edited input, if the
            # page sent one; an approval has none to fill.
            result = ({"action": "accept",
                       "content": updated_input if isinstance(updated_input, dict)
                       else {}} if allow else {"action": "decline"})
        elif method == "item/tool/requestUserInput":
            # The answers are the page's to give, in Codex's shape
            # (`{question_id: {"answers": [...]}}`); a deny answers nothing.
            answers = (updated_input or {}).get("answers") if allow else None
            result = {"answers": answers if isinstance(answers, dict) else {}}
        elif method in ("execCommandApproval", "applyPatchApproval"):
            result = {"decision": "approved" if allow else "denied"}
        else:
            result = {"decision": "accept" if allow else "decline"}
        self.pending.pop(request_id, None)
        await self.send_raw({"jsonrpc": "2.0", "id": req["rpc_id"],
                             "result": result})
        self.last_activity = time.time()
        await self.emit(_resolved_event(self.id, request_id,
                                        resolved_as or behavior, req,
                                        message, checked))
        self.save()

    # -- turns -------------------------------------------------------------

    async def send_message(self, text: str,
                           attachments: list[dict] | None = None) -> int:
        """``turn/start`` with the person's words, after the same
        ``broker.user_message`` a Claude turn logs. Attachments are named by
        path in the text, as for Claude; an image small enough is also given
        as ``localImage``, which is Codex's way of showing one.

        A ``turn/start`` Codex refuses -- no login, a model it does not
        know -- closes the turn as a failed ``result`` carrying Codex's
        sentence, so the page shows the refusal where the answer would be."""
        if self.proc is None or self.state != "running":
            raise BrokerError(409, f"session {self.id} is not running")
        attachments = attachments or []
        event = {"type": "broker.user_message", "session_id": self.id,
                 "text": text}
        if attachments:
            event["attachments"] = attachments
        await self.emit(event)
        lines = [self._timed(text)] if text or self.tell_time else []
        images = []
        if attachments:
            lines.append("Attached to this message (files on disk):")
            for item in attachments:
                lines.append(f"- {item['path']} ({item['type']}, "
                             f"{human_size(item['size'])})")
                if (item["type"] in cfg.INLINE_IMAGE_TYPES
                        and item["size"] <= cfg.INLINE_IMAGE_MAX_BYTES):
                    images.append({"type": "localImage", "path": item["path"]})
        params = {"threadId": self.thread_id,
                  "input": [{"type": "text", "text": "\n".join(lines)}] + images}
        if self.model:
            params["model"] = self.model
            self._codex.model = self.model
        if self.effort:
            params["effort"] = self.effort
        self.last_activity = time.time()
        self._turn_active = True
        if self.title is None:
            self.title = first_words(
                text or (f"Attached {attachments[0]['name']}"
                         if attachments else ""))
        self.save()
        try:
            started = await self.request("turn/start", params)
            turn_id = (started.get("turn") or {}).get("id")
            if turn_id:
                self._codex.turn_id = turn_id
        except BrokerError as exc:
            await Session._handle(self, self._codex.result(
                {"status": "failed", "error": {"message": exc.message}}))
        return event["seq"]

    async def steer(self, text: str,
                    attachments: list[dict] | None = None) -> int | None:
        """``turn/steer`` into the root's open turn (2026-11-14, Codex
        0.169.0), guarded by ``expectedTurnId``: Codex refuses it when that
        turn is no longer the active one, so a steer racing the turn's end
        is refused, never lost, and the caller starts a turn of its own.
        Accepted, Codex takes the words as a user message at the turn's
        next sampling boundary -- after a running command's result, which
        is kept -- and answers in the same turn (probed mid-command and
        after the last agent message: both answered, one
        ``turn/completed``). The ``broker.user_message`` (``steered:
        true``) is logged once Codex has accepted, because a message it
        refused must not be in the log as one it heard. None when refused
        or when no turn is open."""
        turn_id = self._codex.turn_id
        if (not self._turn_active or not turn_id or not self.thread_id
                or self.proc is None or self.state != "running"):
            return None
        attachments = attachments or []
        lines = [self._timed(text)] if text or self.tell_time else []
        images = []
        if attachments:
            lines.append("Attached to this message (files on disk):")
            for item in attachments:
                lines.append(f"- {item['path']} ({item['type']}, "
                             f"{human_size(item['size'])})")
                if (item["type"] in cfg.INLINE_IMAGE_TYPES
                        and item["size"] <= cfg.INLINE_IMAGE_MAX_BYTES):
                    images.append({"type": "localImage", "path": item["path"]})
        try:
            await self.request("turn/steer", {
                "threadId": self.thread_id, "expectedTurnId": turn_id,
                "input": [{"type": "text", "text": "\n".join(lines)}] + images})
        except BrokerError as exc:
            print(f"codex: {self.id[:8]}: turn/steer refused on turn "
                  f"{turn_id[:8]} ({exc.message}); a turn of its own follows",
                  file=sys.stderr, flush=True)
            return None
        event = {"type": "broker.user_message", "session_id": self.id,
                 "text": text, "steered": True, "turn_id": turn_id}
        if attachments:
            event["attachments"] = attachments
        await self.emit(event)
        self.last_activity = time.time()
        return event["seq"]

    async def set_choices(self, changes: dict) -> list[str]:
        """On the record only: ``turn/start`` carries the model and the
        effort, so the next message is the next turn on them, process or no
        process. Nothing is sent now."""
        for field in ("model", "effort"):
            if field in changes:
                setattr(self, field, changes[field])
        self.save()
        return []

    async def stop(self) -> None:
        """``turn/interrupt`` for a turn in flight, then the process ends.
        DELETE on the session is the one stop route there is; interrupting
        first lets Codex close the turn and write its rollout rather than
        lose it to a signal."""
        if (self.state == "running" and self._turn_active
                and self.thread_id and self._codex.turn_id):
            try:
                await self.request("turn/interrupt", {
                    "threadId": self.thread_id, "turnId": self._codex.turn_id})
                deadline = time.monotonic() + 5
                while self._turn_active and time.monotonic() < deadline:
                    await asyncio.sleep(0.1)
            except BrokerError as exc:
                print(f"[{self.agent}/{self.id[:8]}] interrupt: {exc.message}",
                      file=sys.stderr, flush=True)
        # `Session.stop`, by process group: see `loam_codex.kill_group`.
        self._stop_requested = True
        if self.proc is not None and self.proc.returncode is None:
            codex.kill_group(self.proc.pid, signal.SIGTERM)
            try:
                async with asyncio.timeout(10):   # not wait_for: gh-86296
                    await self.proc.wait()
            except TimeoutError:
                codex.kill_group(self.proc.pid)
        await self.close_pending("ended")
        self.state = "exited"
        self._clear_background()
        self._root_calls.clear()
        self._wakes.clear()
        self.save()

    async def _reap(self) -> None:
        for future in self._waiters.values():
            if not future.done():
                future.set_result({"error": {"message": "codex exited"}})
        await super()._reap()

    async def _title(self) -> None:
        # The vault's title comes from the transcript writer, which is a
        # Claude Code hook and does not run here; the stand-in stays.
        self._titling = False


class AntigravitySession(Session):
    """A persona session on Antigravity (2026-11-09): one ``agy -p``
    process per turn in stream-json, translated by
    ``loam_antigravity.Translator`` onto the Claude CLI's event shapes. The
    conversation is Antigravity's own, named by the ``conversation_id`` the
    first turn states and kept as ``thread_id``; every later turn passes
    ``--conversation`` with it.

    Between turns nothing runs, so the session is resident (``is_live``)
    only while a turn is: an open Antigravity chat holds no memory and no
    slot under the cap. The persona's instructions are rendered into
    ``.agents/rules/`` at every start; its MCP servers and skills are the
    ``.agents/`` that ``bin/provision --antigravity`` writes.

    Approvals: none. Antigravity's headless mode has no channel to ask a
    person on, so the turn runs ``--dangerously-skip-permissions``, which is
    the authority move's posture on the other two providers."""

    def __init__(self, *args, **kwargs) -> None:
        super().__init__(*args, **kwargs)
        self.provider = "antigravity"
        self._agy = agy.Translator(self.id)

    def is_live(self) -> bool:
        return (self.state == "running" and self.proc is not None
                and self.proc.returncode is None)

    async def start(self, resume: bool = False) -> None:
        if not (self.workspace / "agent.json").is_file():
            raise BrokerError(404, f"no agent named {self.agent!r}")
        if not (self.workspace / agy.MCP_FILE).is_file():
            raise BrokerError(409, f"{self.agent} has no {agy.MCP_FILE}; "
                                   f"run bin/provision --antigravity {self.agent}")
        login = await asyncio.to_thread(agy.login_state)
        if not login["connected"]:
            raise BrokerError(409, f"Antigravity is not connected: "
                                   f"{login['reason']}")
        await asyncio.to_thread(agy.write_instructions, self.workspace)
        await asyncio.to_thread(loam_skills.quiet_refresh, self.workspace)
        self.resumed = resume
        self._restored_status = None
        self._stop_requested = False
        self._turn_active = False
        self._clear_background()
        self.last_activity = time.time()
        self._process_cost = None
        self.state = "running"
        self.save()

    # One `agy -p` process per turn: nothing reads its stdin once the turn
    # is under way, so a message for a member on Antigravity waits for the
    # turn to end and has a turn of its own (2026-11-14).
    STEERS = False

    async def steer(self, text: str,
                    attachments: list[dict] | None = None) -> int | None:
        return None

    async def send_message(self, text: str,
                           attachments: list[dict] | None = None) -> int:
        if self.state != "running":
            raise BrokerError(409, f"session {self.id} is not running")
        if self.proc is not None and self.proc.returncode is None:
            raise BrokerError(409, f"session {self.id} has a turn in flight")
        attachments = attachments or []
        event = {"type": "broker.user_message", "session_id": self.id,
                 "text": text}
        if attachments:
            event["attachments"] = attachments
        await self.emit(event)
        lines = [self._timed(text)] if text or self.tell_time else []
        if attachments:
            lines.append("Attached to this message (files on disk):")
            for item in attachments:
                lines.append(f"- {item['path']} ({item['type']}, "
                             f"{human_size(item['size'])})")
        prompt = agy.prompt_arg(self.id, "\n".join(lines))
        self.last_activity = time.time()
        self._turn_active = True
        if self.title is None:
            self.title = first_words(
                text or (f"Attached {attachments[0]['name']}"
                         if attachments else ""))
        self.save()
        env = agy.env()
        env["CLAUDE_PROJECT_DIR"] = str(self.workspace)
        env.pop("LOAM_WAKE", None)
        env[loam_waiters.SESSION_ENV] = self.id
        env[loam_transcript.SURFACE_ENV_VAR] = loam_transcript.SURFACE_LOAM_UI
        self._agy = agy.Translator(self.id)
        self._agy.model = self.model
        try:
            self.proc = await asyncio.create_subprocess_exec(
                *first_to_go(agy.argv(prompt, self.thread_id, self.model,
                                      self.effort)),
                cwd=str(self.workspace), stdin=asyncio.subprocess.DEVNULL,
                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE,
                env=env, start_new_session=True, limit=16 * 1024 * 1024)
        except OSError as exc:
            await Session._handle(self, self._agy.result(
                {"status": "ERROR", "error": f"agy did not start: {exc}"}))
            return event["seq"]
        asyncio.create_task(self._pump_stdout())
        asyncio.create_task(self._pump_stderr())
        return event["seq"]

    async def _handle(self, obj: dict) -> None:
        if obj.get("type") == "broker.exit":   # an unparsable line, as is
            await Session._handle(self, obj)
            return
        for event in self._agy.feed(obj):
            if event.get("type") == "result" and self._agy.conversation_id \
                    and self.thread_id != self._agy.conversation_id:
                self.thread_id = self._agy.conversation_id
            await Session._handle(self, event)

    async def _reap(self) -> None:
        """A turn's process ended. The session does not: the next message
        is the next process. A process that ended with no ``result`` closes
        the turn as a failed one."""
        assert self.proc is not None
        code = await self.proc.wait()
        if not self._agy.done:
            await Session._handle(self, self._agy.result(
                {"status": "INTERRUPTED" if self._stop_requested else "ERROR",
                 "error": f"agy exited {code} before its result"}))
        self._turn_active = False
        self.save()

    async def stop(self) -> None:
        self._stop_requested = True
        if self.proc is not None and self.proc.returncode is None:
            codex.kill_group(self.proc.pid, signal.SIGTERM)
            try:
                async with asyncio.timeout(10):   # not wait_for: gh-86296
                    await self.proc.wait()
            except TimeoutError:
                codex.kill_group(self.proc.pid)
        await self.close_pending("ended")
        self.state = "exited"
        self._clear_background()
        self.save()
        await self.emit({"type": "broker.exit", "session_id": self.id,
                         "exit_code": None, "ts": now_iso()})
        for queue in list(self.subscribers):
            queue.put_nowait(None)

    async def set_choices(self, changes: dict) -> list[str]:
        for field in ("model", "effort"):
            if field in changes:
                setattr(self, field, changes[field])
        self.save()
        return []

    async def _title(self) -> None:
        self._titling = False


def session_class(provider: str | None) -> type[Session]:
    if provider == "antigravity":
        return AntigravitySession
    return CodexSession if provider == "codex" else Session


class Broker:
    def __init__(self) -> None:
        self.sessions: dict[str, Session] = {}
        # Starts that have been admitted and whose process is not up yet:
        # each counts SESSION_START_MB against the memory it was admitted to,
        # and one against the backstop, so two starts that arrive together
        # cannot both take the last room (2026-11-09).
        self._starting: set[str] = set()
        self.token = cfg.read_token()
        # Each provider's usage reader and when to read it (2026-10-14).
        self.usage = usage_store.Refresh(
            [cfg.usage_reader(), codex.reader(), agy.reader()],
            live=self.live_providers,
            jobs=lambda: usage_store.running_jobs(self.job_roots()))
        # Everyone watching the live list. Sessions come and go; a subscriber
        # here is watching the whole box, so it is held by the broker and not
        # by any one session.
        self.record_subscribers: set[asyncio.Queue] = set()
        # When a scan for app sessions last ran, so that a read of the list can
        # trigger one without paying for it on every read. Set by the scan
        # itself, which is also what makes the start-up scan count.
        self._scanned = 0.0
        # Making the Claude Code login again, which is one flow at a time for
        # the whole box: see LoginFlow. Idle until somebody asks, and it holds
        # no process while it is.
        self.login = LoginFlow()
        # And Codex's, which is a device code rather than a pasted one.
        self.codex_login = CodexLoginFlow()
        self.antigravity_login = AntigravityLoginFlow()
        # Every wired provider's sign-in, by id: the routes are one set.
        self.login_flows = {"claude-code": self.login,
                            "codex": self.codex_login,
                            "antigravity": self.antigravity_login}
        # The resident count this broker has last told the live list about,
        # so that `broker.residency` is sent when the number moves and not on
        # every record write -- a title, a pin and a seen mark are all saves
        # and none of them is a session arriving in or leaving RAM. Zero is
        # the truth at start: a broker with no processes.
        self._announced_live = 0
        # Set by the first SIGTERM or SIGINT (2026-11-10): from then on no
        # session starts, and a thread turn queued behind says so.
        self.stopping = False
        cfg.SESSION_DIR.mkdir(parents=True, exist_ok=True)

    def job_roots(self) -> list[Path]:
        """Every project's jobs directory, read from disk each time."""
        return [p.jobs for p in eng.projects().values()]

    def live_providers(self) -> set[str]:
        return {s.provider for s in self.live()}

    async def refresh_usage(self) -> None:
        """The usage loop's clock (``loam_provider_usage.Refresh.tick``):
        a look every ``POLL_S``, the reads it decides on off the loop."""
        while True:
            await asyncio.sleep(usage_store.POLL_S)
            try:
                read = await asyncio.to_thread(self.usage.tick,
                                               self.live_providers())
                if read:
                    print(f"usage: read {', '.join(read)}", file=sys.stderr,
                          flush=True)
            except Exception as exc:  # noqa: BLE001 - the loop outlives a bad pass
                print(f"usage: the pass failed ({exc!r})", file=sys.stderr,
                      flush=True)

    def live(self) -> list[Session]:
        """The sessions with a process behind them right now -- the resident
        set, which is what `MAX_SESSIONS` is a cap on.

        Asked of each session's own process (`Session.is_live`) rather than of
        its `state` field, so the count here and the `live` on each record are
        one answer to one question and cannot disagree for a single write.
        """
        return [s for s in self.sessions.values() if s.is_live()]

    def residency(self) -> dict:
        """How many sessions are in RAM right now and how many may be.

        Two fields, so a page can draw "2 live" without counting rows --
        which it could not do correctly anyway: `?agent=` narrows the rows and
        the count is the whole box's. Since 2026-11-09 `cap` is only the
        sanity backstop (`cfg.MAX_SESSIONS`, 30 on 8 GB, 123 on 32 GB):
        admission is by memory (`Broker.room`), so a page should not draw
        "of 30" as a limit anybody meets. `cap` is answered rather than configured
        into the app for the same reason: one number on this box, read from
        `lib/loam_broker.py`, and no copy anywhere that could disagree.
        """
        return {"live_count": len(self.live()), "cap": cfg.MAX_SESSIONS}

    def residency_event(self) -> dict:
        """The same two fields as a stream item, for the live list."""
        return {"type": "broker.residency", **self.residency()}

    def announce_residency(self) -> None:
        """Tell the live list the count moved, if it did.

        Hung off `record_changed` -- which is hung off `Session.save()` --
        because every arrival and departure is a record being written: a
        process starting, `_reap` when one exits, and `stop()` when one is
        ended or reaped for idleness. A residency change that saved nothing
        would be a screen that never heard, so the coupling is the guarantee
        and not a convenience.
        """
        count = len(self.live())
        if count == self._announced_live:
            return
        self._announced_live = count
        event = self.residency_event()
        for queue in list(self.record_subscribers):
            queue.put_nowait(event)

    def adopt(self, session: Session) -> Session:
        """Wire a session's record writes to the live list."""
        session.on_record_change = self.record_changed
        return session

    def close_record_streams(self) -> None:
        """End every live-list stream: the broker is stopping.

        A ``None`` after whatever is already queued, so a client is sent the
        records the stop itself wrote -- each chat ending -- and then the
        stream returns. Called by ``amain`` after the sessions stop, so the
        stop does not rest on ``asyncio.run`` cancelling a handler that a
        connected client is keeping busy (the 10-14 hang)."""
        for queue in list(self.record_subscribers):
            queue.put_nowait(None)

    def record_changed(self, session: Session) -> None:
        """A record was written: hand it to everyone watching the live list.

        The same ``broker.session`` snapshot the per-session stream sends, so
        a client has one shape to read and not two. Archived records are sent
        too, deliberately: a page that filters them out still has to be told
        the moment one becomes archived, and an update it never receives is
        a row that stays on the screen.
        """
        snapshot = session.snapshot()
        for queue in list(self.record_subscribers):
            queue.put_nowait(snapshot)
        # The row's own `live` is on that snapshot; this is the box's count
        # against the cap, which no single row can be read for. Sent after
        # the record, so a client applies the row and then the total.
        self.announce_residency()

    def _settled(self) -> set[str]:
        """Ids the adoption scan must leave exactly as they are.

        Everything the broker started itself, and every adopted session that
        has somehow been written into since -- a record with a log of this
        broker's own has numbering that is load-bearing, and a rescan that
        re-counted the file under it would renumber events a client has
        already seen. Since the fork landed (2026-09-20) that is no longer
        hypothetical: the first message into an adopted session gives it a
        log of this broker's own, and from that moment the app's file is its
        history and nothing else.

        **The log, not the position field.** `record_seq` was what this asked
        until the replay landed on 2026-09-20; since then an adopted record
        carries the translated count there from the moment it is made, so
        asking `record_seq` would have settled every adopted session at its
        first scan and frozen it. The existence of a log of our own is the
        question that was always meant.

        An adopted record nobody has written into is deliberately NOT here:
        rescanning it is how a conversation the owner is still having in the
        app keeps its last message, its place on the home screen and the
        turns he has taken since.
        """
        settled = set()
        for path in sorted(cfg.SESSION_DIR.glob("*.json")):
            try:
                meta = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                settled.add(path.stem)      # unreadable: touch nothing
                continue
            session_id = meta.get("session_id") or path.stem
            log = cfg.SESSION_DIR / f"{session_id}.jsonl"
            if meta.get("origin") != adoption.ORIGIN_APP:
                settled.add(session_id)
            elif log.exists() and log.stat().st_size:
                settled.add(session_id)
        return settled

    def _forks_and_heads(self) -> tuple[set[str], dict[str, str]]:
        """The two things a scan needs so it does not adopt a fork of its own.

        Added 2026-09-22, after the home screen drew one conversation twice.
        A reply into an adopted session forks it, the CLI writes the fork into
        a session file of its own in the same folder, and that file has a
        person in it and today's date on it -- so the scan adopted it as a
        second conversation wearing the first one's title and history.

        - **the fork ids**: every record's ``cli_session_id``. Free, read out
          of records the scan is opening anyway.
        - **the heads**: the first uuid of the file behind each record with a
          source (``loam_adopt.first_uuid``), against the id of the record it
          belongs to, because a fork copies its parent's entries verbatim,
          uuids and all. This is the net under a fork whose id no record
          carries -- one the CLI minted for a turn that died before the broker
          read the id back. The id is kept beside the uuid so that a record's
          own file, which a full rescan re-reads on purpose, is not read as a
          copy of itself.

        Measured on this box 2026-09-22: 49 records, 30 of them with a source,
        **24 ms** warm and 41 ms cold, against the 240 ms of the cheapest scan
        it runs inside. The heads it built collided on exactly four pairs, and
        those four were the four duplicate records this landed to remove.
        """
        forks: set[str] = set()
        heads: dict[str, str] = {}
        for path in sorted(cfg.SESSION_DIR.glob("*.json")):
            try:
                meta = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                continue
            fork = meta.get("cli_session_id")
            if fork:
                forks.add(fork)
            session_id = meta.get("session_id") or path.stem
            source = meta.get("source")
            if source:
                head = adoption.first_uuid(Path(source))
                if head:
                    heads.setdefault(head, session_id)
        return forks, heads

    def _recorded(self) -> set[str]:
        """Every id the broker has a record of at all.

        What a scan that is only looking for conversations it has never seen
        passes as `held`: the records it already has are kept current by the
        refresh on read, one stat each, so re-reading all 27 of their files
        would be 0.69 s spent to learn what 0.36 ms of stats already said.
        """
        return {path.stem for path in cfg.SESSION_DIR.glob("*.json")}

    def _source_moved(self, meta: dict) -> bool:
        """Has the file behind this record been touched since it was read.

        The cheap question the listing asks of a record it has not loaded: one
        stat, and only for a record whose history is in somebody else's file.
        A record with a log of this broker's own, a forked one and everything
        the broker started itself answer False without a syscall.

        True for a touch as well as for growth, because the two are told apart
        by `Session.refresh_from_source` -- which is the one place that rule
        lives -- and a touch is answered there without a parse.
        """
        if meta.get("origin") != adoption.ORIGIN_APP or meta.get("cli_session_id"):
            return False
        source = meta.get("source")
        session_id = meta.get("session_id")
        if not source or not session_id:
            return False
        log = cfg.SESSION_DIR / f"{session_id}.jsonl"
        try:
            if log.stat().st_size:
                return False
        except OSError:
            pass
        size, mtime = adoption.source_stat(Path(source))
        if size is None:
            return False
        return (size, mtime) != (meta.get("source_size"),
                                 meta.get("source_mtime"))

    def scan_for_new(self) -> dict | None:
        """Look for app sessions the broker has never seen, on a read of the
        list, at most once a minute. None if it was not due.

        The owner starts a conversation on their phone and expects to find it in
        Loam UI; before this it appeared at the next broker restart, which
        could be days (2026-09-21). A read of the list is the moment to look,
        because it is the moment somebody is looking.

        **Only what is unknown**, which is what makes it affordable on a read:
        `_recorded` holds every id back, so nothing already adopted is
        re-parsed -- the refresh on read does that job now, and better, per
        record and only when its file moved. Measured on this box 2026-09-21:
        0.24 s over 576 session files, against 0.93 s for the full rescan the
        route and the restart still run.

        Fail-soft and on the loop. A scan that goes wrong is reported and the
        list is answered anyway; 0.24 s once a minute is a pause every open
        stream pays and no reader can see, and a thread would buy that back at
        the price of writing records from one.
        """
        if time.time() - self._scanned < cfg.SCAN_INTERVAL_S:
            return None
        try:
            return self.adopt_app_sessions(new_only=True)
        except Exception as exc:  # noqa: BLE001 - never the reason a list fails
            self._scanned = time.time()
            print(f"scan: the read-triggered scan failed ({exc!r})",
                  file=sys.stderr, flush=True)
            return None

    def adopt_app_sessions(self, new_only: bool = False) -> dict:
        """Every persona's Claude Code app sessions, as records of this box.

        Idempotent, which is what makes it safe both at start and on the
        route: a session already held is either settled (left alone) or
        refreshed from its file, and nothing is ever adopted twice.

        **A fork of an adopted session is never adopted**, which is the other
        half of "nothing is adopted twice" and was missing until 2026-09-22:
        the fork is a session file like any other, and the conversation in it
        is one this broker already holds. `_forks_and_heads` is the two nets.

        `new_only` narrows it to files no record exists for, which is what a
        read of the list triggers (`scan_for_new`): the records that do exist
        are kept in step by the refresh on read. Without it this is the full
        rescan -- every adopted record nobody has written into re-read from its
        file -- which is what the route and every broker start still do.

        The records are written through `Session.save()` rather than straight
        to disk, so the live list hears about them the moment they exist --
        a page open while this runs gains the rows without reloading.
        """
        self._scanned = time.time()
        settled = self._recorded() if new_only else self._settled()
        forks, heads = self._forks_and_heads()
        report: dict = {"adopted": [], "refreshed": [], "agents": {},
                        "skipped": [], "window_days": adoption.WINDOW_DAYS,
                        "new_only": new_only}
        for agent in cfg.roster():
            workspace = cfg.workspace(agent)
            found, passed = adoption.candidates(agent, workspace, settled,
                                                forks=forks, heads=heads)
            for note in passed:
                report["skipped"].append({"agent": agent, **note})
            adopted = 0
            for path in found:
                try:
                    row = self._adopt_one(agent, path)
                except OSError as exc:
                    report["skipped"].append(
                        {"agent": agent, "session_id": path.stem,
                         "why": f"unreadable ({exc})"})
                    continue
                if row is None:
                    report["skipped"].append(
                        {"agent": agent, "session_id": path.stem,
                         "why": "no thread in the file"})
                    continue
                new, record = row
                report["adopted" if new else "refreshed"].append(record)
                adopted += new
            if adopted:
                report["agents"][agent] = adopted
        return report

    def _adopt_one(self, agent: str, path: Path) -> tuple[bool, dict] | None:
        """One app session as a record. None if the file holds no thread."""
        session_id = path.stem
        # Stat'ed BEFORE the file is read, and the direction matters: if the
        # app appends during the read, the record understates the size and the
        # next read of it sees growth and reads again. Stat'ing afterwards
        # would have the record claim a size it never counted, and the turn
        # that landed in between would be invisible until the next one.
        stat = adoption.source_stat(path)
        summary = adoption.summarise(path, session_id, agent)
        if not summary["messages"]:
            return None
        new = not (cfg.SESSION_DIR / f"{session_id}.json").exists()
        session = self.adopt(Session(agent, session_id))
        session.origin = adoption.ORIGIN_APP
        session.source = str(path)
        # What the file will replay, and the number the next process numbers
        # from. Set together and from one count, because a record that
        # promised a different number than the stream delivers is a record
        # whose next turn overwrites the end of its own history.
        session.replayed = summary["events"]
        session.seq = summary["events"]
        # The reading this record is, with its two numbers on it, so that the
        # next read of the record can tell whether the conversation has moved
        # on since. See `Session.refresh_from_source`.
        session.source_size, session.source_mtime = stat
        session.created = summary["created"] or session.created
        session.last_event_at = summary["last_event_at"]
        session.last_activity = parse_iso(summary["last_event_at"],
                                          session.last_activity)
        if summary["last_message"]:
            session.last_message = summary["last_message"][
                :cfg.LAST_MESSAGE_CHARS]
        # The transcript writer's title if it filed one, else the opening
        # words -- the same stand-in every other session wears. A title
        # already on the record (a person's rename) outranks both.
        if not session.title:
            filed = adoption.transcript_title(session_id)
            session.title = filed or first_words(summary["opening"] or "") or None
            session.title_source = "vault" if filed else None
        # Done looking only if the name came from somewhere that outranks the
        # stand-in. One still wearing the opening words is looked at again the
        # next time its file is read, because the writer may file it later.
        session._titled = session.title_source in ("vault", "person")
        # No process of this broker's is behind it. It is a conversation that
        # happened, and `done` is what that is.
        session.state = "exited"
        session._restored_status = "done"
        session.save()
        return new, {"session_id": session_id, "agent": agent,
                     "title": session.title,
                     "messages": summary["messages"],
                     "created": session.created,
                     "last_event_at": session.last_event_at}

    def load(self, session_id: str) -> Session:
        """A session as an object, live if it is and off disk if it is not.

        Pin, archive and rename have to work on a session whose process ended
        weeks ago -- that is most of what is on the home screen -- so they
        cannot be routes that only a running session answers.

        **And it is where an adopted record is brought up to date** (added
        2026-09-21): every route that reaches a record comes through here, so
        one call refreshes it against the app's own file for all of them --
        `GET` on the record, the listing, and opening the thread's stream. It
        costs a stat on an adopted record and nothing at all on any other; the
        file is only re-read when it has grown. See
        `Session.refresh_from_source`.

        A session an object already exists for gets that object. Building a
        second one for a running id would be two writers of one record file.
        """
        session = self.sessions.get(session_id)
        if session is not None:
            session.refresh_from_source()
            return session
        path = cfg.SESSION_DIR / f"{session_id}.json"
        try:
            meta = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            raise BrokerError(404, f"no session {session_id}")
        # Not put into self.sessions: it has no process, it must not count
        # against the cap, and the file is the state. The Session constructor
        # reads the record back, which is what makes this an object and not a
        # dict with methods bolted on.
        session = self.adopt(session_class(meta.get("provider"))(
            meta.get("agent") or "", session_id))
        session.refresh_from_source()
        return session

    async def start_session(self, agent: str, session_id: str | None = None,
                            resume: bool = False,
                            provider: str | None = None,
                            model: str | None = None,
                            effort: str | None = None) -> Session:
        if self.stopping:
            # The 11-10 stop hung on a start begun after SIGTERM (2026-11-10).
            raise BrokerError(503, "the broker is stopping; start the session "
                                   "again once it is back")
        if agent not in cfg.roster():
            raise BrokerError(404, f"no agent named {agent!r}")
        # A record keeps the provider it was started on, and a resume that
        # names none is a resume on that one. A conversation cannot move
        # between providers: neither CLI can read the other's thread.
        stored = None
        if session_id:
            try:
                stored = json.loads((cfg.SESSION_DIR / f"{session_id}.json")
                                    .read_text(encoding="utf-8")).get("provider")
            except (OSError, json.JSONDecodeError):
                stored = None
        if provider and stored and provider != stored:
            raise BrokerError(
                409, f"session {session_id} runs on {stored}; a conversation "
                     f"cannot move to {provider}. Start a new session instead.")
        provider = provider or stored or cfg.DEFAULT_PROVIDER
        if provider not in cfg.WIRED_PROVIDERS:
            known = ", ".join(cfg.PROVIDERS)
            wired = ", ".join(cfg.WIRED_PROVIDERS)
            raise BrokerError(
                400,
                f"provider {provider!r} is not wired: {wired} are the values "
                f"this broker accepts today. The providers it knows about are "
                f"{known}, and GET /v1/providers says which are connected.")
        # Its own process, if it has one, before admission: a session that is
        # already in RAM needs no room to be used (2026-11-09; a thread member
        # whose session was live was refused at the cap the other way round).
        if session_id and session_id in self.sessions:
            existing = self.sessions[session_id]
            if existing.state == "running":
                return existing
        await self.make_room(agent)
        reserved = session_id or f"starting-{uuid.uuid4()}"
        self._starting.add(reserved)
        try:
            return await self._start(agent, session_id, resume, provider,
                                     model, effort)
        finally:
            self._starting.discard(reserved)

    def seats_taken(self) -> int:
        """Sessions in RAM and starts in flight: what the backstop counts."""
        return len(self.live()) + len(self._starting)

    def room(self) -> dict:
        """Whether one more session fits, as admission reads it: the box's
        MemAvailable and the broker cgroup's room under its MemoryMax
        (`cfg.memory`), each less `SESSION_START_MB` per start in flight,
        against the reserve; and the count against the backstop."""
        mem = cfg.memory()
        pending = len(self._starting) * cfg.SESSION_START_MB
        need = cfg.SESSION_START_MB
        available = mem.get("available")
        reserve = mem.get("reserve", cfg.MEMORY_RESERVE_MB)
        box_ok = available is None or available - pending - reserve >= need
        cg = mem.get("cgroup_room")
        cg_ok = cg is None or cg - pending >= need
        count_ok = self.seats_taken() < cfg.MAX_SESSIONS
        return {"ok": box_ok and cg_ok and count_ok,
                "reason": None if box_ok and cg_ok and count_ok
                else ("backstop" if box_ok and cg_ok else "memory"),
                "available_mb": available, "cgroup_room_mb": cg,
                "reserve_mb": reserve, "starting": len(self._starting),
                "need_mb": need}

    async def make_room(self, agent: str) -> None:
        """Admission (2026-11-09): nothing while there is room (`room`).
        Short of it, end the least recently used live session that is idle
        (`Session.busy` is None and nothing for `cfg.EVICT_GRACE_S`), thread
        or classic -- its id resumes, so ending it costs its next turn a
        respawn -- and ask again. Only when nothing idle is left is the start
        refused, in a person's sentence (`error`), with the route-level
        advice in `hint`, the box's numbers in `memory` and who holds it in
        `busy`."""
        while True:
            room = self.room()
            if room["ok"]:
                return
            now = time.time()
            idle = sorted((s for s in self.live() if s.busy() is None
                           and now - s.last_activity >= cfg.EVICT_GRACE_S),
                          key=lambda s: s.last_activity)
            if not idle:
                raise self.cap_error(agent, room)
            victim = idle[0]
            print(f"room: ending {victim.agent}/{victim.id} (idle "
                  f"{int(now - victim.last_activity)} s) for {agent}: "
                  f"{room['reason']}, {room['available_mb']} MB available, "
                  f"reserve {room['reserve_mb']}", file=sys.stderr, flush=True)
            await victim.stop()

    def cap_error(self, agent: str, room: dict | None = None) -> BrokerError:
        room = room or self.room()
        busy = [{"session_id": s.id, "agent": s.agent,
                 "status": s.busy() or "starting"} for s in self.live()]
        reason = room.get("reason") or "memory"
        return BrokerError(
            429, cap_sentence(agent, busy, reason),
            {"reason": reason, "cap": cfg.MAX_SESSIONS,
             "live_count": len(self.live()), "busy": busy,
             "memory": {k: room.get(k) for k in
                        ("available_mb", "cgroup_room_mb", "reserve_mb",
                         "need_mb", "starting")},
             "hint": (f"{len(self.live())} sessions are running and every one "
                      f"is busy, and "
                      + (f"the box has {room.get('available_mb')} MB available "
                         f"against a {room.get('reserve_mb')} MB reserve and "
                         f"{room.get('need_mb')} MB to start one"
                         if reason == "memory" else
                         f"the backstop is {cfg.MAX_SESSIONS} sessions")
                      + ". Try again when one finishes, or end one with "
                        "DELETE /v1/sessions/<id>; its id still resumes.")})

    async def _start(self, agent: str, session_id: str | None, resume: bool,
                     provider: str, model: str | None,
                     effort: str | None) -> Session:
        session = self.adopt(session_class(provider)(
            agent, session_id, provider=provider, model=model, effort=effort))
        # In the table BEFORE the process starts, and this is load-bearing
        # (caused 2026-09-25). The resident count is read off this table, and
        # `start()` writes the record -- which fans the new session's own
        # arrival out to the live list. Registered afterwards, as it was,
        # that fan-out ran while the table still said the session was not
        # there, and every count an open list was told was one behind: four
        # starts against a cap of four announced 1, 2, 3.
        #
        # A start that fails leaves the table exactly as it found it. A
        # session whose process never started is not one the broker has.
        prior = self.sessions.get(session.id)
        self.sessions[session.id] = session
        try:
            await session.start(resume=resume)
        except Exception:
            if prior is None:
                self.sessions.pop(session.id, None)
            else:
                self.sessions[session.id] = prior
            raise
        return session

    def known(self, agent: str | None = None) -> list[dict]:
        """Every session this broker has a record of, live or not, archived
        or not (the classic list's archive filter retired with it on
        2026-11-12; Running now always asked for the archive too), newest
        activity first. Read off disk so a restarted broker still lists what
        it started before it restarted -- those processes are gone, but their
        ids resume, and a client that cannot see them cannot resume them.

        **An adopted record is stat'ed here and re-read if it has grown**
        (2026-09-21). The rows the owner is still talking to in the Claude Code
        app are exactly the rows whose last message goes stale, and the home
        screen is where he reads them. Measured on this box: 27 adopted
        records, 0.36 ms of stats for the lot of them, against 0.69 s to
        re-read all 27 files -- which is why the stat decides and the parse
        happens only for the file that moved. See
        `Session.refresh_from_source`.
        """
        out: dict[str, dict] = {}
        for path in sorted(cfg.SESSION_DIR.glob("*.json")):
            try:
                meta = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                continue
            if meta.get("session_id") in self.sessions:
                meta = self.sessions[meta["session_id"]].meta()
            elif self._source_moved(meta):
                try:
                    meta = self.load(meta["session_id"]).meta()
                except BrokerError:
                    # The record went away between the glob and the read; it is
                    # not on the list, which is the truth about it.
                    continue
            else:
                if meta.get("state") == "running":
                    # This broker did not start it, so it is not running now.
                    meta["state"] = "exited"
                if "seq" in meta:
                    # A record written before 2026-09-16 calls the position
                    # `seq`; a file is only rewritten when its session is
                    # resumed, so the listing answers under one name rather
                    # than handing a client two spellings of one field and
                    # a None for the sessions it has not touched since.
                    meta["record_seq"] = meta.pop("seq")
                meta = normalise(meta)
            out[meta["session_id"]] = meta
        records = list(out.values())
        if agent:
            records = [r for r in records if r.get("agent") == agent]
        records.sort(key=lambda r: r.get("last_activity", ""), reverse=True)
        return records

    async def reap_idle(self) -> None:
        while True:
            await asyncio.sleep(60)
            await self.reap_once(time.time())

    async def reap_once(self, now: float) -> None:
        """One pass of the reaper. **A session that is asking is not idle**
        (2026-10-05): one with a request pending is never ended here, however
        old its `last_activity`; a request that has waited
        `PERMISSION_WAIT_S` is denied instead, and the idle clock runs again
        from that answer. Until then a raised card was the last sign of life
        the reaper saw, and it ended the chat an hour later.

        One session's failure is printed and the pass goes on: an exception
        out of here would end the reaper task for the life of the broker."""
        for session in self.live():
            try:
                if session.pending:
                    for request_id in await session.expire_permissions(now):
                        print(f"idle: expired {request_id} in "
                              f"{session.agent}/{session.id}",
                              file=sys.stderr, flush=True)
                    continue
                idle = now - session.last_activity
                # Idle and not busy past its time -- `THREAD_IDLE_S` for a
                # thread member's, `CLASSIC_IDLE_S` for a chat -- a session
                # leaves memory, and its id resumes at the next message.
                # A busy one -- mid-turn, waiting on work it launched -- is
                # never ended here, however long since its last event: the
                # hour backstop that ended every session went 2026-11-10
                # ("a turn has no clock").
                short = session.idle_timeout_s or cfg.CLASSIC_IDLE_S
                if idle > short and session.busy() is None:
                    print(f"idle: ending {session.agent}/{session.id}",
                          file=sys.stderr, flush=True)
                    await session.stop()
            except Exception as exc:  # noqa: BLE001 - the next pass retries
                print(f"idle: {session.agent}/{session.id}: {exc!r}",
                      file=sys.stderr, flush=True)
        try:
            await self.relieve(now)
        except Exception as exc:  # noqa: BLE001 - the next pass retries
            print(f"pressure: {exc!r}", file=sys.stderr, flush=True)

    async def relieve(self, now: float) -> Session | None:
        """Under pressure, one idle session leaves memory per pass
        (2026-11-09): when the box's MemAvailable is below the reserve,
        sessions growing has eaten what the system was kept, and the least
        recently used idle one is ended before the kernel has to choose."""
        mem = cfg.memory()
        available = mem.get("available")
        if available is None or available >= mem.get("reserve", cfg.MEMORY_RESERVE_MB):
            return None
        idle = sorted((s for s in self.live() if s.busy() is None
                       and now - s.last_activity >= cfg.EVICT_GRACE_S),
                      key=lambda s: s.last_activity)
        if not idle:
            return None
        print(f"pressure: ending {idle[0].agent}/{idle[0].id}, {available} MB "
              f"available against a {mem.get('reserve')} MB reserve",
              file=sys.stderr, flush=True)
        await idle[0].stop()
        return idle[0]


# -- making the login again ------------------------------------------------
#
# The one thing on this box a person cannot do from the app and cannot do
# without: when the refresh token in ``~/.claude/.credentials.json`` expires,
# every session this broker starts stops working, and the only cure is a
# human signing in again. This is that, as three routes.
#
# **What the CLI actually does, measured on this box 2026-09-22** (2.1.270,
# pinned 09-16), because the route is built around what it does and not
# around what it might:
#
#   * With stdin at /dev/null and stdout a pipe, ``claude auth login
#     --claudeai`` prints NOTHING and hangs until it is killed. There is no
#     headless flag and no device-code branch. A route that shelled out to it
#     the ordinary way would hang forever with nothing to show.
#   * Under a pty it prints, in order: ``Opening browser to sign in…``, then
#     ``If the browser didn't open, visit: <url>`` with the URL written twice
#     (an OSC-8 hyperlink target and visible coloured text), then ``Paste code
#     here if prompted >`` -- and blocks on a person.
#   * A code pasted back that is wrong answers ``Login failed: Request failed
#     with status code 400`` and the process exits.
#   * **Starting the flow does not disturb the login already on the box.**
#     Proved with a decoy credentials file under CLAUDE_CONFIG_DIR: started,
#     given a bad code, failed -- and the file was byte-identical afterwards.
#     So this route is safe to call on a login that still works, which is the
#     only way anybody would ever call it.
#
# So: a pty, one flow at a time, and the URL parsed out of what was drawn.
# No token, and no piece of one, is ever answered; the page gets a URL, a
# state and a sentence.


def _make_controlling_tty() -> None:
    """In the child, after setsid: make the pty on fd 0 this session's
    controlling terminal. ``start_new_session`` alone gives the child a pty on
    its file descriptors but no controlling terminal, and the CLI's prompt is
    drawn by a reader that wants one."""
    fcntl.ioctl(0, termios.TIOCSCTTY, 0)


class LoginFlow:
    """One ``claude auth login`` on a pty, and the three things a page can do
    to it: start it, ask how it is going, hand it the code.

    States: ``idle`` (nothing running), ``pending`` (the URL is out and the
    CLI is blocked on a person), ``done``, ``failed``. Only one flow exists at
    a time -- each start mints its own PKCE verifier, so a second flow would
    quietly invalidate the code the person is at that moment pasting.
    """

    def __init__(self) -> None:
        self.state = "idle"
        self.url: str | None = None
        self.message: str | None = None
        self.started_at: str | None = None
        self.finished_at: str | None = None
        self.expires_at: str | None = None
        self.proc = None
        self._master: int | None = None
        self._buf = b""
        self._secret: str | None = None
        self._was = cfg.login_state()
        self._tasks: list[asyncio.Task] = []

    # -- what a route answers ---------------------------------------------

    def snapshot(self) -> dict:
        """The whole of what leaves this box about a flow. The instruction is
        written here rather than in the app so that one sentence describes
        what the CLI on this box actually asks for; an app that wrote its own
        would be guessing at another version's flow."""
        out = {"provider": "claude-code", "kind": "paste-code",
               "state": self.state, "url": self.url, "code": None,
               "accepts_code": self.state == "pending",
               "instructions": None, "message": self.message,
               "started_at": self.started_at, "finished_at": self.finished_at,
               "expires_at": self.expires_at,
               "login": cfg.login_state()}
        if self.state == "pending":
            out["instructions"] = (
                "Open the URL, sign in, and copy the code the page gives you. "
                "Paste it back with POST /v1/providers/claude-code/login/code "
                f"as {{\"code\": \"…\"}} within "
                f"{cfg.LOGIN_FLOW_TIMEOUT_S // 60} minutes.")
        return out

    # -- the flow ----------------------------------------------------------

    async def start(self) -> dict:
        """Start one, or answer the one already running.

        Idempotent on purpose: a phone that loses its connection mid-flow and
        posts again must get back the URL it was already given, not a second
        flow that has invalidated the first.
        """
        if self.state == "pending" and self.proc is not None \
                and self.proc.returncode is None:
            return self.snapshot()
        await self._kill()       # a finished flow's watcher and its pty
        self._reset()
        master, slave = pty.openpty()
        env = dict(os.environ)
        # The CLI draws this prompt with a terminal library; a terminal it has
        # never heard of gets a plainer drawing, not a failure, but this is
        # the one the flow above was measured on.
        env.setdefault("TERM", "xterm-256color")
        env["DISABLE_AUTOUPDATER"] = "1"
        try:
            self.proc = await asyncio.create_subprocess_exec(
                cfg.CLAUDE, *cfg.LOGIN_ARGV,
                stdin=slave, stdout=slave, stderr=slave,
                cwd=str(cfg.AGENTS_ROOT), env=env,
                start_new_session=True, preexec_fn=_make_controlling_tty)
        except OSError as exc:
            os.close(master)
            os.close(slave)
            self.state = "failed"
            self.message = f"the CLI could not be started ({exc})"
            self.finished_at = cfg.now_iso()
            return self.snapshot()
        os.close(slave)          # the child holds the only copy that matters
        os.set_blocking(master, False)
        self._master = master
        # What the login was before this flow touched anything, which is how
        # a finished flow is judged. See _settle.
        self._was = cfg.login_state()
        self.started_at = cfg.now_iso()
        loop = asyncio.get_running_loop()
        loop.add_reader(master, self._drain)
        self._tasks = [asyncio.create_task(self._watch()),
                       asyncio.create_task(self._expire())]
        # Wait for the URL, which is the only part of this a route can
        # usefully report. It arrived in well under a second every time it was
        # measured; the timeout is for the box, not for the person.
        deadline = time.monotonic() + cfg.LOGIN_URL_TIMEOUT_S
        while time.monotonic() < deadline:
            if self.url is None:
                self.url = cfg.login_url(self._buf)
            if self.url is not None:
                self.state = "pending"
                self.expires_at = cfg.epoch_iso(
                    time.time() + cfg.LOGIN_FLOW_TIMEOUT_S)
                return self.snapshot()
            if self.proc.returncode is not None:
                break
            await asyncio.sleep(0.1)
        await self._kill()
        self.state = "failed"
        self.message = (cfg.login_message(self._buf)
                        or f"the CLI printed no sign-in URL in "
                           f"{cfg.LOGIN_URL_TIMEOUT_S}s")
        self.finished_at = cfg.now_iso()
        return self.snapshot()

    async def submit(self, code: str) -> dict:
        """Hand the CLI the code the person copied out of the browser, and
        wait for it to say what happened."""
        if self.state != "pending" or self._master is None \
                or self.proc is None or self.proc.returncode is not None:
            raise BrokerError(
                409, "no login is waiting for a code; start one with POST "
                     "/v1/providers/claude-code/login")
        self._secret = code
        try:
            os.write(self._master, (code + "\r").encode())
        except OSError as exc:
            raise BrokerError(502, f"the CLI would not take the code ({exc})")
        deadline = time.monotonic() + cfg.LOGIN_SUBMIT_TIMEOUT_S
        while time.monotonic() < deadline:
            if self.state != "pending":
                return self.snapshot()
            await asyncio.sleep(0.2)
        # Still thinking. Left running rather than killed: the exchange may
        # yet land, and GET says so when it does.
        return self.snapshot()

    async def cancel(self) -> dict:
        """End a flow nobody is going to finish. The login on the box is
        untouched -- it was never written to."""
        await self._kill()
        self._reset()
        return self.snapshot()

    # -- the machinery -----------------------------------------------------

    def _reset(self) -> None:
        self.state = "idle"
        self.url = self.message = None
        self.started_at = self.finished_at = self.expires_at = None
        self._buf = b""
        self._secret = None
        self.proc = None

    def _drain(self) -> None:
        """Everything the CLI has drawn, kept in one buffer. Bounded: a
        terminal that starts repainting itself must not grow a process that
        lives for fifteen minutes."""
        if self._master is None:
            return
        try:
            chunk = os.read(self._master, 65536)
        except (BlockingIOError, InterruptedError):
            return
        except OSError:
            chunk = b""
        if not chunk:
            self._stop_reading()
            return
        self._buf = (self._buf + chunk)[-65536:]
        if self.url is None:
            self.url = cfg.login_url(self._buf)

    def _stop_reading(self) -> None:
        if self._master is None:
            return
        try:
            asyncio.get_running_loop().remove_reader(self._master)
        except (RuntimeError, ValueError):
            pass
        try:
            os.close(self._master)
        except OSError:
            pass
        self._master = None

    async def _watch(self) -> None:
        """The CLI exiting is the only thing that settles a flow."""
        proc = self.proc
        code = await proc.wait()
        if proc is not self.proc:
            return                      # cancelled, and this is the old one
        await asyncio.sleep(0.2)        # let the last line reach the buffer
        self._drain()
        self._settle(code)

    def _settle(self, code: int) -> None:
        self._stop_reading()
        if self.state in ("done", "failed"):
            return
        message = cfg.login_message(self._buf, self._secret)
        login = cfg.login_state()
        # Judged on the credential, not on what a terminal printed: the
        # credential is what every session will authenticate with.
        #
        # "The file changed since the flow started" is NOT the test, and that
        # was a real false positive: the CLI rewrites that file every time it
        # refreshes an access token, so any session taking a turn during the
        # flow would have made a failed login look like a finished one. What a
        # renewal actually does is mint a new refresh token with a new expiry,
        # so the expiry MOVING is the evidence -- or, when there was no
        # working login to begin with, there simply being one now.
        renewed = (code == 0 and login["connected"]
                   and (login["expires_at"] != self._was["expires_at"]
                        or not self._was["connected"]))
        if renewed:
            self.state = "done"
            self.message = None
        else:
            self.state = "failed"
            self.message = message or "the CLI exited without a new login"
        self._secret = None
        self.finished_at = cfg.now_iso()

    async def _expire(self) -> None:
        await asyncio.sleep(cfg.LOGIN_FLOW_TIMEOUT_S)
        if self.state != "pending":
            return
        await self._kill()
        self.state = "failed"
        self.message = (f"nobody finished the login in "
                        f"{cfg.LOGIN_FLOW_TIMEOUT_S // 60} minutes; start "
                        f"another one")
        self.finished_at = cfg.now_iso()

    async def _kill(self) -> None:
        proc, self.proc = self.proc, None
        # Not the task this runs in: `_expire` is one of `_tasks` and calls
        # this, and a flow cancelling itself is why the wait below once caught
        # `CancelledError` -- which swallowed the broker's own stop as well
        # (2026-10-14). Skipped, a cancel here is only ever a real one.
        here = asyncio.current_task()
        for task in self._tasks:
            if task is not here:
                task.cancel()
        self._tasks = []
        self._stop_reading()
        if proc is None or proc.returncode is not None:
            return
        try:
            proc.kill()
        except ProcessLookupError:
            return
        try:
            async with asyncio.timeout(5):
                await proc.wait()
        except TimeoutError:
            pass


class CodexLoginFlow:
    """One ``codex login --device-auth``, and what a page can do to it:
    start it, read it, cancel it (2026-10-01).

    **What the CLI does, measured on this box** (0.159.3, 2026-10-01): with
    stdin at /dev/null and stdout a pipe -- no pty, unlike ``claude auth
    login`` -- it prints a banner, then "Open this link in your browser and
    sign in to your account" with ``https://auth.openai.com/codex/device``,
    then "Enter this one-time code (expires in 15 minutes)" with the code,
    then a warning to continue only if you started this login, and polls
    until the code is entered or expires. Nothing is pasted back here: the
    person enters the code on OpenAI's page, and the CLI writes
    ``auth.json`` under ``CODEX_HOME`` and exits 0. So there is no code
    route; reading the flow is reading its state.

    States as ``LoginFlow``'s: ``idle``, ``pending`` (URL and code are out),
    ``done``, ``failed``. One flow at a time; a second start answers the
    first, because a second code would leave the first one entered for
    nothing.
    """

    def __init__(self) -> None:
        self.state = "idle"
        self.url: str | None = None
        self.code: str | None = None
        self.message: str | None = None
        self.started_at: str | None = None
        self.finished_at: str | None = None
        self.expires_at: str | None = None
        self.proc = None
        self._buf = ""
        self._tasks: list[asyncio.Task] = []

    def snapshot(self) -> dict:
        out = {"provider": "codex", "kind": "device-code",
               "state": self.state, "url": self.url, "code": self.code,
               "accepts_code": False,
               "instructions": None, "message": self.message,
               "started_at": self.started_at, "finished_at": self.finished_at,
               "expires_at": self.expires_at,
               "login": codex.login_state()}
        if self.state == "pending":
            out["instructions"] = (
                "Open the URL, sign in to ChatGPT, and enter the one-time "
                "code. This page notices the login by itself: GET this route "
                "again for the state.")
        return out

    async def start(self) -> dict:
        if self.state == "pending" and self.proc is not None \
                and self.proc.returncode is None:
            return self.snapshot()
        await self._kill()
        self._reset()
        try:
            self.proc = await asyncio.create_subprocess_exec(
                codex.CODEX, *codex.LOGIN_ARGV,
                stdin=asyncio.subprocess.DEVNULL,
                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.STDOUT,
                cwd=str(codex.CODEX_HOME), env=codex.env(),
                start_new_session=True)
        except OSError as exc:
            self.state = "failed"
            self.message = f"the CLI could not be started ({exc})"
            self.finished_at = cfg.now_iso()
            return self.snapshot()
        self.started_at = cfg.now_iso()
        self._tasks = [asyncio.create_task(self._read()),
                       asyncio.create_task(self._expire())]
        deadline = time.monotonic() + codex.LOGIN_PRINT_TIMEOUT_S
        while time.monotonic() < deadline:
            if self.url and self.code:
                self.state = "pending"
                self.expires_at = cfg.epoch_iso(
                    time.time() + codex.LOGIN_FLOW_TIMEOUT_S)
                return self.snapshot()
            if self.proc.returncode is not None:
                break
            await asyncio.sleep(0.1)
        await self._kill()
        self.state = "failed"
        self.message = (cfg.login_message(self._buf)
                        or f"the CLI printed no code in "
                           f"{codex.LOGIN_PRINT_TIMEOUT_S}s")
        self.finished_at = cfg.now_iso()
        return self.snapshot()

    async def cancel(self) -> dict:
        """End a flow nobody is going to finish. The code dies with the
        process that was polling for it; the login on the box is untouched."""
        await self._kill()
        self._reset()
        return self.snapshot()

    def _reset(self) -> None:
        self.state = "idle"
        self.url = self.code = self.message = None
        self.started_at = self.finished_at = self.expires_at = None
        self._buf = ""
        self.proc = None

    async def _read(self) -> None:
        proc = self.proc
        assert proc is not None and proc.stdout is not None
        while True:
            chunk = await proc.stdout.read(4096)
            if not chunk:
                break
            self._buf = (self._buf + chunk.decode("utf-8", "replace"))[-65536:]
            self.url = self.url or codex.device_url(self._buf)
            self.code = self.code or codex.device_code(self._buf)
        code = await proc.wait()
        if proc is not self.proc or self.state in ("done", "failed", "idle"):
            return
        login = codex.login_state()
        if code == 0 and login["connected"]:
            self.state, self.message = "done", None
        else:
            self.state = "failed"
            self.message = (cfg.login_message(self._buf)
                            or "the CLI exited without a login")
        # A code is a one-time secret for one sign-in; once the flow is over
        # it is answered to nobody.
        self.code = None
        self.finished_at = cfg.now_iso()

    async def _expire(self) -> None:
        await asyncio.sleep(codex.LOGIN_FLOW_TIMEOUT_S)
        if self.state != "pending":
            return
        await self._kill()
        self.state = "failed"
        self.code = None
        self.message = (f"nobody entered the code in "
                        f"{codex.LOGIN_FLOW_TIMEOUT_S // 60} minutes; start "
                        f"another one")
        self.finished_at = cfg.now_iso()

    async def _kill(self) -> None:
        proc, self.proc = self.proc, None
        # Not the task this runs in, for the reason `LoginFlow._kill` gives.
        here = asyncio.current_task()
        for task in self._tasks:
            if task is not here:
                task.cancel()
        self._tasks = []
        if proc is None:
            return
        # By group even when the wrapper has already gone: its native child
        # is the one polling, and may not have. See loam_codex.kill_group.
        codex.kill_group(proc.pid)
        if proc.returncode is not None:
            return
        try:
            async with asyncio.timeout(5):
                await proc.wait()
        except TimeoutError:
            pass


class AntigravityLoginFlow:
    """One ``agy acp --login``, and the four things a page can do to it:
    start it, read it, hand it the code, cancel it (2026-11-11).

    The CLI prints a Google link and reads one line -- the code the landing
    page shows, or that page's whole URL -- from a pipe; no pty (see
    ``loam_antigravity`` "signing in" for what was measured). States as
    ``LoginFlow``'s. One flow at a time: each start mints its own PKCE
    verifier, so a second would void the code being pasted.
    """

    provider = "antigravity"

    def __init__(self) -> None:
        self._tasks: list[asyncio.Task] = []
        self.proc = None
        self._reset()

    def _reset(self) -> None:
        self.state = "idle"
        self.url = self.message = None
        self.started_at = self.finished_at = self.expires_at = None
        self._buf = ""
        self._secret: str | None = None
        self.proc = None

    def snapshot(self) -> dict:
        out = {"provider": self.provider, "kind": "paste-code",
               "state": self.state, "url": self.url, "code": None,
               "accepts_code": self.state == "pending",
               "instructions": None, "message": self.message,
               "started_at": self.started_at, "finished_at": self.finished_at,
               "expires_at": self.expires_at,
               "login": agy.row_login(agy.login_state())}
        if self.state == "pending":
            out["instructions"] = (
                "Open the link, sign in with Google, and paste back the code "
                "the page shows (or the whole address of that page).")
        return out

    async def start(self) -> dict:
        if self.state == "pending" and self.proc is not None \
                and self.proc.returncode is None:
            return self.snapshot()
        await self._kill()
        self._reset()
        try:
            self.proc = await asyncio.create_subprocess_exec(
                agy.AGY, *agy.LOGIN_ARGV,
                stdin=asyncio.subprocess.PIPE,
                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.STDOUT,
                cwd=str(agy.HOME.parent), env=agy.env(),
                start_new_session=True)
        except OSError as exc:
            self.state = "failed"
            self.message = f"the CLI could not be started ({exc})"
            self.finished_at = cfg.now_iso()
            return self.snapshot()
        self.started_at = cfg.now_iso()
        self._tasks = [asyncio.create_task(self._read()),
                       asyncio.create_task(self._expire())]
        deadline = time.monotonic() + agy.LOGIN_PRINT_TIMEOUT_S
        while time.monotonic() < deadline:
            if self.url and agy.LOGIN_PROMPT in self._buf:
                self.state = "pending"
                self.expires_at = cfg.epoch_iso(
                    time.time() + agy.LOGIN_FLOW_TIMEOUT_S)
                return self.snapshot()
            if self.proc.returncode is not None or self.state == "failed":
                break
            await asyncio.sleep(0.05)
        await self._kill()
        self.state = "failed"
        self.message = (cfg.login_message(self._buf)
                        or f"the CLI printed no sign-in link in "
                           f"{agy.LOGIN_PRINT_TIMEOUT_S}s")
        self.finished_at = cfg.now_iso()
        return self.snapshot()

    async def submit(self, code: str) -> dict:
        proc = self.proc
        if self.state != "pending" or proc is None or proc.returncode is not None \
                or proc.stdin is None:
            raise BrokerError(
                409, "no login is waiting for a code; start one with POST "
                     f"/v1/providers/{self.provider}/login")
        self._secret = code
        try:
            proc.stdin.write((code + "\n").encode())
            await proc.stdin.drain()
            proc.stdin.close()
        except (OSError, ConnectionError) as exc:
            raise BrokerError(502, f"the CLI would not take the code ({exc})")
        deadline = time.monotonic() + agy.LOGIN_SUBMIT_TIMEOUT_S
        while time.monotonic() < deadline:
            if self.state != "pending":
                return self.snapshot()
            await asyncio.sleep(0.1)
        return self.snapshot()

    async def cancel(self) -> dict:
        await self._kill()
        self._reset()
        return self.snapshot()

    async def _read(self) -> None:
        proc = self.proc
        assert proc is not None and proc.stdout is not None
        while True:
            chunk = await proc.stdout.read(4096)
            if not chunk:
                break
            self._buf = (self._buf + chunk.decode("utf-8", "replace"))[-65536:]
            self.url = self.url or agy.signin_url(self._buf)
        code = await proc.wait()
        if proc is not self.proc or self.state in ("done", "failed", "idle"):
            return
        # Judged on the credential: the CLI exited 0 AND the probe, asked
        # fresh, now answers signed in.
        login = await asyncio.to_thread(agy.login_state, True) if code == 0 \
            else {"connected": False}
        if login["connected"]:
            account = agy.signed_in_as(self._buf)
            await asyncio.to_thread(agy.remember_account, account)
            await asyncio.to_thread(agy.login_state, True)
            self.state, self.message = "done", None
        else:
            self.state = "failed"
            self.message = (cfg.login_message(self._buf, self._secret)
                            or "the CLI exited without a login")
        self._secret = None
        self.finished_at = cfg.now_iso()

    async def _expire(self) -> None:
        await asyncio.sleep(agy.LOGIN_FLOW_TIMEOUT_S)
        if self.state != "pending":
            return
        await self._kill()
        self.state = "failed"
        self.message = (f"nobody finished the login in "
                        f"{agy.LOGIN_FLOW_TIMEOUT_S // 60} minutes; start "
                        f"another one")
        self.finished_at = cfg.now_iso()

    async def _kill(self) -> None:
        proc, self.proc = self.proc, None
        here = asyncio.current_task()
        for task in self._tasks:
            if task is not here:
                task.cancel()
        self._tasks = []
        if proc is None or proc.returncode is not None:
            return
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            pass
        try:
            async with asyncio.timeout(5):
                await proc.wait()
        except TimeoutError:
            pass


# -- HTTP ------------------------------------------------------------------
#
# Hand-rolled, and deliberately: the whole interface is eight routes and one
# streaming response, the standard library has no HTTP server that streams
# under asyncio, and a dependency here would have to be installed on the box,
# pinned, and explained. The parsing below is strict about the two things that
# matter (the request line and Content-Length) and indifferent to everything
# else, which is what a single known client needs.

BAD = b"HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\n\r\n"

# How often a stream with nothing to say says so, and it is written into the
# stream's own opening comment (`: open ping=<ms>`) so a client measures
# staleness against the number this broker actually uses rather than one it
# was told once in a document. Silence longer than this plus a margin is a
# connection that has gone, which is a thing a client can see and fix.
KEEPALIVE_S = 15
# The live-sessions stream (2026-11-10): a refresh for the memory numbers, and
# the wait that folds a burst of record changes into one send.
LIVE_REFRESH_S = 10
LIVE_DEBOUNCE_S = 1


def choices(payload: dict, provider: str | None = None) -> dict:
    """The ``model`` and ``effort`` a body asked for, checked here so that
    POST and PATCH refuse the same things in the same words.

    Only the keys that are PRESENT come back, because present-and-null is a
    request ("put this chat back on the persona's own setting") and absent is
    not a request at all. A value the CLI would reject is refused here rather
    than passed to a launch that would die on it, or -- worse, on the PATCH
    path -- to a running process that would answer the bad command in the
    chat and leave the record claiming a model it is not on.
    """
    out: dict = {}
    for field in ("model", "effort"):
        if field not in payload:
            continue
        value = payload[field]
        if value is None:
            out[field] = None
            continue
        if not isinstance(value, str) or not value.strip():
            raise BrokerError(
                400, f"`{field}` is a string or null (null is the persona's "
                     f"own setting)")
        value = value.strip()
        if provider == "codex":
            # Codex's own vocabulary, from its `model/list`; see loam_codex.
            if field == "model" and not codex.model_ok(value):
                listed = ", ".join(m["id"] for m in codex.read_models())
                raise BrokerError(
                    400, f"model {value!r} is not one Codex lists ({listed}). "
                         f"GET /v1/providers lists them with their names.")
            offered = codex.efforts()
            if field == "effort" and offered and value not in offered:
                raise BrokerError(
                    400, f"effort {value!r} is not a Codex level: "
                         f"{', '.join(offered)}.")
            out[field] = value
            continue
        if field == "model" and not cfg.model_ok(value):
            aliases = ", ".join(alias for alias, _ in cfg.CLAUDE_CODE_MODELS)
            raise BrokerError(
                400, f"model {value!r} is not one this CLI takes: an alias "
                     f"({aliases}) or a full model id like claude-fable-5. "
                     f"GET /v1/providers lists them with their names.")
        if field == "effort" and value not in cfg.EFFORTS:
            raise BrokerError(
                400, f"effort {value!r} is not a level: "
                     f"{', '.join(cfg.EFFORTS)}.")
        out[field] = value
    return out


def with_steps(thread_id: str, messages: list[dict]) -> list[dict]:
    """Messages with their full record as ``steps`` (2026-11-10), for
    ``?steps=full``. A message with none (a person's, a system line, a
    reply from before the full record) has ``steps: null``."""
    entries = thread_steps.read(thread_id)
    return [{**m, "steps": (entries.get(m.get("id")) or {}).get("steps")}
            for m in messages]


def truthy(value) -> bool:
    """A query parameter as a flag. `?archived=1`, `?archived=true` and a
    bare `?archived` all mean the same thing, and `?archived=0` does not."""
    if value is None:
        return False
    return str(value).strip().lower() not in ("0", "false", "no")


def persona_changes(who: str, before: dict, after: dict) -> list[str]:
    """The thread lines for a persona's PATCH beyond the two the page's own
    change already leaves (the default, a member brought in): a rename, an
    icon, a member taken out, an engine or a model, a pin, an archive."""
    show = threads_rec.display
    said = []
    if after["title"] != before["title"]:
        said.append(f"{who} renamed this thread to \u201c{after['title']}\u201d")
    if after.get("icon") != before.get("icon"):
        said.append(f"{who} changed the icon to {after['icon']}" if after.get("icon")
                    else f"{who} removed the icon")
    for p in before["members"]:
        if p not in after["members"]:
            said.append(f"{who} took {show(p)} out of this thread")
    for p in after["members"]:
        if p not in before["members"]:
            continue
        if after["engines"].get(p) != before["engines"].get(p):
            said.append(f"{who} put {show(p)} on {after['engines'].get(p)}")
        elif after["models"].get(p) != before["models"].get(p):
            model = after["models"].get(p)
            said.append(f"{who} set {show(p)}'s model to {model}" if model
                        else f"{who} put {show(p)} back on its own model")
    if bool(after.get("pinned")) != bool(before.get("pinned")):
        said.append(f"{who} {'pinned' if after.get('pinned') else 'unpinned'} "
                    f"this thread")
    if bool(after.get("archived")) != bool(before.get("archived")):
        said.append(f"{who} {'archived' if after.get('archived') else 'unarchived'} "
                    f"this thread")
    return said


def author(payload: dict) -> str | None:
    """Who made a change, when it was not the owner on the page (2026-11-10).

    `by` on a thread, session or schedule write names the persona that made
    it through the same route the page uses (`bin/settings`, the `settings`
    tool; lib/loam_settings.py). Absent, empty or an id of the owner's is the owner, which
    is every write the page sends; anything else is a persona on this box or
    a 400. It is attribution, not authority: the token is what lets a caller
    in, and every caller holding it is a process on this box."""
    by = payload.get("by")
    if by is None or by == "":
        return None
    if not isinstance(by, str):
        raise BrokerError(400, "`by` is a persona's name")
    who = by.strip().lower()
    if lc.is_owner(who):
        return None
    if who not in cfg.roster():
        raise BrokerError(400, f"`by`: no persona named {by!r} on this box")
    return who


# The most a JSON body may be. A message's text, a permission's updatedInput:
# nothing on this interface is big except an upload, and an unread
# content-length is an allocation a caller chose for this process.
JSON_BODY_MAX = 4 * 1024 * 1024
# The `multipart/form-data` envelope around a file -- the boundary lines, the
# part's headers, the closing boundary. The cap is a cap on the FILE, so the
# wire body is allowed a little more than the file itself. The app in front of
# this one allows itself the same slack (loam-ui, src/server.js).
MULTIPART_SLACK = 8 * 1024


def human_size(count: int) -> str:
    """A size as a refusal says it, which is a sentence a person reads."""
    if count < 1024:
        return f"{count} B"
    if count < 1024 * 1024:
        return f"{round(count / 1024)} KB"
    return f"{round(count / (1024 * 1024), 1)} MB"


def parse_multipart(content_type: str, body: bytes) -> list[dict]:
    """The file parts of a `multipart/form-data` body, as bytes.

    Hand-rolled on bytes, and deliberately. The obvious answers are both
    wrong here: `cgi.FieldStorage` is gone from the standard library after
    3.12, and `email.message_from_bytes` decodes a part's payload through a
    str, which silently corrupts a PNG. This reads the envelope and nothing
    else -- it does not decode, transcode or interpret the bytes between the
    boundaries.

    Each part answered as ``{"field", "filename", "type", "bytes"}``. A part
    with no filename is a plain form field and is skipped: this interface has
    no form fields, and one appearing would mean a client had invented some.
    """
    match = re.search(r'boundary=(?:"([^"]+)"|([^;]+))', content_type)
    if not match:
        raise BrokerError(400, "the multipart body states no boundary")
    boundary = b"--" + (match.group(1) or match.group(2)).strip().encode()
    parts = []
    for chunk in body.split(boundary)[1:]:
        if chunk[:2] == b"--":          # the closing boundary
            break
        chunk = chunk.lstrip(b"\r\n")
        head, sep, data = chunk.partition(b"\r\n\r\n")
        if not sep:
            continue
        if data.endswith(b"\r\n"):      # the CRLF that belongs to the boundary
            data = data[:-2]
        field = filename = None
        part_type = ""
        for line in head.decode("utf-8", "replace").splitlines():
            key, _, value = line.partition(":")
            key = key.strip().lower()
            if key == "content-disposition":
                field = re.search(r'\bname="([^"]*)"', value)
                field = field.group(1) if field else None
                filename = re.search(r'\bfilename="([^"]*)"', value)
                filename = filename.group(1) if filename else None
            elif key == "content-type":
                part_type = value.strip()
        if filename is None:
            continue
        parts.append({"field": field, "filename": filename,
                      "type": part_type, "bytes": data})
    return parts


async def discard(reader: asyncio.StreamReader, length: int) -> None:
    """Read a body this interface has already refused, and keep none of it."""
    left = length
    while left > 0:
        chunk = await reader.read(min(left, 64 * 1024))
        if not chunk:
            return
        left -= len(chunk)


def response(status: int, body: dict | list, extra: str = "") -> bytes:
    payload = json.dumps(body, indent=2).encode()
    reason = {200: "OK", 201: "Created", 202: "Accepted", 400: "Bad Request",
              401: "Unauthorized", 403: "Forbidden", 404: "Not Found",
              405: "Method Not Allowed",
              409: "Conflict", 413: "Content Too Large",
              415: "Unsupported Media Type", 422: "Unprocessable Content",
              429: "Too Many Requests",
              500: "Internal Server Error", 502: "Bad Gateway",
              503: "Service Unavailable", 504: "Gateway Timeout"}.get(status, "OK")
    head = (f"HTTP/1.1 {status} {reason}\r\n"
            f"Content-Type: application/json\r\n"
            f"Content-Length: {len(payload)}\r\n"
            f"Connection: close\r\n{extra}\r\n").encode()
    return head + payload


class Server:
    def __init__(self, broker: Broker) -> None:
        self.broker = broker
        # Threads (2026-11-08): the record is lib/loam_threads.py, the turns
        # lib/loam_thread_engine.py; see broker/README.md, "Threads".
        self.threads = loam_thread_engine.ThreadEngine(broker)

    async def handle(self, reader: asyncio.StreamReader,
                     writer: asyncio.StreamWriter) -> None:
        try:
            await self._handle(reader, writer)
        except (ConnectionResetError, BrokenPipeError):
            pass
        except Exception as exc:  # noqa: BLE001 - one client must not kill the box's broker
            print(f"handler error: {exc!r}", file=sys.stderr, flush=True)
            try:
                writer.write(response(500, {"error": str(exc)}))
                await writer.drain()
            except (ConnectionResetError, BrokenPipeError):
                pass
        finally:
            try:
                writer.close()
            except (ConnectionResetError, BrokenPipeError):
                pass

    async def _handle(self, reader: asyncio.StreamReader,
                      writer: asyncio.StreamWriter) -> None:
        request_line = await reader.readline()
        if not request_line:
            return
        try:
            method, target, _ = request_line.decode().split()
        except ValueError:
            writer.write(BAD)
            await writer.drain()
            return
        headers: dict[str, str] = {}
        while True:
            line = await reader.readline()
            if line in (b"\r\n", b"\n", b""):
                break
            key, _, value = line.decode("utf-8", "replace").partition(":")
            headers[key.strip().lower()] = value.strip()
        # An upload is the one body on this interface that is not JSON, and the
        # one that can be megabytes. Both facts are decided here, before a byte
        # of it is kept: how much may be read, and whether it is parsed at all.
        ctype = headers.get("content-type", "")
        upload = ctype.split(";")[0].strip().lower() == "multipart/form-data"
        limit = (cfg.ATTACHMENT_MAX_BYTES + MULTIPART_SLACK if upload
                 else JSON_BODY_MAX)
        body = b""
        too_large = False
        length = int(headers.get("content-length", "0") or 0)
        if length > limit:
            # Read it and throw it away rather than close on a half-sent body:
            # a client whose socket was cut mid-upload never reads the sentence
            # saying why, and the sentence is the whole of the answer.
            too_large = True
            await discard(reader, length)
        elif length:
            body = await reader.readexactly(length)

        path, _, query = target.partition("?")
        params = dict(
            part.split("=", 1) if "=" in part else (part, "")
            for part in query.split("&") if part
        )

        # /up is the one route with no token. It says the broker is listening
        # and nothing else -- no session, no agent name, no count -- so it is
        # safe to answer unauthenticated, and a health check that needed a
        # credential would be a health check nobody runs.
        if path == "/up":
            writer.write(response(200, {"ok": True, "service": "session-broker"}))
            await writer.drain()
            return

        if headers.get("authorization", "") != f"Bearer {self.broker.token}":
            writer.write(response(401, {"error": "bearer token required"}))
            await writer.drain()
            return

        if too_large:
            writer.write(response(413, {"error": (
                f"that is bigger than this interface carries "
                f"({human_size(cfg.ATTACHMENT_MAX_BYTES)} at most)"
                if upload else "the body is too big")}))
            await writer.drain()
            return

        payload: dict = {}
        if body and not upload:
            try:
                payload = json.loads(body)
            except json.JSONDecodeError:
                writer.write(response(400, {"error": "body is not JSON"}))
                await writer.drain()
                return

        try:
            await self.route(method, path, params, payload, writer,
                             raw=body, content_type=ctype)
        except (BrokerError, threads_rec.ThreadError) as exc:
            writer.write(response(exc.status, {"error": exc.message,
                                               **getattr(exc, "detail", {})}))
            await writer.drain()

    async def route(self, method: str, path: str, params: dict, payload: dict,
                    writer: asyncio.StreamWriter, raw: bytes = b"",
                    content_type: str = "") -> None:
        parts = [p for p in path.split("/") if p]
        broker = self.broker

        # What a client must know before it does something this interface would
        # refuse. One number so far: the biggest file a chat carries, asked for
        # by the app so that a phone is told in the composer rather than after
        # a minute of uploading. A client that does not ask is not broken --
        # the upload route is the gate, and it answers in a sentence.
        if parts == ["v1", "limits"] and method == "GET":
            writer.write(response(200, {
                "attachment_max_bytes": cfg.ATTACHMENT_MAX_BYTES,
                "inline_image_max_bytes": cfg.INLINE_IMAGE_MAX_BYTES,
                "attachment_types": sorted(set(cfg.ATTACHMENT_TYPES.values())),
                # Files' Upload: the same cap, its own list of extensions.
                "files_upload_max_bytes": files_api.UPLOAD_MAX,
                "files_upload_extensions": sorted(files_api.UPLOAD_TYPES),
            }))
            await writer.drain()
            return

        # Who this install is for (2026-11-14, first release L2): the id the
        # runtime writes for the owner and the ids it accepts as the owner's
        # (`owner.id`, plus the legacy id for this release), and the name to
        # show. The page reads it once and never assumes an id.
        if parts == ["v1", "owner"] and method == "GET":
            writer.write(response(200, lc.owner()))
            await writer.drain()
            return

        # The dictation terms note, read fresh on every ask (2026-09-30). The
        # file is cfg's one constant; `params` is never read here and a longer
        # path is not this route, so nothing a client sends can name a file.
        if parts == ["v1", "dictation-terms"] and method == "GET":
            note = cfg.dictation_terms()
            nocache = "Cache-Control: no-store\r\n"
            if note is None:
                writer.write(response(404, {"error": "no dictation terms note on this box"},
                                      nocache))
            else:
                writer.write(response(200, note, nocache))
            await writer.drain()
            return

        # Files (2026-10-02): the vault, the agents' spaces and the runtime's
        # documents, by root and relative path only. lib/loam_files.py holds
        # every rule; this only decodes the query once and writes the answer.
        if parts[:2] == ["v1", "files"]:
            await self.files_route(method, parts[2:], params, payload, writer,
                                   raw, content_type)
            return

        # Threads and boards (2026-11-08). Beside the sessions, not instead of
        # them: every /v1/sessions route is unchanged and is Classic chats.
        if parts[:2] == ["v1", "threads"]:
            await self.threads_route(method, parts[2:], params, payload, writer,
                                     raw, content_type)
            return

        # Schedules, Activity and the engineer's jobs (2026-10-14): see
        # lib/loam_activity.py and broker/README.md, "Schedules and Activity".
        if parts[:2] in (["v1", "schedules"], ["v1", "activity"], ["v1", "jobs"]):
            await self.activity_route(method, parts[1:], params, payload, writer)
            return

        # The settings registry (2026-11-10): every setting the page can
        # change, the route it goes to and whose hands it is in, read from
        # lib/loam_settings.py -- the table `bin/settings` works from, so a
        # client can draw from the one source. Words and routes, no values.
        if parts == ["v1", "settings"] and method == "GET":
            writer.write(response(200, {"settings": loam_settings.table()}))
            await writer.drain()
            return

        # Apps (2026-11-12): the Apps section's list -- the agents' own sites
        # and the projects' deployed containers, read from the deployment
        # layer each time (lib/loam_apps.py; broker/README.md, "Apps").
        # Read-only; a record the generator would refuse is a 503 that says
        # which, since the list cannot be told without it.
        if parts == ["v1", "apps"]:
            nocache = "Cache-Control: no-store\r\n"
            if method != "GET":
                writer.write(response(405, {"error": "the apps list is read-only; use GET"},
                                      nocache))
            else:
                try:
                    value = await asyncio.to_thread(loam_apps.listing)
                    writer.write(response(200, value, nocache))
                except Exception as exc:  # noqa: BLE001 -- a DeployError, or a file gone mid-read
                    writer.write(response(503, {"error": f"the apps list cannot be read: {exc}"},
                                          nocache))
            await writer.drain()
            return

        # Plugins (2026-11-12): the plugin host's one list, on and off,
        # install from a link (two calls: what it declares, then a confirm),
        # remove, and a plugin's page files for the page's loader. Every rule
        # is lib/loam_plugins.py; docs/plugins.md is the interface.
        if parts[:2] == ["v1", "plugins"]:
            await self.plugins_route(method, parts[2:], payload, writer)
            return

        # The marketplace (2026-11-17): the list Settings › Plugins draws
        # above "Install from a link". A read; an install from it is the
        # plugins route's, by the entry's link. Never an error for a list
        # that is not there: lib/loam_marketplace.py says empty.
        if parts == ["v1", "marketplace"]:
            if method != "GET":
                writer.write(response(405, {"error": "use GET for the marketplace's list"},
                                      "Cache-Control: no-store\r\n"))
            else:
                refresh = params.get("refresh") == "1"
                body = await asyncio.to_thread(loam_marketplace.listing, refresh)
                writer.write(response(200, body, "Cache-Control: no-store\r\n"))
            await writer.drain()
            return
        # A listing's own page (2026-11-18, Settings › Market): what the
        # plugin at its link declares, read as an install's first call reads
        # it (nothing written), and its icon, cover and theme.css for the
        # Market to draw. Reads only; installing is the plugins route's.
        if parts[:2] == ["v1", "marketplace"] and len(parts) in (3, 4):
            nocache = "Cache-Control: no-store\r\n"
            try:
                if method not in ("GET", "HEAD"):
                    raise BrokerError(405, "a listing is read with GET")
                if len(parts) == 3:
                    body = await asyncio.to_thread(loam_marketplace.details, parts[2],
                                                   params.get("refresh") == "1")
                    writer.write(response(200, body, nocache))
                else:
                    data, ctype = await asyncio.to_thread(loam_marketplace.file,
                                                          parts[2], parts[3])
                    head = (f"HTTP/1.1 200 OK\r\nContent-Type: {ctype}\r\n"
                            f"Content-Length: {len(data)}\r\n"
                            f"Cache-Control: private, max-age=600\r\n"
                            f"X-Content-Type-Options: nosniff\r\n"
                            f"Connection: close\r\n\r\n").encode()
                    writer.write(head + (b"" if method == "HEAD" else data))
            except loam_marketplace.NotListed as exc:
                writer.write(response(404, {"error": str(exc)}, nocache))
            except loam_plugins.PluginError as exc:
                writer.write(response(exc.status, {"error": exc.message}, nocache))
            except BrokerError as exc:
                writer.write(response(exc.status, {"error": exc.message}, nocache))
            await writer.drain()
            return

        # Shared keys (2026-11-18): Settings › Accounts. API keys by provider,
        # entered once; each plugin that declared a provider uses its shared
        # key unless it has its own. Every rule is lib/loam_keys.py;
        # docs/plugins.md, "Keys", is the interface. An agent may change them
        # with `by` (the owner, 2026-11-10: every setting is an agent's too);
        # no route here ever answers a whole value.
        if parts[:2] == ["v1", "keys"]:
            nocache = "Cache-Control: no-store\r\n"
            rest = parts[2:]
            try:
                by = author(payload) if method != "GET" else None
                if not rest and method == "GET":
                    body = await asyncio.to_thread(loam_keys.listing)
                elif len(rest) == 1 and method == "GET":
                    body = await asyncio.to_thread(loam_keys.one, rest[0])
                elif len(rest) == 1 and method == "PUT":
                    body = await asyncio.to_thread(loam_keys.set_shared, rest[0], payload, by)
                    print(f"keys: {rest[0]} saved by {by or lc.OWNER_ID}",
                          file=sys.stderr, flush=True)
                elif len(rest) == 1 and method == "DELETE":
                    body = await asyncio.to_thread(loam_keys.forget_shared, rest[0], by)
                    print(f"keys: {rest[0]} forgotten by {by or lc.OWNER_ID}",
                          file=sys.stderr, flush=True)
                elif rest[1:] == ["check"] and method == "POST":
                    body = await asyncio.to_thread(loam_keys.recheck, rest[0], by)
                elif len(rest) == 3 and rest[1] == "plugins" and method == "PUT":
                    body = await asyncio.to_thread(loam_keys.set_own, rest[0], rest[2],
                                                   payload, by)
                    print(f"keys: {rest[2]} uses its own {rest[0]} key (by "
                          f"{by or lc.OWNER_ID})", file=sys.stderr, flush=True)
                elif len(rest) == 3 and rest[1] == "plugins" and method == "DELETE":
                    body = await asyncio.to_thread(loam_keys.use_shared, rest[0], rest[2], by)
                    print(f"keys: {rest[2]} uses the shared {rest[0]} key (by "
                          f"{by or lc.OWNER_ID})", file=sys.stderr, flush=True)
                else:
                    raise BrokerError(405, "GET /v1/keys[/<provider>]; PUT or DELETE "
                                           "/v1/keys/<provider>; POST …/<provider>/check; "
                                           "PUT or DELETE …/<provider>/plugins/<id>")
                writer.write(response(200, body, nocache))
            except loam_keys.KeyError_ as exc:
                writer.write(response(exc.status, {"error": str(exc)}, nocache))
            await writer.drain()
            return

        # Updates (2026-11-14, first release L13): Settings › Update reads
        # the state, checks, applies and rolls back. Every rule is
        # lib/loam_update.py; docs/update.md is the page contract.
        if parts[:2] == ["v1", "update"]:
            await self.update_route(method, parts[2:], payload, writer)
            return

        # Appearance (2026-11-11): mode and size for the phone and the
        # desktop, kept on the host in state/broker/settings.json so every
        # browser agrees and a persona can set it (lib/loam_appearance.py).
        # GET fills defaults; PATCH merges named fields in one write and
        # answers the whole value. `by` is the one field beside the kinds.
        if parts == ["v1", "settings", "appearance"]:
            nocache = "Cache-Control: no-store\r\n"
            if method not in ("GET", "PATCH"):
                writer.write(response(405, {"error": "use GET or PATCH for appearance"},
                                      nocache))
                await writer.drain()
                return
            try:
                if method == "GET":
                    value = await asyncio.to_thread(loam_appearance.read)
                else:
                    by = author(payload)
                    patch = {k: v for k, v in payload.items() if k != "by"}
                    value = await asyncio.to_thread(loam_appearance.update, patch)
                    print(f"appearance: {json.dumps(patch, sort_keys=True)} by "
                          f"{by or lc.OWNER_ID}", file=sys.stderr, flush=True)
            except loam_appearance.AppearanceError as exc:
                writer.write(response(exc.status, {"error": exc.message}, nocache))
                await writer.drain()
                return
            writer.write(response(200, value, nocache))
            await writer.drain()
            return

        # Making an agent by conversation, archiving and restoring it, and
        # its uploaded face (2026-11-14, first release L10): every rule is
        # lib/loam_agents.py; broker/README.md, "Making, archiving and
        # restoring agents", is the contract. Before the profile's route,
        # whose `/v1/agents/<agent>` would otherwise take `drafts` and `new`
        # as agents' names (both are reserved ids).
        if parts[:2] == ["v1", "agents"] and (
                parts[2:3] in (["drafts"], ["new"])
                or (len(parts) == 4 and parts[3] in ("archive", "restore", "face"))):
            await self.agents_route(method, parts[2:], params, payload, writer,
                                    raw, content_type)
            return

        # An agent's profile, the engineers and the reviewer (2026-11-13):
        # lib/loam_profile.py holds every rule; broker/README.md, "Agent
        # profiles, engineers and the reviewer", is the contract.
        if (len(parts) == 3 and parts[:2] == ["v1", "agents"]) or \
                parts[:2] == ["v1", "engineers"] or \
                parts == ["v1", "system", "reviewer"]:
            await self.profile_route(method, parts[1:], payload, writer)
            return

        if parts == ["v1", "agents"] and method == "GET":
            # Objects since 2026-09-18, not the bare strings this answered
            # before: the page draws each agent's name and mark, and both are
            # stated in the persona's own agent.json. See cfg.agent_card.
            # `?archived=1` (2026-11-14): the archived ones instead, each
            # with its `archived` mark (Settings › Agents › Archived).
            if truthy(params.get("archived")):
                writer.write(response(200, {"agents": await asyncio.to_thread(
                    loam_agents.archived_cards)}))
                await writer.drain()
                return
            writer.write(response(200, {"agents": cfg.roster_cards()}))
            await writer.drain()
            return

        if parts == ["v1", "providers"] and method == "GET":
            # `?agent=` only decides which model the answer calls the
            # default, and a name nobody has simply ticks nothing. It is not
            # a filter and it is not required: the rows are the same rows.
            # On a thread: the Codex row may run `codex login status`.
            writer.write(response(200, {
                "providers": await asyncio.to_thread(
                    self.providers, params.get("agent"))}))
            await writer.drain()
            return

        # Making the login again, from the app. Three routes on the one wired
        # provider, and a fourth to call the whole thing off. Named under the
        # provider rather than at the top level because that is what it is
        # about -- and because a second provider will one day need its own.
        # See LoginFlow above for what the CLI does and what was measured.
        # Sign-out (2026-11-11): removes the login from the box, on the
        # providers whose row carries `sign_in.sign_out`.
        if (len(parts) == 4 and parts[:2] == ["v1", "providers"]
                and parts[3] == "logout" and method == "POST"):
            provider = parts[2]
            if provider not in cfg.SIGN_OUT_PROVIDERS:
                raise BrokerError(
                    405 if provider in cfg.WIRED_PROVIDERS else 404,
                    f"{provider!r} is not signed out from the app; its row's "
                    f"`sign_in.sign_out` is null. GET /v1/providers says "
                    f"which are.")
            # Never under a turn (2026-11-11): a chat on this provider that
            # is working, asking or waiting on its children would lose its
            # login mid-flight, so the sign-out waits for it.
            busy = [s for s in broker.sessions.values()
                    if s.provider == provider and s.is_live() and s.busy()]
            if busy:
                raise BrokerError(
                    409, f"{len(busy)} {cfg.PROVIDER_NAMES[provider]} chat"
                    f"{'s are' if len(busy) > 1 else ' is'} mid-turn or "
                    f"asking; sign out when "
                    f"{'they finish' if len(busy) > 1 else 'it finishes'}.")
            if broker.login_flows[provider].state == "pending":
                await broker.login_flows[provider].cancel()
            if provider == "antigravity":
                out = await asyncio.to_thread(agy.sign_out)
            elif provider == "codex":
                out = await asyncio.to_thread(codex.sign_out)
                out["login"] = await asyncio.to_thread(self.codex_login)
            else:
                out = await asyncio.to_thread(cfg.claude_code_sign_out)
            writer.write(response(200, out))
            await writer.drain()
            return

        if (len(parts) >= 4 and parts[:2] == ["v1", "providers"]
                and parts[3] == "login"):
            provider, tail = parts[2], parts[4:]
            if provider not in cfg.WIRED_PROVIDERS:
                raise BrokerError(
                    404, f"{provider!r} has no login to make: it is "
                         f"{cfg.NOT_WIRED}. GET /v1/providers says which are.")
            flow = broker.login_flows[provider]
            if not tail and method == "POST":
                # 201 when this call started one, 200 when it handed back the
                # flow that was already running.
                was = flow.state
                out = await flow.start()
                writer.write(response(
                    201 if was != "pending" and out["state"] == "pending"
                    else 200, out))
                await writer.drain()
                return
            if not tail and method == "GET":
                writer.write(response(200, flow.snapshot()))
                await writer.drain()
                return
            if not tail and method == "DELETE":
                writer.write(response(200, await flow.cancel()))
                await writer.drain()
                return
            if tail == ["code"] and method == "POST" \
                    and cfg.SIGN_IN_KINDS[provider] != "paste-code":
                raise BrokerError(
                    405, f"a {cfg.PROVIDER_NAMES[provider]} login is a device "
                         f"code entered on the provider's page; there is "
                         f"nothing to paste back here. GET "
                         f"/v1/providers/{provider}/login says when it is done.")
            if tail == ["code"] and method == "POST":
                code = payload.get("code")
                if not isinstance(code, str) or not code.strip():
                    raise BrokerError(400, "a `code` is required: the one the "
                                           "sign-in page gave you")
                writer.write(response(200, await flow.submit(code.strip())))
                await writer.drain()
                return

        if parts[:3] == ["v1", "integrations", "github"]:
            await self.github(method, parts[3:], params, payload, writer)
            return

        # `/v1/integrations/<id>` for a plugin's integration was forwarded to
        # the plugin's server from 2026-11-14 (L5) until loam-ui 1c4ec9b moved
        # the page to `/x/<id>/`; retired the same day (L11). It is answered
        # now as any unknown route is.

        if parts == ["v1", "sessions"] and method == "GET":
            # A conversation started in the Claude Code app becomes a row here
            # within a minute, without a restart: the scan for files nobody has
            # adopted runs on a read of the list, at most that often, and the
            # records already held are brought into step by `known` itself.
            broker.scan_for_new()
            residency = broker.residency()
            # `?archived=1` is still accepted and changes nothing: since the
            # classic view retired (2026-11-12) every record is listed, which
            # is what Running now, the one reader, always asked for.
            rows = broker.known(params.get("agent"))
            if params.get("turns") != "all":
                rows = [list_row(r) for r in rows]
            writer.write(response(200, {
                "sessions": rows,
                # `live_count` and `cap`: the resident count and the ceiling,
                # for "2 of 4 live". `live` is what that count was called
                # before each session carried its own `live` boolean
                # (2026-09-25), and it is kept because removing it would be a
                # silent break of a client reading it -- but one word cannot
                # mean a number here and a boolean there, so `live_count` is
                # the name from now on and this one is the compatibility copy.
                **residency, "live": residency["live_count"]}))
            await writer.drain()
            return

        # `POST /v1/sessions` (start or resume a classic chat), `PATCH` on a
        # session, `POST /v1/sessions/seen` and a session's `events`,
        # `messages`, `attachments` and `compact` retired with the classic
        # chat view on 2026-11-12 (the owner, 2026-11-11). A thread starts and
        # resumes its members' sessions itself (lib/loam_thread_engine.py),
        # and a thread is what a person talks in. broker/README.md, "The
        # classic chat routes, retired".

        # The live sessions (2026-11-10): what is in RAM now, thread members
        # and classic chats alike, with the box's totals for a small gauge;
        # its stream; and "end all idle". Fixed paths, checked before the
        # per-session block, which would otherwise read `live` as an id
        # (ids are UUIDs the broker mints). broker/README.md, "Live sessions".
        if parts == ["v1", "sessions", "live"] and method == "GET":
            writer.write(response(200, self.live_view()))
            await writer.drain()
            return
        if parts == ["v1", "sessions", "live", "events"] and method == "GET":
            await self.live_stream(writer)
            return
        if parts == ["v1", "sessions", "end-idle"] and method == "POST":
            by = author(payload)
            ended = await self.end_idle()
            if by:
                print(f"sessions: end-idle by {by}: {ended}", file=sys.stderr,
                      flush=True)
            writer.write(response(200, ended))
            await writer.drain()
            return

        # Like `events` below, a fixed three-part path checked before the
        # per-session block, which would otherwise read `adopt` as an id.
        # A session whose id is literally `adopt` is unaffected: it is
        # reached at /v1/sessions/adopt/events and PATCHed at its own path,
        # and ids are UUIDs the broker mints.
        if parts == ["v1", "sessions", "adopt"] and method == "POST":
            report = broker.adopt_app_sessions()
            writer.write(response(200, report))
            await writer.drain()
            return

        # Before the per-session block below, which would otherwise read
        # "events" as a session id and answer 404 for the live list.
        if parts == ["v1", "sessions", "events"] and method == "GET":
            await self.stream_records(writer,
                                      full=params.get("turns") == "all")
            return

        if len(parts) >= 3 and parts[0] == "v1" and parts[1] == "sessions":
            session_id = parts[2]
            tail = parts[3:]

            if not tail and method == "GET":
                # `load`, not `_session`: a record outlives its process, and
                # the id a client has in hand is usually one it read off the
                # listing, where every session is a record and most are ended.
                writer.write(response(200, broker.load(session_id).meta()))
                await writer.drain()
                return

            if not tail and method == "DELETE":
                session = self._session(session_id)
                by = author(payload)
                if by:
                    print(f"sessions: {session_id} ended by {by}",
                          file=sys.stderr, flush=True)
                # A thread member's session mid-turn: the turn ends with one
                # quiet line in the thread, and the next mention resumes the
                # session by id (2026-11-10). The thread itself is untouched.
                thread_id = self.threads.mark_ended(session_id)
                await session.stop()
                record = session.meta()
                if thread_id:
                    record["ended_turn_in"] = thread_id
                writer.write(response(200, record))
                await writer.drain()
                return

            if len(tail) == 2 and tail[0] == "permissions" and method == "POST":
                session = self._session(session_id)
                behavior = payload.get("behavior")
                if behavior not in ("allow", "deny"):
                    raise BrokerError(400, "`behavior` is 'allow' or 'deny'")
                updates = payload.get("updatedPermissions")
                if updates is not None:
                    # The CLI's own suggestions, echoed back: a list of its
                    # `PermissionUpdate` objects, each for this process only.
                    # A suggestion can name `localSettings`, which would have
                    # the CLI write the persona's own settings file from a
                    # tap on a card; persona configs are operator-authored,
                    # so only `session` is accepted and nothing is trimmed.
                    if (behavior != "allow" or not isinstance(updates, list)
                            or not all(isinstance(u, dict) for u in updates)):
                        raise BrokerError(
                            400, "`updatedPermissions` is a list of the "
                                 "request's own permission_suggestions, "
                                 "on an allow")
                    if any(u.get("destination") != "session" for u in updates):
                        raise BrokerError(
                            400, "`updatedPermissions` may only carry "
                                 "suggestions whose destination is 'session'")
                await session.answer_permission(
                    tail[1], behavior, payload.get("message"),
                    payload.get("updatedInput"), payload.get("answers"),
                    updates or None)
                writer.write(response(200, {"answered": tail[1],
                                            "behavior": behavior}))
                await writer.drain()
                return

        writer.write(response(405, {"error": f"no route for {method} {path}"}))
        await writer.drain()

    # -- the live sessions (2026-11-10) --------------------------------------

    def _thread_of(self) -> dict[str, tuple[str, str]]:
        """Session id -> (thread id, persona), for every member session the
        thread state remembers and every turn in flight."""
        out: dict[str, tuple[str, str]] = {}
        try:
            for tid, members in threads_rec.load_state("sessions.json").items():
                for persona, kept in (members or {}).items():
                    if isinstance(kept, dict) and kept.get("session_id"):
                        out[kept["session_id"]] = (tid, persona)
        except (OSError, ValueError, AttributeError):
            pass
        for key, session in list(self.threads.turn_sessions.items()):
            if key in self.threads.turns and getattr(session, "id", None):
                out[session.id] = key
        return out

    def live_row(self, session, thread_of: dict, titles: dict,
                 kids: dict) -> dict:
        state = loam_live.state_of(session.busy())
        pid = getattr(getattr(session, "proc", None), "pid", None)
        started = loam_live.started_ts(pid)
        last = getattr(session, "last_activity", None)

        def stamp(ts):
            return (datetime.fromtimestamp(ts, timezone.utc)
                    .strftime("%Y-%m-%dT%H:%M:%SZ") if ts else None)
        # `model` is the model the session is running on as its CLI said it
        # (Claude's `system/init`, Codex's thread start), else the one it was
        # asked for; `model_asked` is the ask (null: the persona's default).
        # Since 2026-11-12, for Activity: until then `model` was only the
        # ask, so a thread on its persona's default read `opus`.
        asked = getattr(session, "model", None)
        provider = getattr(session, "provider", None)
        engine = loam_waiters.engine_id(provider) or provider or "claude-code"
        row = {"id": session.id, "agent": session.agent,
               "engine": engine,
               "engine_label": loam_waiters.ENGINE_LABELS.get(engine, engine),
               "model": running_model(session) or asked,
               "model_asked": asked,
               "state": state, "last_active": stamp(last),
               # The newest event the session wrote (2026-11-16; since
               # 11-17 it no longer lets a restart go: loam_live).
               "last_event_at": getattr(session, "last_event_at", None),
               "idle_since": stamp(last) if state == "idle" else None,
               "started_at": stamp(started),
               "rss_mb": loam_live.tree_rss_mb(pid, kids),
               "ending": loam_live.ending(state)}
        where = thread_of.get(session.id)
        if where:
            tid = where[0]
            if tid not in titles:
                try:
                    titles[tid] = threads_rec.read(tid)[0]["title"]
                except Exception:  # noqa: BLE001 - a deleted thread keeps its row
                    titles[tid] = (getattr(session, "title", None) or "") \
                        .removeprefix("Thread · ") or None
            row.update(kind="thread", run_kind="thread", thread_id=tid,
                       thread_title=titles[tid], title=None)
        else:
            row.update(kind="classic", run_kind="conversation", thread_id=None,
                       thread_title=None, title=getattr(session, "title", None))
        return row

    async def deliver_owed(self) -> None:
        """Every `DELIVER_EVERY_S`, the receipts no waiting call carried
        (2026-11-12, lib/loam_waiters.py): a call ended by a broker restart
        or by its ceiling while its job ran on. Once its job has a verdict,
        one plain line goes into the thread its brief came from, and the
        persona that sent it gets a turn naming the receipt to read. Fail-soft: never the reason a
        broker is down."""
        await asyncio.sleep(DELIVER_FIRST_S)
        while not self.broker.stopping:
            try:
                for record in await asyncio.to_thread(loam_waiters.owed):
                    try:
                        brief = (Path(record["job_dir"]) / "brief.md").read_text(
                            encoding="utf-8")
                        title = loam_memory.front_matter(brief).get("title")
                    except (OSError, KeyError):
                        title = None
                    outcome = self.threads.deliver_job(
                        record,
                        loam_waiters.delivery_text(
                            record, title,
                            threads_rec.display(record.get("persona") or "")),
                        loam_waiters.handoff_text(record, title))
                    loam_waiters.done(record, outcome)
                    if outcome == "already delivered":
                        continue  # said when it was; a record that would not go
                    print(f"deliver: job {record.get('job')} -> "
                          f"{record.get('thread') or 'no thread'} "
                          f"{record.get('persona')}: {outcome}",
                          file=sys.stderr, flush=True)
            except Exception as exc:  # noqa: BLE001
                print(f"deliver: the pass failed ({exc!r})", file=sys.stderr,
                      flush=True)
            # What an update left for the person's agent (2026-11-14, first
            # release L13, lib/loam_update.py): one line in General and a
            # turn for General's default agent, to say it in its own words.
            try:
                for note in await asyncio.to_thread(loam_update.owed_notices):
                    outcome = self.threads.deliver_note(note)  # on the loop, as deliver_job
                    loam_update.notice_done(note, outcome)  # says a stuck one once
                    if outcome == "already delivered":
                        continue
                    print(f"deliver: update notice {note.get('id')} "
                          f"({note.get('kind')}): {outcome}", file=sys.stderr,
                          flush=True)
            except Exception as exc:  # noqa: BLE001
                print(f"deliver: the update notices failed ({exc!r})",
                      file=sys.stderr, flush=True)
            await asyncio.sleep(DELIVER_EVERY_S)

    def live_view(self) -> dict:
        """`GET /v1/sessions/live`: every session with a process behind it,
        and the box's totals. Reads /proc once; no record is read but the
        titles of the threads that have a live member."""
        broker = self.broker
        live = broker.live()
        thread_of, titles = self._thread_of(), {}
        try:
            kids = loam_live.children()
        except OSError:
            kids = {}
        rows = sorted((self.live_row(s, thread_of, titles, kids) for s in live),
                      key=lambda r: r["last_active"] or "", reverse=True)
        mi = loam_live.meminfo_mb()
        room = broker.room()
        total, avail = mi.get("MemTotal"), mi.get("MemAvailable")
        box = {"ram_total_mb": total,
               "ram_used_mb": (total - avail) if total and avail is not None else None,
               "ram_available_mb": room.get("available_mb"),
               "reserve_mb": room.get("reserve_mb"),
               "start_mb": room.get("need_mb"),
               "can_start": loam_live.can_start(
                   room.get("available_mb"), room.get("reserve_mb") or 0,
                   room.get("need_mb") or cfg.SESSION_START_MB, room.get("starting") or 0,
                   room.get("cgroup_room_mb"), cfg.MAX_SESSIONS - broker.seats_taken()),
               "sessions": {"live": len(rows),
                            "mb": sum(r["rss_mb"] or 0 for r in rows),
                            "idle": sum(1 for r in rows if r["state"] == "idle")},
               "units": loam_live.units()}
        # Thread turns in flight (2026-11-17), with or without a session
        # yet: a planned restart goes only when this is empty and every row
        # is idle (loam_live.restart_blockers), so a turn that has been
        # taken but whose session is still starting is not cut.
        engine = self.threads
        turns = [{"thread_id": tid, "persona": persona,
                  "queued": key not in engine.turns}
                 for key in dict.fromkeys(
                     [*engine.turns,
                      *(k for k, q in list(engine.queues.items()) if not q.empty())])
                 for (tid, persona) in [key]]
        return {"sessions": rows, "box": box, "turns": turns,
                "at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}

    async def end_idle(self) -> dict:
        """`POST /v1/sessions/end-idle`: every live session that is idle and
        not carrying a thread's turn. Never one that is working, asking or
        waiting on background work: each is asked again just before its stop."""
        ended, kept = [], []
        for session in list(self.broker.live()):
            state = loam_live.state_of(session.busy())
            why = None
            if state != "idle":
                why = state
            elif self.threads.turn_of(session.id):
                why = "working"            # a thread's turn is about to send
            elif time.time() - session.last_activity < cfg.EVICT_GRACE_S:
                # As admission's eviction: a session started or answered in
                # the last seconds may be a thread turn on its way to sending.
                why = "just active"
            if why:
                kept.append({"id": session.id, "agent": session.agent, "why": why})
                continue
            await session.stop()
            ended.append({"id": session.id, "agent": session.agent})
        return {"ended": ended, "kept": kept}

    async def live_stream(self, writer: asyncio.StreamWriter) -> None:
        """`GET /v1/sessions/live/events`: `sessions.live`, the whole
        `GET /v1/sessions/live` answer, on open, within a second of any
        record change (a start, a stop, a turn's state), and every
        `LIVE_REFRESH_S` for the memory numbers, only when it changed. A
        few rows, so the whole view each time is slimmer than a diff."""
        queue: asyncio.Queue = asyncio.Queue()
        self.broker.record_subscribers.add(queue)
        self._open_stream(writer)
        last = None
        try:
            while True:
                view = self.live_view()
                same = {k: v for k, v in view.items() if k != "at"}
                if same != last:
                    last = same
                    await self._send_event(writer, {"type": "sessions.live", **view})
                else:
                    await self._ping(writer)
                try:
                    async with asyncio.timeout(LIVE_REFRESH_S):
                        item = await queue.get()
                except TimeoutError:
                    continue
                if item is None:
                    return
                await asyncio.sleep(LIVE_DEBOUNCE_S)
                while not queue.empty():
                    if queue.get_nowait() is None:
                        return
        except (ConnectionResetError, BrokenPipeError):
            pass
        finally:
            self.broker.record_subscribers.discard(queue)

    def thread_model(self, persona: str, engine: str, model) -> str | None:
        """A member's or a turn's model, checked against what its engine
        offers (2026-11-09): Claude Code's aliases and full ids and Codex's
        `model/list`, as a classic chat's are (`choices`), and the models
        Antigravity's CLI lists. Null is the persona's own."""
        if model is None:
            return None
        if engine in ("claude-code", "codex"):
            return choices({"model": model}, engine).get("model")
        if not isinstance(model, str) or not model.strip():
            raise BrokerError(400, "`model` is a string or null")
        listed = [m.get("id") for m in (agy.login_state().get("models") or [])
                  if isinstance(m, dict)]
        if model.strip() not in listed:
            raise BrokerError(
                400, f"model {model!r} is not one Antigravity lists"
                     f"{' (' + ', '.join(listed) + ')' if listed else ''}. "
                     f"GET /v1/providers lists them.")
        return model.strip()

    async def threads_route(self, method: str, tail: list[str], params: dict,
                            payload: dict, writer: asyncio.StreamWriter,
                            raw: bytes = b"", content_type: str = "") -> None:
        """The threads contract (broker/README.md, "Threads"). Every read is
        the vault record, parsed and cached by its mtime; nothing here opens
        or replays a harness session."""
        engine = self.threads
        if not tail:
            if method == "GET":
                threads_rec.ensure_general()
                body = {"threads": engine.listing(
                            archived=truthy(params.get("archived"))),
                        "agents": cfg.roster_cards()}
                writer.write(response(200, body))
                await writer.drain()
                return
            if method == "POST":
                # `persona` is optional since 2026-11-09: a thread with no
                # default records what is written and nobody answers until a
                # default is set or someone is tagged.
                persona = payload.get("persona") or None
                by = author(payload)
                meta = threads_rec.create(persona, payload.get("title"))
                if by:
                    threads_rec.append(
                        meta["id"], "system",
                        f"{threads_rec.display(by)} started this thread",
                        kind="system")
                    print(f"threads: {meta['id']} created by {by}",
                          file=sys.stderr, flush=True)
                if payload.get("text"):
                    engine.post_person(meta["id"], payload["text"])
                engine.publish_row(meta["id"])
                writer.write(response(201, engine.summary(meta["id"])))
                await writer.drain()
                return
            raise BrokerError(405, f"no route for {method} /v1/threads")
        if tail == ["events"] and method == "GET":
            await self.thread_list_stream(writer, truthy(params.get("archived")))
            return
        if tail == ["writer"] and method == "GET":
            # The record writer's own counts (2026-11-10): a reply dropped,
            # carried or recovered late, and a full record that failed to
            # write, are numbers here and lines in the broker's log.
            writer.write(response(200, dict(thread_steps.COUNTS)))
            await writer.drain()
            return
        if tail == ["imported"] and method == "GET":
            # Classic chats imported as archived threads (2026-11-11,
            # `bin/import-classic-chats`): session id -> thread id, read off
            # the records' frontmatter, so a link or bookmark to a classic
            # chat can be sent to its thread. `?session=<id>` asks for one,
            # and a session never imported is a 404.
            mapping = threads_rec.imported()
            sid = params.get("session")
            if sid:
                if sid not in mapping:
                    raise BrokerError(404, f"no thread was imported from session {sid}")
                writer.write(response(200, {"session": sid, "thread": mapping[sid]}))
            else:
                writer.write(response(200, {"imported": mapping}))
            await writer.drain()
            return
        thread_id, rest = tail[0], tail[1:]
        if not rest and method == "GET":
            limit = self._count(params.get("limit"), "limit") or threads_rec.PAGE
            got = threads_rec.page(thread_id, params.get("before") or None, limit)
            meta = got["meta"]
            messages = got["messages"]
            # A read of the newest page is the owner looking at the thread, and
            # marks it seen; `?seen=0` (2026-11-10) is a read that is not --
            # a page's own refresh behind the view -- and writes nothing.
            if messages and not params.get("before") \
                    and truthy(params.get("seen", "1")):
                threads_rec.mark_seen(thread_id, messages[-1]["id"])
            if params.get("steps") == "full":
                messages = with_steps(thread_id, messages)
            # The engineer jobs briefed from this thread (2026-11-13): queued,
            # running, landing, and finished in the last ten minutes, read
            # from the launcher's job state, never from the persona's session
            # (lib/loam_activity.job_rows; contract in broker/README.md).
            summary = engine.summary(thread_id)
            try:
                summary["jobs"] = await asyncio.to_thread(
                    activity.thread_jobs, thread_id)
                summary["jobs_error"] = None
            except Exception as exc:  # noqa: BLE001 -- the thread reads without it
                summary["jobs"] = []
                summary["jobs_error"] = f"the engineer jobs could not be read: {exc}"
            writer.write(response(200, {
                "thread": summary,
                "messages": messages, "has_more": got["has_more"],
                # `turns` (2026-11-10): every member's turn in flight, earliest
                # first; `turn` is the earliest, for the clients that read one.
                "turn": engine.active.get(thread_id),
                "turns": engine.live_turns(thread_id),
                "pending_permissions": engine.pending(thread_id),
                "board": {"path": meta["board"],
                          "markdown": threads_rec.board_text(meta)}}))
            await writer.drain()
            return
        if not rest and method == "DELETE":
            # The record and its board leave the vault. The owner's explicit
            # action only: the app confirms before it sends this (2026-11-09).
            if engine.live_turns(thread_id):
                raise BrokerError(409, "a turn is running in this thread; "
                                       "delete it when the turn has finished")
            by = author(payload)
            gone = threads_rec.delete(thread_id)
            print(f"threads: deleted {thread_id}{f' by {by}' if by else ''}: "
                  f"{', '.join(gone['removed'])}",
                  file=sys.stderr, flush=True)
            engine.publish_removed(thread_id)
            writer.write(response(200, {"deleted": True, **gone}))
            await writer.drain()
            return
        if not rest and method == "PATCH":
            engines = payload.get("engine") or payload.get("engines")
            if engines is not None and not isinstance(engines, dict):
                raise BrokerError(400, "`engine` is {persona: engine}")
            models = payload.get("model") if "model" in payload else payload.get("models")
            if models is not None and not isinstance(models, dict):
                raise BrokerError(400, "`model` is {persona: model or null}")
            for key in ("add", "remove"):
                if payload.get(key) is not None and not isinstance(payload[key], list):
                    payload[key] = [payload[key]]
            for key in ("pinned", "archived"):
                if key in payload and not isinstance(payload[key], bool):
                    raise BrokerError(400, f"`{key}` is true or false")
            by = author(payload)
            who = threads_rec.display(by) if by else f"{lc.OWNER_NAME}"
            before = threads_rec.read(thread_id)[0]
            if models:
                engines_after = {**before["engines"], **(engines or {})}
                models = {p: self.thread_model(
                              p, engines_after.get(p) or threads_rec.default_engine(p), m)
                          for p, m in models.items()}
            if "draft" in payload:
                # A branch's prepared opening (2026-11-11), cleared (null or
                # "") or replaced; the page clears it once it holds its own.
                if payload["draft"] is not None and not isinstance(payload["draft"], str):
                    raise BrokerError(400, "`draft` is a string or null")
                threads_rec.read(thread_id)
                threads_rec.set_draft(thread_id, payload["draft"])
            changes = {}
            if "default" in payload:
                changes["default"] = payload["default"] or None
            if "icon" in payload:
                changes["icon"] = payload["icon"]
            threads_rec.update(thread_id, title=payload.get("title"),
                               add=payload.get("add"), remove=payload.get("remove"),
                               engines=engines, models=models,
                               pinned=payload.get("pinned"),
                               archived=payload.get("archived"), **changes)
            after = threads_rec.read(thread_id)[0]
            if after["default"] != before["default"]:
                # Said in the thread (2026-11-09). The default changes only
                # when the owner changes it, and an untagged message goes to
                # it; a change nobody can see afterwards was how a reply
                # from someone other than the header's default could not be
                # explained from the record.
                said = (f"{who} made {threads_rec.display(after['default'])} "
                        f"the default" if after["default"] else
                        f"{who} set no default: untagged messages are kept "
                        "and nobody answers them")
                line = threads_rec.append(thread_id, "system", said, kind="system")
                engine.publish(thread_id, {"type": "message.done", "message": line})
                print(f"threads: {thread_id} default {before['default']} -> "
                      f"{after['default']}{f' by {by}' if by else ''}",
                      file=sys.stderr, flush=True)
            for persona in payload.get("add") or []:
                if persona not in before["members"]:
                    line = threads_rec.append(
                        thread_id, "system",
                        f"{who} brought in {threads_rec.display(persona)}",
                        kind="system")
                    engine.publish(thread_id, {"type": "member.joined",
                                               "persona": persona,
                                               "by": by or lc.OWNER_ID})
                    engine.publish(thread_id, {"type": "message.done", "message": line})
            if by:
                # A persona's change says itself in the thread (2026-11-10),
                # the ones the page leaves no line for included: the owner knows
                # what they clicked, and nobody else's change to their thread
                # should be one he can only find by noticing it.
                for said in persona_changes(who, before, after):
                    line = threads_rec.append(thread_id, "system", said,
                                              kind="system")
                    engine.publish(thread_id, {"type": "message.done",
                                               "message": line})
                print(f"threads: {thread_id} changed by {by}: "
                      f"{sorted(k for k in payload if k != 'by')}",
                      file=sys.stderr, flush=True)
            if payload.get("seen"):
                msgs = threads_rec.read(thread_id)[1]
                if msgs:
                    threads_rec.mark_seen(thread_id, msgs[-1]["id"])
            summary = engine.summary(thread_id)
            engine.publish(thread_id, {"type": "thread.changed", "summary": summary})
            writer.write(response(200, summary))
            await writer.drain()
            return
        if rest == ["branch"] and method == "GET":
            # Branching (2026-11-11), the sheet's first read: the window a
            # branch at `?message=` carries (`threads_rec.branch_window`),
            # who it can be with (members first), the summarizer's prompt
            # for the draft and title, and a plain fallback for when the
            # summarizer fails. Reads only.
            meta, msgs, path = threads_rec.read(thread_id)
            window = threads_rec.branch_window(msgs, params.get("message") or "",
                                               thread_id)
            people = threads_rec.branch_people(meta)
            persona = params.get("persona") or meta.get("default") or (
                people[0] if people else None)
            if persona and persona not in people:
                raise BrokerError(404, f"no persona named {persona!r}")
            writer.write(response(200, {
                "thread": thread_id, "title": meta["title"],
                "message": window[-1]["id"], "record": str(path),
                "window": window, "persona": persona, "people": people,
                "summarizer": threads_rec.branch_prompt(meta, window, persona),
                "fallback": threads_rec.fallback_branch(meta, window)}))
            await writer.drain()
            return
        if rest == ["branch"] and method == "POST":
            # Start thread: the new thread, its line back, the source's line
            # under the message, the draft for its composer. `by` when a
            # persona branched (the owner's 11-10 rule: anything they can do).
            for key in ("title", "draft", "persona"):
                if payload.get(key) is not None and not isinstance(payload[key], str):
                    raise BrokerError(400, f"`{key}` is a string")
            by = author(payload)
            made = threads_rec.branch(thread_id, payload.get("message") or "",
                                      payload.get("persona") or None,
                                      title=payload.get("title"),
                                      draft=payload.get("draft"), by=by)
            new_id = made["meta"]["id"]
            print(f"threads: {new_id} branched from {thread_id} at "
                  f"{payload.get('message')} ({len(made['window'])} messages)"
                  f"{f' by {by}' if by else ''}", file=sys.stderr, flush=True)
            engine.publish_row(new_id)
            engine.publish(thread_id, {"type": "message.done", "message": made["into"]})
            engine.publish_row(thread_id)
            writer.write(response(201, {"thread": engine.summary(new_id),
                                        "from": made["from"], "into": made["into"],
                                        "window": made["window"]}))
            await writer.drain()
            return
        if rest == ["attachments"] and method == "POST":
            # The bytes into the vault, the attachment objects back, nothing
            # started (a classic chat's own upload route retired 2026-11-12).
            # The next message names them in `attachments`.
            threads_rec.read(thread_id)          # 404 for a thread nobody has
            if not content_type.split(";")[0].strip().lower() == "multipart/form-data":
                raise BrokerError(415, "send the file as multipart/form-data in a "
                                       "`file` part")
            files = [p for p in parse_multipart(content_type, raw)
                     if p["field"] in (None, "file", "files", "files[]")]
            if not files:
                raise BrokerError(400, "no `file` part in the upload")
            stored = [self._store(f, params.get("app") or "loam-ui") for f in files]
            writer.write(response(201, {"attachments": stored}))
            await writer.drain()
            return
        if rest == ["messages"] and method == "POST":
            attachments = payload.get("attachments") or []
            if not isinstance(attachments, list):
                raise BrokerError(400, "`attachments` is a list of paths")
            carried = [self._attachment(p) for p in attachments]
            model = payload.get("model")
            if model is not None:
                # Checked against every engine the turn could run on: the
                # tagged members' and the default's, known only once the
                # mentions are read, so against the thread's engines here.
                meta = threads_rec.read(thread_id)[0]
                for p in threads_rec.mentions(payload.get("text") or "") or (
                        [meta["default"]] if meta.get("default") else []):
                    self.thread_model(p, meta["engines"].get(p)
                                      or threads_rec.default_engine(p), model)
            # `reply_to` (2026-11-11): the id of the earlier message this
            # one answers; a 400 / 404 from the record when it isn't one.
            reply_to = payload.get("reply_to") or None
            msg = engine.post_person(thread_id, payload.get("text") or "",
                                     attachments=carried, model=model,
                                     reply_to=reply_to)
            writer.write(response(200, {"accepted": True, "message": msg}))
            await writer.drain()
            return
        if rest == ["posted"] and method == "POST":
            # A persona's post outside a turn (bin/thread post), told here
            # once it is in the record (0.2.1): on the stream at once, and
            # its @mentions wake members as a reply's do.
            by = str(payload.get("by") or "").strip().lower()
            mid = str(payload.get("message") or "").strip()
            if not by or not mid:
                raise BrokerError(400, "the body is {\"message\": id, \"by\": persona}")
            try:
                body = engine.posted(thread_id, mid, by)
            except threads_rec.ThreadError as exc:
                raise BrokerError(exc.status, str(exc))
            writer.write(response(200, body))
            await writer.drain()
            return
        if rest == ["board"] and method in ("GET", "PUT"):
            meta = threads_rec.read(thread_id)[0]
            if method == "PUT":
                by = author(payload)
                threads_rec.write_board(meta, payload.get("markdown"))
                if by:
                    print(f"threads: {thread_id} board written by {by}",
                          file=sys.stderr, flush=True)
            markdown = threads_rec.board_text(meta)
            if method == "PUT":
                engine.publish(thread_id, {"type": "board.changed",
                                           "board_new": threads_rec.board_new(markdown)})
            writer.write(response(200, {"path": meta["board"], "markdown": markdown,
                                        "board_new": threads_rec.board_new(markdown)}))
            await writer.drain()
            return
        if rest == ["steps"] and method == "GET":
            # The full record (2026-11-10): every step of every reply, for
            # one message (`?message=m4`) or the whole thread.
            threads_rec.read(thread_id)          # 404 for a thread that isn't
            entries = thread_steps.read(thread_id, params.get("message") or None)
            if params.get("message") and not entries:
                raise BrokerError(404, f"no full record for {params['message']}")
            writer.write(response(200, {"thread": thread_id,
                                        "steps": list(entries.values())}))
            await writer.drain()
            return
        if rest == ["events"] and method == "GET":
            await self.thread_stream(thread_id, params.get("after"), writer,
                                     full=params.get("steps") == "full")
            return
        raise BrokerError(405, f"no route for {method} /v1/threads/" + "/".join(tail))

    async def thread_list_stream(self, writer: asyncio.StreamWriter,
                                 archived: bool = False) -> None:
        """The thread list, live (2026-11-09): ``threads.snapshot`` with the
        rows and the agents, then ``thread.changed {summary}`` whenever a
        row moves and ``thread.removed {thread}`` when one is deleted. The
        engine pushes what it does; a post by ``bin/thread`` or an edit in
        Obsidian is seen by stat-ing the records every two seconds, as a
        thread's own stream does. An archived row is sent like any other,
        with ``archived: true``, so a list can drop it."""
        engine = self.threads
        queue = engine.listen_list()
        self._open_stream(writer)

        def stamps() -> dict:
            out = {}
            for tid, name in threads_rec.index().items():
                try:
                    st = (threads_rec.VAULT / threads_rec.CONVERSATIONS / name).stat()
                    out[tid] = (st.st_mtime_ns, st.st_size)
                except OSError:
                    continue
            return out

        try:
            threads_rec.ensure_general()
            seen = stamps()
            quiet = 0.0
            await self._send_event(writer, {
                "type": "threads.snapshot",
                "threads": engine.listing(archived=archived),
                "agents": cfg.roster_cards()})
            while True:
                try:
                    async with asyncio.timeout(2):
                        event = await queue.get()
                except TimeoutError:
                    event = None
                if event is not None:
                    quiet = 0.0
                    await self._send_event(writer, event)
                    continue
                quiet += 2
                now = stamps()
                for tid in now:
                    if now[tid] != seen.get(tid):
                        try:
                            await self._send_event(writer, {
                                "type": "thread.changed", "thread": tid,
                                "summary": engine.summary(tid)})
                        except threads_rec.ThreadError:
                            pass
                for tid in set(seen) - set(now):
                    await self._send_event(writer, {"type": "thread.removed",
                                                    "thread": tid})
                seen = now
                if quiet >= KEEPALIVE_S:
                    quiet = 0.0
                    await self._ping(writer)
        except (ConnectionResetError, BrokenPipeError):
            pass
        finally:
            engine.unlisten_list(queue)

    async def thread_stream(self, thread_id: str, after: str | None,
                            writer: asyncio.StreamWriter, full: bool = False) -> None:
        """A thread's live events. The engine publishes its own; a post made
        by ``bin/thread`` (an agent's wake) and an edit of the board in
        Obsidian are seen by watching the two files, every two seconds."""
        meta, msgs, path = threads_rec.read(thread_id)
        board = threads_rec.VAULT / meta["board"]
        sent = threads_rec._num(after) if after else (
            threads_rec._num(msgs[-1]["id"]) if msgs else 0)

        def stamp(p: Path):
            try:
                st = p.stat()
                return (st.st_mtime_ns, st.st_size)
            except OSError:
                return None

        record_at, board_at = stamp(path), stamp(board)
        queue = self.threads.listen(thread_id)
        self._open_stream(writer)
        try:
            async def send(event: dict) -> None:
                if full and event.get("type") == "message.done":
                    event = {**event, "message": with_steps(
                        thread_id, [event["message"]])[0]}
                await self._send_event(writer, event)

            await self._send_event(writer, {"type": "thread.snapshot",
                                            "thread": thread_id,
                                            "turn": self.threads.active.get(thread_id),
                                            "turns": self.threads.live_turns(thread_id),
                                            "pending": self.threads.pending(thread_id),
                                            "members": self.threads.summary(
                                                thread_id)["members"]})
            if after:
                for m in msgs:
                    if threads_rec._num(m.get("id")) > threads_rec._num(after):
                        await send({"type": "message.done",
                                    "thread": thread_id, "message": m})
            quiet = 0.0
            while True:
                try:
                    async with asyncio.timeout(2):
                        event = await queue.get()
                except TimeoutError:
                    event = None
                if event is not None:
                    quiet = 0.0
                    if event.get("type") == "message.done":
                        n = threads_rec._num(event["message"].get("id"))
                        if n <= sent:
                            continue
                        sent = n
                    await send(event)
                    continue
                quiet += 2
                now_record, now_board = stamp(path), stamp(board)
                if now_record != record_at:
                    record_at = now_record
                    try:
                        meta, fresh, path = threads_rec.read(thread_id)
                    except threads_rec.ThreadError:
                        return
                    # A rename moves the board with the record (2026-11-10);
                    # watch it where it went, not where it was.
                    board = threads_rec.VAULT / meta["board"]
                    for m in fresh:
                        if threads_rec._num(m.get("id")) > sent:
                            sent = threads_rec._num(m["id"])
                            await send({
                                "type": "message.done", "thread": thread_id,
                                "message": m})
                if now_board != board_at:
                    board_at = now_board
                    try:
                        text = board.read_text("utf-8")
                    except OSError:
                        text = ""
                    await self._send_event(writer, {
                        "type": "board.changed", "thread": thread_id,
                        "board_new": threads_rec.board_new(text)})
                if quiet >= KEEPALIVE_S:
                    quiet = 0.0
                    await self._ping(writer)
        except (ConnectionResetError, BrokenPipeError):
            pass
        finally:
            self.threads.unlisten(thread_id, queue)

    async def github(self, method: str, tail: list[str], params: dict,
                     payload: dict, writer: asyncio.StreamWriter) -> None:
        """GitHub as a GitHub App (2026-09-30). The whole flow and its store
        are lib/loam_github_app.py; these routes only dispatch, each GitHub
        call on a worker thread so a slow GitHub never parks the loop. See
        broker/README.md, "GitHub"."""
        def text(name: str) -> str | None:
            value = payload.get(name)
            return value.strip() if isinstance(value, str) and value.strip() else None

        calls = {
            ("GET", ()): lambda: github_app.public_view(),
            # `org` (2026-10-06), in the query or the body: that
            # organization's app alone; without it, everything, as before.
            ("DELETE", ()): lambda: github_app.forget(
                text("org") or (params.get("org") or "").strip() or None),
            # `org` (2026-10-06): an app owned by that organization, which
            # answers for its repositories alone; see the module.
            ("POST", ("manifest",)): lambda: github_app.start_manifest(
                text("name"), text("org")),
            ("POST", ("register",)): lambda: github_app.register(
                text("code") or "", text("state") or ""),
            ("POST", ("install",)): lambda: github_app.start_install(text("org")),
            ("POST", ("callback",)): lambda: github_app.callback(
                text("code"), payload.get("installation_id"),
                text("setup_action"), text("state")),
            ("POST", ("refresh",)): lambda: github_app.check(force_refresh=True),
            ("POST", ("token",)): lambda: github_app.installation_token(
                text("repository")),
            # A pull-request project's landing (2026-10-06): the job cannot
            # push, so the broker pushes its job/<id> branch and opens the PR.
            ("POST", ("pull-request",)): lambda: github_app.open_pull_request(
                text("project") or "", text("branch") or "",
                text("title") or "", payload.get("body") if isinstance(
                    payload.get("body"), str) else ""),
            # A job whose brief names the pull request it updates
            # (2026-10-09): fast-forward that PR's head, then post the reply.
            ("POST", ("pull-request-update",)): lambda: github_app.update_pull_request(
                text("project") or "", text("branch") or "", payload.get("number"),
                payload.get("reply") if isinstance(payload.get("reply"), str) else ""),
        }
        # One account at a time (2026-11-13): the list, refresh one,
        # disconnect one, add another. lib/loam_github_app.py, "Accounts".
        if tail[:1] == ["accounts"]:
            from urllib.parse import unquote  # noqa: PLC0415
            rest = [unquote(t) for t in tail[1:]]
            if method == "GET" and not rest:
                calls[(method, tuple(tail))] = github_app.accounts
            elif method == "POST" and not rest:
                calls[(method, tuple(tail))] = lambda: github_app.add_account(
                    text("org"), payload.get("own_app") is True)
            elif method == "POST" and len(rest) == 2 and rest[1] == "refresh":
                calls[(method, tuple(tail))] = lambda: github_app.check_account(rest[0])
            elif method == "DELETE" and len(rest) == 1:
                calls[(method, tuple(tail))] = lambda: github_app.forget_account(rest[0])
        call = calls.get((method, tuple(tail)))
        if call is None:
            raise BrokerError(405, f"no route for {method} /v1/integrations/github"
                                   + "".join("/" + t for t in tail))
        try:
            out = await asyncio.to_thread(call)
        except github_app.IntegrationError as exc:
            raise BrokerError(exc.status, str(exc)) from None
        writer.write(response(200, out, "Cache-Control: no-store\r\n"))
        await writer.drain()

    async def activity_route(self, method: str, tail: list[str], params: dict,
                             payload: dict, writer: asyncio.StreamWriter) -> None:
        """Schedules and Activity (2026-10-14). Every write is
        loam_schedule.change() as the owner on lane `app`, inside
        lib/loam_activity.py; a refusal is that path's own sentence, as a
        400 (a 404 when the thing named is not there). Each call on a worker
        thread: a write reconciles timers, a read asks the user manager."""
        def q(name: str) -> str | None:
            from urllib.parse import unquote_plus  # noqa: PLC0415
            return unquote_plus(params[name]) if params.get(name) else None

        def number(name: str, default: int) -> int:
            try:
                return int(params.get(name) or default)
            except ValueError:
                raise BrokerError(400, f"`{name}` is a number") from None

        def seen() -> dict:
            ids = ([i["id"] for i in activity.items() if not i["seen"]]
                   if payload.get("all") is True else
                   [i for i in payload.get("ids") or [] if isinstance(i, str)])
            return {"marked": activity.mark_seen(ids), "unread": activity.unread()}

        # `*` is one path segment, handed to the call in order.
        calls = {
            ("GET", "schedules"): lambda: {
                "schedules": activity.schedules(q("agent")),
                "unread": activity.unread()},
            ("GET", "schedules", "*"): lambda a: {
                "schedules": activity.schedules(a), "unread": activity.unread()},
            ("POST", "schedules", "*"): lambda a: activity.create(a, payload),
            ("GET", "schedules", "*", "*"): activity.schedule,
            ("PATCH", "schedules", "*", "*"): lambda a, n: activity.edit(a, n, payload),
            ("DELETE", "schedules", "*", "*"): lambda a, n: activity.delete(a, n, payload),
            ("POST", "schedules", "*", "*", "run"): lambda a, n: activity.run_now(
                a, n, payload),
            ("POST", "schedules", "*", "*", "seen"): activity.seen_schedule,
            ("GET", "activity"): lambda: activity.activity(
                q("agent"), q("kind"), number("limit", 50), number("offset", 0)),
            ("POST", "activity", "seen"): seen,
            ("POST", "activity", "*", "undo"): lambda e: activity.undo(e, payload),
            ("POST", "jobs", "*", "cancel"): lambda j: {
                "job": j, "said": activity.cancel_job(j)},
        }
        for (verb, *pattern), call in calls.items():
            if verb == method and len(pattern) == len(tail) and all(
                    p in ("*", t) for p, t in zip(pattern, tail)):
                args = [t for p, t in zip(pattern, tail) if p == "*"]
                break
        else:
            raise BrokerError(405, f"no route for {method} /v1/" + "/".join(tail))
        try:
            out = await asyncio.to_thread(call, *args)
        except activity.NotFound as exc:
            raise BrokerError(404, str(exc)) from None
        except loam_schedule.Refused as exc:
            raise BrokerError(400, str(exc)) from None
        writer.write(response(200, out, "Cache-Control: no-store\r\n"))
        await writer.drain()

    def _session(self, session_id: str) -> Session:
        session = self.broker.sessions.get(session_id)
        if session is None:
            raise BrokerError(404, f"no session {session_id}")
        return session

    def _store(self, part: dict, app: str) -> dict:
        """One uploaded part, written down, as the answer describes it.

        The name is sanitised before it is a path and the type is read off the
        extension, not off what the browser claimed: the browser's guess is
        whatever the person's operating system said, and on a phone it is often
        nothing. A type this interface does not carry is refused BEFORE
        anything is written, so a refusal leaves no file behind.

        The write is the broker's own, as the user that owns the vault. The
        boundary guard does not see it and could not: the guard is a hook on
        the CLI's tools (`hooks/boundary-guard.py`, PreToolUse), and this is a
        Python process writing a file, not an agent calling Write. What keeps
        it inside the lines is this method -- one directory, a sanitised name,
        an allow-list of types -- and it is stated in broker/README.md so
        nobody reads the guard as covering it.
        """
        name = cfg.sanitise_name(part["filename"])
        media_type = cfg.attachment_type(name)
        if media_type is None:
            ext = name.rpartition(".")[2] if "." in name else ""
            raise BrokerError(415, (
                f"this interface does not carry .{ext} files"
                if ext else "a file needs a name with an extension"))
        data = part["bytes"]
        if len(data) > cfg.ATTACHMENT_MAX_BYTES:
            raise BrokerError(
                413, f"{name} is bigger than this interface carries "
                     f"({human_size(cfg.ATTACHMENT_MAX_BYTES)} at most)")
        directory = cfg.attachment_dir(app)
        directory.mkdir(parents=True, exist_ok=True)
        target = cfg.free_path(directory, name)
        target.write_bytes(data)
        return {"path": str(target), "name": target.name,
                "size": len(data), "type": media_type}

    async def files_route(self, method: str, tail: list[str], params: dict,
                          payload: dict, writer: asyncio.StreamWriter,
                          raw: bytes = b"", content_type: str = "") -> None:
        """``/v1/files/...`` -- see broker/README.md, "Files"."""
        from urllib.parse import unquote_plus
        q = {k: unquote_plus(v) for k, v in params.items()}
        nocache = "Cache-Control: no-store\r\n"
        reads = {"roots": lambda: files_api.roots(),
                 "list": lambda: files_api.listing(q.get("root", ""), q.get("path"),
                                               q.get("cursor"), q.get("limit")),
                 "stat": lambda: files_api.stat_resource(q.get("root", ""),
                                                     q.get("path")),
                 "read": lambda: files_api.read_text(q.get("root", ""), q.get("path")),
                 "resolve": lambda: files_api.resolve(q.get("ref"), q.get("from_root"),
                                                  q.get("from_path"))}
        writes = {("text", "PUT"): (200, files_api.save_text),
                  ("file", "POST"): (201, files_api.create_file),
                  ("folder", "POST"): (201, files_api.create_folder),
                  ("rename", "POST"): (200, files_api.rename)}
        try:
            if len(tail) == 1 and method == "GET" and tail[0] in reads:
                body = await asyncio.to_thread(reads[tail[0]])
                writer.write(response(200, body, nocache))
            elif len(tail) == 1 and (tail[0], method) in writes:
                status, act = writes[(tail[0], method)]
                body = await asyncio.to_thread(act, payload)
                writer.write(response(status, body, nocache))
            elif tail == ["upload"] and method == "POST":
                # The one Files body that is not JSON: one `file` part, the
                # target folder in the query. The cap was enforced before the
                # body was kept (`_handle`); parse_multipart never decodes it.
                if content_type.split(";")[0].strip().lower() != (
                        "multipart/form-data"):
                    raise files_api.FilesError(
                        415, "send the file as multipart/form-data in one "
                             "`file` part")
                found = [p for p in parse_multipart(content_type, raw)
                         if p["field"] in (None, "file")]
                if len(found) != 1:
                    raise files_api.FilesError(
                        400, "an upload is one `file` part; send each file "
                             "on its own request")
                body = await asyncio.to_thread(
                    files_api.upload, q.get("root", ""), q.get("path"), found[0])
                writer.write(response(201, body, nocache))
            elif tail == ["download"] and method == "GET":
                fd, size, headers = await asyncio.to_thread(
                    files_api.download, q.get("root", ""), q.get("path"))
                try:
                    head = "".join(f"{k}: {v}\r\n" for k, v in headers.items())
                    writer.write((f"HTTP/1.1 200 OK\r\nContent-Length: {size}\r\n"
                                  f"Connection: close\r\n{head}\r\n").encode())
                    sent = 0
                    while sent < size:
                        chunk = os.read(fd, min(files_api.CHUNK, size - sent))
                        if not chunk:
                            break     # shrank while sent; the length is the lie
                        writer.write(chunk)
                        sent += len(chunk)
                        await writer.drain()
                finally:
                    os.close(fd)
            else:
                raise BrokerError(405, f"no route for {method} /v1/files/"
                                       f"{'/'.join(tail)}")
        except files_api.FilesError as exc:
            writer.write(response(exc.status, exc.body(), nocache))
        await writer.drain()

    # -- Agent profiles, engineers, the reviewer (2026-11-13) -----------------

    def say_in_general(self, text: str) -> None:
        """A persona's change of a setting that belongs to no thread, said in
        General, as a persona's change of a thread is said in that thread
        (2026-11-10). The owner's own clicks say nothing: they know what they
        clicked. A General that cannot be written is the journal's line only."""
        try:
            threads_rec.ensure_general()
            line = threads_rec.append(threads_rec.GENERAL_ID, "system", text,
                                      kind="system")
            self.threads.publish(threads_rec.GENERAL_ID,
                                 {"type": "message.done", "message": line})
        except Exception as exc:  # noqa: BLE001 -- the change stands
            print(f"profile: could not say in General ({exc}): {text}",
                  file=sys.stderr, flush=True)

    def profile_check(self, provider: str, field: str, value):
        """A model or a thinking level as ``provider`` takes it, by the
        checks a thread and a chat use (``thread_model``, ``choices``)."""
        if field == "model":
            return self.thread_model("", provider, value)
        if provider == "antigravity":
            if value not in agy.EFFORTS:
                raise BrokerError(400, f"effort {value!r} is not an Antigravity "
                                       f"level: {', '.join(agy.EFFORTS)}.")
            return value
        return choices({"effort": value}, provider).get("effort")

    def agent_status(self, agent: str, box: dict | None, next_wake) -> dict:
        """What the agent is doing now: its turns in flight by thread, the
        engineer jobs it briefed that are running or queued, a wake or cron of
        its running, and when its next wake is."""
        threads = []
        for (tid, persona), turn in list(self.threads.turns.items()):
            if persona != agent:
                continue
            try:
                title = threads_rec.read(tid)[0].get("title")
            except Exception:  # noqa: BLE001 -- a thread gone mid-read
                title = None
            threads.append({"thread": tid, "title": title,
                            "since": turn.get("started_at")})
        slots = (box or {}).get("slots") or []
        # The jobs it briefed, by the one job-state reader (loam_activity
        # job_rows, broker/README.md "A thread's engineer jobs").
        try:
            rows = activity.job_rows(live=box) if box is not None else []
        except Exception:  # noqa: BLE001 -- no reading is no jobs, said by box_read
            rows = []
        keep = ("job", "title", "project", "thread", "state", "phase", "since")
        mine = [r for r in rows if r.get("briefed_by") == agent
                and r.get("state") != "finished"]
        jobs = [{k: r.get(k) for k in keep} for r in mine if r.get("state") != "queued"]
        queued = [{k: r.get(k) for k in keep} for r in mine if r.get("state") == "queued"]
        run = next(({"lane": s.get("lane"), "name": s.get("name"),
                     "since": s.get("since")}
                    for s in slots if s.get("kind") == "wake"
                    and s.get("agent") == agent), None)
        return {"threads": threads, "jobs": jobs, "queued": queued, "run": run,
                "next_wake": next_wake, "box_read": box is not None}

    def profile(self, agent: str) -> dict:
        """``GET /v1/agents/<agent>``: everything the profile page draws."""
        config = loam_profile.read_agent(agent)
        try:
            schedule = loam_profile.schedule(agent)
        except Exception as exc:  # noqa: BLE001 -- the rest of the page stands
            schedule, schedule_error = [], str(exc)
        else:
            schedule_error = None
        try:
            box = activity.live_jobs()
        except Exception:  # noqa: BLE001 -- no launcher reading is no jobs, said
            box = None
        wake = next((r for r in schedule if r.get("kind") == "reflection"), None)
        try:
            plugins = loam_plugins.profile_rows(agent)
        except Exception:  # noqa: BLE001
            plugins = []
        return {
            "agent": cfg.agent_card(agent),
            "identity": loam_profile.identity(agent, config),
            "defaults": loam_profile.defaults(agent, config, loam_profile.WAKE_MODEL_DEFAULT,
                                              cfg.persona_model),
            "files": loam_profile.files(agent),
            "schedule": schedule,
            **({"schedule_error": schedule_error} if schedule_error else {}),
            "status": self.agent_status(agent, box,
                                        wake.get("next_fire") if wake else None),
            "plugins": plugins,
        }

    def agent_busy(self, agent: str) -> str | None:
        """What an agent is in the middle of, for an archive to wait on:
        a thread turn (the engine's) or a wake or cron (its run marker)."""
        threads_now = sorted({tid for (tid, p) in self.threads.turns if p == agent})
        if threads_now:
            return f"mid-turn in {', '.join(threads_now)}"
        if (loam_schedule.WAKE_STATE / f"{agent}.running").exists():
            return "in a wake or cron run"
        return None

    def agents_line(self, thread_id: str | None, text: str) -> None:
        if not thread_id:
            return
        try:
            self.threads.system_line(thread_id, text)
        except Exception as exc:  # noqa: BLE001 -- the change stands
            print(f"agents: could not write in {thread_id} ({exc}): {text}",
                  file=sys.stderr, flush=True)

    async def agents_route(self, method: str, tail: list[str], params: dict,
                           payload: dict, writer: asyncio.StreamWriter,
                           raw: bytes = b"", content_type: str = "") -> None:
        """New agent, drafts, confirm, archive, restore and the face
        (lib/loam_agents.py; broker/README.md, "Making, archiving and
        restoring agents")."""
        from urllib.parse import unquote  # noqa: PLC0415
        tail = [unquote(p) for p in tail]
        nocache = "Cache-Control: no-store\r\n"
        say = threads_rec.display
        status = 200
        try:
            by = author(payload) if method != "GET" else None
            if tail == ["new"] and method == "POST":
                # Settings › Agents › New agent: a thread with the starter
                # agent, not a form. The person writes first.
                starter = loam_agents.STARTER
                if starter not in cfg.roster():
                    raise BrokerError(409, f"{starter}, who makes new agents, is not "
                                           f"awake on this box; ask any agent instead")
                meta = threads_rec.create(starter, "New agent")
                self.agents_line(meta["id"], (
                    f"New agent. Tell {say(starter)} who you'd like: "
                    f"{say(starter)} drafts their name, face, soul and config, "
                    f"shows you, changes it on your word, and makes them only "
                    f"when you say yes. ({say(starter)}: `settings describe "
                    f"agent.draft` says how; this thread is `{meta['id']}`.)"))
                if by:
                    self.agents_line(meta["id"], f"{say(by)} started this thread")
                self.threads.publish_row(meta["id"])
                body, status = self.threads.summary(meta["id"]), 201
            elif tail == ["drafts"] and method == "GET":
                body = {"drafts": await asyncio.to_thread(
                    loam_agents.drafts, params.get("thread") or None)}
            elif tail == ["drafts"] and method == "POST":
                body = await asyncio.to_thread(loam_agents.new_draft, payload, by)
                status = 201
                self.agents_line(body.get("thread"), (
                    f"{say(by) if by else lc.OWNER_NAME} drafted a new agent: "
                    f"{body.get('name') or '(no name yet)'} "
                    f"(draft {body['draft']}, revision {body['rev']})"))
            elif len(tail) == 2 and tail[0] == "drafts":
                if method == "GET":
                    body = await asyncio.to_thread(
                        lambda: loam_agents.shown(loam_agents.read_draft(tail[1])))
                elif method == "PATCH":
                    body = await asyncio.to_thread(loam_agents.revise, tail[1], payload, by)
                    self.agents_line(body.get("thread"), (
                        f"{say(by) if by else lc.OWNER_NAME} revised draft "
                        f"{body['draft']}: "
                        f"{body.get('name') or ''}, revision {body['rev']} "
                        f"({', '.join(body['revisions'][-1]['fields'])})"))
                elif method == "DELETE":
                    body = await asyncio.to_thread(loam_agents.discard, tail[1], by)
                    self.agents_line(body.get("thread"), (
                        f"{say(by) if by else lc.OWNER_NAME} set draft "
                        f"{body['draft']} aside"))
                else:
                    raise BrokerError(405, "GET, PATCH or DELETE a draft")
            elif len(tail) == 3 and tail[0] == "drafts" and tail[2] == "confirm" \
                    and method == "POST":
                made = await asyncio.to_thread(loam_agents.confirm, tail[1], payload, by)
                agent = made["agent"]
                first = threads_rec.create(agent)
                yes = made["draft"].get("yes")
                self.agents_line(first["id"], (
                    f"{say(agent)} was made"
                    + (f" by {say(by)} on {lc.OWNER_NAME}'s yes ({yes['message']} "
                       f"in {yes['thread']})" if yes else f" by {lc.OWNER_NAME}")
                    + ". This is their first thread."))
                self.threads.publish_row(first["id"])
                self.agents_line(made["draft"].get("thread"), (
                    f"Made {say(agent)} ({agent}): their first thread is "
                    f"{first['id']}"))
                print(f"agents: made {agent} from {tail[1]} by {by or lc.OWNER_ID}",
                      file=sys.stderr, flush=True)
                body = {**made, "agent": cfg.agent_card(agent),
                        "first_thread": first["id"]}
                body.pop("provision", None)
                status = 201
            elif len(tail) == 2 and tail[1] == "archive" and method == "POST":
                agent = tail[0]
                body = await asyncio.to_thread(loam_agents.archive, agent, payload, by,
                                               busy=self.agent_busy)
                print(f"agents: archived {agent} by {by or lc.OWNER_ID}",
                      file=sys.stderr, flush=True)
                if by:
                    self.say_in_general(f"{say(by)} archived {say(agent)} on "
                                        f"{lc.OWNER_NAME}'s yes")
            elif len(tail) == 2 and tail[1] == "restore" and method == "POST":
                agent = tail[0]
                body = await asyncio.to_thread(loam_agents.restore, agent, payload, by)
                print(f"agents: restored {agent} by {by or lc.OWNER_ID}",
                      file=sys.stderr, flush=True)
                if by:
                    self.say_in_general(f"{say(by)} restored {say(agent)} on "
                                        f"{lc.OWNER_NAME}'s yes")
            elif len(tail) == 2 and tail[1] == "face":
                agent = tail[0]
                if method == "GET":
                    data, ctype = await asyncio.to_thread(loam_agents.face_bytes, agent)
                    head = (f"HTTP/1.1 200 OK\r\nContent-Type: {ctype}\r\n"
                            f"Content-Length: {len(data)}\r\n"
                            f"Cache-Control: private, max-age=31536000, immutable\r\n"
                            f"Connection: close\r\n\r\n").encode()
                    writer.write(head + data)
                    await writer.drain()
                    return
                if method == "PUT":
                    if content_type.split(";")[0].strip().lower() == "multipart/form-data":
                        files = [p for p in parse_multipart(content_type, raw)
                                 if p["field"] in (None, "file")]
                        if not files:
                            raise BrokerError(400, "no `file` part in the upload")
                        body = await asyncio.to_thread(loam_agents.set_face, agent,
                                                       files[0]["bytes"], None)
                    else:
                        body = await asyncio.to_thread(loam_agents.face_from_payload,
                                                       agent, payload, by)
                elif method == "DELETE":
                    body = await asyncio.to_thread(loam_agents.set_face, agent, None, by)
                else:
                    raise BrokerError(405, "GET, PUT or DELETE an agent's face")
                print(f"agents: {agent}'s face {'set' if body.get('face') else 'removed'} "
                      f"by {by or lc.OWNER_ID}", file=sys.stderr, flush=True)
                if by:
                    self.say_in_general(
                        f"{say(by)} {'changed' if body.get('face') else 'removed'} "
                        f"{say(agent)}'s face")
            else:
                raise BrokerError(405, f"no route for {method} /v1/agents/"
                                       + "/".join(tail))
        except loam_agents.AgentsError as exc:
            writer.write(response(exc.status, {"error": exc.message, **exc.detail},
                                  nocache))
            await writer.drain()
            return
        except loam_profile.ProfileError as exc:
            writer.write(response(exc.status, {"error": exc.message}, nocache))
            await writer.drain()
            return
        writer.write(response(status, body, nocache))
        await writer.drain()

    def running_by_project(self) -> dict:
        try:
            box = activity.live_jobs()
        except Exception:  # noqa: BLE001
            return {}
        out: dict = {}
        for s in box.get("slots") or []:
            if s.get("kind") == "engineer job" and s.get("project"):
                out[s["project"]] = out.get(s["project"], 0) + 1
        return out

    async def profile_route(self, method: str, tail: list[str], payload: dict,
                            writer: asyncio.StreamWriter) -> None:
        nocache = "Cache-Control: no-store\r\n"
        from urllib.parse import unquote  # noqa: PLC0415
        tail = [unquote(p) for p in tail]
        try:
            if tail[0] == "agents":
                agent = tail[1]
                if method == "GET":
                    body = await asyncio.to_thread(self.profile, agent)
                elif method == "PATCH":
                    by = author(payload)
                    before = await asyncio.to_thread(loam_profile.read_agent, agent)
                    after = await asyncio.to_thread(
                        loam_profile.update_agent, agent, payload, self.profile_check)
                    changed = [k for k in loam_profile.SETTABLE
                               if before.get(k) != after.get(k)]
                    print(f"profile: {agent} {changed or 'unchanged'} by "
                          f"{by or lc.OWNER_ID}", file=sys.stderr, flush=True)
                    if by and changed:
                        words = ", ".join(
                            f"{k} to {after.get(k)}" if after.get(k) is not None
                            else f"{k} back to its default" for k in changed)
                        self.say_in_general(
                            f"{threads_rec.display(by)} changed "
                            f"{threads_rec.display(agent)}'s {words}")
                    body = await asyncio.to_thread(self.profile, agent)
                else:
                    raise BrokerError(405, "use GET or PATCH for an agent's profile")
            elif tail[0] == "engineers":
                if len(tail) == 1 and method == "GET":
                    running = await asyncio.to_thread(self.running_by_project)
                    body = await asyncio.to_thread(loam_profile.engineers, running)
                elif len(tail) == 2 and method == "GET":
                    running = await asyncio.to_thread(self.running_by_project)
                    body = await asyncio.to_thread(loam_profile.engineer, tail[1],
                                                   running)
                elif len(tail) == 2 and method == "PATCH":
                    by = author(payload)
                    name = tail[1]
                    await asyncio.to_thread(loam_profile.update_engineer, name,
                                            payload, self.profile_check)
                    fields = sorted(k for k in payload if k != "by")
                    print(f"profile: engineer {name} {fields} by {by or lc.OWNER_ID}",
                          file=sys.stderr, flush=True)
                    if by:
                        words = ", ".join(
                            loam_profile.tier_words(payload[k]) if k == "tiers"
                            else f"{k} to {payload[k]}" if payload[k] is not None
                            else f"{k} back to its default" for k in fields)
                        self.say_in_general(
                            f"{threads_rec.display(by)} changed the "
                            f"{'default engineer' if name == 'default' else name + ' engineer'}"
                            f"'s {words}")
                    running = await asyncio.to_thread(self.running_by_project)
                    body = await asyncio.to_thread(loam_profile.engineers, running)
                else:
                    raise BrokerError(405, "GET /v1/engineers, GET or PATCH "
                                           "/v1/engineers/<project or default>")
            else:
                if method == "GET":
                    body = await asyncio.to_thread(loam_profile.reviewer)
                elif method == "PATCH":
                    by = author(payload)
                    body = await asyncio.to_thread(loam_profile.update_reviewer,
                                                   payload, self.profile_check)
                    fields = sorted(k for k in payload if k != "by")
                    print(f"profile: reviewer {fields} by {by or lc.OWNER_ID}",
                          file=sys.stderr, flush=True)
                    if by:
                        words = ", ".join(f"{k} to {payload[k]}" if payload[k] is not None
                                          else f"{k} back to its default" for k in fields)
                        self.say_in_general(f"{threads_rec.display(by)} changed the "
                                            f"nightly reviewer's {words}")
                else:
                    raise BrokerError(405, "use GET or PATCH for the reviewer")
            writer.write(response(200, body, nocache))
        except loam_profile.ProfileError as exc:
            writer.write(response(exc.status, {"error": exc.message}, nocache))
        except BrokerError as exc:
            writer.write(response(exc.status, {"error": exc.message}, nocache))
        await writer.drain()

    async def update_route(self, method: str, tail: list[str], payload: dict,
                           writer: asyncio.StreamWriter) -> None:
        """``GET /v1/update`` the state (and ``/progress``, the run alone);
        ``POST /v1/update/check``; ``POST /v1/update/apply`` ``{"to",
        "accept_library_edits"}`` and ``POST /v1/update/rollback``, each
        answered 202 with the run started as its own unit, or 409 with the
        refusal. docs/update.md."""
        nocache = "Cache-Control: no-store\r\n"
        routes = {((), "GET"), (("progress",), "GET"), (("check",), "POST"),
                  (("apply",), "POST"), (("rollback",), "POST")}
        key = (tuple(tail), method)
        if key not in routes:
            known = any(tuple(tail) == r[0] for r in routes)
            writer.write(response(405 if known else 404, {"error": (
                f"use {' or '.join(sorted(m for t, m in routes if t == tuple(tail)))} here"
                if known else "no such update route")}, nocache))
            await writer.drain()
            return
        try:
            if key == ((), "GET"):
                body, status = await asyncio.to_thread(loam_update.status), 200
            elif key == (("progress",), "GET"):
                body = (await asyncio.to_thread(loam_update.status)).get("run") or {}
                status = 200
            elif key == (("check",), "POST"):
                body, status = await asyncio.to_thread(loam_update.check), 200
            else:
                to = payload.get("to")
                if to is not None and not isinstance(to, str):
                    writer.write(response(400, {"error": "`to` is a version, like "
                                                         "\"1.2.0\""}, nocache))
                    await writer.drain()
                    return
                by = author(payload)
                run = await asyncio.to_thread(
                    loam_update.start, tail[0], to if tail[0] == "apply" else None,
                    payload.get("accept_library_edits") is True, by)
                print(f"update: {tail[0]} started ({run.get('id')}) by "
                      f"{by or lc.OWNER_ID}", file=sys.stderr, flush=True)
                body, status = {"run": run}, 202
        except loam_update.Refusal as r:
            body, status = {"error": r.message, "refusal": r.as_dict()}, 409
        except RuntimeError as exc:
            body, status = {"error": f"the update could not start: {exc}"}, 503
        writer.write(response(status, body, nocache))
        await writer.drain()

    async def plugins_route(self, method: str, tail: list[str], payload: dict,
                            writer: asyncio.StreamWriter) -> None:
        """``/v1/plugins``: GET the list, POST an install (a preview, then a
        confirm); ``/v1/plugins/<id>``: GET one, PATCH ``{"on"}``, DELETE;
        ``/v1/plugins/<id>/files/<path>``: a page, asset or theme file."""
        nocache = "Cache-Control: no-store\r\n"
        from urllib.parse import unquote  # noqa: PLC0415
        tail = [unquote(p) for p in tail]
        try:
            if not tail:
                if method == "GET":
                    body = await asyncio.to_thread(loam_plugins.listing)
                elif method == "POST":
                    by = author(payload)
                    body = await asyncio.to_thread(
                        loam_plugins.install,
                        {k: v for k, v in payload.items() if k != "by"}, by)
                    print(f"plugins: install {payload.get('url') or payload.get('repo')}"
                          f"{' confirmed' if payload.get('confirm') else ' (preview)'}"
                          f"{' -> ' + body['id'] if body.get('installed') else ''} by "
                          f"{by or lc.OWNER_ID}", file=sys.stderr, flush=True)
                else:
                    raise BrokerError(405, "use GET for the list, POST to install")
                writer.write(response(200, body, nocache))
            elif len(tail) == 1:
                pid = tail[0]
                if method == "GET":
                    body = await asyncio.to_thread(loam_plugins.one, pid)
                elif method == "PATCH":
                    by = author(payload)
                    fields = {k: v for k, v in payload.items() if k != "by"}
                    if set(fields) != {"on"}:
                        raise BrokerError(400, "a plugin's one setting is `on`: "
                                               "{\"on\": true}")
                    body = await asyncio.to_thread(loam_plugins.set_on, pid,
                                                   fields["on"], by)
                    print(f"plugins: {pid} on={fields['on']} by {by or lc.OWNER_ID}",
                          file=sys.stderr, flush=True)
                elif method == "DELETE":
                    by = author(payload)
                    body = await asyncio.to_thread(loam_plugins.remove, pid, by)
                    print(f"plugins: removed {pid} by {by or lc.OWNER_ID}",
                          file=sys.stderr, flush=True)
                else:
                    raise BrokerError(405, "use GET, PATCH or DELETE for a plugin")
                writer.write(response(200, body, nocache))
            elif tail[1:] == ["restart"]:
                # A server plugin's restart (2026-11-13): that plugin's own
                # unit, fresh; lib/loam_plugin_servers.py. Never the broker.
                if method != "POST":
                    raise BrokerError(405, "restart a plugin's server with POST")
                by = author(payload)
                body = await asyncio.to_thread(loam_plugins.restart_server,
                                               tail[0], by)
                print(f"plugins: restarted {tail[0]}'s server by {by or lc.OWNER_ID}",
                      file=sys.stderr, flush=True)
                writer.write(response(200, body, nocache))
            elif tail[1:2] == ["secrets"] and len(tail) in (2, 3, 4):
                # A key the person pastes (2026-11-14, first release L9): the
                # plugin's `settings.secret`, checked on entry and kept in its
                # private secrets.env, never in Yours. lib/loam_contributions.py.
                # A credential is the person's own: an agent's call is refused.
                import loam_contributions as contrib  # noqa: PLC0415
                pid = tail[0]
                if author(payload) is not None:
                    raise BrokerError(403, "a key is the owner's to paste, in the "
                                           "plugin's settings; an agent cannot set, "
                                           "check or read one")
                try:
                    if len(tail) == 2 and method == "GET":
                        body = {"id": pid, "secrets": await asyncio.to_thread(
                            contrib.secrets_of, pid)}
                    elif len(tail) == 3 and method == "PUT":
                        body = await asyncio.to_thread(contrib.set_secret, pid, tail[2],
                                                       payload.get("value"))
                        print(f"plugins: {pid} key {tail[2]} set (checked: "
                              f"{body['checked']['why']})", file=sys.stderr, flush=True)
                    elif len(tail) == 3 and method == "DELETE":
                        body = await asyncio.to_thread(contrib.delete_secret, pid, tail[2])
                        print(f"plugins: {pid} key {tail[2]} removed", file=sys.stderr,
                              flush=True)
                    elif tail[3:] == ["check"] and method == "POST":
                        body = await asyncio.to_thread(contrib.recheck_secret, pid, tail[2])
                    elif tail[3:] == ["value"] and method == "GET":
                        # For the app's own server, which makes the provider's
                        # call; the page's relay must never pass this route.
                        # A field of a provider the plugin declared in `keys:`
                        # (2026-11-18) resolves as shared keys do.
                        import loam_keys  # noqa: PLC0415
                        if not await asyncio.to_thread(loam_keys.declares_field, pid, tail[2]):
                            await asyncio.to_thread(contrib._secret_entry, pid, tail[2])
                        value = await asyncio.to_thread(contrib.secret_for, pid, tail[2])
                        if not value:
                            raise BrokerError(404, f"no {tail[2]} is set for {pid}")
                        body = {"name": tail[2], "value": value,
                                "source": contrib.secret_source(pid, tail[2])}
                    else:
                        raise BrokerError(405, "GET /v1/plugins/<id>/secrets; PUT or "
                                               "DELETE …/secrets/<name>; POST …/<name>/check")
                except contrib.ContributionError as exc:
                    status = 404 if "no plugin" in str(exc) or "declares no secret" in str(exc) \
                        else 422
                    raise BrokerError(status, str(exc))
                writer.write(response(200, body, nocache))
            elif tail[1:] == ["settings"]:
                # A plugin's own settings (2026-11-14, first release L4):
                # the `settings.entry` values it contributes, which
                # bin/settings reaches as `plugin.<id>.<key>`.
                # lib/loam_contributions.py.
                import loam_contributions as contrib  # noqa: PLC0415
                pid = tail[0]
                if method == "GET":
                    entries = contrib.entries_of(pid)
                    body = {"id": pid, "entries": entries,
                            "values": {e["key"]: contrib.get_setting(pid, e["key"])
                                       for e in entries}}
                elif method == "PATCH":
                    by = author(payload)
                    values = payload.get("values")
                    if not isinstance(values, dict) or not values:
                        raise BrokerError(400, "the body is {\"values\": {key: value}}")
                    try:
                        for key, value in values.items():
                            await asyncio.to_thread(contrib.set_setting, pid, key, value)
                    except contrib.ContributionError as exc:
                        raise BrokerError(400, str(exc))
                    print(f"plugins: {pid} settings {json.dumps(values, sort_keys=True)} "
                          f"by {by or lc.OWNER_ID}", file=sys.stderr, flush=True)
                    body = {"id": pid, "values": {k: contrib.get_setting(pid, k)
                                                  for k in values}}
                else:
                    raise BrokerError(405, "GET or PATCH a plugin's settings")
                writer.write(response(200, body, nocache))
            elif tail[1:2] == ["agents"] and len(tail) in (2, 3):
                # A plugin's per-agent settings (2026-11-13): what it keeps
                # for each agent and shows on the agent's profile (place
                # `agent.profile`). lib/loam_plugins.py, `agent_values`.
                pid = tail[0]
                agent = tail[2] if len(tail) == 3 else None
                if agent is not None and agent not in cfg.roster():
                    raise BrokerError(404, f"no agent named {agent!r} on this box")
                if method == "GET":
                    body = await asyncio.to_thread(loam_plugins.agent_values,
                                                   pid, agent)
                elif method == "PATCH" and agent is not None:
                    by = author(payload)
                    fields = {k: v for k, v in payload.items() if k != "by"}
                    if set(fields) != {"values"}:
                        raise BrokerError(400, "the body is {\"values\": {field: "
                                               "value}}; null puts one back")
                    body = await asyncio.to_thread(loam_plugins.set_agent_values,
                                                   pid, agent, fields["values"], by)
                    print(f"plugins: {pid} for {agent}: "
                          f"{json.dumps(fields['values'], sort_keys=True)} by "
                          f"{by or lc.OWNER_ID}", file=sys.stderr, flush=True)
                    if by:
                        self.say_in_general(
                            f"{threads_rec.display(by)} set {body.get('name') or pid}'s "
                            f"{', '.join(sorted(fields['values']))} for "
                            f"{threads_rec.display(agent)}")
                else:
                    raise BrokerError(405, "use GET for a plugin's agent settings, "
                                           "PATCH /v1/plugins/<id>/agents/<agent> "
                                           "to change one agent's")
                writer.write(response(200, body, nocache))
            elif len(tail) >= 3 and tail[1] == "files":
                if method not in ("GET", "HEAD"):
                    raise BrokerError(405, "a plugin's files are read with GET")
                path, ctype = await asyncio.to_thread(loam_plugins.file_for,
                                                      tail[0], tail[2:])
                data = await asyncio.to_thread(path.read_bytes)
                head = (f"HTTP/1.1 200 OK\r\nContent-Type: {ctype}\r\n"
                        f"Content-Length: {len(data)}\r\n"
                        f"Cache-Control: no-cache\r\n"
                        f"X-Content-Type-Options: nosniff\r\n"
                        f"Connection: close\r\n\r\n").encode()
                writer.write(head + (b"" if method == "HEAD" else data))
            else:
                raise BrokerError(404, f"no route for {method} /v1/plugins/"
                                       f"{'/'.join(tail)}")
        except loam_plugins.PluginError as exc:
            writer.write(response(exc.status, {"error": exc.message, **exc.detail},
                                  nocache))
        except BrokerError as exc:
            writer.write(response(exc.status, {"error": exc.message}, nocache))
        await writer.drain()

    def _attachment(self, raw) -> dict:
        """A stored path a client sent back, checked before it is read.

        Only a path this interface itself wrote: inside the attachments
        directory, resolved (so a symlink or a `..` cannot point out of it) and
        present on disk. A client cannot use a message to make a persona read
        an arbitrary file on the box -- that is a capability the app has never
        had and must not gain through here.
        """
        if not isinstance(raw, str) or not raw.strip():
            raise BrokerError(400, "`attachments` is a list of stored paths")
        candidate = Path(raw.strip())
        if not candidate.is_absolute():
            candidate = cfg.VAULT / candidate
        try:
            resolved = candidate.resolve()
            resolved.relative_to(cfg.ATTACHMENT_ROOT.resolve())
        except (OSError, ValueError):
            raise BrokerError(
                400, f"{raw} is not a stored attachment; upload it to "
                     f"POST /v1/sessions/<id>/attachments first") from None
        if not resolved.is_file():
            raise BrokerError(404, f"no attachment at {raw}")
        return {"path": str(resolved), "name": resolved.name,
                "size": resolved.stat().st_size,
                "type": cfg.attachment_type(resolved.name)}

    @staticmethod
    def _count(raw: str | None, name: str) -> int | None:
        """A whole number off the query string, or nothing at all."""
        if raw is None or raw == "":
            return None
        try:
            value = int(raw)
        except ValueError:
            raise BrokerError(400, f"`{name}` is a number") from None
        if value < 1:
            raise BrokerError(400, f"`{name}` is 1 or more")
        return value

    async def stream_records(self, writer: asyncio.StreamWriter,
                             full: bool = False) -> None:
        """The live list: every session's record, whenever any of them changes.

        The same ``broker.session`` snapshot the per-session stream leads
        with, and for the same reason it is not an event: it carries no
        ``seq``, it is never logged, and a client applies whichever one
        arrives last per ``session_id``. There is nothing to reconnect *at*,
        so there is no ``?from=`` here -- reopening the stream re-sends the
        whole list, which is by definition current.

        It opens with the listing as it stands, so a page that connects
        before it fetches anything already has the screen. Every record is in
        it, archived or not (``?archived=1`` is accepted and changes nothing
        since 2026-11-12).

        The one other item here is ``broker.residency`` (2026-09-25): the
        resident count and the cap, sent once at the end of the opening burst
        and again whenever the count moves. Each row carries its own ``live``
        on its record, so a client filtering to what is in RAM needs nothing
        more; this exists because the total against the cap is a fact about
        the box and not about any row, and a narrowed list cannot be counted
        for it.
        After that, **every** record change goes out, archived or not: a page
        that filters archived rows still has to be told the moment a row
        becomes archived, or it keeps drawing one.
        """
        queue: asyncio.Queue = asyncio.Queue()
        self.broker.record_subscribers.add(queue)
        self._open_stream(writer)
        try:
            # The opening burst IS a read of the list, so it scans for app
            # sessions nobody has adopted yet on the same terms as the route:
            # a client that only ever opens this stream must not be the one
            # client that never sees a new conversation appear.
            self.broker.scan_for_new()
            # Rows as the listing answers them (`list_row`), here and for
            # every change after: the whole `turns` is the session's own
            # stream's, unless `?turns=all` asked for it (2026-11-09).
            row = (lambda r: r) if full else list_row
            for record in self.broker.known():
                await self._send_event(writer, {"type": "broker.session",
                                                **row(record)})
            # And the count against the cap, so a client that only ever opens
            # this stream has the whole screen -- the rows and "2 of 4 live" --
            # without fetching the list route for the two numbers on it.
            await self._send_event(writer, self.broker.residency_event())
            # `asyncio.timeout` for the reason `stream` gives; and `None` is
            # the broker's stop (`Broker.close_record_streams`), so a stop
            # never depends on this task taking a cancel at all.
            while True:
                try:
                    async with asyncio.timeout(KEEPALIVE_S):
                        record = await queue.get()
                except TimeoutError:
                    await self._ping(writer)
                    continue
                if record is None:
                    return
                await self._send_event(writer, row(record))
        except (ConnectionResetError, BrokenPipeError):
            pass
        finally:
            self.broker.record_subscribers.discard(queue)

    def providers(self, agent: str | None = None) -> list[dict]:
        """Every provider the app draws a row for, connected or not, and what
        each one offers a chat: its models and its effort levels.

        One is wired. The others are named here rather than left out because
        the page has a row for each and "Codex — not wired" is an answer,
        where a missing row is a bug report. `usage` is on the wired one only,
        and is `null` until a rate limit reading has been seen: the CLI
        volunteers those mid-turn, so a box that has not taken a turn since
        the file was last written has nothing to say and says so.

        `models` and `efforts` (2026-09-21) are what the + menu is drawn
        from, and an unwired provider carries both as empty lists -- not as
        absent keys, so a client reads "nothing on offer here" without a
        branch. `default: true` marks the model the persona's own settings
        name, which is what a session runs on when nobody picks: it is read
        off that persona's settings.json when `agent` says whose, and off the
        fleet when it does not. No row is marked when the personas disagree,
        which is honest and is what a fleet mid-change looks like.

        `login` (2026-09-22) is on the wired one only and is read from the
        credential itself on every call, never cached: when it expires, how
        many whole days that is, and which credential the sessions are
        actually running on. It is what lets the page say "Claude Code login
        expires in 3 days" without knowing that a login is a file.
        """
        # A read for each provider that has one, at most once a minute: this
        # is a thread (the route's to_thread), and a read is a short-lived
        # CLI process, ~1 s for Codex and ~3.5 s for Claude Code.
        self.broker.usage.on_fetch()
        login = cfg.login_state()
        connected, reason = login["connected"], login["reason"]
        usage = cfg.read_usage()
        default_model = cfg.persona_model(agent)
        # The persona's own default model (2026-11-13, its profile), when it
        # is a Claude Code one, is the row ticked: it is what a turn runs on.
        if agent and agent in cfg.roster():
            mine = threads_rec.persona_defaults(agent)
            if mine["provider"] == "claude-code" and mine["model"]:
                default_model = mine["model"]
        out = []
        for provider in cfg.PROVIDERS:
            row = {"id": provider,
                   "name": cfg.PROVIDER_NAMES[provider],
                   "connected": False,
                   "reason": cfg.NOT_WIRED,
                   "models": [], "efforts": []}
            if provider == "codex":
                row.update(self.codex_row())
            elif provider == "antigravity":
                row.update(self.antigravity_row())
            elif provider in cfg.WIRED_PROVIDERS:
                row["connected"] = connected
                row["reason"] = reason
                row["usage"] = usage
                row["usage_reason"] = self.broker.usage.reason(provider) or (
                    None if usage is not None else
                    "no reading yet: the read failed and no turn has run")
                row["login"] = cfg.claude_code_row_login(login)
                # `resolves_to` (2026-11-10): the concrete id each alias
                # runs on with the installed CLI, read from its build
                # (cfg.alias_table), so a pill can say "Fable 5.2" before
                # anyone has replied on it. `cli_version` is that build.
                table = cfg.alias_table()
                row["cli_version"] = table["version"]
                row["models"] = []
                for alias, name in cfg.PROVIDER_MODELS.get(provider, ()):
                    model = {"id": alias, "name": name,
                             "default": alias == default_model,
                             "resolves_to": cfg.resolves_to(alias, table)}
                    after = cfg.resolves_after_plan(alias, table)
                    if after:
                        model["resolves_to_after_plan"] = after
                    row["models"].append(model)
                row["efforts"] = list(cfg.EFFORTS)
            # `sign_in.account` (2026-11-11) is the row's own
            # `login.account` while it is connected, so the card can say
            # "Signed in as …" from the one object it draws.
            row["sign_in"] = cfg.sign_in(
                provider, (row.get("login") or {}).get("account")
                if row["connected"] else None)
            out.append(row)
        return out

    @staticmethod
    def antigravity_row() -> dict:
        """The Antigravity row (2026-11-09), in the Claude row's shape. The
        login is read by asking the CLI (``loam_antigravity.login_state``,
        cached a minute). ``usage`` (2026-11-15) is the CLI's own ``/quota``
        and ``/credits``, read on the cadence the other two are
        (``loam_antigravity.read_quota``): every pool's window under
        ``buckets`` with ``utilization`` USED, as the others', and
        ``credits`` in Codex's shape. Null until a read has succeeded on the
        login the box holds."""
        state = agy.login_state()
        usage = agy.row_usage()
        return {
            "connected": state["connected"],
            "reason": state["reason"],
            "usage": usage,
            "usage_reason": None if usage is not None else
            "no reading yet: /quota has not answered on this login",
            "login": agy.row_login(state),
            # A model whose id ends in its level takes no other
            # (loam_antigravity.LEVEL_RE, 2026-11-15).
            "models": [{"id": m["id"], "name": m["name"], "default": False,
                        "efforts": ([] if agy.carries_level(m["id"])
                                    else list(agy.EFFORTS)),
                        "context_window": None}
                       for m in state["models"]],
            "efforts": list(agy.EFFORTS) if state["connected"] else [],
        }

    @staticmethod
    def codex_row() -> dict:
        """The Codex row's own fields (2026-10-01), in the Claude row's shape.

        ``login`` adds three keys the Claude row does not have: ``account``
        and ``plan`` out of the login's id token, and ``status``, the line
        ``codex login status`` prints. ``expires_at`` and ``days_left`` are
        null and always will be on this login -- see
        ``loam_codex.login_state``.

        ``usage`` (2026-10-01, the evening) is the last
        ``account/rateLimits/updated`` kept on disk, in the Claude row's shape
        with ``credits`` and ``planType`` beside the windows -- see
        ``loam_codex.usage_from_rate_limits``. It is null until a Codex turn
        has run on the login the box holds, and ``usage_reason`` then says so.

        ``models`` is what ``model/list`` answered, each with its own
        ``efforts`` (the levels differ by model), and ``efforts`` on the row
        is their union. ``default`` marks the model Codex itself calls the
        default, because a persona's settings name no Codex model.
        ``context_window`` is the window a turn on that model would state,
        out of Codex's own catalogue (``loam_codex.context_windows``;
        ``model/list`` states none), and null when the catalogue does not
        carry it. It is the page's fallback until a turn states its own.
        """
        state = codex.login_state()
        usage = codex.row_usage()
        windows = codex.context_windows()
        return {
            "connected": state["connected"],
            "reason": state["reason"],
            "usage": usage,
            "usage_reason": None if usage is not None else
            "no reading yet: the read failed and no Codex turn has run",
            "login": Server.codex_login(state),
            "models": [{"id": m["id"], "name": m["name"],
                        "default": bool(m.get("default")),
                        "efforts": list(m.get("efforts") or []),
                        "context_window": windows.get(m["id"])}
                       for m in codex.read_models()],
            "efforts": codex.efforts(),
        }

    @staticmethod
    def codex_login(state: dict | None = None) -> dict:
        """The Codex row's ``login`` object; also what its sign-out
        answers."""
        state = codex.login_state() if state is None else state
        return {"expires_at": state["expires_at"],
                "days_left": state["days_left"],
                "source": state["source"],
                "account": state["account"],
                "plan": state["plan"],
                "status": codex.status_line()}

    def _open_stream(self, writer: asyncio.StreamWriter) -> None:
        """The SSE headers and the opening comment, which states the stream's
        own keepalive interval in milliseconds.

        A client measuring staleness needs the number this broker actually
        uses, not one copied into a document that will disagree with the code
        one day. Both streams here open the same way on purpose: two streams
        with two shapes is two readers in the app.
        """
        writer.write(b"HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\n"
                     b"Cache-Control: no-cache\r\nConnection: close\r\n\r\n")
        writer.write(f": open ping={KEEPALIVE_S * 1000}\n\n".encode())

    async def _ping(self, writer: asyncio.StreamWriter) -> None:
        """A comment line keeps a proxy and a dead peer honest; writing
        nothing for minutes is indistinguishable from a hung broker."""
        writer.write(b": ping\n\n")
        await writer.drain()

    async def _send_event(self, writer: asyncio.StreamWriter,
                          event: dict) -> None:
        writer.write(f"data: {json.dumps(for_the_wire(event))}\n\n".encode())
        await writer.drain()


def loaded_source() -> dict[str, list[str]]:
    """This repo's source as the process loaded it: this file and every
    module imported from ``lib/``, read once while the broker starts.

    For the shutdown dump. A broker runs for days while the checkout moves on,
    and ``traceback`` reads a frame's line from the file as it is *now*: the
    10-14 dump printed a docstring under ``line 5639, in dump`` (2026-10-14).
    """
    root = Path(__file__).resolve().parent.parent
    files = {str(Path(__file__))}
    for module in list(sys.modules.values()):
        path = getattr(module, "__file__", None)
        if path and Path(path).resolve().is_relative_to(root):
            files.add(path)
    out = {}
    for path in files:
        try:
            out[path] = Path(path).read_text(encoding="utf-8").splitlines()
        except (OSError, UnicodeDecodeError):
            pass
    return out


LOADED_SOURCE = loaded_source()


class ShutdownWatch:
    """What the broker is doing, written to the journal, when a stop hangs.

    Added 2026-10-13. Four stops between 10-07 and 10-09 ignored SIGTERM for
    systemd's full 90 s and were SIGKILLed with nothing captured: at +15 s
    the main thread sat idle in ``epoll_wait`` and a second thread in
    ``futex_wait_queue``, which fits an idle loop waiting on something that
    never finishes -- a task that will not end when cancelled, or
    ``asyncio.run`` joining a worker thread still inside a ``to_thread``
    call (Python 3.11 joins it with no timeout) -- and does not say which.

    Armed by the first SIGTERM or SIGINT, on a thread of its own and not on
    the loop, because the loop is the thing that may be stuck and because
    ``asyncio.run`` has stopped running it by the time it joins the executor.
    ``cfg.SHUTDOWN_DUMP_S`` later, if the process is still here, it writes
    one line per live session, every thread's stack by name and every
    asyncio task still pending; then the stop goes on as before. A stop that
    finishes in time takes the daemon thread with it and writes nothing.

    Not ``faulthandler`` alone, though it is armed too: on 3.11 it names a
    thread only by a hex ident, and the thread names and the tasks are what
    tell the two suspects apart. ``faulthandler`` needs no GIL, so it is the
    fallback at ``cfg.SHUTDOWN_FALLBACK_S`` for a stop where Python cannot
    run at all, and the first dump cancels it.
    """

    def __init__(self, broker: "Broker",
                 loop: asyncio.AbstractEventLoop) -> None:
        self.broker = broker
        self.loop = loop
        self.armed_at: float | None = None

    def arm(self, signame: str) -> None:
        if self.armed_at is not None:
            return
        self.armed_at = time.monotonic()
        self.signame = signame
        faulthandler.dump_traceback_later(cfg.SHUTDOWN_FALLBACK_S, exit=False,
                                          file=sys.stderr)
        timer = threading.Timer(cfg.SHUTDOWN_DUMP_S, self.dump)
        timer.name = "shutdown-watch"
        timer.daemon = True
        timer.start()
        # The backstop (2026-11-10): past SHUTDOWN_EXIT_S the broker says
        # what is still running and exits, rather than wait for SIGKILL.
        last = threading.Timer(cfg.SHUTDOWN_EXIT_S, self.give_up)
        last.name = "shutdown-exit"
        last.daemon = True
        last.start()

    def give_up(self) -> None:
        waited = time.monotonic() - (self.armed_at or time.monotonic())
        tasks = [line for line in self._tasks()
                 if line.startswith("shutdown: task ")]
        threads_left = sorted(t.name for t in threading.enumerate()
                              if not t.daemon and t is not threading.main_thread())
        lines = [f"shutdown: {self.signame} {waited:.1f}s ago and the broker is "
                 f"still here; exiting now, with {len(tasks)} task(s) and "
                 f"{len(threads_left)} worker thread(s) left running"]
        lines += [line.replace("shutdown: task ", "shutdown: left: task ", 1)
                  for line in tasks]
        lines += [f"shutdown: left: thread {name}" for name in threads_left]
        sys.stderr.write("\n".join(lines) + "\n")
        hard_exit(0)

    def dump(self) -> None:
        faulthandler.cancel_dump_traceback_later()
        waited = time.monotonic() - (self.armed_at or time.monotonic())
        lines = [f"shutdown: {self.signame} {waited:.1f}s ago and the broker "
                 f"has not exited; sessions, threads and tasks follow"]
        lines += self._sessions()
        lines += self._threads()
        lines += self._tasks()
        lines.append("shutdown: end of dump; the stop goes on")
        sys.stderr.write("\n".join(lines) + "\n")
        sys.stderr.flush()

    def _sessions(self) -> list[str]:
        try:
            live = [s for s in list(self.broker.sessions.values())
                    if s.is_live()]
        except Exception as exc:  # noqa: BLE001 - the dump must reach the stacks
            return [f"shutdown: sessions unreadable ({exc!r})"]
        if not live:
            return ["shutdown: no live sessions"]
        out = []
        for s in live:
            try:
                status = s.status()
            except Exception as exc:  # noqa: BLE001
                status = f"? ({exc!r})"
            pid = getattr(s.proc, "pid", None)
            out.append(f"shutdown: session {s.agent}/{s.id} state={s.state} "
                       f"status={status} pid={pid}")
        return out

    def _threads(self) -> list[str]:
        names = {t.ident: t for t in threading.enumerate()}
        out = []
        for ident, frame in sys._current_frames().items():
            t = names.get(ident)
            label = (f"{t.name} (native {t.native_id}, "
                     f"{'daemon' if t.daemon else 'not daemon'})"
                     if t else f"unnamed ident {ident:#x}")
            out.append(f"shutdown: thread {label}, most recent call last:")
            stack = [f for f, _ in traceback.walk_stack(frame)]
            for f in reversed(stack):
                out += self._frame(f)
        return out

    @staticmethod
    def _frame(frame) -> list[str]:
        """A frame as ``traceback`` prints one, its source line read from what
        the process loaded (`LOADED_SOURCE`). A file of this repo that was not
        loaded by then prints no line, rather than today's."""
        code, lineno = frame.f_code, frame.f_lineno
        out = [f'  File "{code.co_filename}", line {lineno}, '
               f"in {code.co_name}"]
        lines = LOADED_SOURCE.get(code.co_filename)
        if lines is not None:
            text = lines[lineno - 1] if 0 < lineno <= len(lines) else ""
        elif Path(code.co_filename).resolve().is_relative_to(
                Path(__file__).resolve().parent.parent):
            text = ""
        else:
            text = linecache.getline(code.co_filename, lineno)
        if text.strip():
            out.append(f"    {text.strip()}")
        return out

    @staticmethod
    def _awaiting(task: asyncio.Task) -> list:
        """Every frame a task is suspended in, outermost first, down to the
        innermost coroutine. ``Task.get_stack`` gives only the outermost, so
        the 10-14 dump stopped at ``Server.handle`` and could not name the
        route; following ``cr_await`` (``gi_yieldfrom`` for a generator-based
        awaitable) reaches the line actually waiting."""
        frames, obj = [], task.get_coro()
        while obj is not None and len(frames) < 64:
            frame = getattr(obj, "cr_frame", None) or getattr(obj, "gi_frame",
                                                              None)
            if frame is None:
                break
            frames.append(frame)
            obj = (getattr(obj, "cr_await", None)
                   or getattr(obj, "gi_yieldfrom", None))
        return frames

    def _tasks(self) -> list[str]:
        try:
            tasks = [t for t in asyncio.all_tasks(self.loop) if not t.done()]
        except Exception as exc:  # noqa: BLE001 - a closed loop has no tasks
            return [f"shutdown: tasks unreadable ({exc!r})"]
        if not tasks:
            return ["shutdown: no pending tasks"]
        out = []
        for task in tasks:
            coro = task.get_coro()
            out.append(f"shutdown: task {task.get_name()} "
                       f"{getattr(coro, '__qualname__', coro)!s}"
                       f"{' cancelling' if task.cancelling() else ''}:")
            for frame in self._awaiting(task) or task.get_stack():
                out += self._frame(frame)
        return out


def hard_exit(code: int) -> None:
    """Exit now, past anything still running. Every record the broker
    writes is written whole and closed as it goes (a session log line, a
    record's atomic replace, a thread's append), so there is no buffer of
    ours to lose; stdout and stderr are flushed for the journal."""
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.flush()
        except Exception:  # noqa: BLE001 - exiting regardless
            pass
    os._exit(code)


async def shutdown(broker: "Broker", server: "Server") -> None:
    """The stop, bounded (2026-11-10; see ``cfg.SHUTDOWN_*``). Each step that
    runs out of time names what it left in the journal and the stop goes on."""
    def say(line: str) -> None:
        print(f"shutdown: {line}", file=sys.stderr, flush=True)

    begun = time.monotonic()
    # Every session ends with the broker. A persona process outliving its
    # broker would hold ~450 MB that nothing can reach, answer to nobody, and
    # still be counted against the cap by nothing at all. Together, not one
    # after another: seven sessions at 10 s each was past systemd's 90 s.
    stops = {asyncio.ensure_future(s.stop()): s for s in broker.live()}
    if stops:
        done, pending = await asyncio.wait(stops, timeout=cfg.SHUTDOWN_SESSIONS_S)
        for fut in done:
            if fut.exception() is not None:
                s = stops[fut]
                say(f"session {s.agent}/{s.id} failed to stop "
                    f"({fut.exception()!r})")
        for fut in pending:
            s = stops[fut]
            say(f"session {s.agent}/{s.id} did not stop within "
                f"{cfg.SHUTDOWN_SESSIONS_S}s; going on without it")
    # Each thread's turn in flight ends on its session's exit and writes its
    # last line ("Ada's turn ended: the broker restarted"); a queued one
    # writes that it never started.
    engine = getattr(server, "threads", None)
    workers = {t: tid for tid, t in getattr(engine, "workers", {}).items()
               if not t.done()}
    if workers:
        _, pending = await asyncio.wait(workers, timeout=cfg.SHUTDOWN_TASKS_S)
        for task in pending:
            say(f"thread {workers[task]}: its turn did not end within "
                f"{cfg.SHUTDOWN_TASKS_S}s; cancelled")
    # And every live list told it is over, after the records those stops
    # wrote. A per-chat stream already ends on its session's `None`.
    broker.close_record_streams()
    # Everything else, cancelled here with a bound, rather than by
    # `asyncio.run`, which waits on a cancelled task for ever.
    me = asyncio.current_task()
    rest = [t for t in asyncio.all_tasks() if t is not me and not t.done()]
    for task in rest:
        task.cancel()
    if rest:
        _, pending = await asyncio.wait(rest, timeout=cfg.SHUTDOWN_TASKS_S)
        if pending:
            for task in pending:
                coro = task.get_coro()
                say(f"task {task.get_name()} "
                    f"{getattr(coro, '__qualname__', coro)!s} did not end when "
                    f"cancelled")
            say(f"exiting {time.monotonic() - begun:.1f}s into the stop with "
                f"{len(pending)} task(s) that would not end")
            hard_exit(0)


async def amain(addr: str, port: int) -> int:
    broker = Broker()
    server = Server(broker)
    # Before a byte is served: every record the box has, filled from its own
    # log. A record written before 2026-09-18 has no title and no last
    # message, and a home screen drawn from those records is a list of rows
    # all reading "New chat" with no status box -- which is what it was.
    seen, changed = backfill_records()
    print(f"backfill: {changed} of {seen} records filled from their logs",
          file=sys.stderr, flush=True)
    # And every record's title made the vault's title, for the records the
    # broker's own titler named before it was taken out (2026-09-22). Once,
    # here, because a name is not something that keeps changing.
    try:
        seen, renamed = sync_titles()
        print(f"titles: {len(renamed)} of {seen} records took the vault's title",
              file=sys.stderr, flush=True)
        for session_id, was, now in renamed:
            print(f"titles: {session_id[:8]} {was!r} -> {now!r}",
                  file=sys.stderr, flush=True)
    except Exception as exc:  # noqa: BLE001 - never the reason a broker is down
        print(f"titles: the sync failed ({exc!r})", file=sys.stderr, flush=True)
    # And the records a scan made of this broker's own forks, before the scan
    # below runs: between 09-20 and 09-22 a reply into an adopted session left
    # a second record of the same conversation, and the home screen drew both.
    try:
        gone = prune_fork_duplicates()
        print(f"prune: {len(gone)} duplicate records of a fork removed",
              file=sys.stderr, flush=True)
        for session_id, title in gone:
            print(f"prune: {session_id} {title!r}",
                  file=sys.stderr, flush=True)
    except Exception as exc:  # noqa: BLE001 - never the reason a broker is down
        print(f"prune: the pass failed ({exc!r})", file=sys.stderr, flush=True)
    # And every session the owner had in the Claude Code app, which are Claude
    # Code sessions on this box that the broker simply did not know about.
    # At start as well as on the route, because the app is still where some
    # of his conversations happen and a restart is the cheapest moment to
    # catch up. Fail-soft: a scan that goes wrong is reported and the broker
    # still serves, because everything it already holds is unaffected.
    try:
        report = broker.adopt_app_sessions()
        per_agent = ", ".join(f"{agent} {n}"
                              for agent, n in report["agents"].items())
        print(f"adopt: {len(report['adopted'])} app sessions adopted "
              f"({per_agent or 'none new'}), "
              f"{len(report['refreshed'])} refreshed",
              file=sys.stderr, flush=True)
    except Exception as exc:  # noqa: BLE001 - never the reason a broker is down
        print(f"adopt: the scan failed ({exc!r})", file=sys.stderr, flush=True)
    asyncio.create_task(broker.reap_idle())
    # Receipts a waiting call could not carry, posted into their threads.
    asyncio.create_task(server.deliver_owed())
    # Usage reads while anything is live, and once as each job ends.
    asyncio.create_task(broker.refresh_usage())
    # Codex's model list, so the + menu has a Codex row before any Codex
    # session has run. Off the loop, and fail-soft: the cached list stays.
    asyncio.create_task(fetch_codex_models())
    # The first-party looks that left the shipped set in 0.2.5 (2026-11-18):
    # one the person was using or had chosen is installed from its Market
    # link, once (lib/loam_listed_themes.py). Off the loop, and fail-soft.
    asyncio.create_task(keep_listed_themes())
    tcp = await asyncio.start_server(server.handle, addr, port)
    print(f"session-broker listening on {addr}:{port} "
          f"(admission by memory: reserve {cfg.MEMORY_RESERVE_MB} MB, "
          f"{cfg.SESSION_START_MB} MB a start; backstop {cfg.MAX_SESSIONS} "
          f"sessions)", file=sys.stderr, flush=True)

    stop = asyncio.Event()
    loop = asyncio.get_running_loop()
    watch = ShutdownWatch(broker, loop)

    def on_signal(sig: signal.Signals) -> None:
        broker.stopping = True
        watch.arm(sig.name)
        stop.set()

    for sig in (signal.SIGTERM, signal.SIGINT):
        loop.add_signal_handler(sig, on_signal, sig)
    async with tcp:
        await stop.wait()
    await shutdown(broker, server)
    return 0


async def keep_listed_themes() -> None:
    try:
        import loam_listed_themes  # noqa: PLC0415
        kept = await asyncio.to_thread(loam_listed_themes.keep)
        for pid, entry in kept.items():
            print(f"themes: {pid} {entry['how']} ({entry['why']})"
                  + (f": {entry.get('link_error') or entry.get('error')}"
                     if entry["how"] != "link" and (entry.get("link_error") or entry.get("error")) else ""),
                  file=sys.stderr, flush=True)
    except Exception as exc:  # noqa: BLE001 - never the reason a broker is down
        print(f"themes: keeping the listed looks failed ({exc!r})", file=sys.stderr, flush=True)


async def fetch_codex_models() -> None:
    try:
        models = await asyncio.to_thread(codex.fetch_models)
        print(f"codex: {len(models)} models listed", file=sys.stderr, flush=True)
    except Exception as exc:  # noqa: BLE001 - never the reason a broker is down
        print(f"codex: the model list failed ({exc!r})", file=sys.stderr, flush=True)


def main() -> int:
    addr, port = cfg.BIND_ADDR, cfg.PORT
    argv = sys.argv[1:]
    if "--addr" in argv:
        addr = argv[argv.index("--addr") + 1]
    if "--port" in argv:
        port = int(argv[argv.index("--port") + 1])
    return asyncio.run(amain(addr, port))


if __name__ == "__main__":
    sys.exit(main())
