# -- the record's derived fields -------------------------------------------
#
# A record read off disk by a broker that did not start it has to answer the
# same questions as a live one, so the rules live here rather than inside
# Session: `known()` applies them to a JSON file and `Session.__init__`
# applies them to itself, and there is one copy of each.

# How soon after start, and how often, the broker looks for a job receipt
# no waiting call carried (Server.deliver_owed).
DELIVER_FIRST_S = 20
DELIVER_EVERY_S = 30


def running_model(session) -> str | None:
    """The model a live session's CLI says it is on: Claude's `system/init`
    model, Codex's or Antigravity's translator's. None before it has said."""
    said = getattr(session, "_init_model", None)
    if isinstance(said, str) and said:
        return said
    for name in ("_codex", "_agy"):
        model = getattr(getattr(session, name, None), "model", None)
        if isinstance(model, str) and model:
            return model
    return None


# The most turns a list row carries (2026-11-09). See `list_row`.
LIST_TURNS_MAX = 10


def _tail_turns(turns: list) -> list:
    """The last turns, back to the ones a list row is read for: the latest
    turn (its cost), the latest that names a `model`, and the latest context
    reading -- walking back past a compaction (both figures null) to the
    turn before it that states a window, as a page computing the context
    does. At most `LIST_TURNS_MAX`."""
    need_model = need_context = True
    after_compaction = False
    start = len(turns)
    for i in range(len(turns) - 1, max(-1, len(turns) - 1 - LIST_TURNS_MAX), -1):
        turn = turns[i] if isinstance(turns[i], dict) else {}
        start = i
        if isinstance(turn.get("model"), str) and turn["model"]:
            need_model = False
        context = turn.get("context") if isinstance(turn.get("context"), dict) else {}
        used, window = context.get("used"), context.get("window")
        if need_context:
            if after_compaction:
                if isinstance(window, (int, float)):
                    need_context = False
            elif used is None and window is None and context:
                after_compaction = True
            elif isinstance(used, (int, float)):
                need_context = False
        if not need_model and not need_context:
            break
    return turns[start:]


def list_row(meta: dict) -> dict:
    """A record as the listing and the live list carry it (2026-11-09): every
    field but `turns`, which is cut to its tail (`_tail_turns`), with
    `turns_total` saying how many the record has. The whole of `turns` is on
    `GET /v1/sessions/<id>` and the session's own stream; `?turns=all` on
    the list routes answers it there too, for a client that read it whole.
    Before this `GET /v1/sessions` was 3.5 MB on this box, 2.1 MB of it
    turns."""
    turns = meta.get("turns")
    if not isinstance(turns, list):
        return meta
    return {**meta, "turns": _tail_turns(turns), "turns_total": len(turns)}


def _without_image_bytes(blocks: list) -> tuple[list, int]:
    """`blocks` with every base64 image's `data` taken out, and how many
    characters went. A tool result's own `content` is a list of the same
    blocks, so this walks into it; nothing else nests images."""
    out, cut = [], 0
    for block in blocks:
        if not isinstance(block, dict):
            out.append(block)
            continue
        source = block.get("source")
        if (block.get("type") == "image" and isinstance(source, dict)
                and source.get("type") == "base64"
                and isinstance(source.get("data"), str)):
            data = source["data"]
            source = {k: v for k, v in source.items() if k != "data"}
            source["omitted_chars"] = len(data)
            out.append({**block, "source": source})
            cut += len(data)
            continue
        inner = block.get("content")
        if block.get("type") == "tool_result" and isinstance(inner, list):
            inner, n = _without_image_bytes(inner)
            if n:
                out.append({**block, "content": inner})
                cut += n
                continue
        out.append(block)
    return out, cut


def for_the_wire(event: dict) -> dict:
    """An event as a client is sent it: the log's copy, less image bytes.

    **A tool result can carry megabytes of base64 pictures** -- `Read` of a
    PDF hands the model each page as a JPEG -- and the log keeps them, because
    the log is the record. No client draws them: the page shows a tool's
    result as text, and a picture the persona looked at is a file it named.
    They were still sent, and that is the 2026-10-15 chat that showed none of
    its replies: a persona read a course's PDFs, seven `user` events of 0.6-3.2 MB
    put 16 MB of a 17 MB log in front of both replies, and a phone opening
    the chat gave up on the window before it got past the pictures.

    So the `data` of a base64 image inside a `user` event is cut here, on the
    way out, and only here. The block keeps its type and `media_type` and says
    `omitted_chars`, so a reader can tell a picture was there and how big.
    The same picture's second copy goes too: `Read` of an image file also
    puts it in `tool_use_result.file.base64`, which no client reads and which
    was 34 MB of one 75 MB persona's log. That key becomes `base64_omitted_chars`.
    The event is copied when there is something to cut and is otherwise the
    same object: the log, the live subscribers' queues and every other
    stream's copy are untouched.
    """
    if event.get("type") != "user":
        return event
    out = event
    message = event.get("message")
    content = message.get("content") if isinstance(message, dict) else None
    if isinstance(content, list):
        blocks, cut = _without_image_bytes(content)
        if cut:
            out = {**out, "message": {**message, "content": blocks}}
    result = event.get("tool_use_result")
    file = result.get("file") if isinstance(result, dict) else None
    if isinstance(file, dict) and isinstance(file.get("base64"), str):
        file = {k: v for k, v in file.items() if k != "base64"}
        file["base64_omitted_chars"] = len(result["file"]["base64"])
        out = {**out, "tool_use_result": {**result, "file": file}}
    return out


class ApiServices:
    def __init__(self) -> None:
        self.token = cfg.read_token()
        # Each provider's usage reader and when to read it (2026-10-14).
        self.usage = usage_store.Refresh(
            [cfg.usage_reader(), codex.reader(), agy.reader()],
            live=self.live_providers,
            jobs=lambda: usage_store.running_jobs(self.job_roots()))
        # Making the Claude Code login again, which is one flow at a time for
        # the whole box: see LoginFlow. Idle until somebody asks, and it holds
        # no process while it is.
        self.login = LoginFlow()
        # And Codex's, which is a device code rather than a pasted one.
        self.codex_login = CodexLoginFlow()
        self.antigravity_login = AntigravityLoginFlow()
        # Every wired provider's sign-in, by id: the routes are one set.
        self.login_flows = {"claude-code": self.login,
                            "codex": self.codex_login,
                            "antigravity": self.antigravity_login}

    def job_roots(self) -> list[Path]:
        """Every project's jobs directory, read from disk each time."""
        return [p.jobs for p in eng.projects().values()]

    def live_providers(self) -> set[str]:
        return {s.provider for s in self.live()}

    async def refresh_usage(self) -> None:
        """The usage loop's clock (``loam_provider_usage.Refresh.tick``):
        a look every ``POLL_S``, the reads it decides on off the loop."""
        while True:
            await asyncio.sleep(usage_store.POLL_S)
            try:
                read = await asyncio.to_thread(self.usage.tick,
                                               self.live_providers())
                if read:
                    print(f"usage: read {', '.join(read)}", file=sys.stderr,
                          flush=True)
            except Exception as exc:  # noqa: BLE001 - the loop outlives a bad pass
                print(f"usage: the pass failed ({exc!r})", file=sys.stderr,
                      flush=True)

class Broker(SessionHost, ApiServices):
    def __init__(self):
        SessionHost.__init__(self)
        ApiServices.__init__(self)


class SocketBroker(RemoteRegistry, ApiServices):
    pass


# -- making the login again ------------------------------------------------
#
# The one thing on this box a person cannot do from the app and cannot do
# without: when the refresh token in ``~/.claude/.credentials.json`` expires,
# every session this broker starts stops working, and the only cure is a
# human signing in again. This is that, as three routes.
#
# **What the CLI actually does, measured on this box 2026-09-22** (2.1.270,
# pinned 09-16), because the route is built around what it does and not
# around what it might:
#
#   * With stdin at /dev/null and stdout a pipe, ``claude auth login
#     --claudeai`` prints NOTHING and hangs until it is killed. There is no
#     headless flag and no device-code branch. A route that shelled out to it
#     the ordinary way would hang forever with nothing to show.
#   * Under a pty it prints, in order: ``Opening browser to sign in…``, then
#     ``If the browser didn't open, visit: <url>`` with the URL written twice
#     (an OSC-8 hyperlink target and visible coloured text), then ``Paste code
#     here if prompted >`` -- and blocks on a person.
#   * A code pasted back that is wrong answers ``Login failed: Request failed
#     with status code 400`` and the process exits.
#   * **Starting the flow does not disturb the login already on the box.**
#     Proved with a decoy credentials file under CLAUDE_CONFIG_DIR: started,
#     given a bad code, failed -- and the file was byte-identical afterwards.
#     So this route is safe to call on a login that still works, which is the
#     only way anybody would ever call it.
#
# So: a pty, one flow at a time, and the URL parsed out of what was drawn.
# No token, and no piece of one, is ever answered; the page gets a URL, a
# state and a sentence.


def _make_controlling_tty() -> None:
    """In the child, after setsid: make the pty on fd 0 this session's
    controlling terminal. ``start_new_session`` alone gives the child a pty on
    its file descriptors but no controlling terminal, and the CLI's prompt is
    drawn by a reader that wants one."""
    fcntl.ioctl(0, termios.TIOCSCTTY, 0)


class LoginFlow:
    """One ``claude auth login`` on a pty, and the three things a page can do
    to it: start it, ask how it is going, hand it the code.

    States: ``idle`` (nothing running), ``pending`` (the URL is out and the
    CLI is blocked on a person), ``done``, ``failed``. Only one flow exists at
    a time -- each start mints its own PKCE verifier, so a second flow would
    quietly invalidate the code the person is at that moment pasting.
    """

    def __init__(self) -> None:
        self.state = "idle"
        self.url: str | None = None
        self.message: str | None = None
        self.started_at: str | None = None
        self.finished_at: str | None = None
        self.expires_at: str | None = None
        self.proc = None
        self._master: int | None = None
        self._buf = b""
        self._secret: str | None = None
        self._was = cfg.login_state()
        self._tasks: list[asyncio.Task] = []

    # -- what a route answers ---------------------------------------------

    def snapshot(self) -> dict:
        """The whole of what leaves this box about a flow. The instruction is
        written here rather than in the app so that one sentence describes
        what the CLI on this box actually asks for; an app that wrote its own
        would be guessing at another version's flow."""
        out = {"provider": "claude-code", "kind": "paste-code",
               "state": self.state, "url": self.url, "code": None,
               "accepts_code": self.state == "pending",
               "instructions": None, "message": self.message,
               "started_at": self.started_at, "finished_at": self.finished_at,
               "expires_at": self.expires_at,
               "login": cfg.login_state()}
        if self.state == "pending":
            out["instructions"] = (
                "Open the URL, sign in, and copy the code the page gives you. "
                "Paste it back with POST /v1/providers/claude-code/login/code "
                f"as {{\"code\": \"…\"}} within "
                f"{cfg.LOGIN_FLOW_TIMEOUT_S // 60} minutes.")
        return out

    # -- the flow ----------------------------------------------------------

    async def start(self) -> dict:
        """Start one, or answer the one already running.

        Idempotent on purpose: a phone that loses its connection mid-flow and
        posts again must get back the URL it was already given, not a second
        flow that has invalidated the first.
        """
        if self.state == "pending" and self.proc is not None \
                and self.proc.returncode is None:
            return self.snapshot()
        await self._kill()       # a finished flow's watcher and its pty
        self._reset()
        master, slave = pty.openpty()
        env = dict(os.environ)
        # The CLI draws this prompt with a terminal library; a terminal it has
        # never heard of gets a plainer drawing, not a failure, but this is
        # the one the flow above was measured on.
        env.setdefault("TERM", "xterm-256color")
        env["DISABLE_AUTOUPDATER"] = "1"
        try:
            self.proc = await asyncio.create_subprocess_exec(
                cfg.CLAUDE, *cfg.LOGIN_ARGV,
                stdin=slave, stdout=slave, stderr=slave,
                cwd=str(cfg.AGENTS_ROOT), env=env,
                start_new_session=True, preexec_fn=_make_controlling_tty)
        except OSError as exc:
            os.close(master)
            os.close(slave)
            self.state = "failed"
            self.message = f"the CLI could not be started ({exc})"
            self.finished_at = cfg.now_iso()
            return self.snapshot()
        os.close(slave)          # the child holds the only copy that matters
        os.set_blocking(master, False)
        self._master = master
        # What the login was before this flow touched anything, which is how
        # a finished flow is judged. See _settle.
        self._was = cfg.login_state()
        self.started_at = cfg.now_iso()
        loop = asyncio.get_running_loop()
        loop.add_reader(master, self._drain)
        self._tasks = [asyncio.create_task(self._watch()),
                       asyncio.create_task(self._expire())]
        # Wait for the URL, which is the only part of this a route can
        # usefully report. It arrived in well under a second every time it was
        # measured; the timeout is for the box, not for the person.
        deadline = time.monotonic() + cfg.LOGIN_URL_TIMEOUT_S
        while time.monotonic() < deadline:
            if self.url is None:
                self.url = cfg.login_url(self._buf)
            if self.url is not None:
                self.state = "pending"
                self.expires_at = cfg.epoch_iso(
                    time.time() + cfg.LOGIN_FLOW_TIMEOUT_S)
                return self.snapshot()
            if self.proc.returncode is not None:
                break
            await asyncio.sleep(0.1)
        await self._kill()
        self.state = "failed"
        self.message = (cfg.login_message(self._buf)
                        or f"the CLI printed no sign-in URL in "
                           f"{cfg.LOGIN_URL_TIMEOUT_S}s")
        self.finished_at = cfg.now_iso()
        return self.snapshot()

    async def submit(self, code: str) -> dict:
        """Hand the CLI the code the person copied out of the browser, and
        wait for it to say what happened."""
        if self.state != "pending" or self._master is None \
                or self.proc is None or self.proc.returncode is not None:
            raise BrokerError(
                409, "no login is waiting for a code; start one with POST "
                     "/v1/providers/claude-code/login")
        self._secret = code
        try:
            os.write(self._master, (code + "\r").encode())
        except OSError as exc:
            raise BrokerError(502, f"the CLI would not take the code ({exc})")
        deadline = time.monotonic() + cfg.LOGIN_SUBMIT_TIMEOUT_S
        while time.monotonic() < deadline:
            if self.state != "pending":
                return self.snapshot()
            await asyncio.sleep(0.2)
        # Still thinking. Left running rather than killed: the exchange may
        # yet land, and GET says so when it does.
        return self.snapshot()

    async def cancel(self) -> dict:
        """End a flow nobody is going to finish. The login on the box is
        untouched -- it was never written to."""
        await self._kill()
        self._reset()
        return self.snapshot()

    # -- the machinery -----------------------------------------------------

    def _reset(self) -> None:
        self.state = "idle"
        self.url = self.message = None
        self.started_at = self.finished_at = self.expires_at = None
        self._buf = b""
        self._secret = None
        self.proc = None

    def _drain(self) -> None:
        """Everything the CLI has drawn, kept in one buffer. Bounded: a
        terminal that starts repainting itself must not grow a process that
        lives for fifteen minutes."""
        if self._master is None:
            return
        try:
            chunk = os.read(self._master, 65536)
        except (BlockingIOError, InterruptedError):
            return
        except OSError:
            chunk = b""
        if not chunk:
            self._stop_reading()
            return
        self._buf = (self._buf + chunk)[-65536:]
        if self.url is None:
            self.url = cfg.login_url(self._buf)

    def _stop_reading(self) -> None:
        if self._master is None:
            return
        try:
            asyncio.get_running_loop().remove_reader(self._master)
        except (RuntimeError, ValueError):
            pass
        try:
            os.close(self._master)
        except OSError:
            pass
        self._master = None

    async def _watch(self) -> None:
        """The CLI exiting is the only thing that settles a flow."""
        proc = self.proc
        code = await proc.wait()
        if proc is not self.proc:
            return                      # cancelled, and this is the old one
        await asyncio.sleep(0.2)        # let the last line reach the buffer
        self._drain()
        self._settle(code)

    def _settle(self, code: int) -> None:
        self._stop_reading()
        if self.state in ("done", "failed"):
            return
        message = cfg.login_message(self._buf, self._secret)
        login = cfg.login_state()
        # Judged on the credential, not on what a terminal printed: the
        # credential is what every session will authenticate with.
        #
        # "The file changed since the flow started" is NOT the test, and that
        # was a real false positive: the CLI rewrites that file every time it
        # refreshes an access token, so any session taking a turn during the
        # flow would have made a failed login look like a finished one. What a
        # renewal actually does is mint a new refresh token with a new expiry,
        # so the expiry MOVING is the evidence -- or, when there was no
        # working login to begin with, there simply being one now.
        renewed = (code == 0 and login["connected"]
                   and (login["expires_at"] != self._was["expires_at"]
                        or not self._was["connected"]))
        if renewed:
            self.state = "done"
            self.message = None
        else:
            self.state = "failed"
            self.message = message or "the CLI exited without a new login"
        self._secret = None
        self.finished_at = cfg.now_iso()

    async def _expire(self) -> None:
        await asyncio.sleep(cfg.LOGIN_FLOW_TIMEOUT_S)
        if self.state != "pending":
            return
        await self._kill()
        self.state = "failed"
        self.message = (f"nobody finished the login in "
                        f"{cfg.LOGIN_FLOW_TIMEOUT_S // 60} minutes; start "
                        f"another one")
        self.finished_at = cfg.now_iso()

    async def _kill(self) -> None:
        proc, self.proc = self.proc, None
        # Not the task this runs in: `_expire` is one of `_tasks` and calls
        # this, and a flow cancelling itself is why the wait below once caught
        # `CancelledError` -- which swallowed the broker's own stop as well
        # (2026-10-14). Skipped, a cancel here is only ever a real one.
        here = asyncio.current_task()
        for task in self._tasks:
            if task is not here:
                task.cancel()
        self._tasks = []
        self._stop_reading()
        if proc is None or proc.returncode is not None:
            return
        try:
            proc.kill()
        except ProcessLookupError:
            return
        try:
            async with asyncio.timeout(5):
                await proc.wait()
        except TimeoutError:
            pass


class CodexLoginFlow:
    """One ``codex login --device-auth``, and what a page can do to it:
    start it, read it, cancel it (2026-10-01).

    **What the CLI does, measured on this box** (0.159.3, 2026-10-01): with
    stdin at /dev/null and stdout a pipe -- no pty, unlike ``claude auth
    login`` -- it prints a banner, then "Open this link in your browser and
    sign in to your account" with ``https://auth.openai.com/codex/device``,
    then "Enter this one-time code (expires in 15 minutes)" with the code,
    then a warning to continue only if you started this login, and polls
    until the code is entered or expires. Nothing is pasted back here: the
    person enters the code on OpenAI's page, and the CLI writes
    ``auth.json`` under ``CODEX_HOME`` and exits 0. So there is no code
    route; reading the flow is reading its state.

    States as ``LoginFlow``'s: ``idle``, ``pending`` (URL and code are out),
    ``done``, ``failed``. One flow at a time; a second start answers the
    first, because a second code would leave the first one entered for
    nothing.
    """

    def __init__(self) -> None:
        self.state = "idle"
        self.url: str | None = None
        self.code: str | None = None
        self.message: str | None = None
        self.started_at: str | None = None
        self.finished_at: str | None = None
        self.expires_at: str | None = None
        self.proc = None
        self._buf = ""
        self._tasks: list[asyncio.Task] = []

    def snapshot(self) -> dict:
        out = {"provider": "codex", "kind": "device-code",
               "state": self.state, "url": self.url, "code": self.code,
               "accepts_code": False,
               "instructions": None, "message": self.message,
               "started_at": self.started_at, "finished_at": self.finished_at,
               "expires_at": self.expires_at,
               "login": codex.login_state()}
        if self.state == "pending":
            out["instructions"] = (
                "Open the URL, sign in to ChatGPT, and enter the one-time "
                "code. This page notices the login by itself: GET this route "
                "again for the state.")
        return out

    async def start(self) -> dict:
        if self.state == "pending" and self.proc is not None \
                and self.proc.returncode is None:
            return self.snapshot()
        await self._kill()
        self._reset()
        try:
            self.proc = await asyncio.create_subprocess_exec(
                codex.CODEX, *codex.LOGIN_ARGV,
                stdin=asyncio.subprocess.DEVNULL,
                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.STDOUT,
                cwd=str(codex.CODEX_HOME), env=codex.env(),
                start_new_session=True)
        except OSError as exc:
            self.state = "failed"
            self.message = f"the CLI could not be started ({exc})"
            self.finished_at = cfg.now_iso()
            return self.snapshot()
        self.started_at = cfg.now_iso()
        self._tasks = [asyncio.create_task(self._read()),
                       asyncio.create_task(self._expire())]
        deadline = time.monotonic() + codex.LOGIN_PRINT_TIMEOUT_S
        while time.monotonic() < deadline:
            if self.url and self.code:
                self.state = "pending"
                self.expires_at = cfg.epoch_iso(
                    time.time() + codex.LOGIN_FLOW_TIMEOUT_S)
                return self.snapshot()
            if self.proc.returncode is not None:
                break
            await asyncio.sleep(0.1)
        await self._kill()
        self.state = "failed"
        self.message = (cfg.login_message(self._buf)
                        or f"the CLI printed no code in "
                           f"{codex.LOGIN_PRINT_TIMEOUT_S}s")
        self.finished_at = cfg.now_iso()
        return self.snapshot()

    async def cancel(self) -> dict:
        """End a flow nobody is going to finish. The code dies with the
        process that was polling for it; the login on the box is untouched."""
        await self._kill()
        self._reset()
        return self.snapshot()

    def _reset(self) -> None:
        self.state = "idle"
        self.url = self.code = self.message = None
        self.started_at = self.finished_at = self.expires_at = None
        self._buf = ""
        self.proc = None

    async def _read(self) -> None:
        proc = self.proc
        assert proc is not None and proc.stdout is not None
        while True:
            chunk = await proc.stdout.read(4096)
            if not chunk:
                break
            self._buf = (self._buf + chunk.decode("utf-8", "replace"))[-65536:]
            self.url = self.url or codex.device_url(self._buf)
            self.code = self.code or codex.device_code(self._buf)
        code = await proc.wait()
        if proc is not self.proc or self.state in ("done", "failed", "idle"):
            return
        login = codex.login_state()
        if code == 0 and login["connected"]:
            self.state, self.message = "done", None
        else:
            self.state = "failed"
            self.message = (cfg.login_message(self._buf)
                            or "the CLI exited without a login")
        # A code is a one-time secret for one sign-in; once the flow is over
        # it is answered to nobody.
        self.code = None
        self.finished_at = cfg.now_iso()

    async def _expire(self) -> None:
        await asyncio.sleep(codex.LOGIN_FLOW_TIMEOUT_S)
        if self.state != "pending":
            return
        await self._kill()
        self.state = "failed"
        self.code = None
        self.message = (f"nobody entered the code in "
                        f"{codex.LOGIN_FLOW_TIMEOUT_S // 60} minutes; start "
                        f"another one")
        self.finished_at = cfg.now_iso()

    async def _kill(self) -> None:
        proc, self.proc = self.proc, None
        # Not the task this runs in, for the reason `LoginFlow._kill` gives.
        here = asyncio.current_task()
        for task in self._tasks:
            if task is not here:
                task.cancel()
        self._tasks = []
        if proc is None:
            return
        # By group even when the wrapper has already gone: its native child
        # is the one polling, and may not have. See loam_codex.kill_group.
        codex.kill_group(proc.pid)
        if proc.returncode is not None:
            return
        try:
            async with asyncio.timeout(5):
                await proc.wait()
        except TimeoutError:
            pass


class AntigravityLoginFlow:
    """One ``agy acp --login``, and the four things a page can do to it:
    start it, read it, hand it the code, cancel it (2026-11-11).

    The CLI prints a Google link and reads one line -- the code the landing
    page shows, or that page's whole URL -- from a pipe; no pty (see
    ``loam_antigravity`` "signing in" for what was measured). States as
    ``LoginFlow``'s. One flow at a time: each start mints its own PKCE
    verifier, so a second would void the code being pasted.
    """

    provider = "antigravity"

    def __init__(self) -> None:
        self._tasks: list[asyncio.Task] = []
        self.proc = None
        self._reset()

    def _reset(self) -> None:
        self.state = "idle"
        self.url = self.message = None
        self.started_at = self.finished_at = self.expires_at = None
        self._buf = ""
        self._secret: str | None = None
        self.proc = None

    def snapshot(self) -> dict:
        out = {"provider": self.provider, "kind": "paste-code",
               "state": self.state, "url": self.url, "code": None,
               "accepts_code": self.state == "pending",
               "instructions": None, "message": self.message,
               "started_at": self.started_at, "finished_at": self.finished_at,
               "expires_at": self.expires_at,
               "login": agy.row_login(agy.login_state())}
        if self.state == "pending":
            out["instructions"] = (
                "Open the link, sign in with Google, and paste back the code "
                "the page shows (or the whole address of that page).")
        return out

    async def start(self) -> dict:
        if self.state == "pending" and self.proc is not None \
                and self.proc.returncode is None:
            return self.snapshot()
        await self._kill()
        self._reset()
        try:
            self.proc = await asyncio.create_subprocess_exec(
                agy.AGY, *agy.LOGIN_ARGV,
                stdin=asyncio.subprocess.PIPE,
                stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.STDOUT,
                cwd=str(agy.HOME.parent), env=agy.env(),
                start_new_session=True)
        except OSError as exc:
            self.state = "failed"
            self.message = f"the CLI could not be started ({exc})"
            self.finished_at = cfg.now_iso()
            return self.snapshot()
        self.started_at = cfg.now_iso()
        self._tasks = [asyncio.create_task(self._read()),
                       asyncio.create_task(self._expire())]
        deadline = time.monotonic() + agy.LOGIN_PRINT_TIMEOUT_S
        while time.monotonic() < deadline:
            if self.url and agy.LOGIN_PROMPT in self._buf:
                self.state = "pending"
                self.expires_at = cfg.epoch_iso(
                    time.time() + agy.LOGIN_FLOW_TIMEOUT_S)
                return self.snapshot()
            if self.proc.returncode is not None or self.state == "failed":
                break
            await asyncio.sleep(0.05)
        await self._kill()
        self.state = "failed"
        self.message = (cfg.login_message(self._buf)
                        or f"the CLI printed no sign-in link in "
                           f"{agy.LOGIN_PRINT_TIMEOUT_S}s")
        self.finished_at = cfg.now_iso()
        return self.snapshot()

    async def submit(self, code: str) -> dict:
        proc = self.proc
        if self.state != "pending" or proc is None or proc.returncode is not None \
                or proc.stdin is None:
            raise BrokerError(
                409, "no login is waiting for a code; start one with POST "
                     f"/v1/providers/{self.provider}/login")
        self._secret = code
        try:
            proc.stdin.write((code + "\n").encode())
            await proc.stdin.drain()
            proc.stdin.close()
        except (OSError, ConnectionError) as exc:
            raise BrokerError(502, f"the CLI would not take the code ({exc})")
        deadline = time.monotonic() + agy.LOGIN_SUBMIT_TIMEOUT_S
        while time.monotonic() < deadline:
            if self.state != "pending":
                return self.snapshot()
            await asyncio.sleep(0.1)
        return self.snapshot()

    async def cancel(self) -> dict:
        await self._kill()
        self._reset()
        return self.snapshot()

    async def _read(self) -> None:
        proc = self.proc
        assert proc is not None and proc.stdout is not None
        while True:
            chunk = await proc.stdout.read(4096)
            if not chunk:
                break
            self._buf = (self._buf + chunk.decode("utf-8", "replace"))[-65536:]
            self.url = self.url or agy.signin_url(self._buf)
        code = await proc.wait()
        if proc is not self.proc or self.state in ("done", "failed", "idle"):
            return
        # Judged on the credential: the CLI exited 0 AND the probe, asked
        # fresh, now answers signed in.
        login = await asyncio.to_thread(agy.login_state, True) if code == 0 \
            else {"connected": False}
        if login["connected"]:
            account = agy.signed_in_as(self._buf)
            await asyncio.to_thread(agy.remember_account, account)
            await asyncio.to_thread(agy.login_state, True)
            self.state, self.message = "done", None
        else:
            self.state = "failed"
            self.message = (cfg.login_message(self._buf, self._secret)
                            or "the CLI exited without a login")
        self._secret = None
        self.finished_at = cfg.now_iso()

    async def _expire(self) -> None:
        await asyncio.sleep(agy.LOGIN_FLOW_TIMEOUT_S)
        if self.state != "pending":
            return
        await self._kill()
        self.state = "failed"
        self.message = (f"nobody finished the login in "
                        f"{agy.LOGIN_FLOW_TIMEOUT_S // 60} minutes; start "
                        f"another one")
        self.finished_at = cfg.now_iso()

    async def _kill(self) -> None:
        proc, self.proc = self.proc, None
        here = asyncio.current_task()
        for task in self._tasks:
            if task is not here:
                task.cancel()
        self._tasks = []
        if proc is None or proc.returncode is not None:
            return
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            pass
        try:
            async with asyncio.timeout(5):
                await proc.wait()
        except TimeoutError:
            pass


# -- HTTP ------------------------------------------------------------------
#
# Hand-rolled, and deliberately: the whole interface is eight routes and one
# streaming response, the standard library has no HTTP server that streams
# under asyncio, and a dependency here would have to be installed on the box,
# pinned, and explained. The parsing below is strict about the two things that
# matter (the request line and Content-Length) and indifferent to everything
# else, which is what a single known client needs.

BAD = b"HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\n\r\n"

# How often a stream with nothing to say says so, and it is written into the
# stream's own opening comment (`: open ping=<ms>`) so a client measures
# staleness against the number this broker actually uses rather than one it
# was told once in a document. Silence longer than this plus a margin is a
# connection that has gone, which is a thing a client can see and fix.
KEEPALIVE_S = 15
# The live-sessions stream (2026-11-10): a refresh for the memory numbers, and
# the wait that folds a burst of record changes into one send.
LIVE_REFRESH_S = 10
LIVE_DEBOUNCE_S = 1


def choices(payload: dict, provider: str | None = None) -> dict:
    """The ``model`` and ``effort`` a body asked for, checked here so that
    POST and PATCH refuse the same things in the same words.

    Only the keys that are PRESENT come back, because present-and-null is a
    request ("put this chat back on the persona's own setting") and absent is
    not a request at all. A value the CLI would reject is refused here rather
    than passed to a launch that would die on it, or -- worse, on the PATCH
    path -- to a running process that would answer the bad command in the
    chat and leave the record claiming a model it is not on.
    """
    out: dict = {}
    for field in ("model", "effort"):
        if field not in payload:
            continue
        value = payload[field]
        if value is None:
            out[field] = None
            continue
        if not isinstance(value, str) or not value.strip():
            raise BrokerError(
                400, f"`{field}` is a string or null (null is the persona's "
                     f"own setting)")
        value = value.strip()
        if provider == "codex":
            # Codex's own vocabulary, from its `model/list`; see loam_codex.
            if field == "model" and not codex.model_ok(value):
                listed = ", ".join(m["id"] for m in codex.read_models())
                raise BrokerError(
                    400, f"model {value!r} is not one Codex lists ({listed}). "
                         f"GET /v1/providers lists them with their names.")
            offered = codex.efforts()
            if field == "effort" and offered and value not in offered:
                raise BrokerError(
                    400, f"effort {value!r} is not a Codex level: "
                         f"{', '.join(offered)}.")
            out[field] = value
            continue
        if field == "model" and not cfg.model_ok(value):
            aliases = ", ".join(alias for alias, _ in cfg.CLAUDE_CODE_MODELS)
            raise BrokerError(
                400, f"model {value!r} is not one this CLI takes: an alias "
                     f"({aliases}) or a full model id like claude-fable-5. "
                     f"GET /v1/providers lists them with their names.")
        if field == "effort" and value not in cfg.EFFORTS:
            raise BrokerError(
                400, f"effort {value!r} is not a level: "
                     f"{', '.join(cfg.EFFORTS)}.")
        out[field] = value
    return out


def with_steps(thread_id: str, messages: list[dict]) -> list[dict]:
    """Messages with their full record as ``steps`` (2026-11-10), for
    ``?steps=full``. A message with none (a person's, a system line, a
    reply from before the full record) has ``steps: null``."""
    entries = thread_steps.read(thread_id)
    return [{**m, "steps": (entries.get(m.get("id")) or {}).get("steps")}
            for m in messages]


def truthy(value) -> bool:
    """A query parameter as a flag. `?archived=1`, `?archived=true` and a
    bare `?archived` all mean the same thing, and `?archived=0` does not."""
    if value is None:
        return False
    return str(value).strip().lower() not in ("0", "false", "no")


def persona_changes(who: str, before: dict, after: dict) -> list[str]:
    """The thread lines for a persona's PATCH beyond the two the page's own
    change already leaves (the default, a member brought in): a rename, an
    icon, a member taken out, an engine or a model, a pin, an archive."""
    show = threads_rec.display
    said = []
    if after["title"] != before["title"]:
        said.append(f"{who} renamed this thread to \u201c{after['title']}\u201d")
    if after.get("icon") != before.get("icon"):
        said.append(f"{who} changed the icon to {after['icon']}" if after.get("icon")
                    else f"{who} removed the icon")
    for p in before["members"]:
        if p not in after["members"]:
            said.append(f"{who} took {show(p)} out of this thread")
    for p in after["members"]:
        if p not in before["members"]:
            continue
        if after["engines"].get(p) != before["engines"].get(p):
            said.append(f"{who} put {show(p)} on {after['engines'].get(p)}")
        elif after["models"].get(p) != before["models"].get(p):
            model = after["models"].get(p)
            said.append(f"{who} set {show(p)}'s model to {model}" if model
                        else f"{who} put {show(p)} back on its own model")
    if bool(after.get("pinned")) != bool(before.get("pinned")):
        said.append(f"{who} {'pinned' if after.get('pinned') else 'unpinned'} "
                    f"this thread")
    if bool(after.get("archived")) != bool(before.get("archived")):
        said.append(f"{who} {'archived' if after.get('archived') else 'unarchived'} "
                    f"this thread")
    return said


def author(payload: dict) -> str | None:
    """Who made a change, when it was not the owner on the page (2026-11-10).

    `by` on a thread, session or schedule write names the persona that made
    it through the same route the page uses (`bin/settings`, the `settings`
    tool; lib/loam_settings.py). Absent, empty or an id of the owner's is the owner, which
    is every write the page sends; anything else is a persona on this box or
    a 400. It is attribution, not authority: the token is what lets a caller
    in, and every caller holding it is a process on this box."""
    by = payload.get("by")
    if by is None or by == "":
        return None
    if not isinstance(by, str):
        raise BrokerError(400, "`by` is a persona's name")
    who = by.strip().lower()
    if lc.is_owner(who):
        return None
    if who not in cfg.roster():
        raise BrokerError(400, f"`by`: no persona named {by!r} on this box")
    return who


# The most a JSON body may be. A message's text, a permission's updatedInput:
# nothing on this interface is big except an upload, and an unread
# content-length is an allocation a caller chose for this process.
JSON_BODY_MAX = 4 * 1024 * 1024
# The `multipart/form-data` envelope around a file -- the boundary lines, the
# part's headers, the closing boundary. The cap is a cap on the FILE, so the
# wire body is allowed a little more than the file itself. The app in front of
# this one allows itself the same slack (loam-ui, src/server.js).
MULTIPART_SLACK = 8 * 1024


def parse_multipart(content_type: str, body: bytes) -> list[dict]:
    """The file parts of a `multipart/form-data` body, as bytes.

    Hand-rolled on bytes, and deliberately. The obvious answers are both
    wrong here: `cgi.FieldStorage` is gone from the standard library after
    3.12, and `email.message_from_bytes` decodes a part's payload through a
    str, which silently corrupts a PNG. This reads the envelope and nothing
    else -- it does not decode, transcode or interpret the bytes between the
    boundaries.

    Each part answered as ``{"field", "filename", "type", "bytes"}``. A part
    with no filename is a plain form field and is skipped: this interface has
    no form fields, and one appearing would mean a client had invented some.
    """
    match = re.search(r'boundary=(?:"([^"]+)"|([^;]+))', content_type)
    if not match:
        raise BrokerError(400, "the multipart body states no boundary")
    boundary = b"--" + (match.group(1) or match.group(2)).strip().encode()
    parts = []
    for chunk in body.split(boundary)[1:]:
        if chunk[:2] == b"--":          # the closing boundary
            break
        chunk = chunk.lstrip(b"\r\n")
        head, sep, data = chunk.partition(b"\r\n\r\n")
        if not sep:
            continue
        if data.endswith(b"\r\n"):      # the CRLF that belongs to the boundary
            data = data[:-2]
        field = filename = None
        part_type = ""
        for line in head.decode("utf-8", "replace").splitlines():
            key, _, value = line.partition(":")
            key = key.strip().lower()
            if key == "content-disposition":
                field = re.search(r'\bname="([^"]*)"', value)
                field = field.group(1) if field else None
                filename = re.search(r'\bfilename="([^"]*)"', value)
                filename = filename.group(1) if filename else None
            elif key == "content-type":
                part_type = value.strip()
        if filename is None:
            continue
        parts.append({"field": field, "filename": filename,
                      "type": part_type, "bytes": data})
    return parts


async def discard(reader: asyncio.StreamReader, length: int) -> None:
    """Read a body this interface has already refused, and keep none of it."""
    left = length
    while left > 0:
        chunk = await reader.read(min(left, 64 * 1024))
        if not chunk:
            return
        left -= len(chunk)


def response(status: int, body: dict | list, extra: str = "") -> bytes:
    payload = json.dumps(body, indent=2).encode()
    reason = {200: "OK", 201: "Created", 202: "Accepted", 400: "Bad Request",
              401: "Unauthorized", 403: "Forbidden", 404: "Not Found",
              405: "Method Not Allowed",
              409: "Conflict", 413: "Content Too Large",
              415: "Unsupported Media Type", 422: "Unprocessable Content",
              429: "Too Many Requests",
              500: "Internal Server Error", 502: "Bad Gateway",
              503: "Service Unavailable", 504: "Gateway Timeout"}.get(status, "OK")
    head = (f"HTTP/1.1 {status} {reason}\r\n"
            f"Content-Type: application/json\r\n"
            f"Content-Length: {len(payload)}\r\n"
            f"Connection: close\r\n{extra}\r\n").encode()
    return head + payload


class Server:
    def __init__(self, broker: Broker) -> None:
        self.broker = broker
        # Threads (2026-11-08): the record is lib/loam_threads.py, the turns
        # lib/loam_thread_engine.py; see broker/README.md, "Threads".
        self.threads = loam_thread_engine.ThreadEngine(broker)

    async def handle(self, reader: asyncio.StreamReader,
                     writer: asyncio.StreamWriter) -> None:
        try:
            await self._handle(reader, writer)
        except (ConnectionResetError, BrokenPipeError):
            pass
        except Exception as exc:  # noqa: BLE001 - one client must not kill the box's broker
            print(f"handler error: {exc!r}", file=sys.stderr, flush=True)
            try:
                writer.write(response(500, {"error": str(exc)}))
                await writer.drain()
            except (ConnectionResetError, BrokenPipeError):
                pass
        finally:
            try:
                writer.close()
            except (ConnectionResetError, BrokenPipeError):
                pass

    async def _handle(self, reader: asyncio.StreamReader,
                      writer: asyncio.StreamWriter) -> None:
        request_line = await reader.readline()
        if not request_line:
            return
        try:
            method, target, _ = request_line.decode().split()
        except ValueError:
            writer.write(BAD)
            await writer.drain()
            return
        headers: dict[str, str] = {}
        while True:
            line = await reader.readline()
            if line in (b"\r\n", b"\n", b""):
                break
            key, _, value = line.decode("utf-8", "replace").partition(":")
            headers[key.strip().lower()] = value.strip()
        # An upload is the one body on this interface that is not JSON, and the
        # one that can be megabytes. Both facts are decided here, before a byte
        # of it is kept: how much may be read, and whether it is parsed at all.
        ctype = headers.get("content-type", "")
        upload = ctype.split(";")[0].strip().lower() == "multipart/form-data"
        limit = (cfg.ATTACHMENT_MAX_BYTES + MULTIPART_SLACK if upload
                 else JSON_BODY_MAX)
        body = b""
        too_large = False
        length = int(headers.get("content-length", "0") or 0)
        if length > limit:
            # Read it and throw it away rather than close on a half-sent body:
            # a client whose socket was cut mid-upload never reads the sentence
            # saying why, and the sentence is the whole of the answer.
            too_large = True
            await discard(reader, length)
        elif length:
            body = await reader.readexactly(length)

        path, _, query = target.partition("?")
        params = dict(
            part.split("=", 1) if "=" in part else (part, "")
            for part in query.split("&") if part
        )

        # /up is the one route with no token. It says the broker is listening
        # and nothing else -- no session, no agent name, no count -- so it is
        # safe to answer unauthenticated, and a health check that needed a
        # credential would be a health check nobody runs.
        if path == "/up":
            if getattr(self.broker, "remote", False):
                try:
                    await self.broker.client.call("health")
                except (OSError, BrokerError):
                    writer.write(response(503, {"ok": False, "service": "session-broker"}))
                    await writer.drain()
                    return
            writer.write(response(200, {"ok": True, "service": "session-broker"}))
            await writer.drain()
            return

        if headers.get("authorization", "") != f"Bearer {self.broker.token}":
            writer.write(response(401, {"error": "bearer token required"}))
            await writer.drain()
            return

        if too_large:
            writer.write(response(413, {"error": (
                f"that is bigger than this interface carries "
                f"({human_size(cfg.ATTACHMENT_MAX_BYTES)} at most)"
                if upload else "the body is too big")}))
            await writer.drain()
            return

        payload: dict = {}
        if body and not upload:
            try:
                payload = json.loads(body)
            except json.JSONDecodeError:
                writer.write(response(400, {"error": "body is not JSON"}))
                await writer.drain()
                return

        try:
            guard = nullcontext(True) if method in ("GET", "HEAD") else fence.admission()
            with guard as admitted:
                if not admitted:
                    raise BrokerError(503, "session maintenance in progress; retry shortly")
                await self.route(method, path, params, payload, writer,
                                 raw=body, content_type=ctype)
        except (BrokerError, threads_rec.ThreadError) as exc:
            writer.write(response(exc.status, {"error": exc.message,
                                               **getattr(exc, "detail", {})}))
            await writer.drain()

    async def route(self, method: str, path: str, params: dict, payload: dict,
                    writer: asyncio.StreamWriter, raw: bytes = b"",
                    content_type: str = "") -> None:
        parts = [p for p in path.split("/") if p]
        broker = self.broker
        remote = getattr(broker, "remote", False)

        if parts == ["v1", "agent-availability"] and method == "GET":
            from loam_check import current_run_status
            status = await asyncio.to_thread(current_run_status)
            writer.write(response(200, status))
            await writer.drain()
            return

        # What a client must know before it does something this interface would
        # refuse. One number so far: the biggest file a chat carries, asked for
        # by the app so that a phone is told in the composer rather than after
        # a minute of uploading. A client that does not ask is not broken --
        # the upload route is the gate, and it answers in a sentence.
        if parts == ["v1", "limits"] and method == "GET":
            writer.write(response(200, {
                "attachment_max_bytes": cfg.ATTACHMENT_MAX_BYTES,
                "inline_image_max_bytes": cfg.INLINE_IMAGE_MAX_BYTES,
                "attachment_types": sorted(set(cfg.ATTACHMENT_TYPES.values())),
                # Files' Upload: the same cap, its own list of extensions.
                "files_upload_max_bytes": files_api.UPLOAD_MAX,
                "files_upload_extensions": sorted(files_api.UPLOAD_TYPES),
            }))
            await writer.drain()
            return

        # Who this install is for (2026-11-14, first release L2): the id the
        # runtime writes for the owner and the ids it accepts as the owner's
        # (`owner.id`, plus the legacy id for this release), and the name to
        # show. The page reads it once and never assumes an id.
        if parts == ["v1", "owner"] and method == "GET":
            writer.write(response(200, lc.owner()))
            await writer.drain()
            return


        # Files (2026-10-02): the vault, the agents' spaces and the runtime's
        # documents, by root and relative path only. lib/loam_files.py holds
        # every rule; this only decodes the query once and writes the answer.
        if parts[:2] == ["v1", "files"]:
            await self.files_route(method, parts[2:], params, payload, writer,
                                   raw, content_type)
            return

        # Threads and boards (2026-11-08). Beside the sessions, not instead of
        # them: every /v1/sessions route is unchanged and is Classic chats.
        if parts[:2] == ["v1", "threads"]:
            await self.threads_route(method, parts[2:], params, payload, writer,
                                     raw, content_type)
            return

        # Schedules, Activity and the engineer's jobs (2026-10-14): see
        # lib/loam_activity.py and broker/README.md, "Schedules and Activity".
        if parts[:2] in (["v1", "schedules"], ["v1", "activity"], ["v1", "jobs"]):
            await self.activity_route(method, parts[1:], params, payload, writer)
            return

        # The settings registry (2026-11-10): every setting the page can
        # change, the route it goes to and whose hands it is in, read from
        # lib/loam_settings.py -- the table `bin/settings` works from, so a
        # client can draw from the one source. Words and routes, no values.
        if parts == ["v1", "settings"] and method == "GET":
            writer.write(response(200, {"settings": loam_settings.table()}))
            await writer.drain()
            return

        # Apps (2026-11-12): the Apps section's list -- the agents' own sites
        # and the projects' deployed containers, read from the deployment
        # layer each time (lib/loam_apps.py; broker/README.md, "Apps").
        # Read-only; a record the generator would refuse is a 503 that says
        # which, since the list cannot be told without it.
        if parts == ["v1", "apps"]:
            nocache = "Cache-Control: no-store\r\n"
            if method != "GET":
                writer.write(response(405, {"error": "the apps list is read-only; use GET"},
                                      nocache))
            else:
                try:
                    value = await asyncio.to_thread(loam_apps.listing)
                    writer.write(response(200, value, nocache))
                except Exception as exc:  # noqa: BLE001 -- a DeployError, or a file gone mid-read
                    writer.write(response(503, {"error": f"the apps list cannot be read: {exc}"},
                                          nocache))
            await writer.drain()
            return

        # Plugins (2026-11-12): the plugin host's one list, on and off,
        # install from a link (two calls: what it declares, then a confirm),
        # remove, and a plugin's page files for the page's loader. Every rule
        # is lib/loam_plugins.py; docs/plugins.md is the interface.
        if parts[:2] == ["v1", "plugins"]:
            await self.plugins_route(method, parts[2:], payload, writer)
            return

        # The marketplace (2026-11-17): the list Settings › Plugins draws
        # above "Install from a link". A read; an install from it is the
        # plugins route's, by the entry's link. Never an error for a list
        # that is not there: lib/loam_marketplace.py says empty.
        if parts == ["v1", "marketplace"]:
            if method != "GET":
                writer.write(response(405, {"error": "use GET for the marketplace's list"},
                                      "Cache-Control: no-store\r\n"))
            else:
                refresh = params.get("refresh") == "1"
                body = await asyncio.to_thread(loam_marketplace.listing, refresh)
                writer.write(response(200, body, "Cache-Control: no-store\r\n"))
            await writer.drain()
            return
        # A listing's own page (2026-11-18, Settings › Market): what the
        # plugin at its link declares, read as an install's first call reads
        # it (nothing written), and its icon, covers, README pictures and
        # theme.css for the Market to draw. Reads only; installing is the plugins route's.
        if parts[:2] == ["v1", "marketplace"] and len(parts) >= 3:
            nocache = "Cache-Control: no-store\r\n"
            try:
                if method not in ("GET", "HEAD"):
                    raise BrokerError(405, "a listing is read with GET")
                if len(parts) == 3:
                    body = await asyncio.to_thread(loam_marketplace.details, parts[2],
                                                   params.get("refresh") == "1")
                    writer.write(response(200, body, nocache))
                else:
                    # A README's picture is `readme/<path>`, any depth.
                    data, ctype = await asyncio.to_thread(loam_marketplace.file,
                                                          parts[2], "/".join(parts[3:]))
                    head = (f"HTTP/1.1 200 OK\r\nContent-Type: {ctype}\r\n"
                            f"Content-Length: {len(data)}\r\n"
                            f"Cache-Control: private, max-age=600\r\n"
                            f"X-Content-Type-Options: nosniff\r\n"
                            f"Connection: close\r\n\r\n").encode()
                    writer.write(head + (b"" if method == "HEAD" else data))
            except loam_marketplace.NotListed as exc:
                writer.write(response(404, {"error": str(exc)}, nocache))
            except loam_plugins.PluginError as exc:
                writer.write(response(exc.status, {"error": exc.message}, nocache))
            except BrokerError as exc:
                writer.write(response(exc.status, {"error": exc.message}, nocache))
            await writer.drain()
            return

        # Shared keys (2026-11-18): Settings › Connections › API keys. API keys by provider,
        # entered once; each plugin that declared a provider uses its shared
        # key unless it has its own. Every rule is lib/loam_keys.py;
        # docs/plugins.md, "Keys", is the interface. An agent may change them
        # with `by` (the owner, 2026-11-10: every setting is an agent's too);
        # no route here ever answers a whole value.
        if parts[:2] == ["v1", "keys"]:
            nocache = "Cache-Control: no-store\r\n"
            rest = parts[2:]
            try:
                by = author(payload) if method != "GET" else None
                if not rest and method == "GET":
                    body = await asyncio.to_thread(loam_keys.listing)
                elif len(rest) == 1 and method == "GET":
                    body = await asyncio.to_thread(loam_keys.one, rest[0])
                elif len(rest) == 1 and method == "PUT":
                    body = await asyncio.to_thread(loam_keys.set_shared, rest[0], payload, by)
                    print(f"keys: {rest[0]} saved by {by or lc.OWNER_ID}",
                          file=sys.stderr, flush=True)
                elif len(rest) == 1 and method == "DELETE":
                    body = await asyncio.to_thread(loam_keys.forget_shared, rest[0], by)
                    print(f"keys: {rest[0]} forgotten by {by or lc.OWNER_ID}",
                          file=sys.stderr, flush=True)
                elif rest[1:] == ["check"] and method == "POST":
                    body = await asyncio.to_thread(loam_keys.recheck, rest[0], by)
                elif len(rest) == 3 and rest[1] == "plugins" and method == "PUT":
                    body = await asyncio.to_thread(loam_keys.set_own, rest[0], rest[2],
                                                   payload, by)
                    print(f"keys: {rest[2]} uses its own {rest[0]} key (by "
                          f"{by or lc.OWNER_ID})", file=sys.stderr, flush=True)
                elif len(rest) == 3 and rest[1] == "plugins" and method == "DELETE":
                    body = await asyncio.to_thread(loam_keys.use_shared, rest[0], rest[2], by)
                    print(f"keys: {rest[2]} uses the shared {rest[0]} key (by "
                          f"{by or lc.OWNER_ID})", file=sys.stderr, flush=True)
                else:
                    raise BrokerError(405, "GET /v1/keys[/<provider>]; PUT or DELETE "
                                           "/v1/keys/<provider>; POST …/<provider>/check; "
                                           "PUT or DELETE …/<provider>/plugins/<id>")
                writer.write(response(200, body, nocache))
            except loam_keys.KeyError_ as exc:
                writer.write(response(exc.status, {"error": str(exc)}, nocache))
            await writer.drain()
            return

        # Updates (2026-11-14, first release L13): Settings › About Loam reads
        # the state, checks, applies and rolls back. Every rule is
        # lib/loam_update.py; docs/update.md is the page contract.
        if parts[:2] == ["v1", "update"]:
            await self.update_route(method, parts[2:], payload, writer)
            return

        # Appearance (2026-11-11): mode and size for the phone and the
        # desktop, kept on the host in state/broker/settings.json so every
        # browser agrees and a persona can set it (lib/loam_appearance.py).
        # GET fills defaults; PATCH merges named fields in one write and
        # answers the whole value. `by` is the one field beside the kinds.
        if parts == ["v1", "settings", "appearance"]:
            nocache = "Cache-Control: no-store\r\n"
            if method not in ("GET", "PATCH"):
                writer.write(response(405, {"error": "use GET or PATCH for appearance"},
                                      nocache))
                await writer.drain()
                return
            try:
                if method == "GET":
                    value = await asyncio.to_thread(loam_appearance.read)
                else:
                    by = author(payload)
                    patch = {k: v for k, v in payload.items() if k != "by"}
                    value = await asyncio.to_thread(loam_appearance.update, patch)
                    print(f"appearance: {json.dumps(patch, sort_keys=True)} by "
                          f"{by or lc.OWNER_ID}", file=sys.stderr, flush=True)
            except loam_appearance.AppearanceError as exc:
                writer.write(response(exc.status, {"error": exc.message}, nocache))
                await writer.drain()
                return
            writer.write(response(200, value, nocache))
            await writer.drain()
            return

        # Whose name agents' commits carry (2026-11-18, lib/loam_git_identity.py):
        # the owner's GitHub account (its name and no-reply address, read once
        # from GitHub with the connection's own token) or a typed name and
        # address; unset is the default (the one connected account), and
        # "neutral" opts out. GET answers the choice, what commits carry now
        # and, when that is the engineer's by no choice of the owner's, the
        # prompt; PATCH takes {"identity": "github" | {"name", "email"} |
        # "neutral" | null}. The address is never logged.
        if parts == ["v1", "settings", "git"]:
            nocache = "Cache-Control: no-store\r\n"
            if method not in ("GET", "PATCH"):
                writer.write(response(405, {"error": "use GET or PATCH for the git identity"},
                                      nocache))
                await writer.drain()
                return
            try:
                if method == "PATCH":
                    by = author(payload)
                    patch = {k: v for k, v in payload.items() if k != "by"}

                    def github_user():
                        import loam_github_app  # noqa: PLC0415
                        try:
                            _, user = loam_github_app.api(
                                "GET", "/user", loam_github_app.user_token())
                        except loam_github_app.IntegrationError as exc:
                            raise loam_git_identity.IdentityError(
                                f"GitHub could not be asked: {exc}", 409) from None
                        return user

                    def write():
                        value = loam_git_identity.validate(patch, github_user)
                        loam_appearance.mutate(loam_git_identity.KEY, lambda _old: value)
                        return value
                    value = await asyncio.to_thread(write)
                    print(f"git identity: {value['source'] if value else 'default'} by "
                          f"{by or lc.OWNER_ID}", file=sys.stderr, flush=True)
                view = await asyncio.to_thread(loam_git_identity.public)
            except loam_git_identity.IdentityError as exc:
                writer.write(response(exc.status, {"error": exc.message}, nocache))
                await writer.drain()
                return
            except loam_appearance.AppearanceError as exc:
                writer.write(response(exc.status, {"error": exc.message}, nocache))
                await writer.drain()
                return
            writer.write(response(200, view, nocache))
            await writer.drain()
            return

        # Making an agent by conversation, archiving and restoring it, and
        # its uploaded face (2026-11-14, first release L10): every rule is
        # lib/loam_agents.py; broker/README.md, "Making, archiving and
        # restoring agents", is the contract. Before the profile's route,
        # whose `/v1/agents/<agent>` would otherwise take `drafts` and `new`
        # as agents' names (both are reserved ids).
        if parts[:2] == ["v1", "agents"] and (
                parts[2:3] in (["drafts"], ["new"])
                or (len(parts) == 4 and parts[3] in ("archive", "restore", "face"))):
            await self.agents_route(method, parts[2:], params, payload, writer,
                                    raw, content_type)
            return

        # Which agent hears when something in Loam needs attention
        # (2026-11-19, batch B step 5; lib/loam_attention.py): GET the
        # choice, PATCH {"persona": id | null}. Settings › Agents, or a
        # persona through bin/settings (`system.persona`). Nothing is said
        # anywhere when it changes; the journal has the line.
        if parts == ["v1", "system", "persona"]:
            import loam_attention as attention_mod  # noqa: PLC0415
            import loam_appearance as appearance_mod  # noqa: PLC0415
            nocache = "Cache-Control: no-store\r\n"
            if method == "GET":
                body, status = await asyncio.to_thread(attention_mod.state), 200
            elif method == "PATCH":
                if not isinstance(payload, dict) or "persona" not in payload:
                    body, status = {"error": "send {\"persona\": an agent's id, "
                                             "or null for the first agent}"}, 400
                else:
                    try:
                        value = await asyncio.to_thread(
                            attention_mod.validate, payload.get("persona"))
                    except ValueError as exc:
                        body, status = {"error": str(exc)}, 400
                    else:
                        await asyncio.to_thread(
                            appearance_mod.mutate, attention_mod.SETTING,
                            lambda cur, v=value: ({**(cur if isinstance(cur, dict) else {}),
                                                   "persona": v} if v else None))
                        body, status = await asyncio.to_thread(attention_mod.state), 200
                        print(f"settings: system.persona -> {body['persona']} "
                              f"by {author(payload) or lc.OWNER_ID}",
                              file=sys.stderr, flush=True)
            else:
                body, status = {"error": "use GET or PATCH"}, 405
            writer.write(response(status, body, nocache))
            await writer.drain()
            return

        # An agent's profile, the engineers and the reviewer (2026-11-13):
        # lib/loam_profile.py holds every rule; broker/README.md, "Agent
        # profiles, engineers and the reviewer", is the contract.
        if (len(parts) == 3 and parts[:2] == ["v1", "agents"]) or \
                parts[:2] == ["v1", "engineers"] or \
                parts == ["v1", "system", "reviewer"]:
            await self.profile_route(method, parts[1:], payload, writer)
            return

        if parts == ["v1", "agents"] and method == "GET":
            # Objects since 2026-09-18, not the bare strings this answered
            # before: the page draws each agent's name and mark, and both are
            # stated in the persona's own agent.json. See cfg.agent_card.
            # `?archived=1` (2026-11-14): the archived ones instead, each
            # with its `archived` mark (Settings › Agents › Archived).
            if truthy(params.get("archived")):
                writer.write(response(200, {"agents": await asyncio.to_thread(
                    loam_agents.archived_cards)}))
                await writer.drain()
                return
            writer.write(response(200, {"agents": cfg.roster_cards()}))
            await writer.drain()
            return

        if parts == ["v1", "providers"] and method == "GET":
            # `?agent=` only decides which model the answer calls the
            # default, and a name nobody has simply ticks nothing. It is not
            # a filter and it is not required: the rows are the same rows.
            # On a thread: the Codex row may run `codex login status`.
            writer.write(response(200, {
                "providers": await asyncio.to_thread(
                    self.providers, params.get("agent"))}))
            await writer.drain()
            return

        # Making the login again, from the app. Three routes on the one wired
        # provider, and a fourth to call the whole thing off. Named under the
        # provider rather than at the top level because that is what it is
        # about -- and because a second provider will one day need its own.
        # See LoginFlow above for what the CLI does and what was measured.
        # Sign-out (2026-11-11): removes the login from the box, on the
        # providers whose row carries `sign_in.sign_out`.
        if (len(parts) == 4 and parts[:2] == ["v1", "providers"]
                and parts[3] == "logout" and method == "POST"):
            provider = parts[2]
            if provider not in cfg.SIGN_OUT_PROVIDERS:
                raise BrokerError(
                    405 if provider in cfg.WIRED_PROVIDERS else 404,
                    f"{provider!r} is not signed out from the app; its row's "
                    f"`sign_in.sign_out` is null. GET /v1/providers says "
                    f"which are.")
            # Never under a turn (2026-11-11): a chat on this provider that
            # is working, asking or waiting on its children would lose its
            # login mid-flight, so the sign-out waits for it.
            if remote:
                await broker.synchronize()
            busy = [s for s in broker.sessions.values()
                    if s.provider == provider and s.is_live() and s.busy()]
            if busy:
                raise BrokerError(
                    409, f"{len(busy)} {cfg.PROVIDER_NAMES[provider]} chat"
                    f"{'s are' if len(busy) > 1 else ' is'} mid-turn or "
                    f"asking; sign out when "
                    f"{'they finish' if len(busy) > 1 else 'it finishes'}.")
            if broker.login_flows[provider].state == "pending":
                await broker.login_flows[provider].cancel()
            if provider == "antigravity":
                out = await asyncio.to_thread(agy.sign_out)
            elif provider == "codex":
                out = await asyncio.to_thread(codex.sign_out)
                out["login"] = await asyncio.to_thread(self.codex_login)
            else:
                out = await asyncio.to_thread(cfg.claude_code_sign_out)
            writer.write(response(200, out))
            await writer.drain()
            return

        if (len(parts) >= 4 and parts[:2] == ["v1", "providers"]
                and parts[3] == "login"):
            provider, tail = parts[2], parts[4:]
            if provider not in cfg.WIRED_PROVIDERS:
                raise BrokerError(
                    404, f"{provider!r} has no login to make: it is "
                         f"{cfg.NOT_WIRED}. GET /v1/providers says which are.")
            flow = broker.login_flows[provider]
            if not tail and method == "POST":
                # 201 when this call started one, 200 when it handed back the
                # flow that was already running.
                was = flow.state
                out = await flow.start()
                writer.write(response(
                    201 if was != "pending" and out["state"] == "pending"
                    else 200, out))
                await writer.drain()
                return
            if not tail and method == "GET":
                writer.write(response(200, flow.snapshot()))
                await writer.drain()
                return
            if not tail and method == "DELETE":
                writer.write(response(200, await flow.cancel()))
                await writer.drain()
                return
            if tail == ["code"] and method == "POST" \
                    and cfg.SIGN_IN_KINDS[provider] != "paste-code":
                raise BrokerError(
                    405, f"a {cfg.PROVIDER_NAMES[provider]} login is a device "
                         f"code entered on the provider's page; there is "
                         f"nothing to paste back here. GET "
                         f"/v1/providers/{provider}/login says when it is done.")
            if tail == ["code"] and method == "POST":
                code = payload.get("code")
                if not isinstance(code, str) or not code.strip():
                    raise BrokerError(400, "a `code` is required: the one the "
                                           "sign-in page gave you")
                writer.write(response(200, await flow.submit(code.strip())))
                await writer.drain()
                return

        if parts[:3] == ["v1", "integrations", "github"]:
            await self.github(method, parts[3:], params, payload, writer)
            return

        # `/v1/integrations/<id>` for a plugin's integration was forwarded to
        # the plugin's server from 2026-11-14 (L5) until loam-ui 1c4ec9b moved
        # the page to `/x/<id>/`; retired the same day (L11). It is answered
        # now as any unknown route is.

        if parts == ["v1", "sessions"] and method == "GET":
            # A conversation started in the Claude Code app becomes a row here
            # within a minute, without a restart: the scan for files nobody has
            # adopted runs on a read of the list, at most that often, and the
            # records already held are brought into step by `known` itself.
            rows, residency = await self.catalog(params.get("agent"))
            # `?archived=1` is still accepted and changes nothing: since the
            # classic view retired (2026-11-12) every record is listed, which
            # is what Running now, the one reader, always asked for.
            if params.get("turns") != "all":
                rows = [list_row(r) for r in rows]
            writer.write(response(200, {
                "sessions": rows,
                # `live_count` and `cap`: the resident count and the ceiling,
                # for "2 of 4 live". `live` is what that count was called
                # before each session carried its own `live` boolean
                # (2026-09-25), and it is kept because removing it would be a
                # silent break of a client reading it -- but one word cannot
                # mean a number here and a boolean there, so `live_count` is
                # the name from now on and this one is the compatibility copy.
                **residency, "live": residency["live_count"]}))
            await writer.drain()
            return

        # `POST /v1/sessions` (start or resume a classic chat), `PATCH` on a
        # session, `POST /v1/sessions/seen` and a session's `events`,
        # `messages`, `attachments` and `compact` retired with the classic
        # chat view on 2026-11-12 (the owner, 2026-11-11). A thread starts and
        # resumes its members' sessions itself (lib/loam_thread_engine.py),
        # and a thread is what a person talks in. broker/README.md, "The
        # classic chat routes, retired".

        # The live sessions (2026-11-10): what is in RAM now, thread members
        # and classic chats alike, with the box's totals for a small gauge;
        # its stream; and "end all idle". Fixed paths, checked before the
        # per-session block, which would otherwise read `live` as an id
        # (ids are UUIDs the broker mints). broker/README.md, "Live sessions".
        if parts == ["v1", "sessions", "live"] and method == "GET":
            if remote:
                await broker.synchronize()
            writer.write(response(200, self.live_view()))
            await writer.drain()
            return
        if parts == ["v1", "sessions", "live", "events"] and method == "GET":
            await self.live_stream(writer)
            return
        if parts == ["v1", "sessions", "end-idle"] and method == "POST":
            by = author(payload)
            if remote:
                await broker.synchronize()
            ended = await self.end_idle()
            if by:
                print(f"sessions: end-idle by {by}: {ended}", file=sys.stderr,
                      flush=True)
            writer.write(response(200, ended))
            await writer.drain()
            return

        # Like `events` below, a fixed three-part path checked before the
        # per-session block, which would otherwise read `adopt` as an id.
        # A session whose id is literally `adopt` is unaffected: it is
        # reached at /v1/sessions/adopt/events and PATCHed at its own path,
        # and ids are UUIDs the broker mints.
        if parts == ["v1", "sessions", "adopt"] and method == "POST":
            report = await broker.client.call("adopt") if remote else broker.adopt_app_sessions()
            writer.write(response(200, report))
            await writer.drain()
            return

        # Before the per-session block below, which would otherwise read
        # "events" as a session id and answer 404 for the live list.
        if parts == ["v1", "sessions", "events"] and method == "GET":
            await self.stream_records(writer,
                                      full=params.get("turns") == "all")
            return

        if len(parts) >= 3 and parts[0] == "v1" and parts[1] == "sessions":
            session_id = parts[2]
            tail = parts[3:]

            if not tail and method == "GET":
                # `load`, not `_session`: a record outlives its process, and
                # the id a client has in hand is usually one it read off the
                # listing, where every session is a record and most are ended.
                session = await broker.inspect(session_id) if remote else broker.load(session_id)
                writer.write(response(200, session.meta()))
                await writer.drain()
                return

            if not tail and method == "DELETE":
                session = await broker.inspect(session_id) if remote else self._session(session_id)
                by = author(payload)
                if by:
                    print(f"sessions: {session_id} ended by {by}",
                          file=sys.stderr, flush=True)
                # A thread member's session mid-turn: the turn ends with one
                # quiet line in the thread, and the next mention resumes the
                # session by id (2026-11-10). The thread itself is untouched.
                thread_id = self.threads.mark_ended(session_id)
                await session.stop()
                record = session.meta()
                if thread_id:
                    record["ended_turn_in"] = thread_id
                writer.write(response(200, record))
                await writer.drain()
                return

            if len(tail) == 2 and tail[0] == "permissions" and method == "POST":
                session = await broker.inspect(session_id) if remote else self._session(session_id)
                behavior, updates = permission_decision(payload)
                await session.answer_permission(
                    tail[1], behavior, payload.get("message"),
                    payload.get("updatedInput"), payload.get("answers"),
                    updates or None)
                writer.write(response(200, {"answered": tail[1],
                                            "behavior": behavior}))
                await writer.drain()
                return

        writer.write(response(405, {"error": f"no route for {method} {path}"}))
        await writer.drain()

    # -- the live sessions (2026-11-10) --------------------------------------

    def _thread_of(self) -> dict[str, tuple[str, str]]:
        """Session id -> (thread id, persona), for every member session the
        thread state remembers and every turn in flight."""
        out: dict[str, tuple[str, str]] = {}
        try:
            for tid, members in threads_rec.load_state("sessions.json").items():
                for persona, kept in (members or {}).items():
                    if isinstance(kept, dict) and kept.get("session_id"):
                        out[kept["session_id"]] = (tid, persona)
        except (OSError, ValueError, AttributeError):
            pass
        for key, session in list(self.threads.turn_sessions.items()):
            if key in self.threads.turns and getattr(session, "id", None):
                out[session.id] = key
        return out

    def live_row(self, session, thread_of: dict, titles: dict,
                 kids: dict) -> dict:
        state = loam_live.state_of(session.busy())
        pid = getattr(getattr(session, "proc", None), "pid", None)
        started = loam_live.started_ts(pid)
        last = getattr(session, "last_activity", None)

        def stamp(ts):
            return (datetime.fromtimestamp(ts, timezone.utc)
                    .strftime("%Y-%m-%dT%H:%M:%SZ") if ts else None)
        # `model` is the model the session is running on as its CLI said it
        # (Claude's `system/init`, Codex's thread start), else the one it was
        # asked for; `model_asked` is the ask (null: the persona's default).
        # Since 2026-11-12, for Activity: until then `model` was only the
        # ask, so a thread on its persona's default read `opus`.
        asked = getattr(session, "model", None)
        provider = getattr(session, "provider", None)
        engine = loam_waiters.engine_id(provider) or provider or "claude-code"
        row = {"id": session.id, "agent": session.agent,
               "engine": engine,
               "engine_label": loam_waiters.ENGINE_LABELS.get(engine, engine),
               "model": running_model(session) or asked,
               "model_asked": asked,
               "state": state, "last_active": stamp(last),
               # The newest event the session wrote (2026-11-16; since
               # 11-17 it no longer lets a restart go: loam_live).
               "last_event_at": getattr(session, "last_event_at", None),
               "idle_since": stamp(last) if state == "idle" else None,
               "started_at": stamp(started),
               "rss_mb": loam_live.tree_rss_mb(pid, kids),
               "ending": loam_live.ending(state)}
        where = thread_of.get(session.id)
        if where:
            tid = where[0]
            if tid not in titles:
                try:
                    titles[tid] = threads_rec.read(tid)[0]["title"]
                except Exception:  # noqa: BLE001 - a deleted thread keeps its row
                    titles[tid] = (getattr(session, "title", None) or "") \
                        .removeprefix("Thread · ") or None
            row.update(kind="thread", run_kind="thread", thread_id=tid,
                       thread_title=titles[tid], title=None)
        else:
            row.update(kind="classic", run_kind="conversation", thread_id=None,
                       thread_title=None, title=getattr(session, "title", None))
        return row

    async def deliver_owed(self) -> None:
        """Every `DELIVER_EVERY_S`, the engineer results owed to a thread
        (lib/loam_waiters.py): every brief from a thread returns at once
        (since 2026-11-18). Once its job has a verdict, the persona that
        sent it gets a turn in the thread it briefed from whose input is the
        result; nothing is posted (`ThreadEngine.deliver_job`). Oldest
        verdict first. A result whose thread is gone, or whose persona left
        it, goes by a run of that persona instead (lib/loam_results.py,
        2026-11-19), never dropped. Results for runs with no thread are not
        this pass's: bin/wake delivers them, broker or no broker.
        Fail-soft: never the reason a broker is down."""
        await asyncio.sleep(DELIVER_FIRST_S)
        while not self.broker.stopping:
            with fence.admission() as admitted:
                if admitted:
                    await self.deliver_once()
            await asyncio.sleep(DELIVER_EVERY_S)

    async def deliver_once(self):
        try:
            for record in await asyncio.to_thread(loam_waiters.owed):
                try:
                    brief = (Path(record["job_dir"]) / "brief.md").read_text(
                        encoding="utf-8")
                    title = loam_memory.front_matter(brief).get("title")
                except (OSError, KeyError):
                    title = None
                outcome = self.threads.deliver_job(
                    record, loam_waiters.handoff_text(record, title))
                if outcome == "waiting for a provider":
                    continue
                loam_waiters.done(record, outcome)
                if outcome in ("no thread", "thread gone", "not a member"):
                    # Logged and removed as a thread's, then written
                    # again as a run's.
                    kicked = await asyncio.to_thread(
                        loam_results.to_headless, record, outcome)
                    outcome = f"{outcome}; handed to a run ({kicked})"
                if outcome == "already delivered":
                    continue  # said when it was; a record that would not go
                print(f"deliver: job {record.get('job')} -> "
                      f"{record.get('thread') or 'no thread'} "
                      f"{record.get('persona')}: {outcome}",
                      file=sys.stderr, flush=True)
        except Exception as exc:  # noqa: BLE001
            print(f"deliver: the pass failed ({exc!r})", file=sys.stderr,
                  flush=True)
        # What an update left for the person's agent (2026-11-14, first
        # release L13, lib/loam_update.py): one line in General and a
        # turn for General's default agent, to say it in its own words.
        try:
            for note in await asyncio.to_thread(loam_update.owed_notices):
                outcome = self.threads.deliver_note(note)  # on the loop, as deliver_job
                loam_update.notice_done(note, outcome)  # says a stuck one once
                if outcome == "already delivered":
                    continue
                print(f"deliver: update notice {note.get('id')} "
                      f"({note.get('kind')}): {outcome}", file=sys.stderr,
                      flush=True)
        except Exception as exc:  # noqa: BLE001
            print(f"deliver: the update notices failed ({exc!r})",
                  file=sys.stderr, flush=True)

    def live_view(self) -> dict:
        """`GET /v1/sessions/live`: every session with a process behind it,
        and the box's totals. Reads /proc once; no record is read but the
        titles of the threads that have a live member."""
        broker = self.broker
        live = broker.live()
        thread_of, titles = self._thread_of(), {}
        try:
            kids = loam_live.children()
        except OSError:
            kids = {}
        rows = sorted((self.live_row(s, thread_of, titles, kids) for s in live),
                      key=lambda r: r["last_active"] or "", reverse=True)
        mi = loam_live.meminfo_mb()
        room = broker.room()
        total, avail = mi.get("MemTotal"), mi.get("MemAvailable")
        box = {"ram_total_mb": total,
               "ram_used_mb": (total - avail) if total and avail is not None else None,
               "ram_available_mb": room.get("available_mb"),
               "reserve_mb": room.get("reserve_mb"),
               "start_mb": room.get("need_mb"),
               "can_start": loam_live.can_start(
                   room.get("available_mb"), room.get("reserve_mb") or 0,
                   room.get("need_mb") or cfg.SESSION_START_MB, room.get("starting") or 0,
                   room.get("cgroup_room_mb"), cfg.MAX_SESSIONS - broker.seats_taken()),
               "sessions": {"live": len(rows),
                            "mb": sum(r["rss_mb"] or 0 for r in rows),
                            "idle": sum(1 for r in rows if r["state"] == "idle")},
               "units": loam_live.units()}
        # Thread turns in flight (2026-11-17), with or without a session
        # yet: a planned restart goes only when this is empty and every row
        # is idle (loam_live.restart_blockers), so a turn that has been
        # taken but whose session is still starting is not cut.
        engine = self.threads
        turns = [{"thread_id": tid, "persona": persona,
                  "queued": key not in engine.turns}
                 for key in dict.fromkeys(
                     [*engine.turns,
                      *(k for k, q in list(engine.queues.items()) if not q.empty())])
                 for (tid, persona) in [key]]
        return {"sessions": rows, "box": box, "turns": turns,
                "api_pid": os.getpid(), "api_revision": getattr(broker, "revision", None),
                "host_pid": getattr(broker, "host_pid", os.getpid()),
                "host_revision": getattr(broker, "host_revision", getattr(broker, "revision", None)),
                "admission_closed": fence.closed(),
                "host_admission_closed": (broker.host_fenced if getattr(broker, "remote", False)
                                          else fence.closed()),
                "opening": (room.get("starting", 0) if getattr(broker, "remote", False)
                            else len(getattr(broker, "_opening", {}))),
                "at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}

    async def end_idle(self) -> dict:
        """`POST /v1/sessions/end-idle`: every live session that is idle and
        not carrying a thread's turn. Never one that is working, asking or
        waiting on background work: each is asked again just before its stop."""
        ended, kept = [], []
        for session in list(self.broker.live()):
            state = loam_live.state_of(session.busy())
            why = None
            if state != "idle":
                why = state
            elif self.threads.turn_of(session.id):
                why = "working"            # a thread's turn is about to send
            elif time.time() - session.last_activity < cfg.EVICT_GRACE_S:
                # As admission's eviction: a session started or answered in
                # the last seconds may be a thread turn on its way to sending.
                why = "just active"
            if why:
                kept.append({"id": session.id, "agent": session.agent, "why": why})
                continue
            if getattr(self.broker, "remote", False):
                try:
                    await session.stop(idle=True)
                except BrokerError as exc:
                    if exc.status != 409:
                        raise
                    kept.append({"id": session.id, "agent": session.agent, "why": exc.message})
                    continue
            else:
                await session.stop()
            ended.append({"id": session.id, "agent": session.agent})
        return {"ended": ended, "kept": kept}

    async def live_stream(self, writer: asyncio.StreamWriter) -> None:
        """`GET /v1/sessions/live/events`: `sessions.live`, the whole
        `GET /v1/sessions/live` answer, on open, within a second of any
        record change (a start, a stop, a turn's state), and every
        `LIVE_REFRESH_S` for the memory numbers, only when it changed. A
        few rows, so the whole view each time is slimmer than a diff."""
        queue: asyncio.Queue = asyncio.Queue()
        self.broker.record_subscribers.add(queue)
        last = None
        try:
            while True:
                if getattr(self.broker, "remote", False):
                    await self.broker.synchronize()
                view = self.live_view()
                same = {k: v for k, v in view.items() if k != "at"}
                if last is None:
                    self._open_stream(writer)
                if same != last:
                    last = same
                    await self._send_event(writer, {"type": "sessions.live", **view})
                else:
                    await self._ping(writer)
                try:
                    async with asyncio.timeout(LIVE_REFRESH_S):
                        item = await queue.get()
                except TimeoutError:
                    continue
                if item is None:
                    return
                await asyncio.sleep(LIVE_DEBOUNCE_S)
                while not queue.empty():
                    if queue.get_nowait() is None:
                        return
        except BrokerError:
            # After headers, EOF lets EventSource reconnect on host recovery.
            if last is None:
                raise
        except (ConnectionResetError, BrokenPipeError):
            pass
        finally:
            self.broker.record_subscribers.discard(queue)

    def thread_model(self, persona: str, engine: str, model) -> str | None:
        """A member's or a turn's model, checked against what its engine
        offers (2026-11-09): Claude Code's aliases and full ids and Codex's
        `model/list`, as a classic chat's are (`choices`), and the models
        Antigravity's CLI lists. Null is the persona's own."""
        if model is None:
            return None
        if not engine:
            raise BrokerError(409, provider_defaults.SETUP)
        if engine in ("claude-code", "codex"):
            return choices({"model": model}, engine).get("model")
        if not isinstance(model, str) or not model.strip():
            raise BrokerError(400, "`model` is a string or null")
        listed = [m.get("id") for m in (agy.login_state().get("models") or [])
                  if isinstance(m, dict)]
        if model.strip() not in listed:
            raise BrokerError(
                400, f"model {model!r} is not one Antigravity lists"
                     f"{' (' + ', '.join(listed) + ')' if listed else ''}. "
                     f"GET /v1/providers lists them.")
        return model.strip()

    async def threads_route(self, method: str, tail: list[str], params: dict,
                            payload: dict, writer: asyncio.StreamWriter,
                            raw: bytes = b"", content_type: str = "") -> None:
        """The threads contract (broker/README.md, "Threads"). Every read is
        the vault record, parsed and cached by its mtime; nothing here opens
        or replays a harness session."""
        engine = self.threads
        if not tail:
            if method == "GET":
                threads_rec.ensure_general()
                body = {"threads": engine.listing(
                            archived=truthy(params.get("archived"))),
                        "agents": cfg.roster_cards()}
                writer.write(response(200, body))
                await writer.drain()
                return
            if method == "POST":
                # `persona` is optional since 2026-11-09: a thread with no
                # default records what is written and nobody answers until a
                # default is set or someone is tagged.
                persona = payload.get("persona") or None
                by = author(payload)
                meta = threads_rec.create(persona, payload.get("title"))
                if by:
                    threads_rec.append(
                        meta["id"], "system",
                        f"{threads_rec.display(by)} started this thread",
                        kind="system")
                    print(f"threads: {meta['id']} created by {by}",
                          file=sys.stderr, flush=True)
                if payload.get("text"):
                    engine.post_person(meta["id"], payload["text"])
                engine.publish_row(meta["id"])
                writer.write(response(201, {**engine.summary(meta["id"]), "ordered_submissions": True}))
                await writer.drain()
                return
            raise BrokerError(405, f"no route for {method} /v1/threads")
        if tail == ["events"] and method == "GET":
            await self.thread_list_stream(writer, truthy(params.get("archived")))
            return
        if tail == ["writer"] and method == "GET":
            # The record writer's own counts (2026-11-10): a reply dropped,
            # carried or recovered late, and a full record that failed to
            # write, are numbers here and lines in the broker's log.
            writer.write(response(200, dict(thread_steps.COUNTS)))
            await writer.drain()
            return
        if tail == ["imported"] and method == "GET":
            # Classic chats imported as archived threads (2026-11-11,
            # `bin/import-classic-chats`): session id -> thread id, read off
            # the records' frontmatter, so a link or bookmark to a classic
            # chat can be sent to its thread. `?session=<id>` asks for one,
            # and a session never imported is a 404.
            mapping = threads_rec.imported()
            sid = params.get("session")
            if sid:
                if sid not in mapping:
                    raise BrokerError(404, f"no thread was imported from session {sid}")
                writer.write(response(200, {"session": sid, "thread": mapping[sid]}))
            else:
                writer.write(response(200, {"imported": mapping}))
            await writer.drain()
            return
        thread_id, rest = tail[0], tail[1:]
        if not rest and method == "GET":
            limit = self._count(params.get("limit"), "limit") or threads_rec.PAGE
            got = threads_rec.page(thread_id, params.get("before") or None, limit)
            meta = got["meta"]
            messages = got["messages"]
            # A read of the newest page is the owner looking at the thread, and
            # marks it seen; `?seen=0` (2026-11-10) is a read that is not --
            # a page's own refresh behind the view -- and writes nothing.
            if messages and not params.get("before") \
                    and truthy(params.get("seen", "1")):
                threads_rec.mark_seen(thread_id, messages[-1]["id"])
            if params.get("steps") == "full":
                messages = with_steps(thread_id, messages)
            # The engineer jobs briefed from this thread (2026-11-13): queued,
            # running, landing, and finished in the last ten minutes, read
            # from the launcher's job state, never from the persona's session
            # (lib/loam_activity.job_rows; contract in broker/README.md).
            summary = engine.summary(thread_id)
            try:
                summary["jobs"] = await asyncio.to_thread(
                    activity.thread_jobs, thread_id)
                summary["jobs_error"] = None
            except Exception as exc:  # noqa: BLE001 -- the thread reads without it
                summary["jobs"] = []
                summary["jobs_error"] = f"the engineer jobs could not be read: {exc}"
            writer.write(response(200, {
                "thread": summary,
                "messages": messages, "has_more": got["has_more"],
                "ordered_submissions": True,
                # `turns` (2026-11-10): every member's turn in flight, earliest
                # first; `turn` is the earliest, for the clients that read one.
                "turn": engine.active.get(thread_id),
                "turns": engine.live_turns(thread_id),
                # `marks` (2026-11-19): what a turn that could not run or
                # ended without a reply shows; never in `messages`.
                "marks": engine.marks_for(thread_id),
                "pending_permissions": engine.pending(thread_id),
                "board": {"path": meta["board"],
                          "markdown": threads_rec.board_text(meta)}}))
            await writer.drain()
            return
        if not rest and method == "DELETE":
            # The record and its board leave the vault. The owner's explicit
            # action only: the app confirms before it sends this (2026-11-09).
            if engine.live_turns(thread_id):
                raise BrokerError(409, "a turn is running in this thread; "
                                       "delete it when the turn has finished")
            by = author(payload)
            gone = threads_rec.delete(thread_id)
            print(f"threads: deleted {thread_id}{f' by {by}' if by else ''}: "
                  f"{', '.join(gone['removed'])}",
                  file=sys.stderr, flush=True)
            engine.publish_removed(thread_id)
            writer.write(response(200, {"deleted": True, **gone}))
            await writer.drain()
            return
        if not rest and method == "PATCH":
            engines = payload.get("engine") or payload.get("engines")
            if engines is not None and not isinstance(engines, dict):
                raise BrokerError(400, "`engine` is {persona: engine}")
            models = payload.get("model") if "model" in payload else payload.get("models")
            if models is not None and not isinstance(models, dict):
                raise BrokerError(400, "`model` is {persona: model or null}")
            for key in ("add", "remove"):
                if payload.get(key) is not None and not isinstance(payload[key], list):
                    payload[key] = [payload[key]]
            for key in ("pinned", "archived"):
                if key in payload and not isinstance(payload[key], bool):
                    raise BrokerError(400, f"`{key}` is true or false")
            by = author(payload)
            who = threads_rec.display(by) if by else f"{lc.OWNER_NAME}"
            before = threads_rec.read(thread_id)[0]
            if models:
                engines_after = {**before["engines"], **(engines or {})}
                engines = dict(engines or {})
                for persona, model in models.items():
                    chosen = engines_after.get(persona) or threads_rec.default_engine(persona)
                    models[persona] = self.thread_model(persona, chosen, model)
                    if model is not None:
                        engines[persona] = chosen
            if "draft" in payload:
                # A branch's prepared opening (2026-11-11), cleared (null or
                # "") or replaced; the page clears it once it holds its own.
                if payload["draft"] is not None and not isinstance(payload["draft"], str):
                    raise BrokerError(400, "`draft` is a string or null")
                threads_rec.read(thread_id)
                threads_rec.set_draft(thread_id, payload["draft"])
            changes = {}
            if "default" in payload:
                changes["default"] = payload["default"] or None
            if "icon" in payload:
                changes["icon"] = payload["icon"]
            threads_rec.update(thread_id, title=payload.get("title"),
                               add=payload.get("add"), remove=payload.get("remove"),
                               engines=engines, models=models,
                               pinned=payload.get("pinned"),
                               archived=payload.get("archived"), **changes)
            after = threads_rec.read(thread_id)[0]
            if after["default"] != before["default"]:
                # Said in the thread (2026-11-09). The default changes only
                # when the owner changes it, and an untagged message goes to
                # it; a change nobody can see afterwards was how a reply
                # from someone other than the header's default could not be
                # explained from the record.
                said = (f"{who} made {threads_rec.display(after['default'])} "
                        f"the default" if after["default"] else
                        f"{who} set no default: untagged messages are kept "
                        "and nobody answers them")
                line = threads_rec.append(thread_id, "system", said, kind="system")
                engine.publish(thread_id, {"type": "message.done", "message": line})
                print(f"threads: {thread_id} default {before['default']} -> "
                      f"{after['default']}{f' by {by}' if by else ''}",
                      file=sys.stderr, flush=True)
            for persona in payload.get("add") or []:
                if persona not in before["members"]:
                    line = threads_rec.append(
                        thread_id, "system",
                        f"{who} brought in {threads_rec.display(persona)}",
                        kind="system")
                    engine.publish(thread_id, {"type": "member.joined",
                                               "persona": persona,
                                               "engine": threads_rec.member_engine(after, persona),
                                               "by": by or lc.OWNER_ID})
                    engine.publish(thread_id, {"type": "message.done", "message": line})
            if by:
                # A persona's change says itself in the thread (2026-11-10),
                # the ones the page leaves no line for included: the owner knows
                # what they clicked, and nobody else's change to their thread
                # should be one he can only find by noticing it.
                for said in persona_changes(who, before, after):
                    line = threads_rec.append(thread_id, "system", said,
                                              kind="system")
                    engine.publish(thread_id, {"type": "message.done",
                                               "message": line})
                print(f"threads: {thread_id} changed by {by}: "
                      f"{sorted(k for k in payload if k != 'by')}",
                      file=sys.stderr, flush=True)
            if payload.get("seen"):
                msgs = threads_rec.read(thread_id)[1]
                if msgs:
                    threads_rec.mark_seen(thread_id, msgs[-1]["id"])
            summary = engine.summary(thread_id)
            engine.publish(thread_id, {"type": "thread.changed", "summary": summary})
            writer.write(response(200, summary))
            await writer.drain()
            return
        if rest == ["branch"] and method == "GET":
            # Branching (2026-11-11), the sheet's first read: the window a
            # branch at `?message=` carries (`threads_rec.branch_window`),
            # who it can be with (members first), the summarizer's prompt
            # for the draft and title, and a plain fallback for when the
            # summarizer fails. Reads only.
            meta, msgs, path = threads_rec.read(thread_id)
            window = threads_rec.branch_window(msgs, params.get("message") or "",
                                               thread_id)
            people = threads_rec.branch_people(meta)
            persona = params.get("persona") or meta.get("default") or (
                people[0] if people else None)
            if persona and persona not in people:
                raise BrokerError(404, f"no persona named {persona!r}")
            writer.write(response(200, {
                "thread": thread_id, "title": meta["title"],
                "message": window[-1]["id"], "record": str(path),
                "window": window, "persona": persona, "people": people,
                "summarizer": threads_rec.branch_prompt(meta, window, persona),
                "fallback": threads_rec.fallback_branch(meta, window)}))
            await writer.drain()
            return
        if rest == ["branch"] and method == "POST":
            # Start thread: the new thread, its line back, the source's line
            # under the message, the draft for its composer. `by` when a
            # persona branched (the owner's 11-10 rule: anything they can do).
            for key in ("title", "draft", "persona"):
                if payload.get(key) is not None and not isinstance(payload[key], str):
                    raise BrokerError(400, f"`{key}` is a string")
            by = author(payload)
            made = threads_rec.branch(thread_id, payload.get("message") or "",
                                      payload.get("persona") or None,
                                      title=payload.get("title"),
                                      draft=payload.get("draft"), by=by)
            new_id = made["meta"]["id"]
            print(f"threads: {new_id} branched from {thread_id} at "
                  f"{payload.get('message')} ({len(made['window'])} messages)"
                  f"{f' by {by}' if by else ''}", file=sys.stderr, flush=True)
            engine.publish_row(new_id)
            engine.publish(thread_id, {"type": "message.done", "message": made["into"]})
            engine.publish_row(thread_id)
            writer.write(response(201, {"thread": engine.summary(new_id),
                                        "from": made["from"], "into": made["into"],
                                        "window": made["window"]}))
            await writer.drain()
            return
        if rest == ["attachments"] and method == "POST":
            # The bytes into the vault, the attachment objects back, nothing
            # started (a classic chat's own upload route retired 2026-11-12).
            # The next message names them in `attachments`.
            threads_rec.read(thread_id)          # 404 for a thread nobody has
            if not content_type.split(";")[0].strip().lower() == "multipart/form-data":
                raise BrokerError(415, "send the file as multipart/form-data in a "
                                       "`file` part")
            files = [p for p in parse_multipart(content_type, raw)
                     if p["field"] in (None, "file", "files", "files[]")]
            if not files:
                raise BrokerError(400, "no `file` part in the upload")
            stored = [self._store(f, params.get("app") or "loam-ui") for f in files]
            writer.write(response(201, {"attachments": stored}))
            await writer.drain()
            return
        if rest == ["messages"] and method in ("POST", "PUT"):
            key = signature = None
            attachments = payload.get("attachments") or []
            if not isinstance(attachments, list):
                raise BrokerError(400, "`attachments` is a list of paths")
            if method == "PUT":
                key = payload.get("submission_id")
                if not isinstance(key, str) or not re.fullmatch(r"[A-Za-z0-9_-]{1,100}", key):
                    raise BrokerError(400, "A stable submission_id is required.")
                text = payload.get("text") or ""
                if not isinstance(text, str):
                    raise BrokerError(400, "Message text must be a string.")
                signature = engine.submission_hash(text, attachments, payload.get("reply_to"),
                                                   payload.get("model"))
                engine.finish_pending_submission(thread_id)
                prior = engine.accepted_submission(threads_rec.read(thread_id)[1], key, signature)
                if prior:
                    writer.write(response(200, {"accepted": True, "message": prior}))
                    await writer.drain()
                    return
            carried = [self._attachment(p) for p in attachments]
            model = payload.get("model")
            if model is not None:
                # Checked against every engine the turn could run on: the
                # tagged members' and the default's, known only once the
                # mentions are read, so against the thread's engines here.
                meta = threads_rec.read(thread_id)[0]
                for p in threads_rec.mentions(payload.get("text") or "") or (
                        [meta["default"]] if meta.get("default") else []):
                    self.thread_model(p, threads_rec.member_engine(meta, p), model)
            # `reply_to` (2026-11-11): the id of the earlier message this
            # one answers; a 400 / 404 from the record when it isn't one.
            reply_to = payload.get("reply_to") or None
            msg = engine.post_person(thread_id, payload.get("text") or "",
                                     attachments=carried, model=model,
                                     reply_to=reply_to, submission_id=key, signature=signature)
            writer.write(response(200, {"accepted": True, "message": msg}))
            await writer.drain()
            return
        if rest == ["posted"] and method == "POST":
            # A persona's post outside a turn (bin/thread post), told here
            # once it is in the record (0.2.1): on the stream at once, and
            # its @mentions wake members as a reply's do.
            by = str(payload.get("by") or "").strip().lower()
            mid = str(payload.get("message") or "").strip()
            if not by or not mid:
                raise BrokerError(400, "the body is {\"message\": id, \"by\": persona}")
            try:
                body = engine.posted(thread_id, mid, by)
            except threads_rec.ThreadError as exc:
                raise BrokerError(exc.status, str(exc))
            writer.write(response(200, body))
            await writer.drain()
            return
        if rest == ["board"] and method in ("GET", "PUT"):
            meta = threads_rec.read(thread_id)[0]
            if method == "PUT":
                by = author(payload)
                threads_rec.write_board(meta, payload.get("markdown"))
                if by:
                    print(f"threads: {thread_id} board written by {by}",
                          file=sys.stderr, flush=True)
            markdown = threads_rec.board_text(meta)
            if method == "PUT":
                engine.publish(thread_id, {"type": "board.changed",
                                           "board_new": threads_rec.board_new(markdown)})
            writer.write(response(200, {"path": meta["board"], "markdown": markdown,
                                        "board_new": threads_rec.board_new(markdown)}))
            await writer.drain()
            return
        if rest == ["steps"] and method == "GET":
            # The full record (2026-11-10): every step of every reply, for
            # one message (`?message=m4`) or the whole thread.
            threads_rec.read(thread_id)          # 404 for a thread that isn't
            entries = thread_steps.read(thread_id, params.get("message") or None)
            if params.get("message") and not entries:
                raise BrokerError(404, f"no full record for {params['message']}")
            writer.write(response(200, {"thread": thread_id,
                                        "steps": list(entries.values())}))
            await writer.drain()
            return
        if rest == ["events"] and method == "GET":
            await self.thread_stream(thread_id, params.get("after"), writer,
                                     full=params.get("steps") == "full")
            return
        raise BrokerError(405, f"no route for {method} /v1/threads/" + "/".join(tail))

    async def thread_list_stream(self, writer: asyncio.StreamWriter,
                                 archived: bool = False) -> None:
        """The thread list, live (2026-11-09): ``threads.snapshot`` with the
        rows and the agents, then ``thread.changed {summary}`` whenever a
        row moves and ``thread.removed {thread}`` when one is deleted. The
        engine pushes what it does; a post by ``bin/thread`` or an edit in
        Obsidian is seen by stat-ing the records every two seconds, as a
        thread's own stream does. An archived row is sent like any other,
        with ``archived: true``, so a list can drop it."""
        engine = self.threads
        queue = engine.listen_list()
        self._open_stream(writer)

        def stamps() -> dict:
            out = {}
            for tid, name in threads_rec.index().items():
                try:
                    st = (threads_rec.VAULT / threads_rec.CONVERSATIONS / name).stat()
                    out[tid] = (st.st_mtime_ns, st.st_size)
                except OSError:
                    continue
            return out

        try:
            threads_rec.ensure_general()
            seen = stamps()
            quiet = 0.0
            await self._send_event(writer, {
                "type": "threads.snapshot",
                "threads": engine.listing(archived=archived),
                "agents": cfg.roster_cards()})
            while True:
                try:
                    async with asyncio.timeout(2):
                        event = await queue.get()
                except TimeoutError:
                    event = None
                if event is not None:
                    quiet = 0.0
                    await self._send_event(writer, event)
                    continue
                quiet += 2
                now = stamps()
                for tid in now:
                    if now[tid] != seen.get(tid):
                        try:
                            await self._send_event(writer, {
                                "type": "thread.changed", "thread": tid,
                                "summary": engine.summary(tid)})
                        except threads_rec.ThreadError:
                            pass
                for tid in set(seen) - set(now):
                    await self._send_event(writer, {"type": "thread.removed",
                                                    "thread": tid})
                seen = now
                if quiet >= KEEPALIVE_S:
                    quiet = 0.0
                    await self._ping(writer)
        except (ConnectionResetError, BrokenPipeError):
            pass
        finally:
            engine.unlisten_list(queue)

    async def thread_stream(self, thread_id: str, after: str | None,
                            writer: asyncio.StreamWriter, full: bool = False) -> None:
        """A thread's live events. The engine publishes its own; a post made
        by ``bin/thread`` (an agent's wake) and an edit of the board in
        Obsidian are seen by watching the two files, every two seconds."""
        meta, msgs, path = threads_rec.read(thread_id)
        board = threads_rec.VAULT / meta["board"]

        def number(message):
            return threads_rec._num(message["id"])

        sent = threads_rec._num(after) if after else max(map(number, msgs), default=0)

        def stamp(p: Path):
            try:
                st = p.stat()
                return (st.st_mtime_ns, st.st_size)
            except OSError:
                return None

        record_at, board_at = None, stamp(board)
        queue = self.threads.listen(thread_id)
        self._open_stream(writer)
        try:
            async def send(event: dict) -> None:
                if full and event.get("type") == "message.done":
                    event = {**event, "message": with_steps(
                        thread_id, [event["message"]])[0]}
                await self._send_event(writer, event)

            async def catch_up(messages, before=None) -> None:
                nonlocal sent
                # A branch line can sit earlier in the Markdown. Send in ID
                # order so a disconnect after any item leaves a valid cursor.
                newer = (m for m in messages if number(m) > sent
                         and (before is None or number(m) < before))
                for message in sorted(newer, key=number):
                    await send({"type": "message.done", "thread": thread_id,
                                "message": message})
                    sent = number(message)

            await self._send_event(writer, {"type": "thread.snapshot",
                                            "thread": thread_id,
                                            "turn": self.threads.active.get(thread_id),
                                            "turns": self.threads.live_turns(thread_id),
                                            "marks": self.threads.marks_for(thread_id),
                                            "pending": self.threads.pending(thread_id),
                                            "members": self.threads.summary(
                                                thread_id)["members"]})
            if after:
                await catch_up(msgs)
            quiet = 0.0
            while True:
                try:
                    async with asyncio.timeout(2):
                        event = await queue.get()
                except TimeoutError:
                    event = None
                if event is not None:
                    quiet = 0.0
                    if event.get("type") == "message.done":
                        n = number(event["message"])
                        if n > sent + 1:
                            # A file-only post can precede this notification.
                            await catch_up(threads_rec.read(thread_id)[1], before=n)
                        if n <= sent:
                            continue
                        sent = n
                    await send(event)
                    continue
                quiet += 2
                now_record, now_board = stamp(path), stamp(board)
                if now_record != record_at:
                    record_at = now_record
                    try:
                        meta, fresh, path = threads_rec.read(thread_id)
                    except threads_rec.ThreadError:
                        return
                    # A rename moves the board with the record (2026-11-10);
                    # watch it where it went, not where it was.
                    board = threads_rec.VAULT / meta["board"]
                    await catch_up(fresh)
                if now_board != board_at:
                    board_at = now_board
                    try:
                        text = board.read_text("utf-8")
                    except OSError:
                        text = ""
                    await self._send_event(writer, {
                        "type": "board.changed", "thread": thread_id,
                        "board_new": threads_rec.board_new(text)})
                if quiet >= KEEPALIVE_S:
                    quiet = 0.0
                    await self._ping(writer)
        except (ConnectionResetError, BrokenPipeError):
            pass
        finally:
            self.threads.unlisten(thread_id, queue)

    async def github(self, method: str, tail: list[str], params: dict,
                     payload: dict, writer: asyncio.StreamWriter) -> None:
        """GitHub as a GitHub App (2026-09-30). The whole flow and its store
        are lib/loam_github_app.py; these routes only dispatch, each GitHub
        call on a worker thread so a slow GitHub never parks the loop. See
        broker/README.md, "GitHub"."""
        def text(name: str) -> str | None:
            value = payload.get(name)
            return value.strip() if isinstance(value, str) and value.strip() else None

        calls = {
            ("GET", ()): lambda: github_app.public_view(),
            # `org` (2026-10-06), in the query or the body: that
            # organization's app alone; without it, everything, as before.
            ("DELETE", ()): lambda: github_app.forget(
                text("org") or (params.get("org") or "").strip() or None),
            # `org` (2026-10-06): an app owned by that organization, which
            # answers for its repositories alone; see the module.
            ("POST", ("manifest",)): lambda: github_app.start_manifest(
                text("name"), text("org")),
            ("POST", ("register",)): lambda: github_app.register(
                text("code") or "", text("state") or ""),
            ("POST", ("install",)): lambda: github_app.start_install(text("org")),
            ("POST", ("callback",)): lambda: github_app.callback(
                text("code"), payload.get("installation_id"),
                text("setup_action"), text("state")),
            ("POST", ("refresh",)): lambda: github_app.check(force_refresh=True),
            ("POST", ("token",)): lambda: github_app.installation_token(
                text("repository")),
            # A pull-request project's landing (2026-10-06): the job cannot
            # push, so the broker pushes its job/<id> branch and opens the PR.
            ("POST", ("pull-request",)): lambda: github_app.open_pull_request(
                text("project") or "", text("branch") or "",
                text("title") or "", payload.get("body") if isinstance(
                    payload.get("body"), str) else ""),
            # A job whose brief names the pull request it updates
            # (2026-10-09): fast-forward that PR's head, then post the reply.
            ("POST", ("pull-request-update",)): lambda: github_app.update_pull_request(
                text("project") or "", text("branch") or "", payload.get("number"),
                payload.get("reply") if isinstance(payload.get("reply"), str) else ""),
        }
        # One account at a time (2026-11-13): the list, refresh one,
        # disconnect one, add another. lib/loam_github_app.py, "Accounts".
        if tail[:1] == ["accounts"]:
            from urllib.parse import unquote  # noqa: PLC0415
            rest = [unquote(t) for t in tail[1:]]
            if method == "GET" and not rest:
                calls[(method, tuple(tail))] = github_app.accounts
            elif method == "POST" and not rest:
                calls[(method, tuple(tail))] = lambda: github_app.add_account(
                    text("org"), payload.get("own_app") is True)
            elif method == "POST" and len(rest) == 2 and rest[1] == "refresh":
                calls[(method, tuple(tail))] = lambda: github_app.check_account(rest[0])
            elif method == "DELETE" and len(rest) == 1:
                calls[(method, tuple(tail))] = lambda: github_app.forget_account(rest[0])
        call = calls.get((method, tuple(tail)))
        if call is None:
            raise BrokerError(405, f"no route for {method} /v1/integrations/github"
                                   + "".join("/" + t for t in tail))
        try:
            out = await asyncio.to_thread(call)
        except github_app.IntegrationError as exc:
            raise BrokerError(exc.status, str(exc)) from None
        writer.write(response(200, out, "Cache-Control: no-store\r\n"))
        await writer.drain()

    async def activity_route(self, method: str, tail: list[str], params: dict,
                             payload: dict, writer: asyncio.StreamWriter) -> None:
        """Schedules and Activity (2026-10-14). Every write is
        loam_schedule.change() as the owner on lane `app`, inside
        lib/loam_activity.py; a refusal is that path's own sentence, as a
        400 (a 404 when the thing named is not there). Each call on a worker
        thread: a write reconciles timers, a read asks the user manager."""
        def q(name: str) -> str | None:
            from urllib.parse import unquote_plus  # noqa: PLC0415
            return unquote_plus(params[name]) if params.get(name) else None

        def number(name: str, default: int) -> int:
            try:
                return int(params.get(name) or default)
            except ValueError:
                raise BrokerError(400, f"`{name}` is a number") from None

        def seen() -> dict:
            ids = ([i["id"] for i in activity.items() if not i["seen"]]
                   if payload.get("all") is True else
                   [i for i in payload.get("ids") or [] if isinstance(i, str)])
            return {"marked": activity.mark_seen(ids), "unread": activity.unread()}

        # `*` is one path segment, handed to the call in order.
        calls = {
            ("GET", "schedules"): lambda: {
                "schedules": activity.schedules(q("agent")),
                "unread": activity.unread()},
            ("GET", "schedules", "*"): lambda a: {
                "schedules": activity.schedules(a), "unread": activity.unread()},
            ("POST", "schedules", "*"): lambda a: activity.create(a, payload),
            ("GET", "schedules", "*", "*"): activity.schedule,
            ("PATCH", "schedules", "*", "*"): lambda a, n: activity.edit(a, n, payload),
            ("DELETE", "schedules", "*", "*"): lambda a, n: activity.delete(a, n, payload),
            ("POST", "schedules", "*", "*", "run"): lambda a, n: activity.run_now(
                a, n, payload),
            ("POST", "schedules", "*", "*", "seen"): activity.seen_schedule,
            ("GET", "activity"): lambda: activity.activity(
                q("agent"), q("kind"), number("limit", 50), number("offset", 0)),
            ("POST", "activity", "seen"): seen,
            ("POST", "activity", "*", "undo"): lambda e: activity.undo(e, payload),
            ("POST", "jobs", "*", "cancel"): lambda j: {
                "job": j, "said": activity.cancel_job(j)},
        }
        for (verb, *pattern), call in calls.items():
            if verb == method and len(pattern) == len(tail) and all(
                    p in ("*", t) for p, t in zip(pattern, tail)):
                args = [t for p, t in zip(pattern, tail) if p == "*"]
                break
        else:
            raise BrokerError(405, f"no route for {method} /v1/" + "/".join(tail))
        try:
            out = await asyncio.to_thread(call, *args)
        except activity.NotFound as exc:
            raise BrokerError(404, str(exc)) from None
        except loam_schedule.Refused as exc:
            raise BrokerError(400, str(exc)) from None
        writer.write(response(200, out, "Cache-Control: no-store\r\n"))
        await writer.drain()

    def _session(self, session_id: str) -> Session:
        session = self.broker.sessions.get(session_id)
        if session is None:
            raise BrokerError(404, f"no session {session_id}")
        return session

    def _store(self, part: dict, app: str) -> dict:
        """One uploaded part, written down, as the answer describes it.

        The name is sanitised before it is a path and the type is read off the
        extension, not off what the browser claimed: the browser's guess is
        whatever the person's operating system said, and on a phone it is often
        nothing. A type this interface does not carry is refused BEFORE
        anything is written, so a refusal leaves no file behind.

        The write is the broker's own, as the user that owns the vault. The
        boundary guard does not see it and could not: the guard is a hook on
        the CLI's tools (`hooks/boundary-guard.py`, PreToolUse), and this is a
        Python process writing a file, not an agent calling Write. What keeps
        it inside the lines is this method -- one directory, a sanitised name,
        an allow-list of types -- and it is stated in broker/README.md so
        nobody reads the guard as covering it.
        """
        name = cfg.sanitise_name(part["filename"])
        media_type = cfg.attachment_type(name)
        if media_type is None:
            ext = name.rpartition(".")[2] if "." in name else ""
            raise BrokerError(415, (
                f"this interface does not carry .{ext} files"
                if ext else "a file needs a name with an extension"))
        data = part["bytes"]
        if len(data) > cfg.ATTACHMENT_MAX_BYTES:
            raise BrokerError(
                413, f"{name} is bigger than this interface carries "
                     f"({human_size(cfg.ATTACHMENT_MAX_BYTES)} at most)")
        directory = cfg.attachment_dir(app)
        directory.mkdir(parents=True, exist_ok=True)
        target = cfg.free_path(directory, name)
        target.write_bytes(data)
        return {"path": str(target), "name": target.name,
                "size": len(data), "type": media_type}

    async def files_route(self, method: str, tail: list[str], params: dict,
                          payload: dict, writer: asyncio.StreamWriter,
                          raw: bytes = b"", content_type: str = "") -> None:
        """``/v1/files/...`` -- see broker/README.md, "Files"."""
        from urllib.parse import unquote_plus
        q = {k: unquote_plus(v) for k, v in params.items()}
        nocache = "Cache-Control: no-store\r\n"
        reads = {"roots": lambda: files_api.roots(),
                 "list": lambda: files_api.listing(q.get("root", ""), q.get("path"),
                                               q.get("cursor"), q.get("limit")),
                 "stat": lambda: files_api.stat_resource(q.get("root", ""),
                                                     q.get("path")),
                 "read": lambda: files_api.read_text(q.get("root", ""), q.get("path")),
                 "resolve": lambda: files_api.resolve(q.get("ref"), q.get("from_root"),
                                                  q.get("from_path"))}
        writes = {("text", "PUT"): (200, files_api.save_text),
                  ("file", "POST"): (201, files_api.create_file),
                  ("folder", "POST"): (201, files_api.create_folder),
                  ("rename", "POST"): (200, files_api.rename)}
        try:
            if len(tail) == 1 and method == "GET" and tail[0] in reads:
                body = await asyncio.to_thread(reads[tail[0]])
                writer.write(response(200, body, nocache))
            elif len(tail) == 1 and (tail[0], method) in writes:
                status, act = writes[(tail[0], method)]
                body = await asyncio.to_thread(act, payload)
                writer.write(response(status, body, nocache))
            elif tail == ["upload"] and method == "POST":
                # The one Files body that is not JSON: one `file` part, the
                # target folder in the query. The cap was enforced before the
                # body was kept (`_handle`); parse_multipart never decodes it.
                if content_type.split(";")[0].strip().lower() != (
                        "multipart/form-data"):
                    raise files_api.FilesError(
                        415, "send the file as multipart/form-data in one "
                             "`file` part")
                found = [p for p in parse_multipart(content_type, raw)
                         if p["field"] in (None, "file")]
                if len(found) != 1:
                    raise files_api.FilesError(
                        400, "an upload is one `file` part; send each file "
                             "on its own request")
                body = await asyncio.to_thread(
                    files_api.upload, q.get("root", ""), q.get("path"), found[0])
                writer.write(response(201, body, nocache))
            elif tail == ["download"] and method == "GET":
                fd, size, headers = await asyncio.to_thread(
                    files_api.download, q.get("root", ""), q.get("path"))
                try:
                    head = "".join(f"{k}: {v}\r\n" for k, v in headers.items())
                    writer.write((f"HTTP/1.1 200 OK\r\nContent-Length: {size}\r\n"
                                  f"Connection: close\r\n{head}\r\n").encode())
                    sent = 0
                    while sent < size:
                        chunk = os.read(fd, min(files_api.CHUNK, size - sent))
                        if not chunk:
                            break     # shrank while sent; the length is the lie
                        writer.write(chunk)
                        sent += len(chunk)
                        await writer.drain()
                finally:
                    os.close(fd)
            elif tail == ["archive"] and method == "GET":
                await self.files_archive(q.get("root", ""), q.get("path"), writer)
                return
            else:
                raise BrokerError(405, f"no route for {method} /v1/files/"
                                       f"{'/'.join(tail)}")
        except files_api.FilesError as exc:
            writer.write(response(exc.status, exc.body(), nocache))
        await writer.drain()

    async def files_archive(self, root: str, path: str | None,
                            writer: asyncio.StreamWriter) -> None:
        """``GET /v1/files/archive``: a folder as one zip, streamed while it
        is built (broker/README.md, "Files", "Archive").

        The body is chunked, so its end is said by the last chunk and not by
        the connection closing: a failure partway resets the connection with
        neither the zip's closing record nor HTTP's last chunk sent, and every
        client sees a failed download, never a short zip that looks whole.
        The walk and the reads run on a worker thread, one chunk at a time,
        so memory holds one chunk and the loop is never blocked on the disk."""
        nocache = "Cache-Control: no-store\r\n"
        try:
            fd, parts, headers = await asyncio.to_thread(files_api.archive,
                                                         root, path)
        except files_api.FilesError as exc:
            writer.write(response(exc.status, exc.body(), nocache))
            await writer.drain()
            return
        where = f"{root}/{'/'.join(parts)}"
        stats: dict = {}
        chunks = files_api.archive_stream(root, parts, fd, stats)
        started = time.monotonic()
        try:
            head = "".join(f"{k}: {v}\r\n" for k, v in headers.items())
            writer.write((f"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n"
                          f"Connection: close\r\n{head}\r\n").encode())
            while True:
                chunk = await asyncio.to_thread(next, chunks, None)
                if chunk is None:
                    break
                writer.write(b"%x\r\n%b\r\n" % (len(chunk), chunk))
                await writer.drain()
            writer.write(b"0\r\n\r\n")
            await writer.drain()
            print(f"files: archive of {where}: {stats['files']} files, "
                  f"{stats['folders']} folders, {stats['bytes']} bytes in "
                  f"{time.monotonic() - started:.1f}s", file=sys.stderr, flush=True)
        except (ConnectionResetError, BrokenPipeError):
            print(f"files: archive of {where}: the client went away after "
                  f"{stats.get('bytes', 0)} bytes", file=sys.stderr, flush=True)
        except Exception as exc:  # noqa: BLE001 -- the zip is abandoned, said once
            print(f"files: archive of {where} failed after "
                  f"{stats.get('bytes', 0)} bytes, the download is reset: "
                  f"{exc}", file=sys.stderr, flush=True)
            writer.transport.abort()
        finally:
            try:
                chunks.close()
            except ValueError:
                pass      # still running on its thread (a cancelled task)

    # -- Agent profiles, engineers, the reviewer (2026-11-13) -----------------

    def say_in_general(self, text: str) -> None:
        """A persona's change of a setting that belongs to no thread, said in
        General, as a persona's change of a thread is said in that thread
        (2026-11-10). The owner's own clicks say nothing: they know what they
        clicked. A General that cannot be written is the journal's line only."""
        try:
            threads_rec.ensure_general()
            line = threads_rec.append(threads_rec.GENERAL_ID, "system", text,
                                      kind="system")
            self.threads.publish(threads_rec.GENERAL_ID,
                                 {"type": "message.done", "message": line})
        except Exception as exc:  # noqa: BLE001 -- the change stands
            print(f"profile: could not say in General ({exc}): {text}",
                  file=sys.stderr, flush=True)

    def profile_check(self, provider: str, field: str, value):
        """A model or a thinking level as ``provider`` takes it, by the
        checks a thread and a chat use (``thread_model``, ``choices``)."""
        if field == "model":
            return self.thread_model("", provider, value)
        if provider == "antigravity":
            if value not in agy.EFFORTS:
                raise BrokerError(400, f"effort {value!r} is not an Antigravity "
                                       f"level: {', '.join(agy.EFFORTS)}.")
            return value
        return choices({"effort": value}, provider).get("effort")

    def agent_status(self, agent: str, box: dict | None, next_wake) -> dict:
        """What the agent is doing now: its turns in flight by thread, the
        engineer jobs it briefed that are running or queued, a wake or cron of
        its running, and when its next wake is."""
        threads = []
        for (tid, persona), turn in list(self.threads.turns.items()):
            if persona != agent:
                continue
            try:
                title = threads_rec.read(tid)[0].get("title")
            except Exception:  # noqa: BLE001 -- a thread gone mid-read
                title = None
            threads.append({"thread": tid, "title": title,
                            "since": turn.get("started_at")})
        slots = (box or {}).get("slots") or []
        # The jobs it briefed, by the one job-state reader (loam_activity
        # job_rows, broker/README.md "A thread's engineer jobs").
        try:
            rows = activity.job_rows(live=box) if box is not None else []
        except Exception:  # noqa: BLE001 -- no reading is no jobs, said by box_read
            rows = []
        keep = ("job", "title", "project", "thread", "state", "phase", "since")
        mine = [r for r in rows if r.get("briefed_by") == agent
                and r.get("state") != "finished"]
        jobs = [{k: r.get(k) for k in keep} for r in mine if r.get("state") != "queued"]
        queued = [{k: r.get(k) for k in keep} for r in mine if r.get("state") == "queued"]
        run = next(({"lane": s.get("lane"), "name": s.get("name"),
                     "since": s.get("since")}
                    for s in slots if s.get("kind") == "wake"
                    and s.get("agent") == agent), None)
        return {"threads": threads, "jobs": jobs, "queued": queued, "run": run,
                "next_wake": next_wake, "box_read": box is not None}

    def profile(self, agent: str) -> dict:
        """``GET /v1/agents/<agent>``: everything the profile page draws."""
        config = loam_profile.read_agent(agent)
        try:
            schedule = loam_profile.schedule(agent)
        except Exception as exc:  # noqa: BLE001 -- the rest of the page stands
            schedule, schedule_error = [], str(exc)
        else:
            schedule_error = None
        try:
            box = activity.live_jobs()
        except Exception:  # noqa: BLE001 -- no launcher reading is no jobs, said
            box = None
        wake = next((r for r in schedule if r.get("kind") == "reflection"), None)
        try:
            plugins = loam_plugins.profile_rows(agent)
        except Exception:  # noqa: BLE001
            plugins = []
        return {
            "agent": cfg.agent_card(agent),
            "identity": loam_profile.identity(agent, config),
            "defaults": loam_profile.defaults(agent, config, loam_profile.WAKE_MODEL_DEFAULT,
                                              cfg.persona_model),
            "files": loam_profile.files(agent),
            "schedule": schedule,
            **({"schedule_error": schedule_error} if schedule_error else {}),
            "status": self.agent_status(agent, box,
                                        wake.get("next_fire") if wake else None),
            "plugins": plugins,
        }

    def agent_busy(self, agent: str) -> str | None:
        """What an agent is in the middle of, for an archive to wait on:
        a thread turn (the engine's) or a wake or cron (its run marker)."""
        threads_now = sorted({tid for (tid, p) in self.threads.turns if p == agent})
        if threads_now:
            return f"mid-turn in {', '.join(threads_now)}"
        if (loam_schedule.WAKE_STATE / f"{agent}.running").exists():
            return "in a wake or cron run"
        return None

    def agents_line(self, thread_id: str | None, text: str) -> None:
        if not thread_id:
            return
        try:
            self.threads.system_line(thread_id, text)
        except Exception as exc:  # noqa: BLE001 -- the change stands
            print(f"agents: could not write in {thread_id} ({exc}): {text}",
                  file=sys.stderr, flush=True)

    async def agents_route(self, method: str, tail: list[str], params: dict,
                           payload: dict, writer: asyncio.StreamWriter,
                           raw: bytes = b"", content_type: str = "") -> None:
        """New agent, drafts, confirm, archive, restore and the face
        (lib/loam_agents.py; broker/README.md, "Making, archiving and
        restoring agents")."""
        from urllib.parse import unquote  # noqa: PLC0415
        tail = [unquote(p) for p in tail]
        nocache = "Cache-Control: no-store\r\n"
        say = threads_rec.display
        status = 200
        try:
            by = author(payload) if method != "GET" else None
            if tail == ["new"] and method == "POST":
                # Settings › Agents › New agent: a thread with the starter
                # agent, not a form. The person writes first.
                starter = loam_agents.STARTER
                if starter not in cfg.roster():
                    raise BrokerError(409, f"{starter}, who makes new agents, is not "
                                           f"awake on this box; ask any agent instead")
                meta = threads_rec.create(starter, "New agent")
                self.agents_line(meta["id"], (
                    f"New agent. Tell {say(starter)} who you'd like: "
                    f"{say(starter)} drafts their name, face, soul and config, "
                    f"shows you, changes it on your word, and makes them only "
                    f"when you say yes. ({say(starter)}: `settings describe "
                    f"agent.draft` says how; this thread is `{meta['id']}`.)"))
                if by:
                    self.agents_line(meta["id"], f"{say(by)} started this thread")
                self.threads.publish_row(meta["id"])
                body, status = self.threads.summary(meta["id"]), 201
            elif tail == ["drafts"] and method == "GET":
                body = {"drafts": await asyncio.to_thread(
                    loam_agents.drafts, params.get("thread") or None)}
            elif tail == ["drafts"] and method == "POST":
                body = await asyncio.to_thread(loam_agents.new_draft, payload, by)
                status = 201
                self.agents_line(body.get("thread"), (
                    f"{say(by) if by else lc.OWNER_NAME} drafted a new agent: "
                    f"{body.get('name') or '(no name yet)'} "
                    f"(draft {body['draft']}, revision {body['rev']})"))
            elif len(tail) == 2 and tail[0] == "drafts":
                if method == "GET":
                    body = await asyncio.to_thread(
                        lambda: loam_agents.shown(loam_agents.read_draft(tail[1])))
                elif method == "PATCH":
                    body = await asyncio.to_thread(loam_agents.revise, tail[1], payload, by)
                    self.agents_line(body.get("thread"), (
                        f"{say(by) if by else lc.OWNER_NAME} revised draft "
                        f"{body['draft']}: "
                        f"{body.get('name') or ''}, revision {body['rev']} "
                        f"({', '.join(body['revisions'][-1]['fields'])})"))
                elif method == "DELETE":
                    body = await asyncio.to_thread(loam_agents.discard, tail[1], by)
                    self.agents_line(body.get("thread"), (
                        f"{say(by) if by else lc.OWNER_NAME} set draft "
                        f"{body['draft']} aside"))
                else:
                    raise BrokerError(405, "GET, PATCH or DELETE a draft")
            elif len(tail) == 3 and tail[0] == "drafts" and tail[2] == "confirm" \
                    and method == "POST":
                made = await asyncio.to_thread(loam_agents.confirm, tail[1], payload, by)
                agent = made["agent"]
                first = threads_rec.create(agent)
                yes = made["draft"].get("yes")
                self.agents_line(first["id"], (
                    f"{say(agent)} was made"
                    + (f" by {say(by)} on {lc.OWNER_NAME}'s yes ({yes['message']} "
                       f"in {yes['thread']})" if yes else f" by {lc.OWNER_NAME}")
                    + ". This is their first thread."))
                self.threads.publish_row(first["id"])
                self.agents_line(made["draft"].get("thread"), (
                    f"Made {say(agent)} ({agent}): their first thread is "
                    f"{first['id']}"))
                print(f"agents: made {agent} from {tail[1]} by {by or lc.OWNER_ID}",
                      file=sys.stderr, flush=True)
                body = {**made, "agent": cfg.agent_card(agent),
                        "first_thread": first["id"]}
                body.pop("provision", None)
                status = 201
            elif len(tail) == 2 and tail[1] == "archive" and method == "POST":
                agent = tail[0]
                body = await asyncio.to_thread(loam_agents.archive, agent, payload, by,
                                               busy=self.agent_busy)
                print(f"agents: archived {agent} by {by or lc.OWNER_ID}",
                      file=sys.stderr, flush=True)
                if by:
                    self.say_in_general(f"{say(by)} archived {say(agent)} on "
                                        f"{lc.OWNER_NAME}'s yes")
            elif len(tail) == 2 and tail[1] == "restore" and method == "POST":
                agent = tail[0]
                body = await asyncio.to_thread(loam_agents.restore, agent, payload, by)
                print(f"agents: restored {agent} by {by or lc.OWNER_ID}",
                      file=sys.stderr, flush=True)
                if by:
                    self.say_in_general(f"{say(by)} restored {say(agent)} on "
                                        f"{lc.OWNER_NAME}'s yes")
            elif len(tail) == 2 and tail[1] == "face":
                agent = tail[0]
                if method == "GET":
                    data, ctype = await asyncio.to_thread(loam_agents.face_bytes, agent)
                    head = (f"HTTP/1.1 200 OK\r\nContent-Type: {ctype}\r\n"
                            f"Content-Length: {len(data)}\r\n"
                            f"Cache-Control: private, max-age=31536000, immutable\r\n"
                            f"Connection: close\r\n\r\n").encode()
                    writer.write(head + data)
                    await writer.drain()
                    return
                if method == "PUT":
                    if content_type.split(";")[0].strip().lower() == "multipart/form-data":
                        files = [p for p in parse_multipart(content_type, raw)
                                 if p["field"] in (None, "file")]
                        if not files:
                            raise BrokerError(400, "no `file` part in the upload")
                        body = await asyncio.to_thread(loam_agents.set_face, agent,
                                                       files[0]["bytes"], None)
                    else:
                        body = await asyncio.to_thread(loam_agents.face_from_payload,
                                                       agent, payload, by)
                elif method == "DELETE":
                    body = await asyncio.to_thread(loam_agents.set_face, agent, None, by)
                else:
                    raise BrokerError(405, "GET, PUT or DELETE an agent's face")
                print(f"agents: {agent}'s face {'set' if body.get('face') else 'removed'} "
                      f"by {by or lc.OWNER_ID}", file=sys.stderr, flush=True)
                if by:
                    self.say_in_general(
                        f"{say(by)} {'changed' if body.get('face') else 'removed'} "
                        f"{say(agent)}'s face")
            else:
                raise BrokerError(405, f"no route for {method} /v1/agents/"
                                       + "/".join(tail))
        except loam_agents.AgentsError as exc:
            writer.write(response(exc.status, {"error": exc.message, **exc.detail},
                                  nocache))
            await writer.drain()
            return
        except loam_profile.ProfileError as exc:
            writer.write(response(exc.status, {"error": exc.message}, nocache))
            await writer.drain()
            return
        writer.write(response(status, body, nocache))
        await writer.drain()

    def running_by_project(self) -> dict:
        try:
            box = activity.live_jobs()
        except Exception:  # noqa: BLE001
            return {}
        out: dict = {}
        for s in box.get("slots") or []:
            if s.get("kind") == "engineer job" and s.get("project"):
                out[s["project"]] = out.get(s["project"], 0) + 1
        return out

    async def profile_route(self, method: str, tail: list[str], payload: dict,
                            writer: asyncio.StreamWriter) -> None:
        nocache = "Cache-Control: no-store\r\n"
        from urllib.parse import unquote  # noqa: PLC0415
        tail = [unquote(p) for p in tail]
        try:
            if tail[0] == "agents":
                agent = tail[1]
                if method == "GET":
                    body = await asyncio.to_thread(self.profile, agent)
                elif method == "PATCH":
                    by = author(payload)
                    before = await asyncio.to_thread(loam_profile.read_agent, agent)
                    after = await asyncio.to_thread(
                        loam_profile.update_agent, agent, payload, self.profile_check)
                    changed = [k for k in loam_profile.SETTABLE
                               if before.get(k) != after.get(k)]
                    print(f"profile: {agent} {changed or 'unchanged'} by "
                          f"{by or lc.OWNER_ID}", file=sys.stderr, flush=True)
                    if by and changed:
                        words = ", ".join(
                            f"{k} to {after.get(k)}" if after.get(k) is not None
                            else f"{k} back to its default" for k in changed)
                        self.say_in_general(
                            f"{threads_rec.display(by)} changed "
                            f"{threads_rec.display(agent)}'s {words}")
                    body = await asyncio.to_thread(self.profile, agent)
                else:
                    raise BrokerError(405, "use GET or PATCH for an agent's profile")
            elif tail[0] == "engineers":
                if len(tail) == 1 and method == "GET":
                    running = await asyncio.to_thread(self.running_by_project)
                    body = await asyncio.to_thread(loam_profile.engineers, running)
                elif len(tail) == 2 and method == "GET":
                    running = await asyncio.to_thread(self.running_by_project)
                    body = await asyncio.to_thread(loam_profile.engineer, tail[1],
                                                   running)
                elif len(tail) == 2 and method == "PATCH":
                    by = author(payload)
                    name = tail[1]
                    await asyncio.to_thread(loam_profile.update_engineer, name,
                                            payload, self.profile_check)
                    fields = sorted(k for k in payload if k != "by")
                    print(f"profile: engineer {name} {fields} by {by or lc.OWNER_ID}",
                          file=sys.stderr, flush=True)
                    if by:
                        words = ", ".join(
                            loam_profile.tier_words(payload[k]) if k == "tiers"
                            else f"{k} to {payload[k]}" if payload[k] is not None
                            else f"{k} back to its default" for k in fields)
                        self.say_in_general(
                            f"{threads_rec.display(by)} changed the "
                            f"{'default engineer' if name == 'default' else name + ' engineer'}"
                            f"'s {words}")
                    running = await asyncio.to_thread(self.running_by_project)
                    body = await asyncio.to_thread(loam_profile.engineers, running)
                else:
                    raise BrokerError(405, "GET /v1/engineers, GET or PATCH "
                                           "/v1/engineers/<project or default>")
            else:
                if method == "GET":
                    body = await asyncio.to_thread(loam_profile.reviewer)
                elif method == "PATCH":
                    by = author(payload)
                    body = await asyncio.to_thread(loam_profile.update_reviewer,
                                                   payload, self.profile_check)
                    fields = sorted(k for k in payload if k != "by")
                    print(f"profile: reviewer {fields} by {by or lc.OWNER_ID}",
                          file=sys.stderr, flush=True)
                    if by:
                        words = ", ".join(f"{k} to {payload[k]}" if payload[k] is not None
                                          else f"{k} back to its default" for k in fields)
                        self.say_in_general(f"{threads_rec.display(by)} changed the "
                                            f"nightly reviewer's {words}")
                else:
                    raise BrokerError(405, "use GET or PATCH for the reviewer")
            writer.write(response(200, body, nocache))
        except loam_profile.ProfileError as exc:
            writer.write(response(exc.status, {"error": exc.message}, nocache))
        except BrokerError as exc:
            writer.write(response(exc.status, {"error": exc.message}, nocache))
        await writer.drain()

    async def update_route(self, method: str, tail: list[str], payload: dict,
                           writer: asyncio.StreamWriter) -> None:
        """``GET /v1/update`` the state (and ``/progress``, the run alone);
        ``POST /v1/update/check``; ``POST /v1/update/apply`` ``{"to",
        "accept_library_edits"}`` and ``POST /v1/update/rollback``, each
        answered 202 with the run started as its own unit, or 409 with the
        refusal. docs/update.md."""
        nocache = "Cache-Control: no-store\r\n"
        routes = {((), "GET"), (("progress",), "GET"), (("check",), "POST"),
                  (("apply",), "POST"), (("rollback",), "POST")}
        key = (tuple(tail), method)
        if key not in routes:
            known = any(tuple(tail) == r[0] for r in routes)
            writer.write(response(405 if known else 404, {"error": (
                f"use {' or '.join(sorted(m for t, m in routes if t == tuple(tail)))} here"
                if known else "no such update route")}, nocache))
            await writer.drain()
            return
        try:
            if key == ((), "GET"):
                body, status = await asyncio.to_thread(loam_update.status), 200
            elif key == (("progress",), "GET"):
                body = (await asyncio.to_thread(loam_update.status)).get("run") or {}
                status = 200
            elif key == (("check",), "POST"):
                body, status = await asyncio.to_thread(loam_update.check), 200
            else:
                to = payload.get("to")
                if to is not None and not isinstance(to, str):
                    writer.write(response(400, {"error": "`to` is a version, like "
                                                         "\"1.2.0\""}, nocache))
                    await writer.drain()
                    return
                by = author(payload)
                run = await asyncio.to_thread(
                    loam_update.start, tail[0], to if tail[0] == "apply" else None,
                    payload.get("accept_library_edits") is True, by)
                print(f"update: {tail[0]} started ({run.get('id')}) by "
                      f"{by or lc.OWNER_ID}", file=sys.stderr, flush=True)
                body, status = {"run": run}, 202
        except loam_update.Refusal as r:
            body, status = {"error": r.message, "refusal": r.as_dict()}, 409
        except RuntimeError as exc:
            body, status = {"error": f"the update could not start: {exc}"}, 503
        writer.write(response(status, body, nocache))
        await writer.drain()

    async def plugins_route(self, method: str, tail: list[str], payload: dict,
                            writer: asyncio.StreamWriter) -> None:
        """``/v1/plugins``: GET the list, POST an install (a preview, then a
        confirm); ``/v1/plugins/<id>``: GET one, PATCH ``{"on"}``, DELETE;
        ``/v1/plugins/<id>/files/<path>``: a page, asset or theme file."""
        nocache = "Cache-Control: no-store\r\n"
        from urllib.parse import unquote  # noqa: PLC0415
        tail = [unquote(p) for p in tail]
        try:
            if not tail:
                if method == "GET":
                    body = await asyncio.to_thread(loam_plugins.listing)
                elif method == "POST":
                    by = author(payload)
                    body = await asyncio.to_thread(
                        loam_plugins.install,
                        {k: v for k, v in payload.items() if k != "by"}, by)
                    print(f"plugins: install {payload.get('url') or payload.get('repo')}"
                          f"{' confirmed' if payload.get('confirm') else ' (preview)'}"
                          f"{' -> ' + body['id'] if body.get('installed') else ''} by "
                          f"{by or lc.OWNER_ID}", file=sys.stderr, flush=True)
                else:
                    raise BrokerError(405, "use GET for the list, POST to install")
                writer.write(response(200, body, nocache))
            elif len(tail) == 1:
                pid = tail[0]
                if method == "GET":
                    body = await asyncio.to_thread(loam_plugins.one, pid)
                elif method == "PATCH":
                    by = author(payload)
                    fields = {k: v for k, v in payload.items() if k != "by"}
                    if set(fields) != {"on"}:
                        raise BrokerError(400, "a plugin's one setting is `on`: "
                                               "{\"on\": true}")
                    body = await asyncio.to_thread(loam_plugins.set_on, pid,
                                                   fields["on"], by)
                    print(f"plugins: {pid} on={fields['on']} by {by or lc.OWNER_ID}",
                          file=sys.stderr, flush=True)
                elif method == "DELETE":
                    by = author(payload)
                    body = await asyncio.to_thread(loam_plugins.remove, pid, by)
                    print(f"plugins: removed {pid} by {by or lc.OWNER_ID}",
                          file=sys.stderr, flush=True)
                else:
                    raise BrokerError(405, "use GET, PATCH or DELETE for a plugin")
                writer.write(response(200, body, nocache))
            elif tail[1:] == ["restart"]:
                # A server plugin's restart (2026-11-13): that plugin's own
                # unit, fresh; lib/loam_plugin_servers.py. Never the broker.
                if method != "POST":
                    raise BrokerError(405, "restart a plugin's server with POST")
                by = author(payload)
                body = await asyncio.to_thread(loam_plugins.restart_server,
                                               tail[0], by)
                print(f"plugins: restarted {tail[0]}'s server by {by or lc.OWNER_ID}",
                      file=sys.stderr, flush=True)
                writer.write(response(200, body, nocache))
            elif tail[1:2] == ["secrets"] and len(tail) in (2, 3, 4):
                # A key the person pastes (2026-11-14, first release L9): the
                # plugin's `settings.secret`, checked on entry and kept in its
                # private secrets.env, never in Yours. lib/loam_contributions.py.
                # A credential is the person's own: an agent's call is refused.
                import loam_contributions as contrib  # noqa: PLC0415
                pid = tail[0]
                if author(payload) is not None:
                    raise BrokerError(403, "a key is the owner's to paste, in the "
                                           "plugin's settings; an agent cannot set, "
                                           "check or read one")
                try:
                    if len(tail) == 2 and method == "GET":
                        body = {"id": pid, "secrets": await asyncio.to_thread(
                            contrib.secrets_of, pid)}
                    elif len(tail) == 3 and method == "PUT":
                        body = await asyncio.to_thread(contrib.set_secret, pid, tail[2],
                                                       payload.get("value"))
                        print(f"plugins: {pid} key {tail[2]} set (checked: "
                              f"{body['checked']['why']})", file=sys.stderr, flush=True)
                    elif len(tail) == 3 and method == "DELETE":
                        body = await asyncio.to_thread(contrib.delete_secret, pid, tail[2])
                        print(f"plugins: {pid} key {tail[2]} removed", file=sys.stderr,
                              flush=True)
                    elif tail[3:] == ["check"] and method == "POST":
                        body = await asyncio.to_thread(contrib.recheck_secret, pid, tail[2])
                    elif tail[3:] == ["value"] and method == "GET":
                        # For the app's own server, which makes the provider's
                        # call; the page's relay must never pass this route.
                        # A field of a provider the plugin declared in `keys:`
                        # (2026-11-18) resolves as shared keys do.
                        import loam_keys  # noqa: PLC0415
                        if not await asyncio.to_thread(loam_keys.declares_field, pid, tail[2]):
                            await asyncio.to_thread(contrib._secret_entry, pid, tail[2])
                        value = await asyncio.to_thread(contrib.secret_for, pid, tail[2])
                        if not value:
                            raise BrokerError(404, f"no {tail[2]} is set for {pid}")
                        body = {"name": tail[2], "value": value,
                                "source": contrib.secret_source(pid, tail[2])}
                    else:
                        raise BrokerError(405, "GET /v1/plugins/<id>/secrets; PUT or "
                                               "DELETE …/secrets/<name>; POST …/<name>/check")
                except contrib.ContributionError as exc:
                    status = 404 if "no plugin" in str(exc) or "declares no secret" in str(exc) \
                        else 422
                    raise BrokerError(status, str(exc))
                writer.write(response(200, body, nocache))
            elif tail[1:] == ["settings"]:
                # A plugin's own settings (2026-11-14, first release L4):
                # the `settings.entry` values it contributes, which
                # bin/settings reaches as `plugin.<id>.<key>`.
                # lib/loam_contributions.py.
                import loam_contributions as contrib  # noqa: PLC0415
                pid = tail[0]
                if method == "GET":
                    entries = contrib.entries_of(pid)
                    body = {"id": pid, "entries": entries,
                            "values": {e["key"]: contrib.get_setting(pid, e["key"])
                                       for e in entries}}
                elif method == "PATCH":
                    by = author(payload)
                    values = payload.get("values")
                    if not isinstance(values, dict) or not values:
                        raise BrokerError(400, "the body is {\"values\": {key: value}}")
                    try:
                        for key, value in values.items():
                            await asyncio.to_thread(contrib.set_setting, pid, key, value)
                    except contrib.ContributionError as exc:
                        raise BrokerError(400, str(exc))
                    print(f"plugins: {pid} settings {json.dumps(values, sort_keys=True)} "
                          f"by {by or lc.OWNER_ID}", file=sys.stderr, flush=True)
                    body = {"id": pid, "values": {k: contrib.get_setting(pid, k)
                                                  for k in values}}
                else:
                    raise BrokerError(405, "GET or PATCH a plugin's settings")
                writer.write(response(200, body, nocache))
            elif tail[1:2] == ["agents"] and len(tail) in (2, 3):
                # A plugin's per-agent settings (2026-11-13): what it keeps
                # for each agent and shows on the agent's profile (place
                # `agent.profile`). lib/loam_plugins.py, `agent_values`.
                pid = tail[0]
                agent = tail[2] if len(tail) == 3 else None
                if agent is not None and agent not in cfg.roster():
                    raise BrokerError(404, f"no agent named {agent!r} on this box")
                if method == "GET":
                    body = await asyncio.to_thread(loam_plugins.agent_values,
                                                   pid, agent)
                elif method == "PATCH" and agent is not None:
                    by = author(payload)
                    fields = {k: v for k, v in payload.items() if k != "by"}
                    if set(fields) != {"values"}:
                        raise BrokerError(400, "the body is {\"values\": {field: "
                                               "value}}; null puts one back")
                    body = await asyncio.to_thread(loam_plugins.set_agent_values,
                                                   pid, agent, fields["values"], by)
                    print(f"plugins: {pid} for {agent}: "
                          f"{json.dumps(fields['values'], sort_keys=True)} by "
                          f"{by or lc.OWNER_ID}", file=sys.stderr, flush=True)
                    if by:
                        self.say_in_general(
                            f"{threads_rec.display(by)} set {body.get('name') or pid}'s "
                            f"{', '.join(sorted(fields['values']))} for "
                            f"{threads_rec.display(agent)}")
                else:
                    raise BrokerError(405, "use GET for a plugin's agent settings, "
                                           "PATCH /v1/plugins/<id>/agents/<agent> "
                                           "to change one agent's")
                writer.write(response(200, body, nocache))
            elif len(tail) >= 3 and tail[1] == "files":
                if method not in ("GET", "HEAD"):
                    raise BrokerError(405, "a plugin's files are read with GET")
                path, ctype = await asyncio.to_thread(loam_plugins.file_for,
                                                      tail[0], tail[2:])
                data = await asyncio.to_thread(path.read_bytes)
                head = (f"HTTP/1.1 200 OK\r\nContent-Type: {ctype}\r\n"
                        f"Content-Length: {len(data)}\r\n"
                        f"Cache-Control: no-cache\r\n"
                        f"X-Content-Type-Options: nosniff\r\n"
                        f"Connection: close\r\n\r\n").encode()
                writer.write(head + (b"" if method == "HEAD" else data))
            else:
                raise BrokerError(404, f"no route for {method} /v1/plugins/"
                                       f"{'/'.join(tail)}")
        except loam_plugins.PluginError as exc:
            writer.write(response(exc.status, {"error": exc.message, **exc.detail},
                                  nocache))
        except BrokerError as exc:
            writer.write(response(exc.status, {"error": exc.message}, nocache))
        await writer.drain()

    def _attachment(self, raw) -> dict:
        """A stored path a client sent back, checked before it is read.

        Only a path this interface itself wrote: inside the attachments
        directory, resolved (so a symlink or a `..` cannot point out of it) and
        present on disk. A client cannot use a message to make a persona read
        an arbitrary file on the box -- that is a capability the app has never
        had and must not gain through here.
        """
        if not isinstance(raw, str) or not raw.strip():
            raise BrokerError(400, "`attachments` is a list of stored paths")
        candidate = Path(raw.strip())
        if not candidate.is_absolute():
            candidate = cfg.VAULT / candidate
        try:
            resolved = candidate.resolve()
            resolved.relative_to(cfg.ATTACHMENT_ROOT.resolve())
        except (OSError, ValueError):
            raise BrokerError(
                400, f"{raw} is not a stored attachment; upload it to "
                     f"POST /v1/sessions/<id>/attachments first") from None
        if not resolved.is_file():
            raise BrokerError(404, f"no attachment at {raw}")
        return {"path": str(resolved), "name": resolved.name,
                "size": resolved.stat().st_size,
                "type": cfg.attachment_type(resolved.name)}

    @staticmethod
    def _count(raw: str | None, name: str) -> int | None:
        """A whole number off the query string, or nothing at all."""
        if raw is None or raw == "":
            return None
        try:
            value = int(raw)
        except ValueError:
            raise BrokerError(400, f"`{name}` is a number") from None
        if value < 1:
            raise BrokerError(400, f"`{name}` is 1 or more")
        return value

    async def catalog(self, agent=None):
        if getattr(self.broker, "remote", False):
            return await self.broker.catalog(agent)
        self.broker.scan_for_new()
        return self.broker.known(agent), self.broker.residency()

    async def stream_records(self, writer: asyncio.StreamWriter,
                             full: bool = False) -> None:
        """The live list: every session's record, whenever any of them changes.

        The same ``broker.session`` snapshot the per-session stream leads
        with, and for the same reason it is not an event: it carries no
        ``seq``, it is never logged, and a client applies whichever one
        arrives last per ``session_id``. There is nothing to reconnect *at*,
        so there is no ``?from=`` here -- reopening the stream re-sends the
        whole list, which is by definition current.

        It opens with the listing as it stands, so a page that connects
        before it fetches anything already has the screen. Every record is in
        it, archived or not (``?archived=1`` is accepted and changes nothing
        since 2026-11-12).

        The one other item here is ``broker.residency`` (2026-09-25): the
        resident count and the cap, sent once at the end of the opening burst
        and again whenever the count moves. Each row carries its own ``live``
        on its record, so a client filtering to what is in RAM needs nothing
        more; this exists because the total against the cap is a fact about
        the box and not about any row, and a narrowed list cannot be counted
        for it.
        After that, **every** record change goes out, archived or not: a page
        that filters archived rows still has to be told the moment a row
        becomes archived, or it keeps drawing one.
        """
        queue: asyncio.Queue = asyncio.Queue()
        self.broker.record_subscribers.add(queue)
        try:
            # The opening burst IS a read of the list, so it scans for app
            # sessions nobody has adopted yet on the same terms as the route:
            # a client that only ever opens this stream must not be the one
            # client that never sees a new conversation appear.
            rows, residency = await self.catalog()
            self._open_stream(writer)
            # Rows as the listing answers them (`list_row`), here and for
            # every change after: the whole `turns` is the session's own
            # stream's, unless `?turns=all` asked for it (2026-11-09).
            row = (lambda r: r) if full else list_row
            for record in rows:
                await self._send_event(writer, {"type": "broker.session",
                                                **row(record)})
            # And the count against the cap, so a client that only ever opens
            # this stream has the whole screen -- the rows and "2 of 4 live" --
            # without fetching the list route for the two numbers on it.
            await self._send_event(writer, {"type": "broker.residency", **residency})
            # `asyncio.timeout` for the reason `stream` gives; and `None` is
            # the broker's stop (`Broker.close_record_streams`), so a stop
            # never depends on this task taking a cancel at all.
            while True:
                try:
                    async with asyncio.timeout(KEEPALIVE_S):
                        record = await queue.get()
                except TimeoutError:
                    await self._ping(writer)
                    continue
                if record is None:
                    return
                await self._send_event(writer, row(record))
        except (ConnectionResetError, BrokenPipeError):
            pass
        finally:
            self.broker.record_subscribers.discard(queue)

    def providers(self, agent: str | None = None) -> list[dict]:
        """Every provider the app draws a row for, connected or not, and what
        each one offers a chat: its models and its effort levels.

        One is wired. The others are named here rather than left out because
        the page has a row for each and "Codex — not wired" is an answer,
        where a missing row is a bug report. `usage` is on the wired one only,
        and is `null` until a rate limit reading has been seen: the CLI
        volunteers those mid-turn, so a box that has not taken a turn since
        the file was last written has nothing to say and says so.

        `models` and `efforts` (2026-09-21) are what the + menu is drawn
        from, and an unwired provider carries both as empty lists -- not as
        absent keys, so a client reads "nothing on offer here" without a
        branch. `default: true` marks the model the persona's own settings
        name, which is what a session runs on when nobody picks: it is read
        off that persona's settings.json when `agent` says whose, and off the
        fleet when it does not. No row is marked when the personas disagree,
        which is honest and is what a fleet mid-change looks like.

        `login` (2026-09-22) is on the wired one only and is read from the
        credential itself on every call, never cached: when it expires, how
        many whole days that is, and which credential the sessions are
        actually running on. It is what lets the page say "Claude Code login
        expires in 3 days" without knowing that a login is a file.
        """
        # A read for each provider that has one, at most once a minute: this
        # is a thread (the route's to_thread), and a read is a short-lived
        # CLI process, ~1 s for Codex and ~3.5 s for Claude Code.
        self.broker.usage.on_fetch()
        login = cfg.login_state()
        connected, reason = provider_defaults.available("claude-code", login)
        usage = cfg.read_usage()
        default_model = cfg.persona_model(agent)
        # The persona's own default model (2026-11-13, its profile), when it
        # is a Claude Code one, is the row ticked: it is what a turn runs on.
        if agent and agent in cfg.roster():
            mine = provider_defaults.agent_choice(threads_rec.provider_card(agent), "claude-code")
            if mine["provider"] == "claude-code" and mine["model"]:
                default_model = mine["model"]
        out = []
        for provider in cfg.PROVIDERS:
            row = {"id": provider,
                   "name": cfg.PROVIDER_NAMES[provider],
                   "connected": False,
                   "reason": cfg.NOT_WIRED,
                   "models": [], "efforts": []}
            if provider == "codex":
                row.update(self.codex_row())
            elif provider == "antigravity":
                row.update(self.antigravity_row())
            elif provider in cfg.WIRED_PROVIDERS:
                row["connected"] = connected
                row["reason"] = reason
                row["usage"] = usage
                row["usage_reason"] = self.broker.usage.reason(provider) or (
                    None if usage is not None else
                    "no reading yet: the read failed and no turn has run")
                row["login"] = cfg.claude_code_row_login(login)
                # `resolves_to` (2026-11-10): the concrete id each alias
                # runs on with the installed CLI, read from its build
                # (cfg.alias_table), so a pill can say "Fable 5.2" before
                # anyone has replied on it. `cli_version` is that build.
                table = cfg.alias_table()
                row["cli_version"] = table["version"]
                row["models"] = []
                for alias, name in cfg.PROVIDER_MODELS.get(provider, ()):
                    model = {"id": alias, "name": name,
                             "default": alias == default_model,
                             "resolves_to": cfg.resolves_to(alias, table)}
                    after = cfg.resolves_after_plan(alias, table)
                    if after:
                        model["resolves_to_after_plan"] = after
                    row["models"].append(model)
                row["efforts"] = list(cfg.EFFORTS)
            # `sign_in.account` (2026-11-11) is the row's own
            # `login.account` while it is connected, so the card can say
            # "Signed in as …" from the one object it draws.
            row["sign_in"] = cfg.sign_in(
                provider, (row.get("login") or {}).get("account")
                if row["connected"] else None)
            out.append(row)
        return out

    @staticmethod
    def antigravity_row() -> dict:
        """The Antigravity row (2026-11-09), in the Claude row's shape. The
        login is read by asking the CLI (``loam_antigravity.login_state``,
        cached a minute). ``usage`` (2026-11-15) is the CLI's own ``/quota``
        and ``/credits``, read on the cadence the other two are
        (``loam_antigravity.read_quota``): every pool's window under
        ``buckets`` with ``utilization`` USED, as the others', and
        ``credits`` in Codex's shape. Null until a read has succeeded on the
        login the box holds."""
        state = agy.login_state()
        usage = agy.row_usage()
        connected, reason = provider_defaults.available("antigravity", state)
        return {
            "connected": connected,
            "reason": reason,
            "usage": usage,
            "usage_reason": None if usage is not None else
            "no reading yet: /quota has not answered on this login",
            "login": agy.row_login(state),
            # A model whose id ends in its level takes no other
            # (loam_antigravity.LEVEL_RE, 2026-11-15).
            "models": [{"id": m["id"], "name": m["name"], "default": False,
                        "efforts": ([] if agy.carries_level(m["id"])
                                    else list(agy.EFFORTS)),
                        "context_window": None}
                       for m in state["models"]],
            "efforts": list(agy.EFFORTS) if state["connected"] else [],
        }

    @staticmethod
    def codex_row() -> dict:
        """The Codex row's own fields (2026-10-01), in the Claude row's shape.

        ``login`` adds three keys the Claude row does not have: ``account``
        and ``plan`` out of the login's id token, and ``status``, the line
        ``codex login status`` prints. ``expires_at`` and ``days_left`` are
        null and always will be on this login -- see
        ``loam_codex.login_state``.

        ``usage`` (2026-10-01, the evening) is the last
        ``account/rateLimits/updated`` kept on disk, in the Claude row's shape
        with ``credits`` and ``planType`` beside the windows -- see
        ``loam_codex.usage_from_rate_limits``. It is null until a Codex turn
        has run on the login the box holds, and ``usage_reason`` then says so.

        ``models`` is what ``model/list`` answered, each with its own
        ``efforts`` (the levels differ by model), and ``efforts`` on the row
        is their union. ``default`` marks the model Codex itself calls the
        default, because a persona's settings name no Codex model.
        ``context_window`` is the window a turn on that model would state,
        out of Codex's own catalogue (``loam_codex.context_windows``;
        ``model/list`` states none), and null when the catalogue does not
        carry it. It is the page's fallback until a turn states its own.
        """
        state = codex.login_state()
        usage = codex.row_usage()
        windows = codex.context_windows()
        connected, reason = provider_defaults.available("codex", state)
        return {
            "connected": connected,
            "reason": reason,
            "usage": usage,
            "usage_reason": None if usage is not None else
            "no reading yet: the read failed and no Codex turn has run",
            "login": Server.codex_login(state),
            "models": [{"id": m["id"], "name": m["name"],
                        "default": bool(m.get("default")),
                        "efforts": list(m.get("efforts") or []),
                        "context_window": windows.get(m["id"])}
                       for m in codex.read_models()],
            "efforts": codex.efforts(),
        }

    @staticmethod
    def codex_login(state: dict | None = None) -> dict:
        """The Codex row's ``login`` object; also what its sign-out
        answers."""
        state = codex.login_state() if state is None else state
        return {"expires_at": state["expires_at"],
                "days_left": state["days_left"],
                "source": state["source"],
                "account": state["account"],
                "plan": state["plan"],
                "status": codex.status_line()}

    def _open_stream(self, writer: asyncio.StreamWriter) -> None:
        """The SSE headers and the opening comment, which states the stream's
        own keepalive interval in milliseconds.

        A client measuring staleness needs the number this broker actually
        uses, not one copied into a document that will disagree with the code
        one day. Both streams here open the same way on purpose: two streams
        with two shapes is two readers in the app.
        """
        writer.write(b"HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\n"
                     b"Cache-Control: no-cache\r\nConnection: close\r\n\r\n")
        writer.write(f": open ping={KEEPALIVE_S * 1000}\n\n".encode())

    async def _ping(self, writer: asyncio.StreamWriter) -> None:
        """A comment line keeps a proxy and a dead peer honest; writing
        nothing for minutes is indistinguishable from a hung broker."""
        writer.write(b": ping\n\n")
        await writer.drain()

    async def _send_event(self, writer: asyncio.StreamWriter,
                          event: dict) -> None:
        writer.write(f"data: {json.dumps(for_the_wire(event))}\n\n".encode())
        await writer.drain()


LOADED_SOURCE.update(loaded_source(__file__))


async def amain(addr: str, port: int) -> int:
    with own_session_store(), own_store(threads_rec.STATE, "thread API"):
        return await serve(addr, port)


async def serve(addr: str, port: int, remote_path=None) -> int:
    broker = SocketBroker(remote_path) if remote_path else Broker()
    broker.revision = fence.revision()
    server = Server(broker)
    if remote_path:
        ready = asyncio.Event()
        registry_task = asyncio.create_task(broker.listen_registry(ready))
        await ready.wait()
        await broker.synchronize()
        await server.threads.restore_tails()
    else:
        broker.prepare_records()
        asyncio.create_task(broker.reap_idle())
    try:
        import loam_starter  # noqa: PLC0415
        loam_starter.inherit_legacy_hello()
    except (OSError, ValueError) as exc:
        print(f"starter: could not update the hello thread ({exc})",
              file=sys.stderr, flush=True)
    # Each thread member's input still on disk from before this start (the
    # owner's messages, job results; 2026-11-19, batch B step 2,
    # lib/loam_thread_inputs.py), scheduled again once each and in order.
    try:
        counts = server.threads.resume_inputs()
        print(f"inputs: {counts['scheduled']} scheduled again for "
              f"{counts['members']} thread member(s), {counts['dropped']} "
              f"dropped", file=sys.stderr, flush=True)
    except Exception as exc:  # noqa: BLE001 - never the reason a broker is down
        print(f"inputs: resuming failed ({exc!r})", file=sys.stderr, flush=True)
    # Results owed to a thread, given to its persona as input.
    asyncio.create_task(server.deliver_owed())
    # Usage reads while anything is live, and once as each job ends.
    asyncio.create_task(broker.refresh_usage())
    # Codex's model list, so the + menu has a Codex row before any Codex
    # session has run. Off the loop, and fail-soft: the cached list stays.
    asyncio.create_task(fetch_codex_models())
    # The first-party looks that left the shipped set in 0.2.5 (2026-11-18):
    # one the person was using or had chosen is installed from its Market
    # link, once (lib/loam_listed_themes.py). Off the loop, and fail-soft.
    asyncio.create_task(keep_listed_themes())
    # Market plugins that became part of Loam (Images, 0.2.10): the copy the
    # Market installed steps aside for the built-in one, once, keeping its
    # switch, settings and keys (lib/loam_built_in.py). Fail-soft.
    asyncio.create_task(take_over_built_ins())
    # Built-in plugins that left for the Market in 0.2.9 (Dictation, Read
    # aloud): one that was on is installed from its Market listing, once,
    # keeping its switch, voices, keys and preferences
    # (lib/loam_to_market.py). Off the loop, and fail-soft.
    asyncio.create_task(keep_moved_to_market())
    tcp = await asyncio.start_server(server.handle, addr, port)
    stop = asyncio.Event()
    loop = asyncio.get_running_loop()
    watch = ShutdownWatch(broker, loop)

    def on_signal(sig: signal.Signals) -> None:
        broker.stopping = True
        watch.arm(sig.name)
        stop.set()

    for sig in (signal.SIGTERM, signal.SIGINT):
        loop.add_signal_handler(sig, on_signal, sig)
    print(f"session-broker listening on {addr}:{port} "
          f"(admission by memory: reserve {cfg.MEMORY_RESERVE_MB} MB, "
          f"{cfg.SESSION_START_MB} MB a start; backstop {cfg.MAX_SESSIONS} "
          f"sessions)", file=sys.stderr, flush=True)
    async with tcp:
        await stop.wait()
    if remote_path:
        # Cancel the workers before closing readers. Cancellation preserves
        # their bound inputs; an EOF would instead file an interrupted turn.
        workers = list(server.threads.workers.values())
        for task in workers:
            task.cancel()
        await asyncio.gather(*workers, return_exceptions=True)
        server.threads.stop_all_tails()
        registry_task.cancel()
        await asyncio.gather(registry_task, return_exceptions=True)
        await broker.client.close_readers()
        broker.close_record_streams()
    else:
        await shutdown(broker, server)
    return 0


async def keep_listed_themes() -> None:
    try:
        import loam_listed_themes  # noqa: PLC0415
        kept = await asyncio.to_thread(loam_listed_themes.keep)
        for pid, entry in kept.items():
            print(f"themes: {pid} {entry['how']} ({entry['why']})"
                  + (f": {entry.get('link_error') or entry.get('error')}"
                     if entry["how"] != "link" and (entry.get("link_error") or entry.get("error")) else ""),
                  file=sys.stderr, flush=True)
    except Exception as exc:  # noqa: BLE001 - never the reason a broker is down
        print(f"themes: keeping the listed looks failed ({exc!r})", file=sys.stderr, flush=True)


async def take_over_built_ins() -> None:
    try:
        import loam_built_in  # noqa: PLC0415
        settled = await asyncio.to_thread(loam_built_in.take_over)
        for pid, entry in settled.items():
            print(f"built-in: {pid} {entry['how']}"
                  + (f" ({entry.get('why') or entry.get('error')})"
                     if entry.get("why") or entry.get("error") else ""),
                  file=sys.stderr, flush=True)
    except Exception as exc:  # noqa: BLE001 - never the reason a broker is down
        print(f"built-in: the take-over failed ({exc!r})", file=sys.stderr, flush=True)


async def keep_moved_to_market() -> None:
    try:
        import loam_to_market  # noqa: PLC0415
        kept = await asyncio.to_thread(loam_to_market.keep)
        for pid, entry in kept.items():
            print(f"to-market: {pid} {entry['how']}"
                  + (f" ({entry.get('link_error') or entry.get('error')})"
                     if entry["how"] != "link" and (entry.get("link_error") or entry.get("error")) else ""),
                  file=sys.stderr, flush=True)
        # Since 0.2.12 each carries its own server half: a copy older than
        # that gets the listing's version, once, and Read aloud's voices
        # setting is seeded from the install's old `app.speech_voices`.
        seeded = await asyncio.to_thread(loam_to_market.seed_voices)
        if seeded:
            print(f"to-market: read-aloud voices {seeded['how']}", file=sys.stderr, flush=True)
        brought = await asyncio.to_thread(loam_to_market.bring_up)
        for pid, entry in brought.items():
            print(f"to-market: {pid} server half {entry['how']}"
                  + (f" ({entry.get('why') or entry.get('error')})"
                     if entry.get("why") or entry.get("error") else ""),
                  file=sys.stderr, flush=True)
    except Exception as exc:  # noqa: BLE001 - never the reason a broker is down
        print(f"to-market: keeping the moved plugins failed ({exc!r})", file=sys.stderr, flush=True)


async def fetch_codex_models() -> None:
    try:
        models = await asyncio.to_thread(codex.fetch_models)
        print(f"codex: {len(models)} models listed", file=sys.stderr, flush=True)
    except Exception as exc:  # noqa: BLE001 - never the reason a broker is down
        print(f"codex: the model list failed ({exc!r})", file=sys.stderr, flush=True)


def main() -> int:
    addr, port = cfg.BIND_ADDR, cfg.PORT
    argv = sys.argv[1:]
    if "--addr" in argv:
        addr = argv[argv.index("--addr") + 1]
    if "--port" in argv:
        port = int(argv[argv.index("--port") + 1])
    if "--session-socket" in argv:
        with own_store(threads_rec.STATE, "thread API"):
            return asyncio.run(serve(addr, port, Path(argv[argv.index("--session-socket") + 1])))
    return asyncio.run(amain(addr, port))


if __name__ == "__main__":
    sys.exit(main())
