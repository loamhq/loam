#!/usr/bin/env python3
"""Every signed-in provider follows its latest release, tested, with rollback.

The rule and every step are in lib/loam_follow.py's docstring. This is the
command loam-provider-follow.timer runs at 02:50 Pacific, and the one to run
by hand.

Usage:
  provider-follow run [--provider NAME]... [--force] [--dry-run]
      One whole run. --force: a provider already current has its live build
      smoked as its own candidate and the switch rehearsed (the broker
      polled, recycle-rc --dry-run, no re-point, no restart, no comms line,
      the watch's signals read once over the last hour). --dry-run: no link
      moves and nothing restarts for any provider; a newer build is still
      installed beside the live one and smoked.
  provider-follow watch       resume an open rollback window (after a reboot)
  provider-follow clear-agy-files [--dry-run]
      Antigravity's files for engineer jobs that finished over a week ago
      (lib/loam_agy_files.py), cleared now; `run` does this as its last step.
  provider-follow status      each provider: signed in, live, latest, on disk
  provider-follow drill [--dir DIR]
      The rollback drill, on a throwaway: an older Claude Code build is
      installed into a scratch versions directory (the real install path),
      a scratch link is pinned to it, the link is switched to the live build
      by the real switch, a lane failure is put in a scratch wake log after
      the switch, and the real watch must roll the scratch link back to the
      throwaway, write the Important line (into a scratch vault) and refuse
      the build. The broker is polled for real and restarted never; the RC
      servers are recycled --dry-run. The scratch directory is removed.

Names: claude-code, codex, antigravity. Log: logs/provider-follow.jsonl.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import sys
import tempfile
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import loam_due  # noqa: E402


def providers(names: list[str] | None):
    import loam_follow as f  # noqa: PLC0415
    every = [cls() for cls in f.PROVIDERS]
    if not names:
        return every
    known = {p.name: p for p in every}
    unknown = [n for n in names if n not in known]
    if unknown:
        raise SystemExit(f"unknown provider(s): {unknown}; known: {sorted(known)}")
    return [known[n] for n in names]


def cmd_run(args) -> int:
    import loam_follow as f  # noqa: PLC0415
    hands = f.Hands(dry=args.dry_run, repoint=not args.dry_run)
    try:
        lock = f.locked()
    except f.Busy as exc:
        print(exc, file=sys.stderr)
        return 75
    with lock:
        f.log("box", "run", None, force=args.force, dry=args.dry_run,
              providers=args.provider or "all")
        plans = f.follow(providers(args.provider), hands, force=args.force)
        # A week after an engineer job, its Antigravity files (2026-11-15).
        f.clear_agy_files(dry=args.dry_run)
    bad = [p for p in plans if not p.passed]
    return 1 if bad else 0


def cmd_watch(args) -> int:
    import loam_follow as f  # noqa: PLC0415
    with f.locked():
        f.watch(providers(None), f.Hands())
    return 0


def cmd_clear_agy_files(args) -> int:
    import loam_follow as f  # noqa: PLC0415
    rows = f.clear_agy_files(dry=args.dry_run)
    for row in rows:
        print(json.dumps(row))
    if not rows:
        print("nothing due: no engineer job's Antigravity conversation is over a week old")
    return 1 if any(r["error"] for r in rows) else 0


def cmd_status(args) -> int:
    import loam_follow as f  # noqa: PLC0415
    for p in providers(None):
        ok, why = p.signed_in()
        row = {"provider": p.name, "signed_in": ok, "why": why, "live": p.live(),
               "follows": p.follows}
        if p.follows:
            try:
                row["latest"] = p.latest()
            except (OSError, ValueError, KeyError) as exc:
                row["latest"] = f"unread: {exc}"
            row["installed"] = p.installed()
            state = f.read_state(p)
            row["state"] = {k: state.get(k) for k in (
                "previous", "switched_at", "watch_until", "watched", "refused")}
        print(json.dumps(row))
    return 0


def cmd_drill(args) -> int:
    scratch = Path(args.dir or tempfile.mkdtemp(prefix="provider-follow-drill-"))
    scratch.mkdir(parents=True, exist_ok=True)
    os.environ.update({
        "LOAM_FOLLOW_STATE": str(scratch / "state"),
        "LOAM_FOLLOW_LOG": str(scratch / "provider-follow.jsonl"),
        "LOAM_FOLLOW_VAULT": str(scratch / "vault"),
        "LOAM_FOLLOW_WAKE_LOGS": str(scratch / "wake-logs"),
        "LOAM_FOLLOW_WATCH_S": "60", "LOAM_FOLLOW_POLL_S": "5",
    })
    import loam_follow as f  # noqa: PLC0415
    real = f.ClaudeCode()
    live = real.live()
    old = args.old
    versions = scratch / "versions"
    versions.mkdir()
    (scratch / "wake-logs").mkdir()
    (scratch / "vault" / "00_INBOX" / "from-agents").mkdir(parents=True)
    drill = f.ClaudeCode(link=scratch / "bin" / "claude", versions=versions)
    drill.link.parent.mkdir()
    ok = True
    try:
        print(f"drill: installing the throwaway {old} by the real install path",
              flush=True)
        drill.install(old)
        got = drill.version_of(drill.build(old))
        print(f"drill: {drill.build(old)} --version -> {got}", flush=True)
        ok &= got == old
        # The "new" build is the live one, by a link into the scratch tree:
        # nothing is downloaded twice and the real link is never touched.
        os.symlink(real.build(live), versions / live)
        drill.repoint(old)
        print(f"drill: scratch link pinned to {drill.live()}", flush=True)
        plan = f.Plan(drill, live, old, checks=[f.Check("given", True, "drill")])
        hands = f.Hands(dry=True, repoint=True, vault=scratch / "vault", quiet_max_s=0)
        # comms into the scratch vault: the drill's lines are real writes there
        hands.comms = lambda section, text: f.log(
            "box", "comms", __import__("loam_inbox").append_comms(
                scratch / "vault", f.POSTER, text, f.LINK, section=section),
            section=section, text=text, vault=str(scratch / "vault"))
        f.switch([plan], hands)
        print(f"drill: switched, scratch link -> {drill.live()}", flush=True)
        ok &= drill.live() == live
        time.sleep(1)
        with (scratch / "wake-logs" / "wake-drill.jsonl").open("w") as fh:
            fh.write(json.dumps({"ts": f.iso(), "ok": False, "stage": "invoke",
                                 "lane": "wake", "returncode": 1,
                                 "error": "drill: the CLI exited 1"}) + "\n")
        # The drill provider's own signals plus the injected wake log; the
        # RC/unit/broker readings are the box's real ones.
        f.watch([drill], hands, poll_s=5)
        state = f.read_state(drill)
        print(f"drill: after the watch, scratch link -> {drill.live()}; "
              f"refused {sorted(state.get('refused', {}))}", flush=True)
        ok &= drill.live() == old and live in state.get("refused", {})
        comms = (scratch / "vault" / "00_INBOX" / "from-agents" / "comms.md").read_text()
        lines = [ln for ln in comms.splitlines() if "rolled back" in ln]
        print("drill: comms (scratch):\n  " + "\n  ".join(comms.splitlines()), flush=True)
        ok &= bool(lines) and "## Important" in comms
        print("drill: run log:", flush=True)
        print((scratch / "provider-follow.jsonl").read_text(), flush=True)
        print(f"drill: real link untouched -> {real.live()}", flush=True)
        ok &= real.live() == live
    finally:
        if not args.keep:
            shutil.rmtree(scratch, ignore_errors=True)
    print("DRILL PASS" if ok else "DRILL FAIL", flush=True)
    return 0 if ok else 1


def main() -> int:
    # A run its timer started when it was not due goes no further
    # (lib/loam_due.py, 2026-11-14).
    if loam_due.refuse_if_not_due("provider-follow"):
        return 0
    ap = argparse.ArgumentParser(prog="provider-follow")
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run")
    r.add_argument("--provider", action="append")
    r.add_argument("--force", action="store_true")
    r.add_argument("--dry-run", action="store_true")
    sub.add_parser("watch")
    c = sub.add_parser("clear-agy-files")
    c.add_argument("--dry-run", action="store_true")
    sub.add_parser("status")
    d = sub.add_parser("drill")
    d.add_argument("--dir")
    d.add_argument("--old", default="2.1.311",
                   help="the throwaway older build (npm `stable` on 11-11)")
    d.add_argument("--keep", action="store_true")
    args = ap.parse_args()
    return {"run": cmd_run, "watch": cmd_watch, "status": cmd_status,
            "clear-agy-files": cmd_clear_agy_files,
            "drill": cmd_drill}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
