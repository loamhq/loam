#!/usr/bin/env python3
"""One run of a plugin's scheduled entry (`contributes.schedule.kind`).

  plugin-run <plugin id> <entry name>

What a contributed timer's service runs (lib/loam_contributions.py). It goes
no further when the timer fired at a moment its calendar did not name
(lib/loam_due.py), or when the plugin is no longer on: a timer outlives its
plugin's switch only until the next reconcile. Otherwise it runs the entry's
`run` with /bin/sh -c in the plugin's folder, with the plugin's id, folder,
settings and data folders in its environment, as a server plugin has.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import loam_contributions as contributions  # noqa: E402
import loam_due  # noqa: E402


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    pid, name = argv
    if loam_due.refuse_if_not_due(f"plugin-run {pid} {name}"):
        return 0
    for p in contributions.active():
        if p["id"] != pid:
            continue
        for entry in p["contributes"].get("schedule.kind") or []:
            if entry["name"] == name:
                for d in (p["settings"], p["data"]):
                    d.mkdir(parents=True, exist_ok=True)
                contributions.private_dir(pid).mkdir(parents=True, exist_ok=True,
                                                     mode=0o700)
                os.chdir(p["folder"])
                os.execve("/bin/sh", ["/bin/sh", "-c", entry["run"]],
                          {**os.environ, **contributions._env(p)})
    print(f"plugin-run: {pid} is off or has no scheduled entry {name!r}; "
          f"nothing ran", flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
