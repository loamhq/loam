#!/usr/bin/env python3
"""Serve the makers' relay on loopback. Defaults to a dry run."""
import argparse
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import loam_config as lc
import loam_feedback as fb
from loam_report_relay import Relay, file_issue

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--port", type=int, default=0)
    parser.add_argument("--file-issues", action="store_true")
    args = parser.parse_args()
    database = lc.STATE / "report-relay" / ("live.db" if args.file_issues else "dry-run.db")
    with Relay(args.port, fb.repo(), database, file_issue if args.file_issues else None) as server:
        print(f"http://127.0.0.1:{server.server_port}/v1/reports", flush=True)
        server.serve_forever()
